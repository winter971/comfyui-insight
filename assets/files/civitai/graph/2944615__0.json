In":0},{"from":"346","fromOut":0,"to":"341","toIn":0},{"from":"341","fromOut":0,"to":"342","toIn":0},{"from":"351","fromOut":0,"to":"345","toIn":0},{"from":"334","fromOut":1,"to":"345","toIn":4},{"from":"329","fromOut":0,"to":"347","toIn":0},{"from":"325","fromOut":0,"to":"350","toIn":0},{"from":"328","fromOut":0,"to":"350","toIn":1},{"from":"322","fromOut":0,"to":"350","toIn":2},{"from":"335","fromOut":0,"to":"350","toIn":3},{"from":"340","fromOut":0,"to":"350","toIn":4},{"from":"352","fromOut":2,"to":"351","toIn":0},{"from":"324","fromOut":0,"to":"352","toIn":0},{"from":"324","fromOut":1,"to":"352","toIn":1},{"from":"337","fromOut":0,"to":"352","toIn":2},{"from":"68","fromOut":0,"to":"346","toIn":0},{"from":"68","fromOut":2,"to":"324","toIn":2},{"from":"68","fromOut":2,"to":"327","toIn":0},{"from":"68","fromOut":2,"to":"331","toIn":1},{"from":"68","fromOut":2,"to":"351","toIn":1},{"from":"86","fromOut":0,"to":"343","toIn":0},{"from":"86","fromOut":0,"to":"344","toIn":0},{"from":"84","fromOut":0,"to":"339","toIn":0},{"from":"363","fromOut":0,"to":"324","toIn":4},{"from":"363","fromOut":0,"to":"329","toIn":0},{"from":"363","fromOut":0,"to":"330","toIn":0},{"from":"363","fromOut":0,"to":"331","toIn":0},{"from":"363","fromOut":0,"to":"348","toIn":0},{"from":"339","fromOut":0,"to":"340","toIn":1},{"from":"334","fromOut":0,"to":"363","toIn":3},{"from":"363","fromOut":2,"to":"345","toIn":1},{"from":"342","fromOut":0,"to":"328","toIn":0}],"ai":{"s":"LTXV 2.3 视频去字幕去水印工作流：VHS 载入视频统一到 24fps，取首帧经预处理生成条件潜空间；整段视频在 VAEEncodeForInpaint 里以全白遮罩编码成'整段待重绘'的初始潜空间，再由 LTXAddVideoICLoRAGuide 把原视频作为引导写进条件——模型因此知道每帧哪里有字幕水印要清掉。模型链是 LTXV 2.3 蒸馏主干串两枚 IC-LoRA（字幕移除 + 水印移除）再打 SageAttention 补丁；提示词由 Gemma 3 12B 编码，正向直接写 Remove all subtitles。采样走 CFG 1 + euler_ancestral + 手写 5 档 ManualSigmas，视频潜空间与空白音频潜空间拼成 AV 潜空间一起采样；采完拆开 AV、LTXVCropGuides 裁掉引导段，平铺解码后与原音频一起封装回视频。核心思路：IC-LoRA 负责'会修什么'，原视频引导负责'照着修'。","u":["批量清除视频硬字幕/内嵌字幕，用于二次剪辑或翻译替换","去角标、平台水印、logo，画面其余部分保持原样","清理素材库带字视频并保留原音轨直接归档","短片试跑确认效果后再处理长视频"],"d":3,"st":[{"name":"视频输入与规格读取","desc":"强制统一帧率后读出视频尺寸与总帧数，并截出首帧供条件生成，后续所有节点都吃这些规格。","nodes":["363","334","338","330","348","329"]},{"name":"遮罩与初始潜空间","desc":"白图按帧数复制转成全白遮罩，把整段视频编码成全待重绘潜空间；首帧另生成条件潜空间，二者汇入 IC 引导节点。","nodes":["336","332","333","331","347","327"]},{"name":"条件与音频潜空间","desc":"Gemma 编码清理指令式提示词，LTXV 条件统一帧率；按帧数造空白音频潜空间，与视频潜空间拼成 AV 潜空间。","nodes":["86","343","344","320","84","339","324","340"]},{"name":"模型与采样配置","desc":"蒸馏主干串两枚清理专用 IC-LoRA 并打 SageAttention 补丁；CFG 1、euler_ancestral、5 档手写 sigma 与固定种子构成少步采样配置。","nodes":["68","346","341","342","328","322","335","323","325","326"]},{"name":"采样与输出","desc":"AV 潜空间采样后拆分音视频，裁掉引导段再平铺解码，与原音频封装成清理后的视频。","nodes":["350","337","352","351","345"]}],"p":"ManualSigmas 定死 5 档 sigma，属蒸馏模型少步接法，调效果改 sigma 值而非加步数；帧率由 PrimitiveFloat(24) 一处分发到强制帧率、条件与输出封装，换帧率只改它；CFG 固定 1，清理强度靠两枚 IC-LoRA 的强度（默认 1）和提示词措辞控制。","n":"需另下 LTXV 2.3 蒸馏主干、Gemma 3 12B 文本编码器、音频 VAE 与两枚 IC-LoRA，22B 级模型显存要求高；依赖 6 个节点包，缺装会大面积报红；旁路的 ManualSigmas(323) 是备选调度，启用前先确认与当前模型匹配；长视频耗时随帧数线性增长，先拿几秒短片试效果。"}}