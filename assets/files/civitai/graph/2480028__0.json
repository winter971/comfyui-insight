91","fromOut":1,"to":"224","toIn":0},{"from":"249","fromOut":1,"to":"262","toIn":0},{"from":"304","fromOut":0,"to":"163","toIn":0},{"from":"304","fromOut":0,"to":"252","toIn":0},{"from":"305","fromOut":0,"to":"312","toIn":0},{"from":"101","fromOut":0,"to":"313","toIn":0},{"from":"256","fromOut":0,"to":"141","toIn":1},{"from":"324","fromOut":0,"to":"313","toIn":2},{"from":"312","fromOut":0,"to":"313","toIn":1},{"from":"76","fromOut":0,"to":"311","toIn":0},{"from":"311","fromOut":1,"to":"14","toIn":3},{"from":"22","fromOut":0,"to":"311","toIn":1},{"from":"329","fromOut":0,"to":"328","toIn":0},{"from":"330","fromOut":0,"to":"328","toIn":1},{"from":"328","fromOut":0,"to":"331","toIn":1},{"from":"328","fromOut":0,"to":"332","toIn":0},{"from":"332","fromOut":0,"to":"331","toIn":0},{"from":"331","fromOut":0,"to":"156","toIn":0},{"from":"333","fromOut":0,"to":"322","toIn":0},{"from":"334","fromOut":0,"to":"333","toIn":1},{"from":"335","fromOut":0,"to":"323","toIn":0},{"from":"256","fromOut":1,"to":"333","toIn":2},{"from":"256","fromOut":0,"to":"333","toIn":0},{"from":"256","fromOut":1,"to":"334","toIn":0},{"from":"256","fromOut":0,"to":"320","toIn":0},{"from":"256","fromOut":1,"to":"335","toIn":0},{"from":"256","fromOut":0,"to":"336","toIn":0},{"from":"345","fromOut":0,"to":"312","toIn":1},{"from":"345","fromOut":0,"to":"313","toIn":3},{"from":"333","fromOut":0,"to":"347","toIn":0},{"from":"20","fromOut":0,"to":"309","toIn":0},{"from":"311","fromOut":0,"to":"350","toIn":0},{"from":"252","fromOut":0,"to":"214","toIn":0},{"from":"313","fromOut":0,"to":"353","toIn":1},{"from":"345","fromOut":0,"to":"353","toIn":2},{"from":"354","fromOut":0,"to":"353","toIn":0},{"from":"355","fromOut":0,"to":"357","toIn":1},{"from":"283","fromOut":0,"to":"357","toIn":0},{"from":"326","fromOut":0,"to":"311","toIn":3},{"from":"309","fromOut":0,"to":"369","toIn":0},{"from":"369","fromOut":0,"to":"2","toIn":0},{"from":"256","fromOut":3,"to":"346","toIn":0},{"from":"373","fromOut":1,"to":"217","toIn":0},{"from":"256","fromOut":3,"to":"373","toIn":0},{"from":"256","fromOut":4,"to":"373","toIn":1},{"from":"308","fromOut":0,"to":"374","toIn":0},{"from":"374","fromOut":0,"to":"352","toIn":0},{"from":"374","fromOut":0,"to":"343","toIn":0},{"from":"378","fromOut":0,"to":"256","toIn":0},{"from":"378","fromOut":0,"to":"269","toIn":0},{"from":"378","fromOut":1,"to":"256","toIn":1},{"from":"357","fromOut":0,"to":"326","toIn":0},{"from":"353","fromOut":0,"to":"311","toIn":2},{"from":"350","fromOut":0,"to":"14","toIn":2},{"from":"311","fromOut":0,"to":"14","toIn":1}],"ai":{"s":"本工作流是作者 Zovetry 基于阿里 Qwen-Image-Edit (2509版) 视觉大模型构建的影视级角色替换与姿态迁移管线。架构采用 UNETLoader 与 CLIPLoader 分离加载 Qwen 图像编辑扩散底模与 Qwen-VL 多模态文本编码器，通过双层 LoraLoaderModelOnly 级联注入目标角色的风格与身份先验。核心技术在于引入 lrzjason 开发的 TextEncodeQwenImageEditPlusCustom_lrzjason 与 QwenEditConfigPreparer 节点，实现对源动作图与参考肖像图的 VL 语义与 VAE 表现双通路解耦编码；中段由 KSampler 完成结构锁定的潜空间（Latent）精准重绘，后段借助 MaskFastGrow 快速外扩羽化遮罩与 ImageCompositeMaskedWithSwitch 实现高动态光影无缝融合，最终由 LayerUtility 拼版与 Image Comparer 交付无痕替换大作。","u":["影视剧照与商业平面广告中的角色替身替换（在完全保留原画面复杂姿态、手势与环境透视下置换人物五官与服饰）。","电商模特批量换脸/换人与虚拟试衣（在不改变拍摄棚内光影、背景陈设与肢体动态前提下实现多角色矩阵上新）。","IP 虚拟偶像与动漫角色跨次元实景合成（将特定原创角色精准迁移到真实街景或电影级动作分镜中）。"],"d":3,"st":[{"name":"视觉大模型与双LoRA解耦加载","desc":"分离式加载 Qwen-Image-Edit (2509版本) 图像编辑扩散底模、Qwen-VL 多模态文本编码器与专用 VAE 解码器；主干链路串联双级 LoraLoaderModelOnly（309 与 20）进行角色外貌与特征微调权重的动态补丁注入；结合 Fast Groups Bypasser (85) 提供全局功能模块的快速一键旁路控制。","nodes":["77","76","22","309","20","85"]},{"name":"多模态指令编译与图像编辑配置编排","desc":"核心枢纽阶段。QwenEditConfigPreparer (312) 针对目标角色外观参考图与源场景动作姿态图进行精细化的双通路（VL 语义路径与 VAE 外观路径）参数标定；随之传入 TextEncodeQwenImageEditPlusCustom_lrzjason (311)，将自然语言编辑指令（如“保持姿态，替换角色外观为目标人物”）与多图特征深度融合，编译为高维条件特征引导流与潜空间输入。","nodes":["312","311"]},{"name":"潜空间定向重绘与去噪收敛","desc":"核心去噪计算。由 KSampler (14) 接收融合了多图参考与编辑指令的高维条件引导张量，在潜空间内对指定替换区域执行精准扩散去噪，在绝对锁定源图像姿态结构与背景透视的前提下，将目标人物五官、发型与服饰特征高保真注入；随后通过 VAEDecode (12) 解码为像素级待融合图像。","nodes":["14","12"]},{"name":"快速外扩羽化遮罩与无缝光影拼合","desc":"后处理无痕融合防穿帮阶段。MaskFastGrow (335) 对人物边界遮罩进行快速像素级外扩与边缘平滑，MaskPreview+ (157) 实时监控羽化边缘质量；配合 ImageCompositeMaskedWithSwitch (333) 与 LayerUtility: ColorImage V2 (332)，将重绘生成的角色与源背景执行高保真遮罩融合，消除边缘硬边裁切痕迹并达成自然的环境光影同调。","nodes":["335","334","157","333","332"]},{"name":"交互式视觉比对与多维拼版成片导出","desc":"成果交付与质检阶段。利用 Image Comparer (136) 实现原图与替换成片的交互式左右卷帘滑动比对；通过 LayerUtility 的 ImageReel (141) 与 ImageReelComposit (142) 自动将原图、参考图与最终效果图排版为多宫格画卷与拼版成片；最终由 SaveImage (78/147) 双路持久化输出单体成片与对比拼图。","nodes":["136","141","142","78","147"]}],"p":"去噪步数（Steps）：推荐 20~28 步；CFG / Guidance Scale：建议设为 4.5~6.0（过低角色特征还原不足，过高易导致边缘出现生硬发光黑边）；去噪幅度（Denoise）：重绘替换区域建议保持 1.0 全量重绘，若需微调保留部分原神态可设为 0.75~0.85；MaskFastGrow 外扩像素推荐设为 12~24 像素，羽化（Blur）设为 6~10 像素以确保发丝过渡自然；QwenEditConfigPreparer 中参考图的权重建议设为 1.0，源图动作保真权重设为 0.9。","t":["【Qwen 多图通路模式配置】在 QwenEditConfigPreparer 中，必须准确指定参考图（Character Reference）与动作源图（Pose Source）的插槽索引与处理模式；若未正确配置双通路，模型可能混淆主体身份与场景动作，导致画面出现“双人重叠”或“面部漂移”。","【遮罩外扩边缘羽化防割裂】千万不要直接使用硬边缘遮罩进行生硬替换；节点 335（MaskFastGrow）是消除画面边界拼贴感的关键，务必给予适当的膨胀值与羽化半径，使重绘发丝与背景环境光实现高斯加权渐变融合。","【双 LoRA 强度梯度分配】两个 LoraLoaderModelOnly 节点分别负责宏观角色画风与微观细节微调，建议前者权重设在 0.7~0.8，后者微调权重设在 0.5 左右，避免权重过高与 Qwen 基础编辑注意力产生剧烈冲突引发肢体畸变。"],"n":"运行本工作流需要提前部署 Qwen-Image-Edit-2509 扩散模型（放置于 models/unet 目录）、匹配的 Qwen-VL 文本编码器（models/clip）以及对应 VAE 模型。必须通过 ComfyUI Manager 安装由 lrzjason 维护的 ComfyUI-EditUtils（或 Comfyui-QwenEditUtils）、LayerUtility（ComfyUI_LayerStyle）、ComfyUI-rgthree 等核心插件。Qwen 多模态图生图编辑需要处理多张高分辨率图像交叉注意力，建议物理显存 16GB 以上（推荐 RTX 3090/4090 或 A5000），显存紧张时请将输入图像长边缩放至 1024 像素以内。","na":{"12":{"brief":"潜空间高保真像素解码器","detail":"将 KSampler 输出的去噪潜空间特征图解压还原为高清 RGB 图像帧，供后续羽化拼合节点使用。"},"14":{"brief":"核心潜空间去噪采样器","detail":"驱动 KSampler 在编辑引导条件下执行重绘去噪计算，在锁定动作骨架的同时将目标角色特征无缝重塑至潜空间。"},"20":{"brief":"角色微调 LoRA 动态注入器 2","detail":"串联在第一级 LoRA 之后，进一步精细化调整人物面部特异性细节与特定服饰纹理，支持独立调节注入强度。"},"22":{"brief":"专用 VAE 解码器加载","detail":"加载与 Qwen 编辑架构匹配的高保真 VAE 模型，负责潜在特征空间与 RGB 像素图像之间的无损转换。"},"76":{"brief":"Qwen-VL 多模态文本编码器加载","detail":"加载 Qwen 视觉语言多模态编码模型，能够同时理解自然语言指令与输入参考图像的全局视觉上下文。"},"77":{"brief":"Qwen 图像编辑扩散底模加载","detail":"负责加载 Qwen-Image-Edit (2509版本) 图像级编辑大模型 Diffusion Transformer 权重，向下游提供主干 MODEL 计算流。"},"78":{"brief":"单张最终高清成片保存","detail":"将无痕替换后的主成片以高质量无损格式存储至磁盘，并完整嵌入节点拓扑元数据。"},"85":{"brief":"rgthree 分组快速旁路总控","detail":"为后处理拼版、遮罩预览与辅助节点组提供全局一键 Bypass（旁路）切换，大幅提升调试效率。"},"136":{"brief":"rgthree 交互式 A/B 视觉对比器","detail":"前端提供带有交互式滑动条的比对视窗，支持左右卷帘式滑动实时审视角色替换前后的无痕融合度。"},"141":{"brief":"LayerUtility 胶卷画卷排版器","detail":"自动将源动作图、参考人物图与生成图按胶卷画卷（Image Reel）形式并排展示，便于视觉核验。"},"142":{"brief":"LayerUtility 替换结果拼版总装器","detail":"将各阶段视觉素材与最终成品按预设比例合成单张综合展示长图，便于对外交付与归档。"},"147":{"brief":"多图拼版对比成片保存","detail":"将包含原图、参考图与成片对比的总装拼图持久化保存，方便创作成果多维汇报。"},"157":{"brief":"MaskPreview+ 遮罩实时监视器","detail":"在工作流界面直接高亮显示人物分割与外扩区域，帮助用户在采样前精确校准抠图范围。"},"309":{"brief":"角色风格 LoRA 动态注入器 1","detail":"将目标角色的核心风格与大形体特征以补丁形式动态注入 Qwen 主干网络，赋予底模特定角色的生成先验。"},"311":{"brief":"Qwen 高级多图与指令语义编码器","detail":"本工作流的语义大脑，接收 QwenEditConfigPreparer 规则，同时吞吐动作源图、角色参考图与编辑文本，输出高维精准引导张量。"},"312":{"brief":"Qwen 编辑配置预处理器","detail":"由 lrzjason 开发的核心辅助节点，通过图形化控件精确配置多张输入图的 VL 语义理解通路与 VAE 外观重构参数。"},"332":{"brief":"LayerUtility 纯色衬底画布生成器","detail":"生成特定颜色或透明通道的背景底板，配合遮罩操作与排版节点进行图像图层化组合。"},"333":{"brief":"带旁路开关的多通道遮罩融合器","detail":"基于膨胀后的柔和遮罩，将重绘生成的新角色无缝贴合回原始背景图像，并提供一键开关对比原生重绘图。"},"334":{"brief":"遮罩转黑白像素图像","detail":"将浮点张量格式的 Mask 转换为标准灰度图像，用于可视化检查遮罩覆盖精密度及跨节点图层传递。"},"335":{"brief":"遮罩边缘快速外扩膨胀器","detail":"对人物遮罩进行快速像素膨胀与边缘过渡平滑处理，为替换角色与源背景之间预留自然的光影交融渐变带。"}}}}