8","fromOut":3,"to":"269","toIn":0},{"from":"268","fromOut":4,"to":"269","toIn":1},{"from":"285","fromOut":0,"to":"270","toIn":0},{"from":"277","fromOut":0,"to":"272","toIn":0},{"from":"289","fromOut":0,"to":"274","toIn":0},{"from":"271","fromOut":0,"to":"274","toIn":1},{"from":"274","fromOut":0,"to":"275","toIn":0},{"from":"285","fromOut":3,"to":"275","toIn":1},{"from":"285","fromOut":4,"to":"275","toIn":2},{"from":"285","fromOut":5,"to":"275","toIn":3},{"from":"285","fromOut":6,"to":"275","toIn":4},{"from":"287","fromOut":0,"to":"277","toIn":0},{"from":"269","fromOut":0,"to":"278","toIn":0},{"from":"279","fromOut":0,"to":"280","toIn":0},{"from":"287","fromOut":0,"to":"282","toIn":0},{"from":"267","fromOut":0,"to":"282","toIn":1},{"from":"267","fromOut":1,"to":"282","toIn":2},{"from":"266","fromOut":0,"to":"282","toIn":3},{"from":"272","fromOut":0,"to":"282","toIn":4},{"from":"267","fromOut":2,"to":"282","toIn":5},{"from":"285","fromOut":1,"to":"284","toIn":0},{"from":"268","fromOut":0,"to":"285","toIn":0},{"from":"269","fromOut":0,"to":"285","toIn":3},{"from":"280","fromOut":0,"to":"287","toIn":0},{"from":"287","fromOut":0,"to":"289","toIn":0},{"from":"267","fromOut":0,"to":"289","toIn":1},{"from":"267","fromOut":1,"to":"289","toIn":2},{"from":"266","fromOut":0,"to":"289","toIn":3},{"from":"272","fromOut":1,"to":"289","toIn":4},{"from":"282","fromOut":1,"to":"289","toIn":5},{"from":"292","fromOut":0,"to":"293","toIn":0},{"from":"292","fromOut":2,"to":"294","toIn":0},{"from":"294","fromOut":1,"to":"293","toIn":1},{"from":"294","fromOut":1,"to":"287","toIn":1},{"from":"293","fromOut":0,"to":"295","toIn":0},{"from":"293","fromOut":1,"to":"296","toIn":0},{"from":"275","fromOut":0,"to":"302","toIn":0},{"from":"294","fromOut":1,"to":"303","toIn":0},{"from":"303","fromOut":0,"to":"302","toIn":2},{"from":"302","fromOut":0,"to":"304","toIn":0},{"from":"304","fromOut":0,"to":"293","toIn":2},{"from":"275","fromOut":0,"to":"480","toIn":0},{"from":"292","fromOut":3,"to":"480","toIn":1},{"from":"480","fromOut":0,"to":"293","toIn":3},{"from":"293","fromOut":2,"to":"476","toIn":0},{"from":"481","fromOut":0,"to":"268","toIn":0},{"from":"482","fromOut":0,"to":"292","toIn":0}],"ai":{"s":"IcEdit 图像编辑的参数扫描自动化流程。核心是 IC-LoRA 编辑协议：载入图按 512 宽规整后，easy makeImageForICLora 把原图与等大实心遮罩拼成\"左边原图、右边空白\"的二联画布，遮罩标出待生成区，这正是 IcEdit LoRA 要求的输入格式；提示词用 CR Prompt Text 的 diptych 描述配 Flux 双编码器，InpaintModelConditioning 把图与遮罩写进条件并给出初始潜空间。模型侧是 Flux Fill fp8 叠辅助 LoRA（0.4）与 IcEdit-normal LoRA，30 步 beta 调度在第 10 步切成两台 SamplerCustom 接力，第二段补一次噪声注入强化编辑幅度。外层套着 easy forLoop 循环：每轮给 IcEdit LoRA 强度累加 0.1（共十轮扫到 1.0），每轮采样、解码、按 makeImageForICLora 给的坐标裁出右栏结果、AddLabel 标上强度值，最后批量汇总成强度对比图，挑最满意的一张直接用。","u":["不知道 IcEdit LoRA 强度调多少：一次跑完 0.1-1.0 十档对比图直接挑","用 Flux Fill 加 IC-LoRA 协议做指令式图像编辑（换装、换物、改背景）","同一句编辑指令批量产出不同力度版本供客户或自己挑选","学习 IC-LoRA 二联画布输入格式的标准接法"],"d":3,"st":[{"name":"编辑画布构建","desc":"载入图缩放后，makeImageForICLora 把原图与等大实心遮罩拼成左图右空白的二联画布，输出待编辑图、遮罩和后续裁切坐标，全部下游都依赖这一步的格式。","nodes":["481","268","269","285","270","278","284"]},{"name":"条件与潜空间","desc":"diptych 式提示词经 Flux DualCLIP 编码，FluxGuidance 给高引导；InpaintModelConditioning 把二联画布与遮罩写进条件并产出潜空间，负向直接空文本。","nodes":["273","290","265","264","263","271","267"]},{"name":"模型链","desc":"Flux Fill fp8 先叠 0.4 的辅助 LoRA，再串 IcEdit-normal LoRA，其强度端口留给循环注入，是整个扫描机制的变量所在。","nodes":["279","280","287"]},{"name":"两段接力采样","desc":"30 步 beta 调度表在第 10 步切开，前段铺编辑底稿，后段带新种子补噪续算，强化编辑力度后解码回图像。","nodes":["277","272","266","282","289","274"]},{"name":"循环扫描与汇总","desc":"forLoop 每轮把 LoRA 强度加 0.1，ImageCrop 按坐标裁出右栏结果，AddLabel 写上当前强度，batchAnything 收集十轮图片经循环末端预览并保存。","nodes":["292","482","294","275","302","303","304","480","293","295","296","476"]}],"p":"IcEdit LoRA 强度是灵魂参数，作者 Note 写明简单编辑 0.6、复杂编辑 1.0，本图用循环自动扫 0.1-1.0；辅助 LoRA 固定 0.4 别乱动；30 步与第 10 步分界决定底稿与强化段的配比，编辑不听话可把分界调小。","n":"需准备 Flux Fill、两个 LoRA 与 Flux 双编码器等模型文件；整轮要跑 10 次两段采样，耗时约为单次出图的十倍；图里两个 MediaPlayer 是无关残留节点，可删。"}}