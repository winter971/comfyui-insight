:"3507","fromOut":1,"to":"3523","toIn":6},{"from":"3523","fromOut":0,"to":"3508","toIn":0},{"from":"3523","fromOut":0,"to":"3457","toIn":0},{"from":"3483","fromOut":0,"to":"3519","toIn":0},{"from":"3522","fromOut":1,"to":"3507","toIn":0},{"from":"3521","fromOut":0,"to":"4012","toIn":0},{"from":"3984","fromOut":0,"to":"4012","toIn":1},{"from":"4012","fromOut":0,"to":"3481","toIn":5},{"from":"4012","fromOut":0,"to":"3483","toIn":5},{"from":"4012","fromOut":0,"to":"3521","toIn":5},{"from":"4012","fromOut":0,"to":"3522","toIn":5},{"from":"4012","fromOut":0,"to":"3523","toIn":2},{"from":"4012","fromOut":1,"to":"3481","toIn":0},{"from":"4012","fromOut":1,"to":"3483","toIn":0},{"from":"4012","fromOut":1,"to":"3521","toIn":1},{"from":"4012","fromOut":1,"to":"3522","toIn":1},{"from":"4012","fromOut":1,"to":"3523","toIn":0},{"from":"4012","fromOut":2,"to":"3481","toIn":1},{"from":"4012","fromOut":2,"to":"3483","toIn":1},{"from":"4012","fromOut":2,"to":"3521","toIn":0},{"from":"4012","fromOut":2,"to":"3522","toIn":0},{"from":"4012","fromOut":2,"to":"3523","toIn":1},{"from":"4012","fromOut":3,"to":"4011","toIn":0},{"from":"3984","fromOut":4,"to":"4013","toIn":0},{"from":"4013","fromOut":1,"to":"3987","toIn":0},{"from":"4013","fromOut":0,"to":"3522","toIn":4},{"from":"4013","fromOut":1,"to":"3522","toIn":3}],"ai":{"s":"多角色分区重绘流水线。从一张带生成参数的 PNG 出发，DJZ_PromptExtractorV2 自动回提提示词喂给模型装载子图（Illustrious 主干），免手抄。核心是五个 GUID 子图节点，各对应一个重绘区域——角色1身体、角色1面部、角色2身体、角色2面部、背景——内部都是同一套结构：手涂遮罩转 SEGS 切块，再由 Impact Pack 的 DetailerForEach 按各自独立的随机模板提示词（含 LoRA 标签）对裁剪区重采样后贴回。区域间首尾串联：上一段的输出图接到下一段的 PreviewBridge，用户新预览上涂下一块遮罩，保证每次重绘都基于最新整图；角色1身体段还把负向条件输出传给面部段复用。PreviewBridge 图与遮罩同口出，是整条链的换图加涂遮罩枢纽。角色二与背景三大段默认旁路，单人图只跑前两段。","u":["双人或多角色图的分角色修正：每个角色身体与面部各涂一块遮罩，用各自的提示词与 LoRA 分别重绘","拿到别人分享的出图 PNG，直接自动回收提示词，在原图基础上改自己要的角色","单人立绘的身体体型与脸部细节分两遍精修，脸部段沿用身体段负向条件保持风格一致","整图完成后启用旁路的背景段，单独重画背景而人物不动"],"d":3,"st":[{"name":"输入与模型装载","desc":"上传带生成信息的 PNG 并自动提取提示词，子图节点统一加载 Illustrious checkpoint 与 VAE，把 MODEL/CLIP/VAE 分发给所有重绘段。","nodes":["3984","4012"]},{"name":"角色1 身体重绘","desc":"在预览桥上涂身体遮罩，子图内遮罩转 SEGS 后按身体专用提示词重采，输出新图与负向条件。","nodes":["4013","3987","3522","3503"]},{"name":"角色1 面部重绘","desc":"拿身体段结果涂脸部遮罩，面部子图以更高步数做脸部精修，负向条件直接沿用上一段，保持全程一致。","nodes":["3507","3504","3523","3508"]},{"name":"角色2 支线（默认旁路）","desc":"与角色1同构的身体加面部两段，给第二个角色用；启用后整链延长，结果继续向后传递。","nodes":["3457","3458","3481","3480","3479","3476","3483","3482"]},{"name":"背景支线与总览（默认旁路）","desc":"最后一段按背景模板提示词重涂背景，其输出回灌模型装载段做最终预览，形成闭环的成图出口。","nodes":["3519","3516","3521","3520","4011"]}],"p":"各区域子图内部自带独立参数：去噪 0.4~0.6、CFG 6、euler 系采样、20~35 步，脸部段建议保持 0.5 左右防崩脸；改写幅度主要靠遮罩大小和各子图里 DynamicPrompt 模板提示词控制，正向词里的 LoRA 标签权重（如 0.8）直接决定角色相似度。","n":"每个区域都要在对应 PreviewBridge 预览上手动涂遮罩；角色二与背景两组默认旁路，画双人图或改背景时需手动启用。依赖 Impact Pack（DetailerForEach/MaskToSEGS）、comfyui_essentials 与 DJZ 提示词提取节点，Illustrious 底模与各 LoRA 需提前就位。"}}