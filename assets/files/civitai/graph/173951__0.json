o":"6","toIn":0},{"from":"4","fromOut":1,"to":"7","toIn":0},{"from":"6","fromOut":0,"to":"30","toIn":3},{"from":"7","fromOut":0,"to":"30","toIn":4},{"from":"34","fromOut":3,"to":"8","toIn":1},{"from":"30","fromOut":0,"to":"126","toIn":0},{"from":"126","fromOut":4,"to":"58","toIn":0},{"from":"126","fromOut":5,"to":"58","toIn":1},{"from":"66","fromOut":0,"to":"127","toIn":4},{"from":"66","fromOut":1,"to":"127","toIn":5},{"from":"126","fromOut":0,"to":"127","toIn":0},{"from":"127","fromOut":0,"to":"34","toIn":0},{"from":"134","fromOut":0,"to":"58","toIn":3},{"from":"135","fromOut":0,"to":"66","toIn":3},{"from":"148","fromOut":0,"to":"20","toIn":0},{"from":"148","fromOut":0,"to":"147","toIn":1},{"from":"149","fromOut":0,"to":"20","toIn":1},{"from":"149","fromOut":0,"to":"147","toIn":2},{"from":"144","fromOut":0,"to":"147","toIn":0},{"from":"147","fromOut":0,"to":"134","toIn":0},{"from":"148","fromOut":0,"to":"151","toIn":1},{"from":"149","fromOut":0,"to":"151","toIn":2},{"from":"146","fromOut":0,"to":"151","toIn":0},{"from":"151","fromOut":0,"to":"135","toIn":0},{"from":"30","fromOut":0,"to":"154","toIn":0},{"from":"154","fromOut":1,"to":"156","toIn":0},{"from":"154","fromOut":2,"to":"156","toIn":1},{"from":"156","fromOut":0,"to":"157","toIn":0},{"from":"20","fromOut":0,"to":"158","toIn":0},{"from":"158","fromOut":0,"to":"154","toIn":1}],"ai":{"s":"AnimateDiff 图到图渐变动画：16 帧视频从首图出发平滑过渡到尾图。核心是两个 tile ControlNet 的时间轴接力——首尾两图用同一组 ImpactInt 宽高缩放到 512，各接一条 ControlNetLoaderAdvanced；LatentKeyframeTiming 让首图支线强度从第 0 帧的 1.0 ease-out 衰减到 0.2，尾图支线从第 6 帧的 0.2 ease-in 爬到 1.0，于是采样早期被首图锁定、后期向尾图靠拢，中途自然渐变。控制后的正负条件经 EditBasicPipe 回写 BasicPipe（图作者用管线封装理顺多条控制支线的连线），交给挂 mm_sd_v15_v2 运动模块的 AnimateDiffSampler 以 dpmpp_sde_gpu 25 步采出 16 帧潜空间，解码后 AnimateDiffCombine 合成 12fps mp4。另有一条默认旁路的 ImpactKSamplerBasicPipe 文生图支线，没有现成首尾图时用它先批量生成候选。","u":["两张图片之间的渐变转场：首图尾图各放一张，直接渲染 mp4","给静态角色做'从姿势A morph 到姿势B'的短动画","批量生成风格统一的过渡帧，供剪辑软件做视频素材","没有现成图片时，启用旁路支线先文生图出首尾候选再动画"],"d":3,"st":[{"name":"首尾图准备","desc":"两张图用同一组 ImpactInt 宽高缩放，空潜空间也从这两个节点取尺寸，图像、潜空间与动画画布三方一致不变形。","nodes":["144","146","148","149","147","151","20"]},{"name":"基础管线","desc":"checkpoint 加正负提示词打包成 BasicPipe 便于在两条控制支线间传递修改，是作者为理顺连线做的封装。","nodes":["4","6","7","30","126"]},{"name":"双 Tile 控制网时间轴接力","desc":"两个 tile 控制网分别看首图与尾图；LatentKeyframeTiming 让前者强度 ease-out 衰减、后者 ease-in 爬升，采样早期贴首图、后期向尾图过渡。","nodes":["64","62","59","58","134","124","69","67","66","135"]},{"name":"动画采样与合成","desc":"控制后的条件经 EditBasicPipe 回写管线，AnimateDiff 挂运动模块采 16 帧，解码后合成 12fps mp4。","nodes":["16","127","34","15","8","100"]},{"name":"默认旁路的补图支线","desc":"ImpactKSamplerBasicPipe 配 RepeatLatentBatch 可先文生图出两张候选当首尾图，没有素材时才启用。","nodes":["154","158","156","157"]}],"p":"两条 LatentKeyframeTiming 的起止帧与缓动曲线是最值得调的参数：决定何时离开首图、何时抵达尾图；16 帧 12fps 是基础节奏，想要更慢的过渡加帧数或降 fps；25 步 CFG 7 dpmpp_sde_gpu 保持即可。","n":"需装 AnimateDiff-Evolved 与 ComfyUI-Impact-Pack，另下 mm_sd_v15_v2 运动模块与 control_v11f1e_sd15_tile 控制网；首尾两张图需自备（或启用旁路支线现生成）；改分辨率时要同步改 ImpactInt，否则图与潜空间错位。"}}