":"336","toIn":0},{"from":"336","fromOut":0,"to":"327","toIn":3},{"from":"338","fromOut":0,"to":"327","toIn":2},{"from":"337","fromOut":0,"to":"338","toIn":0},{"from":"334","fromOut":0,"to":"337","toIn":0},{"from":"329","fromOut":0,"to":"339","toIn":0},{"from":"339","fromOut":0,"to":"332","toIn":1},{"from":"11","fromOut":0,"to":"173","toIn":0},{"from":"309","fromOut":0,"to":"311","toIn":0},{"from":"10","fromOut":0,"to":"269","toIn":0},{"from":"10","fromOut":1,"to":"11","toIn":0},{"from":"10","fromOut":1,"to":"12","toIn":0},{"from":"10","fromOut":1,"to":"184","toIn":0},{"from":"27","fromOut":0,"to":"343","toIn":0},{"from":"343","fromOut":0,"to":"332","toIn":0},{"from":"27","fromOut":0,"to":"76","toIn":0},{"from":"344","fromOut":0,"to":"279","toIn":0},{"from":"344","fromOut":0,"to":"345","toIn":0},{"from":"345","fromOut":0,"to":"281","toIn":1},{"from":"137","fromOut":0,"to":"348","toIn":0},{"from":"348","fromOut":0,"to":"138","toIn":0},{"from":"346","fromOut":0,"to":"320","toIn":1}],"ai":{"s":"循环式二维码艺术化工作流。Text Multiline 给链接、PrimitiveNode 选协议，comfy-qr-by-module-split 生成黑白基准码并输出码点遮罩与模块尺寸；LoopManager 加 RecallFloat/MemorizeFloat 维护迭代计数，迭代值经一组 CyclistMathFloat 换算成三张 ControlNetApplyAdvanced 的强度与起止区间：QR Pattern 网锁码点（基数 0.7、每轮 +0.03），brightness 网两路修明暗，其中一路经 ConditioningSetMask 限制在放大后的码点遮罩内。disneyPixarCartoon 底模走两段 img2img：第一段 denoise 从 0.88 起逐轮递减 0.02 打底，第二段 30 步 dpmpp_2m_sde_gpu、denoise 0.6 精修；comfy-qr-mask_errors 找出扫不出的错误区，与基准码点图相乘限定范围后，ImageCompositeMasked 分别用提亮图补白码点、压暗图补黑码点（幅度每轮 +0.09），OverrideImage 写回 QR_1。comfy-qr-validate/read 支线默认静音，启用后解码文本与原文一致且错误码归零时，Interrupt 终止循环。","u":["生成能扫的卡通场景风艺术二维码","印刷物料二维码美化：High 容错加错误区补偿，保证印刷后可扫","把推广链接嵌进插画海报或桌面背景","学习 Cyclist 循环框架加 Interrupt 终止条件的接法"],"d":3,"st":[{"name":"二维码模板生成与注入起点","desc":"由链接文本生成高容错基准码，Interrupt 决定本轮用哪张码图进入控制链，是整个循环每轮的起点。","nodes":["333","334","27","343","332","31"]},{"name":"迭代参数调度","desc":"循环计数器与一排浮点运算把迭代数换算成各级控制网强度、起止区间、denoise 与补光幅度，实现逐轮渐进逼近。","nodes":["344","346","279","280","281","282","283","309","284","285","287","288","293","294","298","307","310","311"]},{"name":"条件注入与两段采样","desc":"双 QR 网 + 双亮度网的四层条件链把码点结构写进采样，两段低噪 img2img 在保结构与加风格间分层处理。","nodes":["10","152","11","12","23","173","166","174","195","185","186","189","190","13","15","258","118","240","241","196","198"]},{"name":"错误修补与回写","desc":"对比基准码找出扫不出的区域，按白区黑区分别用提亮压暗图补回，结果写回 QR_1 文件供下一轮或验证支线使用。","nodes":["263","120","76","33","69","271","72","74","91","92","80","81","82","83","59","77","79","84","320"]},{"name":"验证与终止（默认静音）","desc":"读回 QR_1 实际解码校验，错误码为零才放行终止信号；这是自动停机条件，不启用则循环由人工控制。","nodes":["331","325","326","328","327","330","329","339","335","336","337","338"]}],"p":"","n":"依赖 Cyclist 循环框架（LoopManager/RecallFloat/MemorizeFloat）与 comfy-qr 节点包；验证支线与部分 Reroute 默认静音属正常态；底模 disneyPixarCartoon 决定画风，换底模不影响 QR 逻辑但风格会变。","f":["① 333 的链接文本与 334 的协议（Https）进 27 comfy-qr-by-module-split，生成黑白基准二维码，输出基准图、码点 MASK（27.3）与模块宽高（27.4/27.5）","② 基准图经 343 ImageFilterMode 预处理后进 332 Interrupt；stop 为 false 时输出当前轮码图，31 缩到 512 作控制网的控制图","③ 344 LoopManager 令 279 RecallFloat 取出迭代数，280 加 1 后由 281 MemorizeFloat 写回；迭代值经 282/283/309 三个乘法节点派生出 0.03/0.02/0.01 三种步进","④ 条件链：11/12 的正负条件进 173（QR 网，强度 0.85+0.03i），23 同挂 QR 网（强度 0.7+0.03i）后串进 166（brightness 网），174（brightness 网）的输出被 185/188 ConditioningSetMask 用 195 放大过的码点遮罩限制在码区，186/189 ConditioningCombine 合成 13 的正负条件","⑤ 10 的 disneyPixarCartoon 底模经 269/270 分发，152 的 blessed2 VAE 把控制图编码进 190，13 KSampler 以 denoise=0.88-0.02i 低噪重绘","⑥ 15 解码后由 240 缩到 118 设定的 768，241 再编码，196 以 30 步 dpmpp_2m_sde_gpu、CFG=6、denoise 0.6 精修，198 解码","⑦ 263 的成图缩回 27.4/27.5 的原始码尺寸进 76 comfy-qr-mask_errors，与基准码对比得到错误区域 MASK","⑧ 错误 MASK 转图像后与基准码（72 路白区）及其反相（74 路黑区）相乘限定范围，模糊放大到 768 转回 MASK；59 的提亮图补进白码点错误区（79），77 的压暗图补进黑码点错误区（84）","⑨ 84 的结果经 320 OverrideImage 写回 QR_1 文件（文件名由 346 LoopManager 提供），迭代数已在 ③ 加 1，回到 ② 进入下一轮","⑩ 默认静音的验证支线：325 ReloadImage 读 QR_1 → 328 comfy-qr-read 解码 → 327 comfy-qr-validate 校验 → 329 与 330 的零错误码比较，相等时 332 Interrupt 终止循环"],"t":["想换内容只改 333 的链接文本；334 的协议要与内容匹配（网址选 Https）","验证支线默认静音：启用 325-329 才能自动停在扫得通的那一轮，否则只能手动控制执行次数","风格化过头扫不出来时，把 284 的 0.7 基数调高，或把 307 的 0.88 降档减少对码结构的破坏","321 的 Instructions 注释是作者留的操作说明，先跑一轮看 76 输出的错误区域分布再调参","59/77 的补光幅度由 310/311 每轮 +0.09 递增，码点边缘发灰时减小这个步进"],"na":{"13":{"brief":"第一段低噪采样。","desc":"30 步 dpmpp_2m_sde_gpu/karras、CFG=7，denoise 由 307 链注入（0.88-0.02i）；从 Interrupt 给的码图出发做风格化重绘，低噪起步保结构。","params":[{"name":"cfg","kind":"浮点","default":"7","desc":"画风浓度来源，过高会盖掉码点结构"}]},"23":{"brief":"QR 控制网第一级。","desc":"挂 controlnetQRPatternQR_v2Sd15，控制图取 31 的 512 缩放码，强度与起始百分比由 284/285 链动态注入，输出串进 166 的条件链。"},"27":{"brief":"生成基准二维码与码点遮罩。","desc":"comfy-qr-by-module-split 按协议 Https 与链接文本生成 Square 码：模块尺寸 8、容错 High、黑白双色；输出基准图、模块图、码点 MASK 与宽高 INT，是全链的素材源头。","params":[{"name":"text","kind":"字符串","default":"civitai.com/user/Postpos/models","desc":"码里编码的内容，由 333 注入"},{"name":"ecc","kind":"下拉选择","default":"High","desc":"高容错给艺术化留出错码冗余，别降"}]},"59":{"brief":"白码点提亮补偿。","desc":"Image Filter Adjustments 基础亮度 0.14 加 310 的步进，专门服务 79 的白区修补。"},"72":{"brief":"错误遮罩与基准码相乘（白区）。","desc":"Combine Masks 用 multiply 把错误区限定在白色码点范围内，防止补光误伤背景画风。"},"76":{"brief":"检测生成图的扫码错误区域。","desc":"comfy-qr-mask_errors 对比基准码与缩回原尺寸的成图，输出错误区 MASK 与错误指标，是修补链的依据；阈值 0.03 控制判定灵敏度。"},"79":{"brief":"提亮图补进白码点错误区。","desc":"ImageCompositeMasked 以成图为底、59 的提亮版为源、白区错误遮罩控制范围，把扫不出的白色码点推回高对比。"},"84":{"brief":"压暗图补进黑码点错误区。","desc":"第二层合成：以 79 的结果为底，77 的压暗版按黑区错误遮罩补入；两次合成后码图整体可扫性恢复。"},"166":{"brief":"亮度控制网链级。","desc":"挂 control_v1p_sd15_brightness，接 23 的输出再修一轮明暗，强度与区间来自 293/294/296 链；明暗分离让码点对比度不被画风吃掉。"},"173":{"brief":"QR 控制网第二链起点。","desc":"与 23 平行的另一条 QR 控制级：正向取 11、负向取 12，强度 0.85+0.03i、区间由 288/290 链控制，输出给 174。"},"174":{"brief":"亮度控制网链级（码区限定前级）。","desc":"接 173 的输出，强度 0.12+0.03i；其输出还要经 185/188 的遮罩限定才进最终条件，专门服务码点区域。"},"185":{"brief":"把 174 正向条件限制在码区。","desc":"ConditioningSetMask 强度 2、default 组合，与 166 的全图条件在 186 合并——码区内条件更重、区外保持画风自由。"},"186":{"brief":"合并正向条件。","desc":"ConditioningCombine 把全图亮度条件与码区加强条件相加，输出 13 的 positive，是四层控制链的收口。"},"190":{"brief":"把当前码图编码进潜空间。","desc":"VAEEncode 用 blessed2 VAE 把 260 来的控制图转成 13 的 latent_image，img2img 的起点。"},"195":{"brief":"码点遮罩膨胀。","desc":"GrowMask 24 像素放大 27.3 的码点遮罩，给 185/188 的 ConditioningSetMask 用，让码区条件的生效范围盖住边缘过渡带。"},"196":{"brief":"第二段 768 分辨率精修。","desc":"把第一段结果放大到 118 的 768 再编码，以 CFG=6、denoise 0.6 精修细节；两段式避免一步到位时结构崩坏。"},"279":{"brief":"读出当前迭代数。","desc":"RecallFloat 从 Counter_1 取迭代值，分发给 +1、0.03/0.02/0.01 三个乘法链，是所有渐进参数的根。"},"280":{"brief":"迭代数加 1。","desc":"+1 Next Iteration 把读出的计数加一，经 281 写回，保证每轮执行后参数自动前进一步。"},"281":{"brief":"写回迭代数。","desc":"MemorizeFloat 把新计数存回 Counter_1，与 279/280 构成完整的计数闭环。"},"282":{"brief":"0.03 步进发生器。","desc":"迭代数乘 0.03，喂给 QR 数据区与 Finder 区的强度、起止计算，让控制网随轮数缓慢加强。"},"284":{"brief":"CN1 数据区强度计算。","desc":"0.7 + 0.03i 得出 23 号 QR 控制网的强度，是码点结构锁定的主力度，扫不出时优先加大基数。"},"293":{"brief":"CN2 数据区强度计算。","desc":"由 282 的 0.03i 派生 166 号亮度网的强度起点，第二级修正随迭代同步加深。"},"307":{"brief":"低噪 denoise 计算。","desc":"0.88 - 0.02i 得出 13 号采样器的去噪强度，轮数越多越保守，防止后期把已生成的风格改飞。"},"310":{"brief":"白码点补光步进。","desc":"迭代数乘 0.09 加进 59 的亮度补偿，越到后面的轮次白色码点推得越亮，抵消风格化造成的灰化。"},"311":{"brief":"黑码点压暗步进。","desc":"与 310 对偶，负向步进让 77 的补偿逐轮加深，保住黑色码点的对比度。"},"320":{"brief":"把修补结果写回 QR_1。","desc":"OverrideImage 每轮覆盖写 QR_1 文件，文件名由 346 提供；它是循环与验证支线之间的磁盘交接点。"},"327":{"brief":"校验 QR_1 是否与原文一致。","desc":"comfy-qr-validate 接 326 垫边后的图、328 解码的文本、336 的原文与 338 的协议，输出错误码 INT 给 329 比对；默认静音，启用后才参与循环判定。"},"329":{"brief":"错误码归零判定。","desc":"CyclistCompare 用 equals 比较 327 的错误码与 330 的 0，相等输出 true 经 339 触发 332 终止——整个自动停机条件的最后一环。"},"332":{"brief":"Interrupt，循环的闸门与出图口。","desc":"stop 接 329 的校验结果：true 立即终止执行，false 时把 343 预处理的码图输出给 31 进入本轮控制链，兼具开关与数据通道两个角色。"},"333":{"brief":"二维码内容文本。","desc":"Text Multiline 存链接原文，一路进 27 生成、一路经 335/336 进 327 校验比对，两处必须同源。"},"334":{"brief":"二维码协议选择。","desc":"PrimitiveNode 输出 Https 到 27 与 327，协议决定解码端的匹配规则，网址类保持 Https。"},"344":{"brief":"迭代计数循环管理器。","desc":"LoopManager 绑定 Counter_1，向 279 提供循环 id、向 281 提供写回 id，没有它整个递进参数链就断了。"},"346":{"brief":"文件名循环管理器。","desc":"绑定 QR_1 文件名给 320 OverrideImage，每轮把结果覆写到同一文件，供验证支线读取。"}}}}