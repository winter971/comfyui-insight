t":0,"to":"1207","toIn":1},{"from":"1003","fromOut":1,"to":"1220","toIn":0},{"from":"1175","fromOut":2,"to":"1218","toIn":0},{"from":"1061","fromOut":1,"to":"1224","toIn":0},{"from":"1061","fromOut":2,"to":"1224","toIn":1},{"from":"1061","fromOut":3,"to":"1224","toIn":2},{"from":"1218","fromOut":0,"to":"1224","toIn":3},{"from":"1061","fromOut":8,"to":"1224","toIn":6},{"from":"1061","fromOut":15,"to":"1224","toIn":7},{"from":"1061","fromOut":16,"to":"1224","toIn":8},{"from":"1175","fromOut":6,"to":"1061","toIn":3},{"from":"1061","fromOut":6,"to":"1224","toIn":5},{"from":"1224","fromOut":1,"to":"1003","toIn":0},{"from":"1224","fromOut":2,"to":"1003","toIn":1},{"from":"1224","fromOut":3,"to":"1003","toIn":2},{"from":"1224","fromOut":4,"to":"1003","toIn":3},{"from":"1224","fromOut":6,"to":"1003","toIn":5},{"from":"1224","fromOut":8,"to":"1003","toIn":6},{"from":"1224","fromOut":15,"to":"1003","toIn":7},{"from":"1224","fromOut":16,"to":"1003","toIn":8},{"from":"1003","fromOut":6,"to":"1207","toIn":4},{"from":"1003","fromOut":4,"to":"1220","toIn":1},{"from":"1218","fromOut":0,"to":"1225","toIn":0},{"from":"1225","fromOut":0,"to":"1224","toIn":4},{"from":"1224","fromOut":5,"to":"1003","toIn":4},{"from":"1004","fromOut":1,"to":"1163","toIn":1},{"from":"1004","fromOut":4,"to":"1163","toIn":2},{"from":"1004","fromOut":5,"to":"1163","toIn":3},{"from":"1227","fromOut":0,"to":"1207","toIn":2},{"from":"1188","fromOut":0,"to":"1228","toIn":0},{"from":"1188","fromOut":1,"to":"1228","toIn":1},{"from":"1228","fromOut":0,"to":"1002","toIn":0},{"from":"1228","fromOut":1,"to":"1002","toIn":1},{"from":"1038","fromOut":8,"to":"1143","toIn":7},{"from":"1143","fromOut":0,"to":"1048","toIn":0},{"from":"1143","fromOut":0,"to":"284","toIn":0}],"ai":{"s":"Cyberdelia 的 CyberRealistic Anima Turbo V3 文生图+放大工作流。Anima 是基于 Lumina 架构的 turbo 模型，所以文本端用 qwen_3_06b 编码器、PCTextEncode 编码正向提示词，负向用 ConditioningZeroOut 置零（turbo 模型不需要真正的负条件）；模型链为 UNETLoader → ModelSamplingAuraFlow(shift 6) → CLIPNegPip → Power Lora Loader，再经由六层 Context Big (rgthree) 节点接力传递，每个阶段取用自己需要的东西。采样用 SamplerCustomAdvanced + SamplerER_SDE(ODE) + BasicScheduler(beta57) 低步数出图；VAE 解码后图像回注 Context 链，交给 UltimateSDUpscale 按 4x_NickelbackFS 模型放大 1.5 倍并二次采样；脸部修复支线（yolov8 检测 + DetailerForEach）默认整体旁路，需要时用 rgthree 开关启用。","u":["用 Anima Turbo 类 turbo/蒸馏模型低步数快速出写实图","出图后一键放大 1.5 倍，让 UltimateSDUpscale 在高分辨率上二次采样补细节","人像特写需要脸部修复时，一键启用内置 Face Detailer 支线","想把正向提示词与风格/pseudo-negative 尾缀自动拼接，统一管理提示词"],"d":2,"st":[{"name":"模型装配","desc":"加载 Anima Turbo 主模型并串联采样层调整、NegPip 与可选 LoRA，为全图提供模型与编码器。","nodes":["1168","1195","1188","1169","1228","1002","1170"]},{"name":"条件与画布","desc":"拼接提示词用 PCTextEncode 编码、置零负向，并按预设生成分辨率匹配的空白 latent。","nodes":["1216","1217","1215","1218","1225","1187","1173","8"]},{"name":"核心采样","desc":"噪声、调度、引导分离式低步数采样，是 turbo 模型的出图核心。","nodes":["1220","1227","1211","1210","1207","220","12"]},{"name":"放大精修","desc":"首图回注上下文后交给 UltimateSDUpscale 分块放大重绘，提升分辨率与细节。","nodes":["1158","1004","1163","1154","1165","1150"]},{"name":"脸部修复支线","desc":"默认旁路：检测人脸并逐块重绘，启用后输出带元数据成图。","nodes":["1145","1144","1143","1048","284"]}],"p":"步数 8、CFG 1、shift 6 是 Anima Turbo 的固定组合，只建议调步数（4~12）；UltimateSDUpscale 的 denoise 0.1 决定放大时改画面的程度，想明显换细节可到 0.2；放大倍率 1.5 由独立 float 节点控制。","n":"需 AnimaTurbo 模型、qwen 文本编码器/VAE、4x 放大模型与 face_yolov8m 检测器；脸部修复支线与普通 CLIPTextEncode 编码节点默认旁路，rgthree 开关面板可启用；turbo 模型严禁高 CFG。","f":["① 装配模型：UNETLoader 1168 加载 AnimaTurbo → ModelSamplingAuraFlow 1195（shift 6）→ CLIPNegPip 1188（同时接 CLIPLoader 1169 的 qwen 文本编码器）→ Power Lora Loader 1228 → 写入 Context Big 1002；VAELoader 1170 也进 1002。","② 组装提示词：Prompt 1216 与 Style 1217 两段文本经 StringConcatenate 1215 拼接，送 PCTextEncode 1218 编码为正向条件；1218 再接 ConditioningZeroOut 1225 生成全零负向条件（turbo 模型标准做法）。","③ 尺寸与画布：AnimaResolutions 1187 输出宽高给 EmptyLatentImage 1173，空白 latent 依次穿过 1175 → 1061 → 1224 三层 Context 传递；Seed (rgthree) 8 提供 seed。","④ 采样：1224 的输出进 1003，1003 的正向条件给 BasicGuider 1220、latent 给 SamplerCustomAdvanced 1207，配合 RandomNoise 1210、SamplerER_SDE 1227、BasicScheduler 1211（beta57、8 步）完成低步数采样。","⑤ 首图落地：1207 的 latent 经 VAEDecode 220 出图进 PreviewImage 12，并把图像回注 Context 链（1158 → 1004），供放大阶段使用。","⑥ 放大：1004 把模型/条件/VAE/图像交给 UltimateSDUpscale 1163，放大模型来自 1154（4x_NickelbackFS），倍率由 easy float 1165（1.5）控制，内部 8 步 CFG 1 二次采样；结果输出到 Image Comparer 1150 与 284 右侧。","⑦ 脸部修复支线（默认旁路）：放大图经旁路的 Context 1062/1038 传给 BboxDetectorSEGS 1144（检测器来自 1145 的 face_yolov8m）与 DetailerForEach 1143，修复结果进 SaveImageWithMetaData 1048 与对比器 284 左侧；ComfySwitchNode 1147/1148 负责切换正/负条件来源。","⑧ 两个 Fast Groups Bypasser（1185/248）是全图旁路组的总开关面板。"],"t":["turbo 模型不要把 CFG 调高：BasicScheduler 与 UltimateSDUpscale 内部都是 CFG 1，调高会直接过曝烧图。","负向提示词走 ConditioningZeroOut，想压制负面元素要用 1217 里的 NegPip 伪负向写法，写在正向文本末尾才有效。","放大倍率由 easy float 1165 控制（默认 1.5），UltimateSDUpscale 的 tile 1024/8 padding 保持默认；显存不足把 tile 降到 768。","脸部修复支线整组旁路（1143/1144/1145/1147/1148），出人像时在 rgthree 开关面板启用；启用后保存节点 1048 才会写盘。","1211 的步数 8 与 1227 的 ODE 求解器是作者给 Anima Turbo 的组合，别只把步数翻倍而不检查 sigma 调度。"],"na":{"220":{"brief":"首图解码","desc":"VAEDecode 把 1207 的 latent 用 qwen_image_vae 解成 IMAGE，分给预览节点 12 并回注 Context 链作为放大阶段的输入图像。","params":[]},"1002":{"brief":"上下文链第一环","desc":"Context Big 接收 LoRA 链后的 MODEL/CLIP 与 VAE、seed，打包成 RGTHREE_CONTEXT 向下游 1175 传递，让后续每段支线都能按需取用而不用重复连线。","params":[]},"1004":{"brief":"放大阶段上下文","desc":"Context Big 承载放大所需的全部资源：把首图（来自 1158 的图像槽）、模型、条件、VAE 交给 UltimateSDUpscale，是采样结果进入放大阶段的交接点。","params":[]},"1048":{"brief":"带元数据保存","desc":"SaveImageWithMetaData 按 yyyy-MM-dd 分目录、以时间戳命名保存 png 并写入完整生成参数；只接收修复支线输出，启用修复后才会工作。","params":[]},"1143":{"brief":"脸部逐块修复","desc":"DetailerForEach 对检测出的每张脸用独立采样（CFG 1、denoise 0.3、dpmpp_2m_sde_gpu）精修，输出进保存节点 1048 与对比器 284；旁路状态下全图输出停留在放大结果。","params":[{"name":"denoise","kind":"float","default":"0.3","desc":"脸崩严重可到 0.4。"}]},"1145":{"brief":"人脸检测模型","desc":"UltralyticsDetectorProvider 提供 face_yolov8m 的 BBOX 检测器，供旁路的 1144 定位人脸区域；整组默认旁路，画人像时才启用。","params":[]},"1150":{"brief":"首图/放大图对比","desc":"rgthree Image Comparer 左侧接放大结果、右侧接解码首图，滑动对比放大前后的差异；纯查看节点。","params":[]},"1154":{"brief":"放大模型加载","desc":"UpscaleModelLoader 加载 4x_NickelbackFS_72000_G，为 1163 提供像素级上采样；换放大模型只动这里。","params":[]},"1163":{"brief":"终极放大二次采样","desc":"UltimateSDUpscale 接收首图与模型/条件/VAE，用 4x_NickelbackFS 放大模型上采样、按 Chess 分块 1024 重绘（denoise 0.1、CFG 1），在放大分辨率上补细节；倍率由 1165 的 1.5 控制，输出进对比器与旁路的修复支线。","params":[{"name":"denoise","kind":"float","default":"0.1","desc":"极低值只修纹理，调高会改构图。"},{"name":"tile","kind":"int","default":"1024","desc":"显存吃紧降 768。"}]},"1165":{"brief":"放大倍率控制","desc":"easy float 输出 1.5 连到 1163 的 upscale_by 输入，把倍率参数独立出来方便快速调整；改这一个数即可换输出尺寸。","params":[{"name":"value","kind":"float","default":"1.5","desc":"2.0 以上建议配合更大 tile。"}]},"1168":{"brief":"加载 Anima 主模型","desc":"UNETLoader 单独加载 CyberRealistic_AnimaTurbo_V4.2 权重，是全图唯一的模型来源，输出经 AuraFlow 采样层调整后进入 LoRA 链；换模型版本只动这里。","params":[]},"1169":{"brief":"加载 Qwen 文本编码器","desc":"CLIPLoader 以 lumina2 类型加载 qwen_3_06b_base，为 PCTextEncode 提供编码能力；Anima 不用 SDXL 的 CLIP，缺它整个提示词链瘫痪。","params":[]},"1187":{"brief":"分辨率预设","desc":"AnimaResolutions 输出基准值与宽高（默认 1024x1536 竖版），喂给 EmptyLatentImage 定画布；首推分辨率参考旁边的 MarkdownNote 指南。","params":[{"name":"resolution","kind":"combo","default":"1024x1536 (2:3)","desc":"turbo 模型对分辨率敏感，按预设选。"}]},"1188":{"brief":"负向嵌入反转","desc":"CLIPNegPip 同时接管 MODEL 与 CLIP，让模型支持把负向语义嵌入正向通道，配合 1217 的 pseudo-negative 文本实现 turbo 模型下的负向控制；位于 LoRA 加载器之前。","params":[]},"1195":{"brief":"AuraFlow 采样调整","desc":"ModelSamplingAuraFlow 把 shift 设为 6，改变 sigma 时间分布以适配 Anima/Lumina 架构；它串在主模型通路必经之路上，删掉会导致采样步数利用不均、画面发糊。","params":[{"name":"shift","kind":"float","default":"6","desc":"turbo 模型按作者值 6 使用。"}]},"1207":{"brief":"核心采样节点","desc":"SamplerCustomAdvanced 汇集 RandomNoise 1210、Guider 1220、Sampler 1227、Sigmas 1211 与来自 1003 的 latent，一次性完成采样；比 KSampler 更适合 turbo 模型的噪声/调度分离式配置。","params":[]},"1211":{"brief":"sigma 调度","desc":"BasicScheduler 按 beta57 调度生成 8 步、denoise 1 的 sigma 序列喂给 1207；步数与 turbo 模型能力匹配，改动需同步评估质量。","params":[{"name":"steps","kind":"int","default":"8","desc":"Anima Turbo 甜点值，4~12 之间调。"}]},"1216":{"brief":"主体提示词输入","desc":"PrimitiveStringMultiline 存放用户写的画面描述，经 1215 与风格尾缀拼接后编码；改画面内容只动这一处。","params":[]},"1217":{"brief":"风格与伪负向尾缀","desc":"存放质量词与 score_6 类 pseudo-negative 尾缀，与 1216 拼接后一起进 PCTextEncode；依赖 CLIPNegPip 才能起到负向作用。","params":[]},"1218":{"brief":"正向提示词编码","desc":"PCTextEncode 用 qwen 编码器处理 1215 拼接后的完整文本，输出正向条件进 Context 1224；Anima 专用编码方式，换成普通 CLIPTextEncode 会丢失语义对齐。","params":[]},"1225":{"brief":"负向条件置零","desc":"ConditioningZeroOut 把 1218 的正向条件直接置零当作负向条件，这是 turbo/蒸馏模型的标配——负向不再参与真实引导，省掉一次编码开销。","params":[]},"1227":{"brief":"ODE 采样器","desc":"SamplerER_SDE 以 ODE 模式配置（3 段、rho 1），作为 SamplerCustomAdvanced 的 sampler 输入；与 beta57 调度配套是作者调好的低步数组合。","params":[]},"1228":{"brief":"可选 LoRA 挂载","desc":"Power Lora Loader 串在模型链末端，行默认关闭；用户按需挂画风/角色 LoRA 后把 MODEL/CLIP 写入 Context Big 1002 供全图取用。","params":[{"name":"行开关","kind":"toggle","default":"off","desc":"turbo 模型对 LoRA 敏感，权重从 0.6 起试。"}]}}}}