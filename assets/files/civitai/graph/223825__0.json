to":"160","toIn":1},{"from":"166","fromOut":0,"to":"18","toIn":1},{"from":"166","fromOut":1,"to":"19","toIn":1},{"from":"40","fromOut":0,"to":"170","toIn":0},{"from":"40","fromOut":1,"to":"170","toIn":1},{"from":"170","fromOut":0,"to":"159","toIn":0},{"from":"170","fromOut":1,"to":"159","toIn":1},{"from":"171","fromOut":0,"to":"172","toIn":3},{"from":"43","fromOut":0,"to":"171","toIn":0},{"from":"147","fromOut":0,"to":"171","toIn":1},{"from":"147","fromOut":1,"to":"171","toIn":2},{"from":"28","fromOut":0,"to":"171","toIn":3},{"from":"58","fromOut":0,"to":"171","toIn":5},{"from":"53","fromOut":0,"to":"171","toIn":4},{"from":"4","fromOut":0,"to":"171","toIn":6},{"from":"21","fromOut":0,"to":"172","toIn":0},{"from":"18","fromOut":0,"to":"172","toIn":1},{"from":"19","fromOut":0,"to":"172","toIn":2},{"from":"58","fromOut":0,"to":"172","toIn":5},{"from":"53","fromOut":0,"to":"172","toIn":4},{"from":"4","fromOut":0,"to":"172","toIn":6},{"from":"172","fromOut":0,"to":"23","toIn":0},{"from":"43","fromOut":0,"to":"173","toIn":0},{"from":"18","fromOut":0,"to":"173","toIn":1},{"from":"19","fromOut":0,"to":"173","toIn":2},{"from":"33","fromOut":0,"to":"173","toIn":3},{"from":"58","fromOut":0,"to":"173","toIn":4},{"from":"173","fromOut":0,"to":"34","toIn":0}],"ai":{"s":"本工作流是 Winston 打造的集大成工业级 AIGC 综合重构渲染管线，融合了双模型时序接力、多模态参考引导、两阶段混合超分与面部可视化精修。主干架构创新性地采用 Model 1 与 Model 2 双大模级联，通过百分比步数控制器（Steps on Model1 %）实现结构生成与质感细化的无缝交接；条件端集成高达 6 图矩阵的 IP-Adapter 图像批处理特征提取与多路 ControlNet 精准姿态导向；放大链路构建了 Pixel US 1 与 US 2 双重模型超分与潜空间回传重采样的混合管线；尾端更配备了带多通道 Alpha/裁剪实时 Debug 监视的 SAM 级联 FaceDetailer，全方位保障从微观毛孔到宏观构图的顶级商业画质交付。","u":["需要融合两款不同大模型优势（如一款保构图姿态、另一款保胶片质感）的高阶时序接力生成","依赖多张参考图特征（6通道 IP-Adapter 批处理）与 ControlNet 强几何约束的高难度商业视觉定制","大幅面海报印刷级双重模型超分（两阶段超分 + 潜空间回传降噪）与面部毛孔毫米级微观精修"],"d":3,"st":[{"name":"多模型资产配置与多路 VAE 动态路由","desc":"加载 Model 1（基础构图大模）与 Model 2（细节质感大模），配合独立 VAELoader；通过 ImpactSwitch 与 VAE Selector 整数控制器实现内嵌 VAE 与外置定制 VAE 的动态软切换，利用 Steps on Model1 %（节点 54）参数化调控两阶段步数分配比例，结合 EmptyLatentImage 初始化画幅潜空间。","nodes":["20","21","22","149","150","151","28","54"]},{"name":"6 图 IP-Adapter 图像批处理与 ControlNet 精确受控","desc":"部署六通道参考图矩阵（LoadImage 1-6），经 PrepImageForClipVision 标准化后通过 ImageBatch 级联汇聚为图像批次张量，送入 IP-Adapter 提取参考特征；同时结合 ControlNetLoader、4路图像选择开关（CR Switch）与 ControlNetApplyAdvanced 实现构图与姿态引导，配合正负文本提示词与 FaceStyler 完成全维度条件特征编码。","nodes":["116","117","119","120","122","123","126","127","128","129","130","131","118","121","124","125","135","132","114","115","145","146","142","147","18","19","165"]},{"name":"双模型时序分步采样与原始画幅 Tiled 解码","desc":"依托 Inspire 套件的 KSampler 与 KSamplerAdvanced 搭建时序接力采样管线：Model 1 在前半段去噪中锁定整体光影与解剖轮廓，Model 2 依据步数比例切入完成高频质感细化；通过 VAEDecodeTiled 进行分块解码，消除显存溢出风险并生成 OG（原始画幅）图像供实时预览比对。","nodes":["173","171","23","80"]},{"name":"双重模型级像素超分与潜在重采样精修","desc":"支持 Pixel US #1 与 #2 双重模型超分辨率放大（ImageUpscaleWithModel），结合 Float 与 Evaluate Floats 精确计算缩放因子；经 ImageScaleBy / Image scale to side 控制像素尺寸，通过 VAEEncode 将超分图像重新编码入潜空间进行二次低去噪采样，最终由专用 Tiled VAE 解码输出超清大图。","nodes":["37","38","35","31","156","157","32","140","113","33","34","148"]},{"name":"SAM 级联面部多级 Debug 精雕与最终成片落盘","desc":"加载 SAM 高精分割模型与人脸精修专用大模型，设定专属 Face Prompt；通过 DetailerForEachDebug 节点对画面人物五官展开深度级联修复，并在 cropped、cropped_refined 及 alpha 通道三组预览监视器中进行全流程可视化 Debug 审计，最终由 SaveImage 落盘保存至臻商业成片。","nodes":["98","104","102","103","101","105","106","107","158"]}],"p":"Steps on Model1 %（节点 54）建议设为 40%-60%，让 Model 1 专注于前 50% 步数的宏观骨骼与构图去噪，Model 2 负责后 50% 步数的微观纹理与胶片质感收敛；两阶段超分中，Pixel US 1 推荐使用通用超分模型（如 DAT-2 或 RealESRGAN），US 2 可选用画质细腻的动漫/写实专用模型；潜空间回传采样（VAEEncode）时去噪幅度（Denoise）严格保持在 0.25-0.35 之间，避免破坏原图解剖结构；FaceDetailer 引导尺寸建议保持在 512-768。","t":["【双模型步数百分比与调度器对齐】：在配置节点 54（Steps on Model1 %）时，必须确保 Model 1 与 Model 2 采用兼容的调度器策略（如均为 Karras 或 Exponential），且总步数建议不低于 30 步；若步数截断比例设置不当（如 Model 1 仅跑 10%），会导致构图尚未收敛即切换大模，产生多肢体畸变或面部重影。","【6 图 IP-Adapter 批处理权重过载】：工作流支持 6 张图片级联打批次送入 IP-Adapter，若每张图特征均满额注入，极易导致提示词（Prompt）失效或画面色彩过饱和发黑；建议搭配 PrepImageForClipVision 进行标准化预处理，并在 IPAdapterModelLoader 中将总 weight 适当压低至 0.6-0.75。"],"n":"【超大显存开销与扩展库依赖】：该全能管线节点总数高达 60 个，同时常驻 3 个大模型检查点（Model 1、Model 2、FaceDetailer 专用模）、ControlNet、IP-Adapter 及超分模型，最低显存门槛为 16GB（强烈推荐 24GB VRAM 显卡），物理内存建议 >= 64GB。运行前必须确保已安装 ComfyUI-Impact-Pack、ComfyUI_IPAdapter_plus、comfyui-inspire-pack 及 ComfyUI-Comfyroll-CustomNodes 等插件。","na":{"35":{"brief":"第一阶段模型级像素超分辨率放大器","detail":"调用专用超分神经模型对解码后的初始图像进行无损高倍数放大，为后续第二阶段混合超分与潜空间回传重采样奠定高密度的像素基底。"},"54":{"brief":"双模型时序采样步数百分比控制器","detail":"本工作流双模型接力采样的核心中枢，动态计算并分配 Model 1 与 Model 2 在总去噪步数中的执行占比，实现前半段强构图与后半段强细节的完美解耦结合。"},"101":{"brief":"可视化多通道面部 Debug 精修核心","detail":"集成 SAM 高精分割与专属人脸提示词的面部细化节点，不仅执行毫米级局部重绘，更外接 cropped、cropped_refined 及 alpha 预览端，提供全流程透明可审计的精修质检。"},"114":{"brief":"IP-Adapter 多模态特征注入模型加载器","detail":"加载 IP-Adapter 跨注意力引导权重，驱动经由 6 通道 ImageBatch 批处理汇聚的图像特征与主干扩散模型深度交互，实现极高保真度的多图参考风格迁移。"},"171":{"brief":"Inspire 级联时序采样推进器","detail":"承接第一阶段 KSampler 的中间态潜空间，在不重置噪声的前提下无缝切换至 Model 2，按照预设步长序列完成剩余去噪计算，确保跨模型接力无缝平滑。"}}}}