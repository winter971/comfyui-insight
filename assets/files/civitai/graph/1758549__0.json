8","fromOut":3,"to":"269","toIn":0},{"from":"268","fromOut":4,"to":"269","toIn":1},{"from":"285","fromOut":0,"to":"270","toIn":0},{"from":"277","fromOut":0,"to":"272","toIn":0},{"from":"289","fromOut":0,"to":"274","toIn":0},{"from":"271","fromOut":0,"to":"274","toIn":1},{"from":"274","fromOut":0,"to":"275","toIn":0},{"from":"285","fromOut":3,"to":"275","toIn":1},{"from":"285","fromOut":4,"to":"275","toIn":2},{"from":"285","fromOut":5,"to":"275","toIn":3},{"from":"285","fromOut":6,"to":"275","toIn":4},{"from":"287","fromOut":0,"to":"277","toIn":0},{"from":"269","fromOut":0,"to":"278","toIn":0},{"from":"279","fromOut":0,"to":"280","toIn":0},{"from":"287","fromOut":0,"to":"282","toIn":0},{"from":"267","fromOut":0,"to":"282","toIn":1},{"from":"267","fromOut":1,"to":"282","toIn":2},{"from":"266","fromOut":0,"to":"282","toIn":3},{"from":"272","fromOut":0,"to":"282","toIn":4},{"from":"267","fromOut":2,"to":"282","toIn":5},{"from":"285","fromOut":1,"to":"284","toIn":0},{"from":"268","fromOut":0,"to":"285","toIn":0},{"from":"269","fromOut":0,"to":"285","toIn":3},{"from":"280","fromOut":0,"to":"287","toIn":0},{"from":"287","fromOut":0,"to":"289","toIn":0},{"from":"267","fromOut":0,"to":"289","toIn":1},{"from":"267","fromOut":1,"to":"289","toIn":2},{"from":"266","fromOut":0,"to":"289","toIn":3},{"from":"272","fromOut":1,"to":"289","toIn":4},{"from":"282","fromOut":1,"to":"289","toIn":5},{"from":"292","fromOut":0,"to":"293","toIn":0},{"from":"292","fromOut":2,"to":"294","toIn":0},{"from":"294","fromOut":1,"to":"293","toIn":1},{"from":"294","fromOut":1,"to":"287","toIn":1},{"from":"293","fromOut":0,"to":"295","toIn":0},{"from":"293","fromOut":1,"to":"296","toIn":0},{"from":"275","fromOut":0,"to":"302","toIn":0},{"from":"294","fromOut":1,"to":"303","toIn":0},{"from":"303","fromOut":0,"to":"302","toIn":2},{"from":"302","fromOut":0,"to":"304","toIn":0},{"from":"304","fromOut":0,"to":"293","toIn":2},{"from":"275","fromOut":0,"to":"480","toIn":0},{"from":"292","fromOut":3,"to":"480","toIn":1},{"from":"480","fromOut":0,"to":"293","toIn":3},{"from":"293","fromOut":2,"to":"476","toIn":0},{"from":"481","fromOut":0,"to":"268","toIn":0},{"from":"482","fromOut":0,"to":"292","toIn":0}],"ai":{"s":"IC-Edit 循环编辑工作流（Flux Fill 非 MOE 版）：载入图先按 512 宽等比缩放，SolidMask 生成全幅遮罩，easy makeImageForICLora 把原图与遮罩拼成 IC-LoRA 规定的左右双联画，后续裁剪坐标也由它给出；CR Prompt Text 的双联画指令经 CLIP 编码、FluxGuidance 抬到 50，与双联画、遮罩一起进 InpaintModelConditioning 组装成 Flux Fill 专用条件。模型链是 fluxFillFP8 叠 pytorch_lora 再叠 IcEdit-normal-lora，后者强度不写死：forLoopStart 跑 10 轮，MathExpression 每轮 +0.1，从 0.1 一路扫到 1.0。30 步 BasicScheduler 被 SplitSigmas 从第 10 步切成两段，两台 SamplerCustom 接力采样，CFG 均 1。每轮结果解码后按坐标裁出编辑的那一半、打上当轮强度标签批量收集，一次运行就能横向对比不同强度下的编辑幅度，再挑一档固定下来。","u":["一句话改图（换装、换手持物、换发型）：IC-Edit 指令式编辑，不用涂遮罩选区域","拿不准 IC-LoRA 强度给多少合适：跑一遍循环，0.1-1.0 十档结果并排挑","普通改图（0.6）与复杂大改（1.0）之间的取舍：直接看扫档结果决定","想学 IC-Edit 原理时的标准参考：双联画 + InpaintModelConditioning 的完整接法"],"d":3,"st":[{"name":"输入与 IC 画布准备","desc":"图片按 512 宽等比缩放并取整倍数，SolidMask 给出全幅遮罩，makeImageForICLora 把图和遮罩拼成 IC-LoRA 要求的左右双联画，同时输出裁剪坐标。","nodes":["481","268","269","285","270"]},{"name":"指令与条件编码","desc":"双联画指令模板经 Flux 双编码器编码、FluxGuidance 抬高引导，InpaintModelConditioning 把图、遮罩、VAE 组装成 Flux Fill 专用条件与 latent。","nodes":["273","290","265","264","263","271","267"]},{"name":"模型装配","desc":"Flux Fill fp8 主干先叠 pytorch_lora 再叠 IC-Edit 主 LoRA；主 LoRA 的强度端口留给循环改写，是整条工作流的实验变量。","nodes":["279","280","287"]},{"name":"两段接力采样","desc":"BasicScheduler 生成 30 步 sigma 表后被 SplitSigmas 切成两段，两台 SamplerCustom 各跑一段，euler 采样 CFG 1，降低单次长行程的漂移。","nodes":["266","277","272","282","289"]},{"name":"循环与结果收集","desc":"循环跑 10 轮，每轮强度 +0.1 重复整个编辑；结果解码后按双联画坐标裁出编辑半边、标上强度数字批量归集，最后统一保存。","nodes":["292","482","294","274","275","302","304","293","476"]}],"p":"IC-LoRA 强度是核心变量：普通编辑 0.6、复杂编辑 1.0，循环从 0.1 扫到 1.0 后按结果选定；总步数 30、SplitSigmas 在第 10 步分段、两段 CFG 1 保持不动；FluxGuidance 50 的高引导是 IC-Edit 刻意设置，调低会明显不服从指令；输入宽度 512 决定编辑速度与精度。","n":"需另下 fluxFillFP8_v10、IcEdit-normal-lora、pytorch_lora 三个模型文件；循环 10 轮等于把 30 步采样跑十遍，出全套对比图耗时较长；遮罩默认全幅（SolidMask），若只想编辑局部需自行替换遮罩来源；图里还有两个未接线的 MediaPlayer 节点，属残留可忽略。"}}