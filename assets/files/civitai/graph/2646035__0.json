"fromOut":0,"to":"150","toIn":6},{"from":"142","fromOut":0,"to":"150","toIn":7},{"from":"114","fromOut":1,"to":"144","toIn":0},{"from":"31","fromOut":0,"to":"143","toIn":0},{"from":"144","fromOut":0,"to":"38","toIn":1},{"from":"143","fromOut":0,"to":"38","toIn":2},{"from":"145","fromOut":0,"to":"151","toIn":6},{"from":"146","fromOut":0,"to":"151","toIn":7},{"from":"96","fromOut":0,"to":"151","toIn":0},{"from":"98","fromOut":0,"to":"38","toIn":3},{"from":"99","fromOut":0,"to":"150","toIn":0},{"from":"94","fromOut":0,"to":"149","toIn":0},{"from":"92","fromOut":0,"to":"148","toIn":0},{"from":"39","fromOut":0,"to":"147","toIn":0},{"from":"37","fromOut":0,"to":"102","toIn":0}],"ai":{"s":"Pony 系的变身序列生成器：一张源图缩放到 832×1216 后，串联六个 img2img 采样阶段——每段 denoise 0.95、独立种子、各自的 score 词表正负提示词（CR Prompt Text 六对），潜空间从上一段直接流进下一段，角色在六帧之间完成渐进变身。模型侧 prefectPonyXL 叠 ZXC_Style_v4 风格 LoRA 与 CLIP 截尾 -2；参数中枢用 Image Saver 系列的选择器与 Literal（30 步、CFG 7.5、euler_ancestral/normal）统一分发到全部七个 KSampler。六个阶段的成图各带一份全参数元数据归档（Image Saver ×6），加上首帧共七档，直接构成变身动画的帧素材或逐格漫画。CR SDXL Aspect Ratio 统一管画幅，改尺寸一处生效。","u":["角色变身序列：人变狼、人变机械等六帧渐进变化，逐帧出图后可合成动画","漫画分镜连续格：同角色六格渐进表情/形态变化","img2img 链式渐变的机制示范：潜空间接力加逐段换词的标准写法","Pony 系 score 词表的成套实践：六对正负词表一次配齐"],"d":3,"st":[{"name":"模型与参数中枢","desc":"检查点加风格 LoRA 加截尾，选择器与 Literal 把步数、CFG、采样器、种子、画幅统一分发到七个采样位。","nodes":["24","114","31","25","26","27","28","29","30"]},{"name":"起始帧与第一段","desc":"源图缩放编码后第一段 0.95 采样，首帧归档；六段接力的起点。","nodes":["83","89","82","84","115","33","35","37","44","102","124","126"]},{"name":"中间段二至六","desc":"五个采样位依次接力，各自词表各自种子，潜空间逐段传递完成渐进变身，末段输出完成帧。","nodes":["128","127","90","39","132","131","91","92","136","135","93","94","140","139","98","99","38","96","97","129","130","133","134","137","138","141","142","145","146","143","144"]},{"name":"逐帧归档","desc":"第二至六帧各自带全参数元数据归档，与首帧的 102 组成完整序列。","nodes":["147","148","149","150","151"]}],"p":"步数/CFG/采样器/画幅在中枢四处改全局生效；六对词表是变身剧本；段间 denoise 0.95 决定词表话语权；七颗种子独立可分别锁定。","n":"需 prefectPonyXL、ZXC_Style_v4、sdxl_vae_pony 与 Comfyroll、Image-Saver 插件；六对 CR 词表编辑量大但结构相同；全程七段采样耗时约为单图的七倍；相邻段词表差异决定变形幅度。","f":["① 模型中枢：24 加载 prefectPonyXL（模型名 STRING 供元数据）进 114 叠 ZXC_Style_v4（1/1），CLIP 过 31 截尾 -2；25/26/27/28 四个选择器定 30 步、CFG 7.5、euler_ancestral/normal，29 出随机种子，30 定 5:8 竖版画幅","② 起始帧：83 载入源图，89 按 30 的尺寸 nearest-exact 缩放，84 用 Pony VAE 编码进 35 的 latent 口；115（124 的 score 正向）与 33（126 的负面）编码后进 35","③ 35 第一段 0.95 降噪采样，37 解码进 44 预览与 102 归档（首帧）；潜空间交给 90","④ 二至五段：90→91→93→98 依次接力，每段吃自己那对 CR 词表（129/130、133/134、137/138、141/142），各自解码预览（39/92/94/99）——角色逐段变形","⑤ 98 的潜空间再进 38 第六段（143/144 词表），96 解码预览——变身完成帧","⑥ 归档：六个阶段的解码图各进一个 Image Saver（147-151 与 102），全部带模型名、种子、尺寸与词表元数据按日期归档"],"t":["六段词表是变身剧本：相邻两段的描述差决定变形幅度，写序列时保持每段只变一件事","0.95 的段间降噪很高——潜空间接力时上一段只留两成半信息，词表才是主导；想保留更多上一段特征降到 0.8","七颗随机种子各自独立：想整条序列风格统一就把七颗锁成同值或相近值","30 的画幅改一次全链跟随（缩放、画布、元数据三处同步），分段词表不用动","参数中枢的选择器一改七段全变：想给某一段特殊参数得把它的连线断开手填","逐帧做动画时按 147-151 的文件顺序排帧，元数据里有种子与词表可回溯任何一帧","BSS 类超权重 LoRA 别往 114 里加——变身序列吃的是词表驱动，风格件多了段间会跳"],"na":{"24":{"brief":"带名检查点装载器。","desc":"Image Saver 系的 Checkpoint Loader 额外输出模型名字符串，六个归档位的 modelname 字段都由它供——改名即改档。","params":[]},"25":{"brief":"采样器选择器（euler_ancestral）。","desc":"COMBO 加字符串双输出：COMBO 喂七个采样位，字符串进七个归档位的 sampler 字段——参数与元数据永远一致。","params":[]},"26":{"brief":"调度器选择器（normal）。","desc":"与 25 同构的双输出，喂采样与归档两侧。","params":[]},"27":{"brief":"CFG Literal（7.5）。","desc":"Pony 系常规 CFG，直喂七个采样位与归档。","params":[]},"28":{"brief":"步数 Literal（30）。","desc":"覆盖七个采样位控件里的 20 步——Literal 分发是这条线「一处改全局变」的核心手段。","params":[]},"29":{"brief":"随机种子发生器。","desc":"randomize 档喂归档元数据；七个采样位各自内部随机，互不共享。","params":[]},"30":{"brief":"CR SDXL Aspect Ratio（5:8 竖版）。","desc":"出宽高 INT 三路：源图缩放、七个归档位的尺寸字段——画幅唯一事实源。","params":[{"name":"aspect","kind":"下拉","default":"5:8 portrait 832x1216","desc":"竖版变身帧标准幅面"}]},"31":{"brief":"CLIP 截尾 -2。","desc":"Pony 系标准操作，进 114 的 clip 口后分发各段编码器。","params":[]},"33":{"brief":"第一段负向编码。","desc":"编码 126 的 score_6 以下负面词表给 35 的 negative。","params":[]},"35":{"brief":"第一段采样器（img2img 起手）。","desc":"从源图潜空间 0.95 降噪起步，参数全部来自中枢选择器；输出潜空间接力给 90、解码归档为第 0 帧。","params":[]},"37":{"brief":"首帧解码。","desc":"第一段成果转像素进 44 预览与 102 归档。","params":[]},"38":{"brief":"第六段采样器（完成帧）。","desc":"接力 98 的潜空间、143/144 词表收尾——变身终态在这里定型，解码进 97 预览与 151 归档。","params":[]},"83":{"brief":"变身源图输入。","desc":"载入起始形态的图；它的构图与角色决定整条序列的骨架。","params":[]},"84":{"brief":"源图编码。","desc":"Pony VAE 把缩放后的图转潜空间给 35——第一段 img2img 的起点。","params":[]},"89":{"brief":"源图缩放。","desc":"nearest-exact 按 30 的画幅缩到 832×1216——nearest 保像素边缘，对像素风或硬边源图友好。","params":[]},"90":{"brief":"第二段采样器（代表中间段）。","desc":"潜空间接力自 35、词表换 129/130 这一对、种子独立——中间段的通用模式：结构与 90 相同的还有 91/93/98/38 四位，词表逐段递进。","params":[]},"91":{"brief":"第三段采样器。","desc":"接力 90 的潜空间，133/134 词表驱动第三形态；解码后继续向下一段传递。","params":[]},"93":{"brief":"第四段采样器。","desc":"接力 91，137/138 词表；四段过后变身已过半。","params":[]},"98":{"brief":"第五段采样器。","desc":"接力 93，141/142 词表；输出同时解码预览与交给第六段。","params":[]},"102":{"brief":"首帧归档。","desc":"Image Saver 写入步数、CFG、模型名、词表、种子与尺寸全套元数据；变身序列的基准帧。","params":[]},"114":{"brief":"ZXC_Style_v4 风格 LoRA。","desc":"1/1 满强度给全部七个采样位；变身的画风统一由它兜底。","params":[]},"115":{"brief":"第一段正向编码。","desc":"编码 124 的 score 系正向（derpibooru 标签开头）给 35；第一段的形态目标写在这里。","params":[]},"124":{"brief":"第一段正向词表。","desc":"score_9/8_up/7_up 的 derpibooru 标签开头——Pony 系质量锚点加第一段形态描述；每段一对、六对成剧本。","params":[]},"147":{"brief":"第二帧归档（代表逐帧归档位）。","desc":"与 148-151 同构：全参数元数据按日期目录落盘；五帧加首帧构成完整序列档案。","params":[]}}}}