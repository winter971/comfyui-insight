,"toIn":0},{"from":"218","fromOut":0,"to":"219","toIn":0},{"from":"196","fromOut":0,"to":"218","toIn":1},{"from":"197","fromOut":0,"to":"218","toIn":2},{"from":"195","fromOut":0,"to":"219","toIn":1},{"from":"219","fromOut":0,"to":"194","toIn":0},{"from":"199","fromOut":0,"to":"218","toIn":0},{"from":"225","fromOut":0,"to":"224","toIn":0},{"from":"225","fromOut":0,"to":"226","toIn":0},{"from":"224","fromOut":0,"to":"227","toIn":1},{"from":"44","fromOut":0,"to":"227","toIn":0},{"from":"44","fromOut":0,"to":"228","toIn":0},{"from":"45","fromOut":0,"to":"228","toIn":1},{"from":"225","fromOut":0,"to":"229","toIn":0},{"from":"229","fromOut":0,"to":"230","toIn":0},{"from":"15","fromOut":0,"to":"230","toIn":1},{"from":"223","fromOut":0,"to":"232","toIn":0},{"from":"45","fromOut":0,"to":"232","toIn":1},{"from":"232","fromOut":1,"to":"11","toIn":0},{"from":"232","fromOut":1,"to":"12","toIn":0},{"from":"232","fromOut":0,"to":"65","toIn":0},{"from":"219","fromOut":0,"to":"233","toIn":0},{"from":"225","fromOut":0,"to":"234","toIn":0},{"from":"226","fromOut":0,"to":"231","toIn":0},{"from":"225","fromOut":0,"to":"223","toIn":1},{"from":"225","fromOut":1,"to":"223","toIn":2},{"from":"230","fromOut":0,"to":"235","toIn":0},{"from":"235","fromOut":0,"to":"218","toIn":3},{"from":"228","fromOut":0,"to":"237","toIn":0},{"from":"228","fromOut":1,"to":"237","toIn":1},{"from":"237","fromOut":0,"to":"223","toIn":0},{"from":"229","fromOut":0,"to":"238","toIn":0},{"from":"219","fromOut":0,"to":"238","toIn":1},{"from":"238","fromOut":0,"to":"239","toIn":0}],"ai":{"s":"Anima 模型的简易局部重绘工作流，主打 8 步快速出图。原图在 LoadImage 里涂好遮罩后缩放到 1 百万像素，VAE 编码成潜空间直接作为采样起点；区域控制不走传统 inpaint 遮罩管线，而是用 AnimaLLLiteApply 适配器把原图与遮罩一起写进模型——这是 Anima 系对 ControlNet 的替代物。正向词（改黑瞳红眼之类）与负向词经 Set/Get 节点接入 KSampler。模型侧 anima-base 检查点过 Power Lora Loader，其中 turbo LoRA 处于开启状态，所以 8 步 er_sde、cfg 1 全去噪即可收敛；面板另存一个被旁路的 dmd2 蒸馏 LoRA 作备选加速。输出把结果存成 webp，并与缩放原图左右拼接另存对比图，方便验收重绘区域。旁路里还有 canny、lineart、depth 三条预处理支线，对应 Anima 的其他控制适配器，需要按结构控制时启用。","u":["给已有图改局部细节（瞳色、配饰、背景物件）：涂个遮罩 8 步出结果","不想装 ControlNet 做区域控制：LLLite 适配器直接接管重绘范围","需要修改前后对比图：自动拼接原图与结果另存归档","作为 Anima 其他控制适配器（canny/lineart/depth）的启用模板"],"d":3,"st":[{"name":"模型装配","desc":"anima-base 检查点与 qwen3 文本编码器就位，Power Lora 面板开着 turbo LoRA——8 步快出的前提；dmd2 蒸馏 LoRA 是被旁路的备选方案。","nodes":["44","45","228","237"]},{"name":"输入与潜空间","desc":"载入在 MaskEditor 涂好遮罩的图，缩到 1 百万像素后 VAE 编码成潜空间，配好批量数直接交给采样器。","nodes":["225","229","15","230","235"]},{"name":"重绘条件装配","desc":"正负提示词编码后经 Set/Get 广播；AnimaLLLiteApply 吃入原图与遮罩，把'只改这里'写进模型本身，等价于传统 inpaint 的遮罩管线。","nodes":["11","12","223"]},{"name":"采样与解码","desc":"8 步 er_sde、cfg 1、全去噪——步数少是 turbo LoRA 的功劳，区域约束交给 LLLite，解码回图。","nodes":["218","219"]},{"name":"输出与对比","desc":"结果单独存 webp，同时与缩放原图左右拼接成对比图再存一份，重绘是否越界一眼可查。","nodes":["194","233","238","239"]},{"name":"旁路控制支线","desc":"canny、lineart、depth 三条预处理链默认旁路，对应 Anima 的预览/控制适配器；需要按边缘、线稿或景深约束生成时 Ctrl+B 启用。","nodes":["224","227","226","231","234","232"]}],"p":"8 步 er_sde + cfg 1 的快出配置依赖 237 面板里开启的 turbo LoRA，换风格 LoRA 时确认步数别按 20+ 习惯填；ImageScaleToTotalPixels 固定 1 百万像素，重绘区域太大细节不足时可提高；denoise 保持 1，区域控制交给 LLLite，调低会让遮罩外也轻微变动。","n":"需先在 LoadImage 的 MaskEditor 里涂遮罩（示例已带涂好的 clipspace 遮罩）；anima-base 检查点、anima-lllite-inpainting 适配器与 turbo LoRA 都要另下；旁路的 canny/lineart/depth 支线启用后还需对应的预处理器模型。"}}