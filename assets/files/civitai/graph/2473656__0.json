s":[{"name":"IMAGE","type":"IMAGE"},{"name":"MASK","type":"MASK"}],"widgets":["pasted/image (147).png","image"],"brief":"节点 45/46 是旁路的额外参考图，启用后进入多参考编辑","desc":""},{"id":"111","title":"Fast Groups Bypasser (rgthree)","type":"Fast Groups Bypasser (rgthree)","cat":"util","x":-2411,"y":-531,"inputs":[],"outputs":[{"name":"OPT_CONNECTION","type":"*"}],"widgets":[],"brief":"按组一键旁路，切风格 LoRA 与模型通道","desc":""}],"links":[{"from":"27","fromOut":0,"to":"90","toIn":1},{"from":"99","fromOut":0,"to":"102","toIn":5},{"from":"27","fromOut":0,"to":"102","toIn":4},{"from":"102","fromOut":0,"to":"104","toIn":0},{"from":"114","fromOut":0,"to":"127","toIn":0},{"from":"113","fromOut":0,"to":"127","toIn":1},{"from":"127","fromOut":1,"to":"6","toIn":0},{"from":"6","fromOut":0,"to":"3","toIn":1},{"from":"6","fromOut":0,"to":"102","toIn":2},{"from":"134","fromOut":0,"to":"3","toIn":0},{"from":"127","fromOut":0,"to":"134","toIn":0},{"from":"134","fromOut":0,"to":"102","toIn":1},{"from":"127","fromOut":1,"to":"135","toIn":0},{"from":"135","fromOut":0,"to":"3","toIn":2},{"from":"135","fromOut":0,"to":"102","toIn":3},{"from":"160","fromOut":0,"to":"161","toIn":0},{"from":"78","fromOut":0,"to":"161","toIn":1},{"from":"161","fromOut":0,"to":"91","toIn":0},{"from":"91","fromOut":0,"to":"90","toIn":0},{"from":"27","fromOut":0,"to":"179","toIn":1},{"from":"3","fromOut":0,"to":"179","toIn":0},{"from":"179","fromOut":0,"to":"9","toIn":0},{"from":"188","fromOut":0,"to":"189","toIn":0},{"from":"6","fromOut":0,"to":"188","toIn":1},{"from":"135","fromOut":0,"to":"188","toIn":2},{"from":"108","fromOut":0,"to":"3","toIn":3},{"from":"90","fromOut":0,"to":"188","toIn":3},{"from":"27","fromOut":0,"to":"189","toIn":1},{"from":"189","fromOut":0,"to":"191","toIn":0},{"from":"78","fromOut":0,"to":"193","toIn":0},{"from":"189","fromOut":0,"to":"193","toIn":1},{"from":"194","fromOut":0,"to":"102","toIn":0},{"from":"194","fromOut":0,"to":"195","toIn":0},{"from":"102","fromOut":0,"to":"195","toIn":1},{"from":"202","fromOut":0,"to":"203","toIn":1},{"from":"201","fromOut":0,"to":"203","toIn":3},{"from":"27","fromOut":0,"to":"203","toIn":2},{"from":"91","fromOut":0,"to":"201","toIn":0},{"from":"134","fromOut":0,"to":"203","toIn":0},{"from":"203","fromOut":0,"to":"188","toIn":0}],"ai":{"s":"Z-Image Turbo 四合一主工作流，默认只跑文生图：z_image_turbo 主干过 Power LoRA 列表（当前全关）与 ModelSamplingAuraFlow（shift 7），Qwen3-4B 编码器写正负提示词，1536x1024 空潜空间由 KSampler 9 步 CFG 1 euler simple 完成，VAE 解码保存——典型的 turbo 少步低 CFG 接法。其余三条支线默认旁路，靠 Fast Groups Bypasser 切换：I2I 支线把底图 4x 放大再规整到 2048x1536，编码后以 denoise 0.7 重绘并给前后对比；ControlNet 支线用 Canny 提边缘，经 QwenImageDiffsynthControlnet 挂 Fun-Union 控制网，注入 I2I 采样链锁定构图；UltimateSDUpscale 支线独立载图做 1.5 倍分块放大（denoise 0.35）保细节。用哪个模式开哪组即可。","u":["快速文生图出大图：Z-Image Turbo 九步出 1536x1024，迭代提示词效率高","参考图改画风：开 I2I 支线，denoise 0.7 在保留构图的前提下重绘","按轮廓控图：开 ControlNet 支线，Canny 边缘锁定姿态与结构","成图放大交付：UltimateSDUpscale 1.5 倍分块重绘，低 denoise 不糊细节"],"d":2,"st":[{"name":"模型与文本编码","desc":"turbo 主干叠可选 LoRA 与 AuraFlow 位移采样，Qwen3-4B 编码正负提示词，VAE 独立加载供全程编解码。","nodes":["114","113","127","6","135","134","27"]},{"name":"T2I 采样与输出","desc":"1536x1024 空潜空间进九步采样，解码后直接保存，是默认激活的唯一通路。","nodes":["108","3","179","9"]},{"name":"旁路：I2I 支线","desc":"底图先 4x 模型放大再规整尺寸，编码后低阈值重绘，解码另存并并排对比原图。","nodes":["78","160","161","91","90","188","189","191","193"]},{"name":"旁路：ControlNet 支线","desc":"Canny 从缩放底图提边缘，DiffSynth 控制网补丁把结构写进模型后接给 I2I 采样器。","nodes":["202","201","203"]},{"name":"旁路：UltimateSDUpscale 支线","desc":"独立载图按 1.5 倍分块放大重绘，复用同一套模型与提示词，低 denoise 保细节。","nodes":["194","99","102","104","195"]}],"p":"T2I 保持 9 步、CFG 1、euler/simple 的 turbo 接法，别按常规模型调高；I2I 幅度看 188 号 KSampler 的 denoise 0.7，想更贴近原图就降；放大支线 denoise 0.35、1.5 倍，超过 2 倍建议改用 I2I 先放大再 USU。","n":"四条支线靠 111 号 Fast Groups Bypasser 切换，默认仅 T2I 激活；ControlNet 支线需另下 Z-Image-Turbo-Fun-Controlnet-Union 模型，放大支线需 4x-UltraMix_Balanced 模型与 UltimateSDUpscale 包；qwen_3_4b 编码器与 ae.safetensors VAE 需提前就位。"}}