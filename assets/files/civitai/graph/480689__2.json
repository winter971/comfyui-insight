286","toIn":0},{"from":"286","fromOut":0,"to":"244","toIn":2},{"from":"286","fromOut":0,"to":"276","toIn":0},{"from":"176","fromOut":0,"to":"182","toIn":0},{"from":"174","fromOut":0,"to":"7","toIn":1},{"from":"175","fromOut":0,"to":"7","toIn":2},{"from":"211","fromOut":0,"to":"7","toIn":3},{"from":"176","fromOut":0,"to":"7","toIn":0},{"from":"184","fromOut":0,"to":"291","toIn":0},{"from":"182","fromOut":0,"to":"289","toIn":0},{"from":"183","fromOut":0,"to":"290","toIn":0},{"from":"185","fromOut":0,"to":"292","toIn":0},{"from":"180","fromOut":0,"to":"287","toIn":0},{"from":"181","fromOut":0,"to":"288","toIn":0},{"from":"291","fromOut":0,"to":"232","toIn":4},{"from":"289","fromOut":0,"to":"232","toIn":1},{"from":"287","fromOut":0,"to":"232","toIn":2},{"from":"288","fromOut":0,"to":"232","toIn":3},{"from":"182","fromOut":0,"to":"14","toIn":0},{"from":"179","fromOut":0,"to":"7","toIn":4},{"from":"242","fromOut":0,"to":"294","toIn":0},{"from":"232","fromOut":0,"to":"313","toIn":0},{"from":"244","fromOut":0,"to":"314","toIn":0},{"from":"244","fromOut":0,"to":"318","toIn":0},{"from":"232","fromOut":0,"to":"318","toIn":1},{"from":"305","fromOut":0,"to":"319","toIn":0},{"from":"319","fromOut":0,"to":"308","toIn":0},{"from":"308","fromOut":0,"to":"309","toIn":0},{"from":"309","fromOut":0,"to":"318","toIn":2},{"from":"15","fromOut":0,"to":"326","toIn":0},{"from":"182","fromOut":0,"to":"326","toIn":1},{"from":"183","fromOut":0,"to":"326","toIn":2},{"from":"184","fromOut":0,"to":"326","toIn":3},{"from":"181","fromOut":0,"to":"326","toIn":4},{"from":"181","fromOut":0,"to":"326","toIn":5},{"from":"302","fromOut":0,"to":"326","toIn":6},{"from":"325","fromOut":0,"to":"326","toIn":7},{"from":"326","fromOut":3,"to":"305","toIn":0},{"from":"309","fromOut":0,"to":"310","toIn":0},{"from":"318","fromOut":0,"to":"333","toIn":0},{"from":"15","fromOut":0,"to":"334","toIn":0},{"from":"249","fromOut":0,"to":"15","toIn":0}],"ai":{"s":"换脸精修全流程。analogMadness 先做 384x640 文生图（20 步 denoise 1），潜空间 1.5 倍放大后由 denoise 0.7 的 hires KSampler 出高清底图；DZ_Face_Detailer 在潜空间细化面部并顺手产出脸部遮罩。VAE 解码后 ReActor 用上传的源照片把脸换进画面，这是整条链的核心目的。放大走双路：整图交给 UltimateSDUpscale 以 512 分块、denoise 0.2 做高分辨率底版；脸部按遮罩 Cut 出来单独走 LDSR 超分，再经模糊加腐蚀的羽化遮罩 Paste 回底版，脸部细节与整图分辨率兼得。最后 Impact FaceDetailer 挂 Eyes.pt 眼部检测模型，按眼睛遮罩把 UltimateSDUpscale 版的眼部混回，治换脸回贴后常见的眼睛糊掉。必须如此迂回，是因为 ReActor 输出的脸分辨率低，整图一步放大救不了脸部，只能切出来单独超分再回贴。","u":["AI 生成的人脸不像目标人物：上传源照片用 ReActor 换成指定人脸","换脸后脸部模糊：切脸走 LDSR 单独超分再羽化回贴，脸部特写也经得起放大看","换脸后眼睛崩坏：启用眼部检测支线单独修眼，FaceEyeFix 版本专门存这个结果","想一次性拿到换脸原版、回贴版、修眼版三个成品质检对比"],"d":3,"st":[{"name":"加载与提示词","desc":"analogMadness 主模截 CLIP 末层、配独立 VAE，rgthree Seed 统一管理随机种子，正负提示词与 384x640 空白潜空间就位。","nodes":["22","4","2","201","6","9","31"]},{"name":"两段式生成与面部细化","desc":"先生成小图再潜空间放大 1.5 倍做 hires 采样，DZ_Face_Detailer 在解码前细化面部并输出脸部遮罩，遮罩是后续切脸回贴的依据。","nodes":["7","13","14","15","249","250","334"]},{"name":"换脸","desc":"上传的源照片经 ReActor（inswapper + retinaface + GFPGAN）把脸换到生成图上，是后续所有放大精修的对象。","nodes":["204","126","209"]},{"name":"双路放大与面部回贴","desc":"整图走 UltimateSDUpscale 低噪分块放大做底版，脸部按遮罩切出走 LDSR 超分，再用模糊加腐蚀的羽化遮罩贴回，避免接缝和脸部细节损失。","nodes":["242","230","235","234","232","273","286","276","244","313","314","294"]},{"name":"眼部修复与成品","desc":"Eyes.pt 检测眼部出遮罩，FaceDetailer 对眼部单独重采，把修好的眼部按遮罩混回成品，解决回贴脸常见的眼睛劣化。","nodes":["302","325","326","305","319","308","309","310","318","333"]}],"p":"主生成 20 步 cfg 8、hires 段 35 步 denoise 0.7 决定基础画质；UltimateSDUpscale 的 denoise 0.2 只做放大细化，调高会让换好的脸漂移；FaceDetailer denoise 0.5 针对眼部，修眼过度会不自然，可降到 0.35 左右。","n":"依赖模型很多：analogMadness 主模、inswapper_128.onnx、retinaface_resnet50、GFPGANv1.4、LDSR 的 last.ckpt、4x_foolhardy_Remacri、bbox/Eyes.pt、sam_vit_b，缺一不可跑；换脸源图需在 LoadImage 节点上传；三个 SaveImage 分别输出换脸原版（FaceOriginal）、回贴版（FaceSwap）与修眼版（FaceEyeFix），取用别拿错。"}}