:-434,"inputs":[],"outputs":[{"name":"birefnet_model","type":"BIREFNET_MODEL"}],"widgets":["RMBG-2.0"],"brief":"图层样式合成节点。（LayerMask: LoadBiRefNetModelV2）","desc":""}],"links":[{"from":"99","fromOut":0,"to":"98","toIn":1},{"from":"98","fromOut":0,"to":"100","toIn":0},{"from":"42","fromOut":0,"to":"98","toIn":0},{"from":"101","fromOut":0,"to":"102","toIn":1},{"from":"102","fromOut":0,"to":"103","toIn":0},{"from":"97","fromOut":0,"to":"102","toIn":0},{"from":"125","fromOut":0,"to":"108","toIn":0},{"from":"110","fromOut":0,"to":"108","toIn":1},{"from":"109","fromOut":0,"to":"110","toIn":0},{"from":"126","fromOut":0,"to":"110","toIn":1},{"from":"123","fromOut":0,"to":"111","toIn":0},{"from":"126","fromOut":0,"to":"111","toIn":1},{"from":"123","fromOut":0,"to":"112","toIn":0},{"from":"118","fromOut":0,"to":"112","toIn":1},{"from":"112","fromOut":0,"to":"113","toIn":0},{"from":"126","fromOut":0,"to":"113","toIn":1},{"from":"122","fromOut":0,"to":"114","toIn":0},{"from":"108","fromOut":0,"to":"114","toIn":1},{"from":"126","fromOut":0,"to":"116","toIn":0},{"from":"124","fromOut":0,"to":"118","toIn":0},{"from":"114","fromOut":0,"to":"118","toIn":1},{"from":"111","fromOut":0,"to":"118","toIn":3},{"from":"126","fromOut":1,"to":"118","toIn":10},{"from":"126","fromOut":2,"to":"118","toIn":11},{"from":"125","fromOut":0,"to":"122","toIn":0},{"from":"110","fromOut":0,"to":"122","toIn":1},{"from":"115","fromOut":0,"to":"124","toIn":0},{"from":"117","fromOut":0,"to":"124","toIn":1},{"from":"98","fromOut":0,"to":"128","toIn":0},{"from":"102","fromOut":0,"to":"129","toIn":0},{"from":"129","fromOut":0,"to":"127","toIn":1},{"from":"128","fromOut":0,"to":"127","toIn":0},{"from":"128","fromOut":0,"to":"130","toIn":0},{"from":"129","fromOut":0,"to":"131","toIn":0},{"from":"127","fromOut":0,"to":"126","toIn":0},{"from":"133","fromOut":0,"to":"122","toIn":2},{"from":"112","fromOut":0,"to":"140","toIn":0},{"from":"113","fromOut":0,"to":"142","toIn":0},{"from":"142","fromOut":0,"to":"120","toIn":0}],"ai":{"s":"HunyuanCustom 多主体视频一致性工作流：两张参考图各走一条 BiRefNet（RMBG-2.0）抠图支线得到干净主体，TTP_Expand_And_Mask 把主体展开到白底画布后左右拼成一张参考大图；这张图统一缩到 896x512 后兵分三路——CLIP-Vision 编码成图像语义、HyVideoEncode 编成图像潜空间条件、并进文本编码器。提示词由 CR Prompt Text 统一供词（'A woman is holding the bag'），正负条件经 HyVideoTextEmbedBridge 打包，guidance 2 是 Hunyuan 视频的惯例值，clip_l + llava_llama3 双 CLIP 是其固定搭配。Hunyuan Custom 720p fp8 模型先叠 20 块 Block Swap 再由 HyVideoSampler 采 85 帧、30 步，解码成视频；一路直接经 VHS 导出，另一路把参考图拼到每帧下方生成对照视频，方便逐帧检查主体一致性。多主体能成立，靠的就是先抠图、再同画布拼合这个预处理，模型才能同时认出两个参考对象。torch compile 提速支线默认旁路。","u":["让两个指定人物/物品同时出现在一段视频里并保持外观一致（换装、换场景）","给商品做视频：主体图抠底后按提示词演一段持物、展示的动作","参考图与成片并排导出的对照视频，逐帧验收主体一致性","HunyuanCustom 多主体的标准预处理模板：双抠图支线加白底拼合可直接复用"],"d":3,"st":[{"name":"双主体抠图","desc":"两张参考图各自加载一份 BiRefNet 模型做背景移除，得到边缘干净的主体抠图，两路互不干扰。","nodes":["97","42","99","101","98","102","100","103"]},{"name":"参考画布与图像条件","desc":"主体各自展开到白底统一画幅后左右拼合，缩放到 896x512，再由 HyVideoEncode 编成图像潜空间条件，是多主体一致性的物理基础。","nodes":["128","129","127","126","116","111","123"]},{"name":"语义条件编码","desc":"拼合参考图经 CLIP-Vision 提语义，与双 CLIP 编码的正负提示词一起打包成 Hunyuan 采样器要的 embeds，文本描述两主体的互动动作。","nodes":["109","110","125","133","122","108","114"]},{"name":"模型装配","desc":"Hunyuan Custom 720p fp8 加载时接 20 块 Block Swap 压显存峰值；torch compile 设置默认旁路，需要提速时再启用。","nodes":["124","117","115"]},{"name":"采样与视频导出","desc":"85 帧、30 步采样后解码，一路直接导出成片，另一路把参考图拼接到每帧下方做对照视频再导出。","nodes":["118","112","113","142","120","140"]}],"p":"85 帧（约 3.5 秒）、30 步、guidance 2 是 Hunyuan 视频惯例起步值，画面不稳先加步数；参考画布 896x512 决定视频比例，改动要同时保持 16 倍数；提示词只写动作与互动，主体外观交给参考图，不要在文本里重复描述长相。","n":"模型文件多：Hunyuan Custom 720p fp8、clip_l、llava_llama3 文本与视觉两份、Hunyuan VAE、BiRefNet(RMBG-2.0) 都要提前就位；显存压力大，Block Swap 已开但建议 16GB 以上；torch compile 支线默认旁路，开启后首次运行要等编译。"}}