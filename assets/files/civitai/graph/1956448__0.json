outputs":[{"name":"CONDITIONING","type":"CONDITIONING"}],"widgets":["1","multiply"],"brief":"Redux 把服装视觉特征注入条件，强度 1","desc":""}],"links":[{"from":"31","fromOut":0,"to":"8","toIn":0},{"from":"35","fromOut":0,"to":"31","toIn":1},{"from":"37","fromOut":0,"to":"31","toIn":0},{"from":"38","fromOut":0,"to":"6","toIn":0},{"from":"39","fromOut":0,"to":"8","toIn":1},{"from":"39","fromOut":0,"to":"124","toIn":1},{"from":"6","fromOut":0,"to":"135","toIn":0},{"from":"135","fromOut":0,"to":"31","toIn":2},{"from":"124","fromOut":0,"to":"177","toIn":1},{"from":"6","fromOut":0,"to":"177","toIn":0},{"from":"8","fromOut":0,"to":"198","toIn":0},{"from":"200","fromOut":3,"to":"31","toIn":4},{"from":"39","fromOut":0,"to":"206","toIn":1},{"from":"206","fromOut":0,"to":"31","toIn":3},{"from":"245","fromOut":0,"to":"246","toIn":1},{"from":"246","fromOut":0,"to":"124","toIn":0},{"from":"252","fromOut":0,"to":"253","toIn":1},{"from":"252","fromOut":0,"to":"254","toIn":1},{"from":"42","fromOut":0,"to":"253","toIn":0},{"from":"253","fromOut":0,"to":"246","toIn":0},{"from":"245","fromOut":0,"to":"254","toIn":0},{"from":"254","fromOut":0,"to":"206","toIn":0},{"from":"8","fromOut":0,"to":"256","toIn":0},{"from":"205","fromOut":0,"to":"274","toIn":1},{"from":"190","fromOut":0,"to":"274","toIn":0},{"from":"274","fromOut":0,"to":"245","toIn":0},{"from":"190","fromOut":0,"to":"278","toIn":0},{"from":"278","fromOut":0,"to":"275","toIn":3},{"from":"278","fromOut":1,"to":"275","toIn":4},{"from":"190","fromOut":0,"to":"279","toIn":0},{"from":"275","fromOut":0,"to":"279","toIn":1},{"from":"190","fromOut":1,"to":"280","toIn":0},{"from":"280","fromOut":0,"to":"279","toIn":2},{"from":"279","fromOut":0,"to":"42","toIn":0},{"from":"308","fromOut":0,"to":"309","toIn":0},{"from":"312","fromOut":0,"to":"311","toIn":1},{"from":"309","fromOut":0,"to":"311","toIn":2},{"from":"205","fromOut":0,"to":"313","toIn":0},{"from":"313","fromOut":0,"to":"309","toIn":1},{"from":"177","fromOut":0,"to":"311","toIn":0},{"from":"311","fromOut":0,"to":"35","toIn":0}],"ai":{"s":"Flux Kontext 双参考虚拟试衣工作流。人物图先涂遮罩并经 Mask Fill Holes 填洞，再把同尺寸纯灰画布合成进遮罩区做成灰衣人，提示词据此要求 replace the grey area；灰衣人与规范化后的服装图左右拼接成一张双参考图，VAEEncode 后由 ReferenceLatent 挂进条件——Kontext 的多参考机制要求参考内容同图呈现才能被注意力读到。服装图另走 Redux 支线：sigclip 视觉编码加 flux1-redux-dev 的 StyleModelApply 把服装特征注入条件，双保险让版型花色严格还原。初始潜空间取自按人物尺寸规范化的服装图，denoise 1.0 下只负责定画布尺寸；FluxGuidance 2.5、负向清零、20 步 euler 采样后解码预览，SaveImage 默认静音只出不存。","u":["给照片里的人换上指定服装：人物图涂遮罩，服装图用商品图或平铺图即可","虚拟试衣批量过款：锁种子只换 Garment Ref，快速对比同一人穿不同衣服","要求服装 logo、花纹、版型严格还原时，靠 Redux 支线防止细节走样","作为 Kontext 多参考模板改造：把第二参考换成发型、配饰等其他元素"],"d":3,"st":[{"name":"输入与灰衣合成","desc":"读出人物图尺寸生成同宽高纯灰画布，遮罩填洞后把灰色合成到人物被涂区域——灰色是给 Kontext 的明确标记：这里就是要换装的位置。","nodes":["190","205","278","275","280","279","274","42"]},{"name":"双参考拼接与编码","desc":"服装图对齐人物尺寸后与灰衣人左右拼接成单张参考图，编码成潜像交给 ReferenceLatent；降采样旋钮统一控显存。","nodes":["245","253","254","252","246","124","177"]},{"name":"服装 Redux 支线","desc":"服装图压到 1 百万像素后过 sigclip 视觉编码与 Redux 风格模型，把服装的视觉特征直接写进条件，弥补单靠参考图的细节损失。","nodes":["313","308","312","309","311"]},{"name":"条件与采样","desc":"Kontext fp8 主干配双 CLIP 编码，正向条件叠加参考潜像与 Redux 特征后经 FluxGuidance 定引导，负向清零是 Flux 固有接法；初始潜像在 denoise 1.0 下只提供画布尺寸。","nodes":["38","37","39","6","135","35","200","31","206"]},{"name":"解码与输出","desc":"VAE 解码回图像后进预览；SaveImage 默认静音，需要落盘时手动启用。","nodes":["8","198","256"]}],"p":"FluxGuidance 2.5 是 Kontext 改图的稳妥引导值，过高易过饱和；20 步、cfg 1、euler 加 simple 调度为模板默认，够用不必加；Redux 的 strength 1（multiply）控制服装还原度，发现衣服抢过人物姿态可降到 0.8 左右。","n":"需在 Human Ref 的 LoadImage 里提前涂出服装区域遮罩，灰膜据此生成；fp8 Kontext 约需 8-12GB 显存；flux1-redux-dev、sigclip_vision_patch14_384、ae.sft 等模型需另下；SaveImage 默认静音，只出预览不存图。"}}