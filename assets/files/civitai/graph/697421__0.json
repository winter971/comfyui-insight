61","toIn":0},{"from":"160","fromOut":0,"to":"161","toIn":1},{"from":"160","fromOut":0,"to":"157","toIn":1},{"from":"161","fromOut":0,"to":"133","toIn":1},{"from":"144","fromOut":0,"to":"39","toIn":3},{"from":"162","fromOut":0,"to":"163","toIn":5},{"from":"6","fromOut":0,"to":"163","toIn":2},{"from":"89","fromOut":0,"to":"163","toIn":3},{"from":"10","fromOut":0,"to":"163","toIn":4},{"from":"127","fromOut":0,"to":"163","toIn":1},{"from":"163","fromOut":0,"to":"165","toIn":0},{"from":"165","fromOut":0,"to":"164","toIn":0},{"from":"166","fromOut":0,"to":"163","toIn":0},{"from":"39","fromOut":5,"to":"166","toIn":0},{"from":"166","fromOut":1,"to":"163","toIn":6},{"from":"166","fromOut":2,"to":"163","toIn":7},{"from":"166","fromOut":3,"to":"163","toIn":8},{"from":"167","fromOut":0,"to":"48","toIn":0},{"from":"167","fromOut":1,"to":"48","toIn":1},{"from":"168","fromOut":0,"to":"5","toIn":0},{"from":"169","fromOut":0,"to":"5","toIn":1},{"from":"168","fromOut":0,"to":"143","toIn":4},{"from":"169","fromOut":0,"to":"143","toIn":5},{"from":"134","fromOut":0,"to":"170","toIn":0},{"from":"170","fromOut":0,"to":"143","toIn":0},{"from":"170","fromOut":1,"to":"143","toIn":2},{"from":"170","fromOut":2,"to":"143","toIn":3},{"from":"144","fromOut":0,"to":"171","toIn":0},{"from":"5","fromOut":0,"to":"171","toIn":1}],"ai":{"s":"Binx 的 Flux.1-dev 图生图 + GPT 反推提示词 + 分块放大三合一。主线：LoadImage 读图后由 GetImageSizeAndCount 报出实际尺寸，ImageResizeKJ 按 width/height 两个 Primitive 统一到 1024x1280 再 VAEEncode 成潜空间，Switch 决定走 img2img 还是纯文生图的空潜空间，交给 KSampler (Efficient)（25 步、CFG 1、euler/beta、denoise 0.85）。提示词可走 GPT 支线：指令模板与手写关键词经 JWStringConcat 拼接喂给 OpenAI 视觉模型反推扩写，Switch 决定用 GPT 结果还是手写词，负向条件固定不变。模型侧留了实验性融合支线：RevUltaMerge checkpoint 过强度 10 的 LoRA 后经 ModelMergeFlux1 与 Flux 主干逐块混合、CLIPMergeSimple 混编码器，两个 Switch 默认关闭融合、直接用原始 Flux。首图锐化保存一份后切成 2x2 分片送 UltimateSDUpscale（4x-UltraSharp、denoise 0.45）分块重绘放大，再锐化二次保存。","u":["把已有图片交给 Flux 做保持构图的风格化重绘（img2img，denoise 0.85）","不想自己写提示词：让 GPT 看图反推并扩写成完整描述","出图后直接 2K 级放大：UltimateSDUpscale 分块重绘，普通显存也能跑","实验把 Flux 与其他 checkpoint/LoRA 融合出新模型（默认关闭，需手动开 Switch）"],"d":3,"st":[{"name":"图像输入与尺寸对齐","desc":"读图并报出实际宽高，按 Primitive 目标值缩放到 1024x1280 再编码成潜空间，保证 img2img 分辨率可控。","nodes":["134","170","168","169","143","144"]},{"name":"提示词生成","desc":"指令模板与手写关键词拼接后交给 OpenAI 视觉模型反推扩写；Switch 在 GPT 结果与纯手写提示词间二选一，正负两路编码。","nodes":["156","160","161","133","157","135","6","89"]},{"name":"模型组装与可选融合","desc":"默认直接用 Flux fp8 主干与双 CLIP；融合支线把 RevUltaMerge 过 LoRA 后与 Flux 逐块混合，Bypasser 与两个 Switch 控制是否启用，融合用完即弃不影响原文件。","nodes":["127","129","167","48","130","132","141","142","147"]},{"name":"采样","desc":"Switch 在 img2img 潜空间与空潜空间间选择，Seed 节点统一管理随机数，KSampler (Efficient) 一步完成采样并给 latent2rgb 预览。","nodes":["171","5","128","39"]},{"name":"锐化与分块放大","desc":"首图轻锐化先存一份；切成 2x2 分片后由 UltimateSDUpscale 配 4x-UltraSharp 低重绘幅逐块放大保细节，二次锐化后保存成图。","nodes":["150","90","166","162","163","165","164"]}],"p":"img2img 的还原度看 KSampler 的 denoise 0.85（想更贴原图就往下降）；放大质量看 UltimateSDUpscale 的 denoise 0.45 与 15 步，伪影多就降到 0.3-0.35；Flux 全程 CFG 1，别调高；目标分辨率改 width/height 两个 Primitive 即可，空潜空间与缩放会一起变。","n":"GPT 反推支线要配置 OpenAI API Key 并联网，没有 Key 就把 Use_GPT_Prompts? 切到 false 用手写词；LoRA 强度 10 只服务于模型融合实验，属极端值；融合支线需另下 RevUltaMerge checkpoint 与 PsyAI LoRA；放大走 4x-UltraSharp 需另下模型文件。"}}