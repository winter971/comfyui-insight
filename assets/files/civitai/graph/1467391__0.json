},{"from":"1","fromOut":2,"to":"17","toIn":4},{"from":"118","fromOut":0,"to":"17","toIn":6},{"from":"116","fromOut":0,"to":"29","toIn":1},{"from":"10","fromOut":0,"to":"29","toIn":2},{"from":"118","fromOut":0,"to":"29","toIn":4},{"from":"147","fromOut":0,"to":"116","toIn":0},{"from":"116","fromOut":0,"to":"122","toIn":2},{"from":"10","fromOut":0,"to":"122","toIn":3},{"from":"1","fromOut":2,"to":"122","toIn":4},{"from":"118","fromOut":0,"to":"122","toIn":6},{"from":"147","fromOut":0,"to":"10","toIn":0},{"from":"118","fromOut":0,"to":"44","toIn":3},{"from":"152","fromOut":0,"to":"150","toIn":0},{"from":"150","fromOut":0,"to":"67","toIn":0},{"from":"116","fromOut":0,"to":"67","toIn":1},{"from":"10","fromOut":0,"to":"67","toIn":2},{"from":"1","fromOut":2,"to":"67","toIn":4},{"from":"118","fromOut":0,"to":"67","toIn":6},{"from":"150","fromOut":0,"to":"17","toIn":1},{"from":"116","fromOut":0,"to":"17","toIn":2},{"from":"10","fromOut":0,"to":"17","toIn":3},{"from":"1","fromOut":2,"to":"17","toIn":4},{"from":"118","fromOut":0,"to":"17","toIn":6},{"from":"150","fromOut":0,"to":"29","toIn":0},{"from":"116","fromOut":0,"to":"29","toIn":1},{"from":"10","fromOut":0,"to":"29","toIn":2},{"from":"118","fromOut":0,"to":"29","toIn":4},{"from":"147","fromOut":0,"to":"116","toIn":0},{"from":"150","fromOut":0,"to":"122","toIn":1},{"from":"116","fromOut":0,"to":"122","toIn":2},{"from":"10","fromOut":0,"to":"122","toIn":3},{"from":"1","fromOut":2,"to":"122","toIn":4},{"from":"118","fromOut":0,"to":"122","toIn":6},{"from":"147","fromOut":0,"to":"10","toIn":0},{"from":"118","fromOut":0,"to":"44","toIn":3},{"from":"150","fromOut":0,"to":"67","toIn":0},{"from":"116","fromOut":0,"to":"67","toIn":1},{"from":"10","fromOut":0,"to":"67","toIn":2},{"from":"1","fromOut":2,"to":"67","toIn":4},{"from":"118","fromOut":0,"to":"67","toIn":6},{"from":"150","fromOut":0,"to":"17","toIn":1},{"from":"116","fromOut":0,"to":"17","toIn":2},{"from":"10","fromOut":0,"to":"17","toIn":3},{"from":"1","fromOut":2,"to":"17","toIn":4},{"from":"118","fromOut":0,"to":"17","toIn":6},{"from":"150","fromOut":0,"to":"28","toIn":0},{"from":"116","fromOut":0,"to":"29","toIn":1},{"from":"10","fromOut":0,"to":"29","toIn":2},{"from":"118","fromOut":0,"to":"29","toIn":4},{"from":"147","fromOut":0,"to":"116","toIn":0},{"from":"150","fromOut":0,"to":"122","toIn":1},{"from":"116","fromOut":0,"to":"122","toIn":2},{"from":"10","fromOut":0,"to":"122","toIn":3},{"from":"1","fromOut":2,"to":"122","toIn":4},{"from":"118","fromOut":0,"to":"122","toIn":6},{"from":"147","fromOut":0,"to":"10","toIn":0},{"from":"118","fromOut":0,"to":"44","toIn":3},{"from":"150","fromOut":0,"to":"67","toIn":0},{"from":"116","fromOut":0,"to":"67","toIn":1},{"from":"10","fromOut":0,"to":"67","toIn":2},{"from":"1","fromOut":2,"to":"67","toIn":4},{"from":"118","fromOut":0,"to":"67","toIn":6},{"from":"150","fromOut":0,"to":"17","toIn":1},{"from":"116","fromOut":0,"to":"17","toIn":2},{"from":"10","fromOut":0,"to":"17","toIn":3},{"from":"1","fromOut":2,"to":"17","toIn":4},{"from":"118","fromOut":0,"to":"17","toIn":6},{"from":"150","fromOut":0,"to":"28","toIn":0},{"from":"116","fromOut":0,"to":"29","toIn":1},{"from":"10","fromOut":0,"to":"29","toIn":2},{"from":"118","fromOut":0,"to":"29","toIn":4},{"from":"147","fromOut":0,"to":"116","toIn":0},{"from":"150","fromOut":0,"to":"122","toIn":1},{"from":"116","fromOut":0,"to":"122","toIn":2},{"from":"10","fromOut":0,"to":"122","toIn":3},{"from":"1","fromOut":2,"to":"122","toIn":4},{"from":"118","fromOut":0,"to":"122","toIn":6},{"from":"147","fromOut":0,"to":"10","toIn":0},{"from":"118","fromOut":0,"to":"44","toIn":3},{"from":"162","fromOut":0,"to":"163","toIn":0},{"from":"161","fromOut":0,"to":"163","toIn":1},{"from":"160","fromOut":0,"to":"163","toIn":2},{"from":"162","fromOut":1,"to":"164","toIn":0},{"from":"161","fromOut":0,"to":"164","toIn":1},{"from":"160","fromOut":0,"to":"164","toIn":2},{"from":"129","fromOut":0,"to":"162","toIn":0},{"from":"160","fromOut":0,"to":"122","toIn":4},{"from":"163","fromOut":0,"to":"122","toIn":2},{"from":"164","fromOut":0,"to":"122","toIn":3},{"from":"150","fromOut":0,"to":"149","toIn":0},{"from":"1","fromOut":0,"to":"152","toIn":0},{"from":"169","fromOut":0,"to":"117","toIn":0},{"from":"149","fromOut":0,"to":"169","toIn":0},{"from":"1","fromOut":0,"to":"67","toIn":0},{"from":"116","fromOut":0,"to":"67","toIn":1},{"from":"10","fromOut":0,"to":"67","toIn":2},{"from":"1","fromOut":2,"to":"67","toIn":4},{"from":"118","fromOut":0,"to":"67","toIn":6},{"from":"1","fromOut":0,"to":"17","toIn":1},{"from":"116","fromOut":0,"to":"17","toIn":2},{"from":"10","fromOut":0,"to":"17","toIn":3},{"from":"1","fromOut":2,"to":"17","toIn":4},{"from":"118","fromOut":0,"to":"17","toIn":6},{"from":"147","fromOut":0,"to":"116","toIn":0},{"from":"1","fromOut":0,"to":"122","toIn":1},{"from":"116","fromOut":0,"to":"122","toIn":2},{"from":"10","fromOut":0,"to":"122","toIn":3},{"from":"1","fromOut":2,"to":"122","toIn":4},{"from":"118","fromOut":0,"to":"122","toIn":6},{"from":"147","fromOut":0,"to":"10","toIn":0},{"from":"118","fromOut":0,"to":"44","toIn":3}],"ai":{"s":"本工作流是专为 Illustrious-XL（动漫领域顶流 SDXL 衍生基模）量身定制的高阶工业级二次元绘图与精修旗舰管线。主干链路采用「Illustrious-XL 底座加载协同 PAG（扰动注意力引导）与 Skimmed CFG 增强 ➔ TIPO（二次元专精提示词大模型）智能扩写 ➔ Anything Everywhere 无线拓扑广播 ➔ 精炼厂式两阶段分步潜空间采样（Sampling 1 构图 + Sampling 2 精炼） ➔ 面部/眼部双级 YOLO+Detailer 级联重绘 ➔ 管道化蒙版重绘（MaskDetailerPipe） ➔ 基于数学表达式动态计算瓦片的 Ultimate SD Upscale 切块平铺超分」的现代化无飞线闭环。工作流彻底摆脱了复杂的连线缠绕，在保持高可读性的同时，将二次元人物立绘的五官精致度、睫毛虹膜光影与 4K 巨幅印刷质感推向极致。","u":["顶级二次元角色立绘与插画创作：借助 Illustrious-XL 的二次元原生表现力与 TIPO 智能扩写，快速产出动作张力强、服饰细节丰富的原画级作品。","面部崩坏与眼部微观结构深度修复：通过面部+眼部两级 YOLO 检测器与专用 Detailer，彻底根除远景小脸与复杂角度下的眼睛不对称、死鱼眼与五官扭曲。","4K 商业海报级动态瓦片超分辨率重绘：结合动态数学公式自适应计算切块尺寸，利用 Ultimate SD Upscale 消除重叠缝隙，输出极高清晰度的动漫壁纸。"],"d":2,"st":[{"name":"阶段一：模型底座加载与注意力引导增强配置","desc":"通过 CheckpointLoaderSimple 载入 Illustrious-XL 官方或微调底模，利用 CLIPSetLastLayer 设定层深为 -2；同时预留 LoRA 加载接口，挂载 PerturbedAttentionGuidance（PAG 扰动注意力引导）与 Skimmed CFG，在注意力底层抑制动漫形体畸变并平抑高 CFG 带来的色彩过曝断层。","nodes":["1","147","169","28","152","149","150","70","71","154","156"]},{"name":"阶段二：TIPO 智能提示词扩写与无线广播总线","desc":"引入专门针对动漫 Tag 训练的轻量级语言大模型 TIPO（Text to Image Prompt Optimizer），根据用户输入的极简基础词自动补全高质量构图、光影与服饰词条，并通过 ShowText 实时预览；搭配 Prompts Everywhere、Anything Everywhere3 与 Seed Everywhere 构建无飞线全局总线，将条件无损分发到所有采样器。","nodes":["44","45","167","39","140","10","116","6","115","117","118"]},{"name":"阶段三：双阶精炼式潜空间采样生成","desc":"构建“精炼厂（Refinery）”式分步采样架构。由 easy int 集中调控总步数（如 28 步）与切换断点（Switch At，如 20 步）；第一阶段 KSamplerAdvanced (Sampling 1) 负责从纯噪波构建宏观姿态与场景分布，随后无缝衔接至第二阶段 KSampler Adv. (Efficient) (Sampling 2) 执行残差去噪与微观光影精炼收敛，输出初始高清原图。","nodes":["78","79","74","29","67","68","60","21","158","159"]},{"name":"阶段四：面部与眼部双级语义精修","desc":"基于 Impact Pack 构建阶梯式双重局部精修流水线。第一级通过面部 YOLO 检测模型定位脸部轮廓，执行 FaceDetailer 基础面容修形；第二级通过眼部专用检测模型捕捉双眼局部，输入专属眼部提示词进行二次微步数超分辨率重绘，确保动漫眼睛特有的复杂虹膜反光与睫毛线条极致清晰。","nodes":["36","37","42","46","82","84","87","86","85","83","90","91"]},{"name":"阶段五：管道化蒙版精准局部重绘","desc":"独立配备基于 ToBasicPipe 的 MaskDetailerPipe 局部重绘分支，允许创作者导入特定图像与自定义绘制蒙版，在不干扰全局构图的前提下，对破损的手指、穿模的衣物或背景杂质执行定向重绘与边缘无缝融合。","nodes":["102","98","110","109","111","97","96","100","112"]},{"name":"阶段六：动态瓦片超分辨率切块重绘矩阵","desc":"集成两条并行的 UltimateSDUpscale 切块放大链路（分别支持主生图与外部大图）。创新性地引入 MathExpression 节点，根据原图宽高与指定的行列数（Row/Col number）动态除算并自适应生成最佳 Tile 瓦片宽度与高度，彻底解决切块重绘边界缝隙撕裂与重复肢体伪影，输出出版级壁纸大图。","nodes":["14","145","142","141","143","144","17","137","123","160","161","162","163","164","122","120","121","129","132","165"]},{"name":"阶段七：全局极速旁路流控中枢","desc":"由 rgthree Fast Groups Bypasser 统揽全局，将 TIPO 扩写、分步采样、面部精修、眼部精修、蒙版修复及切块超分等耗时重型组映射为单键开关，支持在文生图构图快筛与精修最终成片之间灵活瞬时切换。","nodes":["113"]}],"p":"1. 采样步数与切分设置：推荐总步数（Total Step）设为 26-30 步；切换步数（Switch At）设为 18-22 步（即约 70% 节点切换至 Sampling 2）；采样器推荐使用 dpmpp_2m 或 euler，调度器设为 karras 或 exponential。\n2. PAG 与 CFG 配置：启用 PerturbedAttentionGuidance 时，PAG scale 建议设为 1.5-2.5（过高易导致色块发硬）；基础 CFG 建议设在 5.0-6.5 之间，配合 Skimmed CFG 可有效避免二次元线条过度焦化。\n3. 局部精修去噪幅度：FaceDetailer 去噪幅度（Denoise）建议设为 0.35-0.40；眼部专用 Detailer 的 Denoise 建议控制在 0.25-0.35，避免过大变动导致画风与原脸脱节。\n4. 切块放大尺寸：Ultimate SD Upscale 放大倍率（Upscale by）设为 1.5x-2.0x，Denoise 建议 0.25-0.30；行列数（Row/Col number）设为 2 或 3，切块重叠边缘（Padding/Mask Blur）设为 32-48 像素。","t":["TIPO 智能提示词扩写调优：TIPO 节点能大幅扩充画面细节，但在输入原始 Prompt 时避免堆叠过多相互冲突的质量 Tag（如 masterpiece, best quality 重复），只需输入核心角色名、动作与核心特征，交由 TIPO 自动平衡权重，出图自然度会大幅提升。","无线广播 Everywhere 节点防穿透技巧：工作流广泛采用了 Anything Everywhere 广播，若在画布上新增其他需要独立条件/潜空间的测试分支，需使用非标准端口或使用 Reroute 显式连线隔断，以免被全局广播的潜空间与提示词意外覆盖。","分步采样与旁路快筛组合策略：在抽卡阶段，建议在 Fast Groups Bypasser 中先旁路关闭 FaceDetailer、EyeDetailer 与 UltimateSDUpscale，并将 Switch At 调满直接跑 Sampling 1；待选中心仪的角色构图与种子后，再开启精炼采样与双重局部精修输出终极成片。"],"n":"本工作流基于 Illustrious-XL 架构设计，底模推荐使用 Illustrious-XL v0.1 或对应微调动漫模型；显存建议 12GB（如 RTX 3060/4070）及以上；必须通过 ComfyUI-Manager 安装 ComfyUI-Impact-Pack、rgthree-comfy、ComfyUI-TIPO-Extension、ComfyUI-Custom-Scripts 与 Ultimate-SD-Upscale 扩展包，并在 models/ultralytics 目录下配置 face_yolov8m 与眼部专用检测模型权重。","na":{"1":{"brief":"Illustrious-XL 主底模加载器","detail":"加载以动漫、二次元插画见长的 Illustrious-XL（SDXL 衍生）核心大模型，输出全流程所需的主干扩散网络（MODEL）与底层双 CLIP 特征。"},"17":{"brief":"动态切块超分辨率重绘核心","detail":"结合前置数学表达式动态计算的最佳瓦片尺寸，对放大后的巨幅图像执行切块重绘与无缝拼接，成倍增强原画纹理且避免产生重复伪影。"},"28":{"brief":"PAG 扰动注意力引导控制器","detail":"在 Diffusion 注意力矩阵中引入微小高斯扰动并计算残差，显著增强二次元人物五官轮廓与肢体结构的几何一致性，降低画面畸变率。"},"29":{"brief":"第一阶段基模高级采样器","detail":"负责从初始噪声潜空间执行宏观构图生成，在指定的断点步数（Switch At）停止并返回中间潜状态，为后续精炼提供高保真框架。"},"37":{"brief":"面部自动语义检测与精修器","detail":"结合 YOLO 检测框自动裁切面部，并在提取的高分辨率子画布上基于正负提示词进行局部去噪重绘，彻底解决远景面部五官模糊问题。"},"44":{"brief":"TIPO 提示词智能扩写大模型","detail":"基于开源小型语言模型构建的二次元图像提示词优化器，根据用户输入的简短关键词，全自动推导并补全符合动漫审美的场景、服饰、光影与构图标签。"},"67":{"brief":"第二阶段精炼高级采样器","detail":"衔接第一阶段未完成的去噪轨迹，专注收敛微观高频细节与色彩层次，以更细腻的步长完成基础图像的终极降噪。"},"84":{"brief":"眼部超精细局部精修器","detail":"第二级局部细化核心，专门针对眼球区域进行微观检测与二次重采样，显著强化虹膜反光、眼睑轮廓与睫毛细节，提升二次元画面的灵魂神采。"},"109":{"brief":"管道化蒙版局部精准重绘核心","detail":"将模型、条件与 VAE 打包进 BasicPipe，根据输入的外部图像与绘制蒙版执行针对性修复，解决特定区域的穿模或伪影缺陷。"},"113":{"brief":"全局模块极速旁路开关 (Fast Groups Bypasser)","detail":"rgthree 提供的全局流控枢纽，支持在画布上一键旁路跳过 TIPO 扩写、双阶采样、局部修脸修眼或切块超分，实现生产调试的敏捷自由切换。"}}}}