fromOut":1,"to":"81","toIn":0},{"from":"19","fromOut":2,"to":"82","toIn":0},{"from":"83","fromOut":0,"to":"36","toIn":0},{"from":"84","fromOut":0,"to":"38","toIn":1},{"from":"85","fromOut":0,"to":"59","toIn":0},{"from":"85","fromOut":0,"to":"60","toIn":0},{"from":"33","fromOut":0,"to":"89","toIn":0},{"from":"90","fromOut":0,"to":"87","toIn":0},{"from":"91","fromOut":0,"to":"87","toIn":1},{"from":"62","fromOut":3,"to":"92","toIn":0},{"from":"92","fromOut":0,"to":"94","toIn":0},{"from":"95","fromOut":0,"to":"92","toIn":1},{"from":"60","fromOut":0,"to":"106","toIn":0},{"from":"59","fromOut":0,"to":"107","toIn":0},{"from":"108","fromOut":0,"to":"62","toIn":1},{"from":"109","fromOut":0,"to":"62","toIn":2},{"from":"124","fromOut":0,"to":"118","toIn":5},{"from":"118","fromOut":0,"to":"125","toIn":0},{"from":"127","fromOut":0,"to":"125","toIn":2},{"from":"125","fromOut":0,"to":"128","toIn":0},{"from":"128","fromOut":0,"to":"129","toIn":0},{"from":"132","fromOut":0,"to":"128","toIn":1},{"from":"135","fromOut":0,"to":"118","toIn":1},{"from":"62","fromOut":0,"to":"136","toIn":0},{"from":"137","fromOut":0,"to":"138","toIn":0},{"from":"131","fromOut":0,"to":"138","toIn":1},{"from":"138","fromOut":0,"to":"139","toIn":0},{"from":"140","fromOut":0,"to":"118","toIn":0},{"from":"141","fromOut":0,"to":"118","toIn":2},{"from":"62","fromOut":3,"to":"142","toIn":0},{"from":"143","fromOut":0,"to":"125","toIn":3},{"from":"128","fromOut":0,"to":"144","toIn":0},{"from":"62","fromOut":1,"to":"148","toIn":0},{"from":"62","fromOut":2,"to":"149","toIn":0},{"from":"150","fromOut":0,"to":"125","toIn":1},{"from":"92","fromOut":0,"to":"151","toIn":0}],"ai":{"s":"两遍式的'替换/移除画面中任意物体'工作流。第一遍：在 LoadImage 的 MaskEditor 里涂遮罩，图像经 ImageScaleBy 缩放后由 VAEEncodeForInpaint 编码（grow_mask 28 外扩边缘防接缝），RealVisXL Lightning 模型挂上 Fooocus inpaint 补丁补偿被遮罩清零的潜空间，KSampler (Efficient) 用 uni_pc + sgm_uniform 15 步在遮罩内重画，先把目标物抹掉或铺底。第二遍把重绘结果当参考图：模型先过 fix_hands、repair_slider 两个修手 LoRA，再由 IPAdapter-plus 配 CLIP-ViT-H 把参考特征注入模型，第二遍 KSampler 照着参考重新合成整幅画面，让替换物吃进原图的光影与质感。正负条件与潜空间经 rgthree Set/Get 在两遍间复用，最终解码保存并与原图左右对比验收。两遍缺一不可：第一遍定内容，第二遍保融合。","u":["把照片里的物体换成别的东西：涂遮罩并写新物体提示词，示例用 (AK47:1.3) 演示，两遍自动融合","抹除画面中的杂物、路人或水印：第一遍 inpaint 清空遮罩区，第二遍按原图风格补全背景","替换物涉及手部时的修图：fix_hands 与 repair_slider LoRA 在第二遍顺带修复手部结构","需要交付前后对比的商业修图：自带 rgthree Image Comparer 左右对比原图与结果"],"d":3,"st":[{"name":"输入与遮罩准备","desc":"在 LoadImage 内涂好遮罩，图像轻缩放后与遮罩一起编码为 inpaint 潜空间，grow_mask 外扩让重绘边界不留硬边；原图同时暂存供最终对比。","nodes":["33","64","38","77","89"]},{"name":"模型与条件编码","desc":"RealVisXL V4.0 Lightning 检查点加载后，Fooocus 重绘补丁写入模型以补偿遮罩区被清零的潜空间；正负提示词编码后经 Set/Get 分发到两遍采样。","nodes":["19","35","36","60","59","106","107"]},{"name":"第一遍遮罩内重绘","desc":"KSampler (Efficient) 以 15 步 uni_pc 在遮罩内重画内容，结果暂存为 inpainted_img 并预览，同时把模型、条件、潜空间转交给第二遍复用。","nodes":["63","62","92","94","151"]},{"name":"第二遍 IPAdapter 重合成","desc":"第一遍的图经 IPAdapter-plus 与 CLIP-ViT-H 作为参考注入，模型先过两个修手 LoRA；第二遍采样照着参考图重新生成，替换物因此带原图光影而非贴图感。","nodes":["135","124","137","138","118","125"]},{"name":"解码保存与对比","desc":"第二遍潜空间解码后按 IPA_ 前缀保存，结果与原图在 Image Comparer 中左右对照，检查替换是否干净、光影是否衔接。","nodes":["128","129","144","87"]}],"p":"Lightning 底模配 uni_pc + sgm_uniform、15 步即可，CFG 2.5/2.1 不要拉高否则会烧图；IPAdapter weight 默认 1，想更贴近原图调低到 0.7-0.8，想更大改动换构图则调低参考图权重；grow_mask 28 保持默认防边缘接缝。","n":"需在 LoadImage 节点右键 MaskEditor 涂遮罩后确认；需安装 rgthree、IPAdapter_plus、Efficiency Nodes 并另下 Fooocus inpaint 补丁、CLIP-ViT-H、ip-adapter-plus_sdxl 与两个手部修复 LoRA；每张图要跑两遍采样，显存和时间翻倍。"}}