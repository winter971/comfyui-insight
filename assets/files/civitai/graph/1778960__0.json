ts":["512","500","0.5"],"brief":"用 SVD 视觉编码处理人像、抽取音频特征，打包成驱动数据","desc":""},{"id":"318","title":"ImageOnlyCheckpointLoader","type":"ImageOnlyCheckpointLoader","cat":"load","x":-399,"y":133,"inputs":[],"outputs":[{"name":"MODEL","type":"MODEL"},{"name":"CLIP_VISION","type":"CLIP_VISION"},{"name":"VAE","type":"VAE"}],"widgets":["svd_xt_1_1.safetensors"],"brief":"SVD 1.1 提供底模、CLIP-Vision 与 VAE","desc":""}],"links":[{"from":"229","fromOut":1,"to":"230","toIn":4},{"from":"229","fromOut":0,"to":"230","toIn":0},{"from":"229","fromOut":0,"to":"231","toIn":0},{"from":"225","fromOut":0,"to":"230","toIn":1},{"from":"257","fromOut":0,"to":"255","toIn":0},{"from":"258","fromOut":0,"to":"256","toIn":0},{"from":"255","fromOut":0,"to":"259","toIn":0},{"from":"256","fromOut":0,"to":"260","toIn":0},{"from":"271","fromOut":0,"to":"269","toIn":0},{"from":"271","fromOut":1,"to":"269","toIn":1},{"from":"272","fromOut":0,"to":"271","toIn":0},{"from":"272","fromOut":1,"to":"271","toIn":1},{"from":"270","fromOut":0,"to":"272","toIn":0},{"from":"273","fromOut":0,"to":"272","toIn":1},{"from":"281","fromOut":0,"to":"252","toIn":0},{"from":"254","fromOut":0,"to":"281","toIn":0},{"from":"286","fromOut":0,"to":"285","toIn":0},{"from":"282","fromOut":0,"to":"286","toIn":0},{"from":"287","fromOut":0,"to":"286","toIn":1},{"from":"292","fromOut":0,"to":"293","toIn":0},{"from":"291","fromOut":0,"to":"293","toIn":1},{"from":"295","fromOut":0,"to":"294","toIn":0},{"from":"297","fromOut":0,"to":"294","toIn":1},{"from":"293","fromOut":0,"to":"298","toIn":0},{"from":"233","fromOut":0,"to":"299","toIn":0},{"from":"300","fromOut":0,"to":"281","toIn":1},{"from":"300","fromOut":0,"to":"233","toIn":0},{"from":"294","fromOut":0,"to":"301","toIn":0},{"from":"263","fromOut":0,"to":"304","toIn":0},{"from":"304","fromOut":0,"to":"306","toIn":0},{"from":"306","fromOut":0,"to":"229","toIn":0},{"from":"226","fromOut":0,"to":"317","toIn":3},{"from":"225","fromOut":0,"to":"317","toIn":2},{"from":"263","fromOut":2,"to":"317","toIn":1},{"from":"263","fromOut":1,"to":"317","toIn":0},{"from":"317","fromOut":0,"to":"229","toIn":1}],"ai":{"s":"T8star 的 Sonic 唱歌数字人工作流：主线四步——人像照片与一段歌声进 SONIC_PreData，借用 SVD 1.1 自带的 CLIP-Vision 与 VAE 编码人像并抽取音频特征；SVD 底模先过 FBCache 首块缓存加速，再由 SONICTLoader 挂上 Sonic 的 unet，SONICSampler 按音频特征逐帧驱动照片里的人开口演唱，25fps 出帧；VHS_VideoCombine 把帧序列与原音频合成为带歌声的视频，PurgeVRAM 收尾清显存。图上一大半节点是被旁路的音频工具箱：CosyVoice 三个 TTS 档（台词已写好）、FreeVC 音色转换、SeedVC 歌声转目标音色、人声伴奏合并，外加一条 LatentSync 对口型后处理线。这些支线决定音频从哪来、成片要不要修口型，按需把对应组切回来即可，主线本身不依赖它们。","u":["让照片里的人开口唱歌：一张正脸照加一段歌声，直接出演唱视频","数字人口播：启用旁路 CosyVoice 组，按台词自动合成语音再驱动人像","把任意歌曲换成指定人声演唱：启用 SeedVC 歌声转换支线","成片口型与音频对不上：启用 LatentSync 支线做对口型修正"],"d":3,"st":[{"name":"输入与音频特征","desc":"载入人像与歌声，SONIC_PreData 用 SVD 的视觉编码器与 VAE 处理人像、抽取音频特征并打包成驱动数据，帧数参数在此决定视频长度。","nodes":["226","225","317"]},{"name":"底模加载与加速","desc":"SVD 1.1 检查点给出底模、CLIP-Vision 与 VAE 三件，FBCache 对扩散模型做首块缓存跳算提速，SONICTLoader 再挂上 Sonic 驱动 unet 并转 fp16。","nodes":["263","304","306"]},{"name":"音频驱动生成","desc":"SONICSampler 拿驱动数据逐帧生成演唱画面，固定种子保证可复现，同时输出帧率供合成端对齐。","nodes":["229"]},{"name":"合成与收尾","desc":"VHS_VideoCombine 把帧序列与 LoadAudio 的原音频封装成视频，歌声与口型天然同步；PurgeVRAM 清理显存防跨任务溢出。","nodes":["230","231"]},{"name":"旁路：语音与歌声工具箱","desc":"全部默认旁路的备选支线：CosyVoice 三档 TTS、FreeVC 音色转换、SeedVC 歌声转音色、人声伴奏合并，以及 VHS 读视频加 LatentSync 对口型的后处理线，启用哪组取决于音频来源与成片要求。","nodes":["233","254","281","293","294","270","272","271"]}],"p":"SONIC_PreData 里的 512/500 控制生成长度，音频多长视频多长，别为了短剪音频后突然截断；SONICSampler 固定 25fps，合成端帧率取自它不要单独改；FBCache 阈值 0.1 越大越快但伪影风险升高；换歌只需换 LoadAudio 文件，口型会跟着新音频走。","n":"需 SVD 1.1（约 9GB）与 Sonic unet.pth，并安装 Sonic、CosyVoice、SeedVC、FreeVC、VHS、FBCache 多个节点包，首次配置成本高；生成唱歌视频前先确认音频可用，想要指定台词必须手动启用 233 所在的 TTS 旁路组；LatentSync 后处理线默认关闭，启用后渲染时间明显增加。"}}