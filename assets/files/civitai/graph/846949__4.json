rom":"25","fromOut":0,"to":"166","toIn":0},{"from":"16","fromOut":0,"to":"166","toIn":2},{"from":"167","fromOut":0,"to":"166","toIn":3},{"from":"31","fromOut":0,"to":"167","toIn":0},{"from":"181","fromOut":0,"to":"180","toIn":1},{"from":"31","fromOut":0,"to":"185","toIn":0},{"from":"75","fromOut":0,"to":"186","toIn":1},{"from":"13","fromOut":0,"to":"189","toIn":0},{"from":"189","fromOut":0,"to":"193","toIn":3},{"from":"75","fromOut":0,"to":"191","toIn":1},{"from":"191","fromOut":0,"to":"193","toIn":1},{"from":"116","fromOut":0,"to":"192","toIn":1},{"from":"192","fromOut":0,"to":"193","toIn":2},{"from":"187","fromOut":0,"to":"193","toIn":0},{"from":"187","fromOut":1,"to":"191","toIn":0},{"from":"187","fromOut":1,"to":"192","toIn":0},{"from":"194","fromOut":0,"to":"195","toIn":0},{"from":"196","fromOut":0,"to":"195","toIn":1},{"from":"184","fromOut":0,"to":"197","toIn":0},{"from":"197","fromOut":0,"to":"173","toIn":0},{"from":"194","fromOut":0,"to":"202","toIn":0},{"from":"198","fromOut":0,"to":"9","toIn":0},{"from":"198","fromOut":0,"to":"202","toIn":1},{"from":"203","fromOut":0,"to":"194","toIn":1},{"from":"184","fromOut":0,"to":"181","toIn":4},{"from":"173","fromOut":0,"to":"198","toIn":0},{"from":"193","fromOut":0,"to":"180","toIn":0},{"from":"180","fromOut":0,"to":"194","toIn":0},{"from":"195","fromOut":0,"to":"166","toIn":4},{"from":"203","fromOut":0,"to":"181","toIn":1},{"from":"187","fromOut":0,"to":"181","toIn":0},{"from":"191","fromOut":0,"to":"181","toIn":2},{"from":"192","fromOut":0,"to":"181","toIn":3},{"from":"166","fromOut":0,"to":"206","toIn":0},{"from":"196","fromOut":0,"to":"206","toIn":1},{"from":"206","fromOut":0,"to":"197","toIn":1}],"ai":{"s":"Ratatoskr Flux 检查点配套的双段出图与可选放大工作流：正向词经带定制 clip_l 的双编码器编码（guidance 2），896x1152 潜空间 15 步 euler 一次出底图；潜空间经 LatentInterposer 转成 XL 格式，先由 SDXL VAE 解码预览、再用 Flux VAE 重新编码，进入第二段 15 步 denoise 0.25 的 Flux 精修——这一转一换让 Flux 与 SDXL 两族模型能在同一条管线里协作。图上多数增强组默认旁路：SDXL 检查点（同作者 V7.3）0.15 去噪精修、迭代潜空间放大、Remacri/DAT 模型放大 2 倍、自动对比度与对比度滤镜，另有一条独立停放的 SUPIR 超分组，全部由 rgthree Fast Groups Bypasser 一键启停。默认状态下第二段精修结果直接保存，并与第一段底图在对比器里并排检查。","u":["直接体验 Ratatoskr Flux 检查点的出图质感，双段采样自动完成精修","要更高分辨率：经 Fast Groups Bypasser 打开 SDXL 精修与迭代放大组","对比底图与成品差异：第一段结果与最终输出在对比器里滑块查看","当 Ratatoskr 系列模型的官方示例模板，替换提示词即用"],"d":2,"st":[{"name":"提示词与条件编码","desc":"同一批文本经四个编码入口分发：Flux 正向带 guidance 2，SDXL 正负向只服务旁路组；Flux 的 BasicGuider 不吃负向，负向编码在主线里自然闲置。","nodes":["56","75","116","71","26","158"]},{"name":"Flux 底图采样","desc":"Flux 检查点（可挂旁路的超写实 LoRA）在 896x1152 潜空间上 15 步全量去噪，噪声、引导、采样器、调度四件套组装进 SamplerCustomAdvanced。","nodes":["31","185","94","25","16","17","22","13"]},{"name":"潜空间格式交接","desc":"LatentInterposer 把 Flux 潜空间转成 XL 格式，SDXL VAE 解码出可看的底图，再用 Flux VAE 重编码回潜空间——没有这一步，第二段 Flux 精修和可选 SDXL 放大都无从谈起。","nodes":["189","194","203","195","196"]},{"name":"Flux 二段精修","desc":"15 步调度只跑到 denoise 0.25，在底图上轻修细节与纹理，改动力度刻意压低。","nodes":["167","166","206"]},{"name":"旁路的 SDXL 精修与放大组","desc":"整组默认停用：SDXL 检查点 0.15 去噪精修，再交迭代潜空间放大（配像素级上采样器）或 Remacri/DAT 模型放大 2 倍，用于冲击高分辨率输出。","nodes":["187","191","192","193","181","180","145","184","197"]},{"name":"滤镜与输出","desc":"自动对比度、对比度两个滤镜默认旁路，最终图直接保存；rgthree 对比器把底图与成品并排，Fast Groups Bypasser 是所有组的总开关面板。","nodes":["173","198","9","202","200"]}],"p":"Flux 段 guidance 2、15 步 euler/simple 是作者调好的档；第二段 denoise 0.25 控制精修力度，嫌变化不够可升到 0.35。分辨率在 SD3LatentSelectRes 里换比例档（默认 896x1152 3:4）。启用 SDXL 精修组时它自带 20 步、CFG 3.5、denoise 0.15 的独立参数，与 Flux 段互不影响。","n":"增强组默认全部旁路，经 Fast Groups Bypasser（节点 200）启停；SUPIR 组只接了 captions、输出悬空，要用需自行补线。需备 RatatoskrFluxV4 与 RatatoskrV7.3 两个检查点、Flux 与 SDXL 两套 VAE、Remacri/DAT 两个上采样模型，开 SUPIR 还要另下 SUPIR-v0Q。旁路的 Flux LoRA（185，超写实 0.5）与滤镜组按需启用。"},"sameAs":"846949__0.json"}