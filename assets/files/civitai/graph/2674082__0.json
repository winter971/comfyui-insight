:1},{"from":"8","fromOut":1,"to":"11","toIn":2},{"from":"8","fromOut":2,"to":"11","toIn":3},{"from":"28","fromOut":0,"to":"11","toIn":4},{"from":"20","fromOut":0,"to":"11","toIn":5},{"from":"4","fromOut":0,"to":"11","toIn":6},{"from":"18","fromOut":0,"to":"17","toIn":0},{"from":"27","fromOut":0,"to":"18","toIn":0},{"from":"8","fromOut":1,"to":"20","toIn":0},{"from":"28","fromOut":0,"to":"22","toIn":1},{"from":"20","fromOut":0,"to":"22","toIn":2},{"from":"24","fromOut":0,"to":"23","toIn":0},{"from":"15","fromOut":0,"to":"24","toIn":0},{"from":"11","fromOut":0,"to":"25","toIn":0},{"from":"8","fromOut":1,"to":"28","toIn":0},{"from":"24","fromOut":1,"to":"16","toIn":0},{"from":"10","fromOut":0,"to":"22","toIn":3},{"from":"24","fromOut":0,"to":"49","toIn":0},{"from":"23","fromOut":0,"to":"49","toIn":1},{"from":"18","fromOut":0,"to":"24","toIn":1},{"from":"7","fromOut":0,"to":"51","toIn":0},{"from":"7","fromOut":1,"to":"51","toIn":1},{"from":"51","fromOut":0,"to":"29","toIn":0},{"from":"51","fromOut":0,"to":"22","toIn":0},{"from":"27","fromOut":0,"to":"52","toIn":1},{"from":"52","fromOut":0,"to":"51","toIn":2},{"from":"52","fromOut":0,"to":"53","toIn":0},{"from":"49","fromOut":0,"to":"66","toIn":0},{"from":"18","fromOut":0,"to":"70","toIn":0},{"from":"23","fromOut":0,"to":"70","toIn":1},{"from":"70","fromOut":0,"to":"52","toIn":0},{"from":"49","fromOut":0,"to":"51","toIn":4},{"from":"8","fromOut":0,"to":"26","toIn":0},{"from":"26","fromOut":0,"to":"76","toIn":0},{"from":"76","fromOut":0,"to":"77","toIn":0},{"from":"77","fromOut":0,"to":"7","toIn":0}],"ai":{"s":"不用 ControlNet 的照片人物重绘工作流：上传照片（自动调色节点默认旁路）后由 SAM3 按文本 girl 直接分割出人物，反相得背景遮罩，再把反相遮罩写进 alpha 通道抠出人物。参考图（抠图或全图）与注意力遮罩（人物或背景）各由一个 Crystools 开关切换，对应作者注记的依人物创作、依背景创作两种模式。IPAdapter plus-face 用选出的参考图与遮罩把长相注入模型，当前为全图加人物遮罩，weight 0.65 只在前 80% 步生效。采样在 816x1136 空白潜空间上进行：构图完全交给提示词，人物身份靠 IPAdapter，这是它不用 ControlNet 也能 I2I 的原因。成图解码后由 FaceDetailer 用 face_yolov8m 找脸、0.4 去噪二次精修再保存。","u":["保留照片人物长相、按新提示词重摆场景：换提示词即可让同一人出现在新构图里","以背景为创作依据的模式：开关切到背景遮罩，让人物融入生成的新场景","给写实人像快速换装换造型：改正向提示词，脸部由 FaceDetailer 自动保真","不想装 ControlNet、不想手涂遮罩的 I2I 用户：SAM3 文本分割一步到位"],"d":3,"st":[{"name":"参考图与 SAM3 分割","desc":"上传照片后用文本提示直接分割人物，免手涂；人物、背景两块遮罩与抠图、全图两条参考通路各由开关二选一，四个预览节点用来核对选择结果。","nodes":["27","18","15","24","23","70","49","52","16","17","53","66"]},{"name":"IPAdapter 身份注入","desc":"底模先穿过三个默认旁路的同款 LoRA 串位，再由 UnifiedLoader 装配 plus-face 适配器；IPAdapterAdvanced 参考开关选出的图与遮罩，把人物特征写进模型注意力。","nodes":["8","26","76","77","7","6","51"]},{"name":"采样","desc":"叠上写实风格 LoRA 后在空白潜空间按提示词生成，构图不依赖原图像素，人物身份完全由 IPAdapter 保证，是这套无 ControlNet 方案的核心取舍。","nodes":["29","10","28","20","22"]},{"name":"面部精修与输出","desc":"整图解码预览后自动检测人脸区域，低去噪二次采样修复远景糊脸，修完才落盘。","nodes":["4","11","3","2","5","25"]}],"p":"IPAdapterAdvanced 的 weight 0.65 与 end_at 0.8 决定像不像、抢不抢构图：太像原照就降 weight，不像就升；主采样 24 步、cfg 4、dpmpp_2m karras 是写实模型的稳妥配置；FaceDetailer 的 denoise 0.4 控制修脸力度，超过 0.5 容易换脸。","n":"attn_mask 连线可按需断开：true 模式下服装出现异色时，作者注记要求断开它；三个 monsterXgirl LoRA 串在同一模型链路上且默认旁路，全部启用会叠加强度；SAM3 模型、face_yolov8m、ip-adapter-plus-face 需另行下载。"}}