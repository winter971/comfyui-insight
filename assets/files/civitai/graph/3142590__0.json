","toIn":1},{"from":"89","fromOut":0,"to":"25","toIn":1},{"from":"5","fromOut":0,"to":"96","toIn":2},{"from":"96","fromOut":0,"to":"89","toIn":0},{"from":"30","fromOut":0,"to":"89","toIn":2},{"from":"102","fromOut":0,"to":"103","toIn":0},{"from":"103","fromOut":0,"to":"26","toIn":1},{"from":"104","fromOut":0,"to":"103","toIn":1},{"from":"105","fromOut":0,"to":"103","toIn":2},{"from":"150","fromOut":0,"to":"64","toIn":0},{"from":"62","fromOut":0,"to":"151","toIn":0},{"from":"62","fromOut":1,"to":"151","toIn":1},{"from":"151","fromOut":3,"to":"84","toIn":4},{"from":"151","fromOut":0,"to":"84","toIn":3},{"from":"84","fromOut":0,"to":"88","toIn":1},{"from":"84","fromOut":1,"to":"88","toIn":2},{"from":"155","fromOut":0,"to":"4","toIn":1},{"from":"73","fromOut":0,"to":"150","toIn":0},{"from":"156","fromOut":0,"to":"72","toIn":0},{"from":"4","fromOut":0,"to":"157","toIn":0},{"from":"3","fromOut":0,"to":"157","toIn":1},{"from":"81","fromOut":0,"to":"157","toIn":2},{"from":"2","fromOut":0,"to":"157","toIn":3},{"from":"150","fromOut":0,"to":"160","toIn":0},{"from":"151","fromOut":0,"to":"160","toIn":1},{"from":"160","fromOut":0,"to":"158","toIn":0},{"from":"164","fromOut":0,"to":"156","toIn":0},{"from":"164","fromOut":0,"to":"150","toIn":2},{"from":"164","fromOut":0,"to":"151","toIn":2},{"from":"121","fromOut":1,"to":"165","toIn":0},{"from":"165","fromOut":0,"to":"156","toIn":1},{"from":"165","fromOut":0,"to":"150","toIn":3},{"from":"165","fromOut":0,"to":"151","toIn":3},{"from":"27","fromOut":0,"to":"25","toIn":2},{"from":"167","fromOut":0,"to":"4","toIn":0},{"from":"171","fromOut":0,"to":"165","toIn":1},{"from":"121","fromOut":0,"to":"164","toIn":0},{"from":"170","fromOut":0,"to":"164","toIn":1},{"from":"177","fromOut":0,"to":"158","toIn":1},{"from":"177","fromOut":0,"to":"172","toIn":0},{"from":"5","fromOut":0,"to":"178","toIn":2},{"from":"25","fromOut":0,"to":"178","toIn":3},{"from":"178","fromOut":0,"to":"177","toIn":0},{"from":"184","fromOut":0,"to":"167","toIn":0}],"ai":{"s":"Z-Image Turbo 三合一模板：t2i、i2i、inpaint 共用一条采样干线，靠分组静音加 Any Switch 切换。模型侧 z_image_turbo_bf16 经空 LoRA 面板与 Shift 滑杆（默认 3）进 ModelSamplingAuraFlow，模型、CLIP(qwen_3_4b lumina2)、风格条件与 VAE 由 Anything Everywhere 免线广播全图。潜空间、Guider、Denoise 各设三选一开关：t2i 用分辨率选择器的空白潜空间加 cfg 1；i2i 把图缩到 2048x1152 再编码，denoise 0.3；inpaint 走 InpaintModelConditioning，带遮罩条件与 denoise 0.64——i2i/inpaint 的 CFGGuider(1.5) 平时被静音，启用对应分组后 Any Switch 自动接通活着的支路，这就是三模式不必改连线的原理。主采样 res_2s 4 步走 SamplerCustomAdvanced，尾部再过 2 步 denoise 0.05 的 KSampler 抛光，解码后与输入图对比、按时间戳保存。","u":["一套图进出搞定文生图、图生图与局部重绘，不用另开工作流","批量出图时用 16:9 等分辨率预设直出 Z-Image Turbo 少步成品","i2i 保留构图只换质感（denoise 0.3 起调），或涂遮罩做局部修改","按作者注释把 Shift 从 3 降到 2 换更贴提示词、更细节的风格"],"d":3,"st":[{"name":"模型与条件广播","desc":"Turbo 主模型经 LoRA 面板与 shift 偏移装配；模型、CLIP、风格条件、VAE 四路用 Anything Everywhere 广播，三套模式分支不用重复拉线。","nodes":["184","167","155","4","3","81","2","157"]},{"name":"潜空间三选一","desc":"t2i 出空白潜空间；i2i 把图缩放到 2048x1152 后编码；inpaint 由 InpaintModelConditioning 产出带遮罩条件的潜空间。Any Switch 只放行未被静音的一路。","nodes":["121","164","165","156","73","150","64","62","151","84"]},{"name":"引导与去噪三选一","desc":"Guider 在 cfg 1（t2i）与 cfg 1.5（i2i/inpaint，平时静音）间切换；Denoise 在 1、0.3、0.64 三档间切换；负向条件统一清零。","nodes":["30","96","88","5","102","104","105","103","26","27","29","83"]},{"name":"采样与抛光","desc":"SamplerCustomAdvanced 跑 res_2s 4 步主采样，再接 2 步 denoise 0.05 的 KSampler 做微调抛光，去高频噪点稳细节。","nodes":["25","178","177"]},{"name":"对比与保存","desc":"缩放后的输入图与成品进 Image Comparer 对比，按时间戳文件名保存。","nodes":["160","158","172"]}],"p":"Shift 滑杆默认 3，作者注释称 2.0 更细节、更贴提示词；t2i 保持 denoise 1 加 cfg 1，i2i 从 0.3 起调、inpaint 从 0.64 起调；4 步 res_2s 主采样加 2 步 0.05 抛光是 Turbo 少步配方，别照搬常规 20 步习惯。","n":"切模式要动两处：Fast Groups Muter 'Whatcha up to?' 选模式分支、'Latent Size' 选尺寸来源，Any Switch 才会接通正确支路；inpaint 需先在 LoadImage 的 MaskEditor 涂遮罩；i2i/inpaint 时按注释把 guider cfg 提到 1.2-1.5。"}}