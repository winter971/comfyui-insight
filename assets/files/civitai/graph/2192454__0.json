"fromOut":11,"to":"589","toIn":6},{"from":"344","fromOut":13,"to":"589","toIn":7},{"from":"344","fromOut":14,"to":"589","toIn":8},{"from":"589","fromOut":0,"to":"8","toIn":0},{"from":"569","fromOut":0,"to":"336","toIn":6},{"from":"372","fromOut":4,"to":"344","toIn":3},{"from":"372","fromOut":5,"to":"344","toIn":4},{"from":"569","fromOut":4,"to":"590","toIn":0},{"from":"569","fromOut":6,"to":"591","toIn":0},{"from":"591","fromOut":0,"to":"592","toIn":0},{"from":"590","fromOut":0,"to":"593","toIn":0},{"from":"593","fromOut":0,"to":"561","toIn":8},{"from":"592","fromOut":0,"to":"561","toIn":9},{"from":"562","fromOut":3,"to":"436","toIn":0},{"from":"595","fromOut":0,"to":"429","toIn":0},{"from":"419","fromOut":0,"to":"595","toIn":0},{"from":"59","fromOut":0,"to":"595","toIn":1},{"from":"59","fromOut":1,"to":"595","toIn":2},{"from":"59","fromOut":2,"to":"595","toIn":3},{"from":"548","fromOut":0,"to":"595","toIn":4},{"from":"549","fromOut":0,"to":"595","toIn":5},{"from":"540","fromOut":0,"to":"595","toIn":6},{"from":"596","fromOut":0,"to":"595","toIn":7},{"from":"595","fromOut":1,"to":"597","toIn":0},{"from":"595","fromOut":2,"to":"598","toIn":0},{"from":"59","fromOut":1,"to":"548","toIn":0},{"from":"243","fromOut":0,"to":"427","toIn":0},{"from":"336","fromOut":1,"to":"607","toIn":0},{"from":"336","fromOut":2,"to":"607","toIn":1},{"from":"607","fromOut":0,"to":"372","toIn":0},{"from":"607","fromOut":1,"to":"372","toIn":1},{"from":"608","fromOut":0,"to":"610","toIn":1},{"from":"608","fromOut":0,"to":"611","toIn":1},{"from":"433","fromOut":0,"to":"612","toIn":0},{"from":"181","fromOut":0,"to":"612","toIn":1},{"from":"181","fromOut":3,"to":"612","toIn":2},{"from":"181","fromOut":4,"to":"612","toIn":3},{"from":"181","fromOut":2,"to":"612","toIn":4},{"from":"533","fromOut":0,"to":"612","toIn":5},{"from":"608","fromOut":0,"to":"612","toIn":6},{"from":"344","fromOut":8,"to":"612","toIn":7},{"from":"610","fromOut":0,"to":"612","toIn":8},{"from":"611","fromOut":0,"to":"612","toIn":9},{"from":"612","fromOut":0,"to":"505","toIn":0},{"from":"433","fromOut":0,"to":"613","toIn":0},{"from":"613","fromOut":0,"to":"610","toIn":0},{"from":"613","fromOut":1,"to":"611","toIn":0},{"from":"614","fromOut":0,"to":"336","toIn":5},{"from":"614","fromOut":1,"to":"336","toIn":11},{"from":"614","fromOut":2,"to":"336","toIn":12}],"ai":{"s":"专为打造高一致性商业级写实 AI 虚拟网红（AI Influencer）定制的 SDXL 工业级端到端生成管线。主干拓扑深度依托 rgthree Context Big 与 BasicPipe 构筑的全局数据总线，将多重角色特征 LoRA、模型权重与多通道提示词整洁解耦；全链路实行严密的四阶段递进式渲染：1st Pass 确立人物动态姿态与基础构图，2nd Pass 通过动态像素数学表达式自适应计算平铺尺寸并驱动 UltimateSDUpscale 进行毛孔级超清重绘，3rd & 4th Pass 搭载 Bbox 与 SAM 双模检测器执行面部与手部解剖级局部重绘，最终经由色彩回正与锐化滤镜封装输出，实现多图集间角色面部特征与质感的稳定一致性。","u":["AI 虚拟模特/社交媒体 KOL（意见领袖）跨姿态、跨场景高一致性写真图集批量生成","高保真商业人像摄影级画报创作，对皮肤毛孔纹理、发丝细节及手部微解剖结构有极致要求","电商服装模特虚拟换景与肖像定制，需要精准保持模特特定五官外貌特征不变"],"d":2,"st":[{"name":"模型底模加载、特征 LoRA 注入与全局 Context 总线","desc":"加载 SDXL 1.0 写实风格检查点底模，通过 Power Lora Loader 级联挂载数字人定制面容、皮肤微质感与胶片颗粒专属 LoRA；依托 rgthree Context Big 与 ToBasicPipe/FromBasicPipe 节点群搭建跨阶段传输网络，将主模型、CLIP、VAE 以及基础参数以结构化管道形式全局广播，杜绝复杂连线干扰。","nodes":["562","607","592","593","336","341","344","354","372","51","59","181","240","276","419","421","422","423","424","425","426","427","428","429","430","431","432","433","434","436","439","505","590","591"]},{"name":"写实提示词编码与一阶段潜空间采样","desc":"通过结构化 String Literal 节点输入正向写实光影、镜头参数及负向防畸变提示词，经 CLIPTextEncode 转换为精准的文本条件张量；由 SDXL Empty Latent Image 生成 1024x1024 标准原生比例 Latent（潜空间），送入首发 KSampler 进行大尺度去噪，经 VAE 解码生成兼顾构图透视与人物形态的首轮底图（1st Pass）。","nodes":["585","587","586","588","614","589","8","191"]},{"name":"基于动态分块的 USDU 高清平铺重绘","desc":"为解决大图放大时的显存瓶颈与接缝失真，管线调用 GetImageSize+ 获取实时分辨率，通过两个 MathExpression 表达式动态自适应计算平铺重绘时的最佳 Tile width 与 Tile height；结合 4x 超分模型加载器与 easy float 放大倍率控制器，驱动 UltimateSDUpscale 执行局部重叠平铺采样，重塑超微观皮肤纹理与衣物纤维。","nodes":["533","608","613","610","611","612","206"]},{"name":"面部与手部双重 SEGS 局部精修","desc":"采用双支路目标检测与语义重绘架构。面部通道利用 Ultralytics 与 Bbox 检测器提取人脸 SEGS（分割切片），调用高保真专用提示词进行低去噪幅度定向重绘，修复眼神光与五官微表情；手部通道引入 SAMLoader 协同分割，施加肢体防多指负向约束与专属手部正向描述，由 DetailerForEach 分别输出独立的对比预览图。","nodes":["242","245","243","595","522","523","279","248","540","596","548","549","506","597","598"]},{"name":"色彩回正、微观锐化与元数据封装归档","desc":"多轮重绘放大易导致局部色温偏移，系统通过 ImageColorMatch+ 节点以一阶段原图为色相/对比度基准进行整体色调校准补偿；随后经由 ImageSharpen 节点滤除噪点并提升晶状体锐利度；末端由 Image Saver Metadata 与 Input Parameters 节点将全套模型配置、LoRA 权重与提示词完整写入图像 EXIF 元数据并自动化归档。","nodes":["524","526","528","529","527","569","560","561"]}],"p":"【一阶段底图采样】KSampler 推荐使用 DPM++ 2M Karras 或 Euler a，步数 28-35 步，CFG 保持在 5.5-7.0，潜空间原生分辨率锁定 1024x1024 或 896x1152；【USDU 平铺放大】Upscale by 推荐 1.5x-2.0x，Denoise（去噪幅度）严格控制在 0.32-0.38 之间，Tile 宽度与高度由数学表达式动态保持在 1024 像素左右对齐；【面部精修】FaceDetailer 去噪幅度建议设为 0.35-0.42，Guide Size 设为 512-768；【手部精修】SAM 检测阈值设为 0.3-0.5，手部重绘去噪幅度设为 0.45-0.52；【后期锐化】ImageSharpen 强度建议控制在 0.5-0.8，避免产生白边光晕。","t":["【动态平铺防网格纹接缝】：平铺放大时切勿手动锁死过小的 Tile 尺寸。本工作流配置了 MathExpression（610/611）动态计算切块，确保切块始终与输入图像长宽比自适应匹配并留有 32-64 像素的 Padding（边缘重叠），有效杜绝画面切块边缘拼缝线。","【分段特征提示词隔离】：面部修复（522/523）与手部修复（548/549）拥有独立的 CLIP 文本编码输入，严禁将全身服饰或背景关键词填入局部修补节点，面部仅需保留眼睛神态、睫毛、自然毛孔等微观特征词，手部仅保留干净手掌、自然手指骨节等描述。"],"n":"【显存与前置依赖要求】本工作流专为 SDXL 高分辨率打造，包含两次全图推理与两次多目标局部切片重绘，系统显存建议至少 12GB（如 RTX 3060 12G/4070 及以上），16GB 及以上显存体验最佳。使用前需通过 ComfyUI Manager 确保安装 comfyui-impact-pack、rgthree-comfy、ComfyUI_IPAdapter_plus、comfyui_segment_anything 以及配套的 ultralytics 预训练检测权重文件（bbox/face_yolov8m.pt 与 sam_vit_b.pth），缺少检测模型将导致面部与手部精修阶段直接报错中断。","na":{"336":{"brief":"Context Big 全局数据总线路由中枢","detail":"封装并同步模型、CLIP、VAE 及条件参数流，使得深层后处理网络可随时调用干净的源数据链路，保障多阶段渲染的结构统一性。"},"524":{"brief":"ImageColorMatch+ 动态色彩校准回正节点","detail":"以一阶段未经多轮重绘破坏的原始图像作为基准色彩直方图参考，自动对多级放大后的图像进行色相、饱和度与明度校正，防止暗部发灰和肤色泛黄。"},"595":{"brief":"FaceDetailer 面部高精度自适应精修节点","detail":"基于 YOLO 检测框裁剪人脸区域并映射至独立潜空间，应用定制写实提示词进行二次去噪细化，在保持整体五官轮廓不变的前提下极大丰富眼球虹膜与唇部纹理。"},"607":{"brief":"Power Lora Loader 多模型矩阵加载器","detail":"采用堆叠架构统一控制数字人面孔专属 LoRA、超写实皮肤细节 LoRA 及胶片色彩 LoRA 的模型与文本权重配比。"},"610":{"brief":"平铺重绘宽度动态数学计算节点","detail":"接收当前图像物理尺寸并通过内置表达式自适应计算适合显存承载的最佳瓦片宽度，确保重叠采样无断层。"},"612":{"brief":"UltimateSDUpscale 动态平铺放大重绘核心","detail":"结合超分模型与局部潜空间切片采样，利用重叠蒙版渐变混合机制在大画幅尺度下生成极其逼真的皮肤肌理与光影微反光，打破常规插值放大的模糊感。"}}}}