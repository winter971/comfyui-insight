0","toIn":4},{"from":"34","fromOut":0,"to":"21","toIn":0},{"from":"11","fromOut":0,"to":"21","toIn":2},{"from":"12","fromOut":0,"to":"21","toIn":3},{"from":"10","fromOut":0,"to":"21","toIn":4},{"from":"8","fromOut":0,"to":"21","toIn":5},{"from":"27","fromOut":0,"to":"22","toIn":0},{"from":"26","fromOut":0,"to":"23","toIn":0},{"from":"23","fromOut":0,"to":"24","toIn":0},{"from":"24","fromOut":0,"to":"25","toIn":0},{"from":"26","fromOut":1,"to":"25","toIn":1},{"from":"20","fromOut":0,"to":"27","toIn":0},{"from":"25","fromOut":0,"to":"29","toIn":0},{"from":"25","fromOut":1,"to":"29","toIn":1},{"from":"27","fromOut":0,"to":"34","toIn":0},{"from":"29","fromOut":0,"to":"34","toIn":1},{"from":"9","fromOut":0,"to":"34","toIn":2},{"from":"10","fromOut":0,"to":"34","toIn":3},{"from":"11","fromOut":0,"to":"34","toIn":4},{"from":"12","fromOut":0,"to":"34","toIn":5},{"from":"31","fromOut":0,"to":"34","toIn":6},{"from":"32","fromOut":0,"to":"34","toIn":7},{"from":"31","fromOut":1,"to":"34","toIn":8},{"from":"9","fromOut":0,"to":"35","toIn":0},{"from":"7","fromOut":0,"to":"27","toIn":1},{"from":"14","fromOut":0,"to":"37","toIn":0},{"from":"37","fromOut":0,"to":"21","toIn":1},{"from":"9","fromOut":0,"to":"37","toIn":1},{"from":"25","fromOut":0,"to":"14","toIn":0}],"ai":{"s":"Illustrious 二次元出图全流程模板：一次采样、hi-res 二次细化、自动修脸、可选分块放大四段连跑。模型链在 Checkpoint 后串 FreeU_V2 与 DynamicThresholding（防高 CFG 过曝）、3D 渲染风格 LoRA 和 ACC 加速 LoRA，CLIPSetLastLayer -2 是 Illustrious 系惯例。提示词经 SDXLPromptStyler 套质量模板后，再用 SDXLRefiner 编码器补一段 HDR 增强词经 ConditioningConcat 拼到正向条件尾部。一期在 832x1152 空白潜空间直接画完（denoise 1），解码放大 1.2 倍重编码后走 InjectLatentNoise+ 重加噪、LatentBlend 0.8 与干净编码混合——重注纹理防止二阶段糊脸——再由 denoise 0.5 的二期 KSampler 精修，两期共用 Seed Generator 的递增种子保证构图连续。出图后 FaceDetailer 用 Anim-Furry-Faces 检测器自动定位并重绘面部。Ultimate SD Upscale 分块放大支线整体默认静音，要输出大图时再启用。","u":["Illustrious 系动漫图直出：套好提示词模板一键出 832x1152 精修图","需要比原生分辨率更细的成图：走 hi-res 二期加噪细化支线","多人或特写构图脸部崩坏：FaceDetailer 自动检测修脸，furry/兽人也有专用检测模型","需要 2K 以上大图：启用静音的 UltimateSDUpscale 支线做分块放大"],"d":3,"st":[{"name":"模型链装配","desc":"主模型串 FreeU、动态阈值与两只 LoRA 后分发；VAE 单独走一条 sdxl_vae 通道并经 set/get 别名复用，Illustrious 的出图质量全靠这条链调教。","nodes":["26","23","24","25","29","9","10","6","7"]},{"name":"提示词组装","desc":"Styler 模板生成正负词，Refiner 通道追加 HDR 增强词后拼进正向条件，让高清质感词只作用于特定层。","nodes":["30","4","5","12","35","11"]},{"name":"一期出图","desc":"832x1152 空白潜空间一次采样到位（denoise 1），这一步定构图。","nodes":["17","19","2"]},{"name":"二期细化","desc":"放大重编码后重注噪声并与干净潜空间混合，再以 0.5 去噪精修，是分辨率翻倍后细节不糊的核心机关。","nodes":["15","3","13","16","20","27","22"]},{"name":"面部修复","desc":"Ultralytics 检测脸/兽脸加 SAM 分割，Impact FaceDetailer 局部放大重绘，denoise 0.35 只动脸不动构图。","nodes":["31","32","34","1"]},{"name":"旁路放大支线","desc":"默认静音的 UltimateSDUpscale：4x-UltraSharp 分块超分，出大图时解除静音并接 FaceDetailer 输出。","nodes":["8","14","37","21","18"]}],"p":"两期都是 28 步 euler，CFG 6.5/7 配 DynamicThresholding(5, 0.8) 防；二期 denoise 0.5 是清晰度与保构图平衡点，脸部重建感强就降；InjectLatentNoise+ 强度 1 配 LatentBlend 0.8 控制二阶段细节注入量；FaceDetailer denoise 0.35，种子建议先 fixed 调好构图再切 increment 批量。","n":"需另下 PATNROM_ILL_PAseer_V2 主模型、ACC 加速 LoRA、3D 渲染风格 LoRA、Anim-Furry-FacesV1 检测模型、sam_vit_b 与 4x-UltraSharp；UltimateSDUpscale 支线默认静音，启用时记得连 37→21 的模型线也已解封；分块放大一步 1.5 倍，要更大可改倍数但显存与耗时线性涨。"}}