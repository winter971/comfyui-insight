n":0},{"from":"273","fromOut":0,"to":"422","toIn":1},{"from":"273","fromOut":1,"to":"422","toIn":2},{"from":"213","fromOut":0,"to":"422","toIn":4},{"from":"211","fromOut":0,"to":"422","toIn":5},{"from":"422","fromOut":0,"to":"365","toIn":0},{"from":"422","fromOut":1,"to":"365","toIn":2},{"from":"422","fromOut":2,"to":"365","toIn":13},{"from":"423","fromOut":0,"to":"422","toIn":6},{"from":"216","fromOut":0,"to":"425","toIn":0},{"from":"425","fromOut":0,"to":"181","toIn":1},{"from":"214","fromOut":0,"to":"428","toIn":0},{"from":"428","fromOut":0,"to":"429","toIn":0},{"from":"431","fromOut":0,"to":"321","toIn":0},{"from":"429","fromOut":0,"to":"432","toIn":0},{"from":"432","fromOut":0,"to":"430","toIn":0},{"from":"432","fromOut":0,"to":"431","toIn":0},{"from":"430","fromOut":0,"to":"438","toIn":0},{"from":"438","fromOut":0,"to":"375","toIn":0},{"from":"236","fromOut":0,"to":"191","toIn":1},{"from":"218","fromOut":2,"to":"422","toIn":3},{"from":"218","fromOut":2,"to":"417","toIn":3},{"from":"242","fromOut":0,"to":"417","toIn":4},{"from":"418","fromOut":0,"to":"417","toIn":5},{"from":"349","fromOut":2,"to":"633","toIn":2},{"from":"218","fromOut":2,"to":"633","toIn":0},{"from":"422","fromOut":3,"to":"633","toIn":1},{"from":"633","fromOut":0,"to":"191","toIn":2}],"ai":{"s":"本工作流基于 Lightricks 旗舰级 LTX-Video 2.3（LTXV2）构建，是业界罕见的音画一体化多帧受控生成前沿管线。全链路基于 GGUF 量化加载扩散主模与双 CLIP 文本编码器，结合专用的 LTXVAudioVAELoader 实现了音频与视频多模态潜空间（AV Latent）的统一拼接（Concat）与联合去噪采样；输入端突破单图限制，支持首帧、尾帧及两个中继过渡帧（共 4 帧）的空间自适应引导与裁剪对齐；采样链路采用 KSampler 双阶段分步降噪与蒸馏 LoRA 路由切换，并在采样后通过 LTXVSeparateAVLatent 完美解耦音视频数据流，最终在消费级显卡上稳定输出声画高度协同、运动过渡平滑自然的 720p 电影级视听长镜头。","u":["需要严格根据背景音乐/音效时序节奏生成高契合度电影配乐画面的音视频协同创作","给定首帧、尾帧及中间两处关键构图（四帧引导插值）的高精度平滑剧情转场动画生成","消费级单卡（16GB-24GB 显存）环境下 720p 高清画质与蒸馏极速打样的灵活切换生产"],"d":3,"st":[{"name":"多模态底座与全套 GGUF/音视频模型加载","desc":"采用 GGUF 紧凑量化方案加载 LTX-Video 2.3 核心扩散骨干（UnetLoaderGGUF）与双模态文本编码器（DualCLIPLoaderGGUF），挂载视频 VAE、专属音频 VAE（LTXVAudioVAELoader）以及潜空间放大模型，并由全套工程便签标注标准版与蒸馏加速版选型逻辑。","nodes":["215","216","213","212","211","423","435","434","426","637"]},{"name":"多级 LoRA 权重编排与模式路由切换","desc":"构建 6 级级联式 LoRA 调制链路，针对 Dev 完整版、蒸馏加速版（Distilled LoRA）以及特定动态控制数据进行分层注入；通过 ComfySwitchNode 旁路路由开关，实现加速打样与极致高精画质之间的无缝切换。","nodes":["214","428","429","430","431","438","633","437"]},{"name":"四关键帧空间尺寸自适应与时空条件编码","desc":"引入多关键帧输入机制，支持首帧（Load first）、尾帧（Load last）及两个中间过渡帧（Load 2/3）协同约束；通过 GetImageSize 与多组 ImageScale 自动重缩放尺寸以适配 720p 规格，结合 LTXVCropGuides 裁剪对齐，经 LTXVConditioning 与正负文本提示词转化为强约束的时空引导特征。","nodes":["280","306","309","314","367","366","368","370","273","181","231","425","322"]},{"name":"音视频双模态潜空间拼接与分段级联采样","desc":"加载音频素材并通过 LTXVConcatAVLatent 创新性地将音频潜空间与视频潜空间拼接为一个统一的音视频张量（Joint AV Latent）；由 KSampler1 与 KSampler2 构成两段式降噪/重绘采样链路，在自定义调度子图驱动下完成高动态去噪；最后由 LTXVSeparateAVLatent 将音视频潜空间高保真解耦分离。","nodes":["242","418","421","278","251","375","321","271","424","427","365","349","218","325","422","236","417"]},{"name":"音视频同步合成与电影级 720p 封装落盘","desc":"接收解码后的高清晰度视频图像序列与对应时序音频流，由 CreateVideo 与 SaveVideo 节点进行时间轴精确对齐，执行电影级高动态色彩编码封装，最终导出声画完全同步的 720p 商业级视频。","nodes":["191","220"]}],"p":"分辨率建议优先选择 1280×720（16:9 标准 720p）或 720×1280，由 ImageScale 节点统一对齐；当切换到 Dev+Distilled LoRA 加速模式时，KSampler 推荐步数 10-15 步，CFG 设为 3.0-3.5；若运行 Dev Full 原生模型，KSampler 推荐步数 25-35 步，CFG 保持在 4.0-5.0；音频输入应尽量使用 44.1kHz 或 48kHz WAV 格式以保障 Audio VAE 潜空间无失真对齐。","t":["【音视频潜空间拼接长度对齐】：LTXVConcatAVLatent（节点 278/251）要求音频时长与视频生成帧数在时间轴上高度匹配；若载入的音频过短，会导致音频潜空间填充异常，引发解码杂音或报错，建议音频时长略长于或严格等于预设视频帧率换算时长。","【四关键帧分辨率与几何一致性】：工作流引入了 Load first、Load last、Load 2、Load 3 四张输入图，虽然系统配备了 ImageScale 与 LTXVCropGuides 自动缩放裁剪，但如果四张图宽高比差异悬殊，仍会导致中间帧过度拉伸形变，务必在输入前预先规整图片构图比例。"],"n":"【硬件要求与专属组件警告】：本工作流集成了音频潜空间处理与双阶段视频采样，计算负载较大，推荐显存 >= 16GB。环境必须预先配置 ComfyUI-GGUF 以及专用的 LTXV 扩展组件，并确保 models 目录下具备 LTXV2 扩散主模、DualCLIP GGUF 权重、专属 Video VAE 与关键的 Audio VAE 权重文件，缺失音频 VAE 将直接导致节点 212 报错中断。","na":{"181":{"brief":"LTXV 多帧时空时序引导打包器","detail":"整合多张关键帧（首、尾、过渡帧）经过尺寸缩放与裁剪后的像素引导条件，结合提示词文本嵌入，向扩散模型输出精确的多时序空间锚点与运动先验。"},"212":{"brief":"LTXV 专属音频 VAE 加载器","detail":"专为 LTX-Video 2.3 打造的音频潜空间编解码器加载节点，负责将时域音频波形转换为能够与视频潜空间在扩散过程中联合去噪的音频特征张量。"},"271":{"brief":"复合潜空间音视频解耦分离器","detail":"在两段式 KSampler 完成联合去噪后，精准解构分离复合潜空间张量，将视频潜空间交付给主 VAE 解码为像素序列，音频潜空间交付给 Audio VAE 还原为高保真音频波形。"},"278":{"brief":"音视频潜空间多模态拼接器","detail":"本工作流跨模态协同的核心枢纽，将音频 Latent 与视频 Latent 沿特定特征维度拼接为一个统一的音视频复合潜空间（Joint Latent），使扩散去噪同时感知声画动态关联。"},"633":{"brief":"蒸馏加速与原生渲染模式路由开关","detail":"全局逻辑切换中枢，支持创作者在 Dev 完整全量采样分支与加载 Distilled LoRA 的极速出图分支间一键拨动，兼顾批量测试与终稿渲染效率。"}}}}