In":0},{"from":"42","fromOut":0,"to":"43","toIn":0},{"from":"14","fromOut":0,"to":"46","toIn":0},{"from":"46","fromOut":0,"to":"47","toIn":0},{"from":"10","fromOut":0,"to":"3","toIn":1},{"from":"53","fromOut":0,"to":"52","toIn":1},{"from":"53","fromOut":1,"to":"52","toIn":2},{"from":"53","fromOut":2,"to":"52","toIn":3},{"from":"6","fromOut":0,"to":"54","toIn":0},{"from":"54","fromOut":0,"to":"52","toIn":4},{"from":"7","fromOut":0,"to":"55","toIn":0},{"from":"55","fromOut":0,"to":"52","toIn":5},{"from":"56","fromOut":0,"to":"52","toIn":6},{"from":"8","fromOut":0,"to":"52","toIn":0},{"from":"52","fromOut":0,"to":"61","toIn":0},{"from":"14","fromOut":0,"to":"34","toIn":0},{"from":"4","fromOut":1,"to":"62","toIn":1},{"from":"4","fromOut":0,"to":"62","toIn":0},{"from":"62","fromOut":0,"to":"3","toIn":0},{"from":"62","fromOut":1,"to":"6","toIn":0},{"from":"62","fromOut":1,"to":"7","toIn":0},{"from":"63","fromOut":0,"to":"10","toIn":2},{"from":"40","fromOut":0,"to":"63","toIn":1},{"from":"46","fromOut":0,"to":"63","toIn":2},{"from":"32","fromOut":0,"to":"63","toIn":0},{"from":"42","fromOut":0,"to":"63","toIn":3}],"ai":{"s":"SDXL ControlNet 万金油出图工作流。一张参考图同时喂给七个预处理器（scribble、normalmap、openpose、canny、lineart、depth、hed）各自出预览，其中四路进 Comfyroll 四选一开关，选中哪张控制图就按哪种方式约束构图。之所以全程只挂一个 ControlNet++ union 模型，是它一个顶全部控制类型，换控制方式只需切开关、不用换模型，注入强度固定 0.5。主采样走 centerfold 检查点叠 detailer_v5 LoRA，1344x768 潜空间、40 步 dpmpp_3m_sde 出图。解码后不直接保存：FaceDetailer 换用另一颗 epicrealismXL 检查点做面部精修——底图和脸可以分属两个模型，YOLO 检出人脸后放大重绘、denoise 0.5，修完才落盘。结构直白，是典型的底图加控制网加脸部二次加工三件套。","u":["有参考图但想换画风换内容：在 hed/canny/depth/lineart 四种控制方式间切换锁定构图","写实人像出图后脸容易崩，用第二颗写实检查点自动修脸","对比不同 ControlNet 预处理效果，七路预览一眼挑出最合适的","1344x768 横版写实插画批量出图，保持姿势与场景不跑偏"],"d":2,"st":[{"name":"控制信号预处理","desc":"参考图并行过七种预处理器，把同一张图翻译成涂鸦、法线、姿态、边缘、线稿、深度等不同控制信号，每路配预览方便挑选。","nodes":["14","15","30","32","34","40","42","46"]},{"name":"控制图选择与注入","desc":"四选一开关决定实际生效的控制图，ControlNet++ union 模型按 0.5 强度把它写进正向条件——一个模型覆盖所有类型，是这条线的省事之处。","nodes":["63","13","10"]},{"name":"主采样","desc":"centerfold 检查点叠 detailer_v5 LoRA，正负提示词与 1344x768 空白潜空间交给 40 步 dpmpp_3m_sde 采样，解码出底图。","nodes":["4","62","6","7","5","3","8"]},{"name":"人脸精修与输出","desc":"底图交给 FaceDetailer：换 epicrealismXL 检查点与独立采样参数，只对人脸区域低去噪重绘，修完保存。","nodes":["53","56","52","61"]}],"p":"CR 四选一开关的数字就是控制方式（1=hed、2=canny、3=depth、4=lineart），换数字即换构图约束；ControlNetApply 强度 0.5，画面太像参考图就降、跑形就升；主采样 40 步 CFG 4，Detailer 内部 20 步 CFG 8、denoise 0.5，脸修得太过可降 denoise。","n":"需自备 ControlNet++ union、两个 XL 检查点、detailer_v5 LoRA 与 face_yolov8m；预处理器模型（openpose、canny 等）首次运行自动下载；scribble、normalmap、openpose 三路只接了预览没进开关，想用要手动改接 63 的输入；依赖 Art-Venture、Impact、Comfyroll 三个节点包。"}}