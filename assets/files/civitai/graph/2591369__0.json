:"674","toIn":4},{"from":"658","fromOut":0,"to":"674","toIn":4},{"from":"662","fromOut":0,"to":"674","toIn":5},{"from":"659","fromOut":0,"to":"674","toIn":6},{"from":"660","fromOut":0,"to":"674","toIn":7},{"from":"661","fromOut":0,"to":"674","toIn":8},{"from":"653","fromOut":0,"to":"675","toIn":0},{"from":"654","fromOut":0,"to":"675","toIn":1},{"from":"655","fromOut":0,"to":"675","toIn":2},{"from":"656","fromOut":0,"to":"675","toIn":3},{"from":"657","fromOut":0,"to":"675","toIn":4},{"from":"658","fromOut":0,"to":"675","toIn":4},{"from":"662","fromOut":0,"to":"675","toIn":5},{"from":"659","fromOut":0,"to":"675","toIn":6},{"from":"660","fromOut":0,"to":"675","toIn":7},{"from":"661","fromOut":0,"to":"675","toIn":8},{"from":"653","fromOut":0,"to":"676","toIn":0},{"from":"654","fromOut":0,"to":"676","toIn":1},{"from":"655","fromOut":0,"to":"676","toIn":2},{"from":"656","fromOut":0,"to":"676","toIn":3},{"from":"657","fromOut":0,"to":"676","toIn":4},{"from":"658","fromOut":0,"to":"676","toIn":4},{"from":"662","fromOut":0,"to":"676","toIn":5},{"from":"659","fromOut":0,"to":"676","toIn":6},{"from":"660","fromOut":0,"to":"676","toIn":7},{"from":"661","fromOut":0,"to":"676","toIn":8},{"from":"663","fromOut":0,"to":"679","toIn":0},{"from":"663","fromOut":1,"to":"679","toIn":1},{"from":"664","fromOut":0,"to":"682","toIn":0},{"from":"664","fromOut":1,"to":"682","toIn":1},{"from":"665","fromOut":1,"to":"683","toIn":1},{"from":"666","fromOut":0,"to":"684","toIn":0},{"from":"666","fromOut":1,"to":"684","toIn":1},{"from":"667","fromOut":0,"to":"677","toIn":0},{"from":"667","fromOut":1,"to":"677","toIn":1},{"from":"668","fromOut":0,"to":"681","toIn":0},{"from":"668","fromOut":1,"to":"681","toIn":1},{"from":"669","fromOut":0,"to":"685","toIn":0},{"from":"669","fromOut":1,"to":"685","toIn":1},{"from":"670","fromOut":1,"to":"686","toIn":1},{"from":"671","fromOut":1,"to":"687","toIn":1},{"from":"672","fromOut":0,"to":"678","toIn":0},{"from":"672","fromOut":1,"to":"678","toIn":1},{"from":"673","fromOut":0,"to":"680","toIn":0},{"from":"673","fromOut":1,"to":"680","toIn":1},{"from":"674","fromOut":0,"to":"688","toIn":0},{"from":"674","fromOut":1,"to":"688","toIn":1},{"from":"675","fromOut":1,"to":"689","toIn":1},{"from":"676","fromOut":1,"to":"690","toIn":1},{"from":"37","fromOut":0,"to":"691","toIn":0},{"from":"691","fromOut":0,"to":"89","toIn":0},{"from":"670","fromOut":0,"to":"686","toIn":0},{"from":"665","fromOut":0,"to":"683","toIn":0},{"from":"676","fromOut":0,"to":"689","toIn":0},{"from":"675","fromOut":0,"to":"690","toIn":0},{"from":"671","fromOut":0,"to":"687","toIn":0},{"from":"702","fromOut":0,"to":"662","toIn":0},{"from":"93","fromOut":0,"to":"702","toIn":0},{"from":"39","fromOut":0,"to":"702","toIn":1}],"ai":{"s":"Qwen Image Edit 2511 多角度数据集生成器，专为 LoRA 训练集批量造图设计。主线:LoadImage 载入角色图，ImageScaleToTotalPixels 统一像素量后由 VAEEncode 转成参考潜空间；模型侧 UNETLoader 加载 qwen_image_edit_2511 的 lightning fp8 版，先叠 Multiple-angles 多角度 LoRA，再串速度 LoRA(强度为 0 等于停用，需要提速时可拉回 1)；CLIP 用 qwen_2.5_vl_7b。提示词不是手写长句，而是两个 ComboSetter 分别给出'表情'(neutral/sad/angry 等枚举)与'景别+微状态'(headshot/half body/full body 等)，加上角色名 PrimitiveString 与目录名，拼装后分发。核心是 15 个结构完全相同的生成子图节点，每个子图接收 CLIP/VAE/参考图/文本/模型/潜空间六类输入，各自生成一个角度的变体，再各接一个 SaveImage 按日期目录落盘。之所以复制 15 份而不是循环，是因为每个子图内部提示词组合不同，展开写反而直观可改。","u":["给自己的角色 LoRA 训练批量补数据：一张参考图产出 15 个不同景别与表情的角度变体","给角色设定集补图：headshot/half body/full body 三档景别一次拉满","表情包素材生产：切换 611 号的表情枚举重跑，批量得到同角色不同情绪的图"],"d":2,"st":[{"name":"参考图与潜空间准备","desc":"载入角色图并统一像素量，编码成参考潜空间广播给所有生成子图。这一步保证 15 个角度都以同一张脸为基准，是一致性的物理来源。","nodes":["78","93","702","662"]},{"name":"模型装配","desc":"主干+多角度 LoRA+速度 LoRA 的组合链，配 Qwen 专用 CLIP 与 VAE。多角度 LoRA 是让模型理解'同一个人换个角度'的关键权重，强度保持 1。","nodes":["37","691","89","38","39","653","654","658"]},{"name":"结构化提示词组件","desc":"表情、景别、角色名、目录名四个字符串源。用枚举下拉而不是自由文本，保证 15 个子图的描述格式统一，这正是 LoRA 训练集需要的规整标注。","nodes":["611","626","567","579"]},{"name":"15 路批量生成","desc":"十五个同构子图并行排开，各自持有不同的提示词组合，共同吃同一套模型与参考潜空间，一次跑完整个多角度数据集。","nodes":["652","663","664","665","666","667","668","669","670","671","672","673","674","675","676"]},{"name":"按日期目录落盘","desc":"每个子图配一个 SaveImage，用 %date% 表达式建当天目录并统一前缀，产出即可直接喂给训练脚本，省去手动归档。","nodes":["463","677","678","679","680","681","682","683","684","685","686","687","688","689","690"]}],"p":"决定产量的三处：78 的参考图质量、611/626 的枚举组合、89 速度 LoRA 的强度开关。保持结构化标签词不变是训练集规整的前提。","n":"四个模型文件(主干/多角度 LoRA/速度 LoRA/CLIP)都需提前放进 models 对应目录；15 路全跑一次耗时较长，可先只启用 652 一个子图试效果。","f":["① 78 LoadImage 载入角色参考图，93 ImageScaleToTotalPixels 按 lanczos 缩到 1MP 档统一像素量","② 93 的图经 702 VAEEncode 变成参考潜空间，经 Reroute(662) 分发给全部 15 个生成子图","③ 37 UNETLoader 加载 qwen_image_edit_2511 lightning fp8 主干，691 叠 Qwen-Edit-2509-Multiple-angles LoRA(强度1)，89 串速度 LoRA 但强度为 0 即停用","④ 38 CLIPLoader 给出 qwen_2.5_vl 文本编码器、39 VAELoader 给出配套 VAE，分别经 Reroute 分发","⑤ 611 ComboSetter 从表情枚举选 angry 等，626 选景别与微状态，567 写角色名 Sandrine，579 定输出子目录 LorasetSandrine/","⑥ 652/663~676 共 15 个同构子图节点各收六路输入，各自按内部提示词组合生成一个角度变体，输出 IMAGE+STRING(文件名描述)","⑦ 每个子图的 IMAGE+STRING 分别接自己的 SaveImage，按 %date% 目录与统一前缀 ConsistentFace_7 落盘"],"t":["89 速度 LoRA 强度当前为 0：嫌 15 张跑得慢就把它调回 1，配合 lightning 主干能明显提速，但角度多样性可能略降","想换角色只改三处：567 角色名、579 输出目录、78 的输入图，其余 15 个子图不用碰","参考图若已是 1024 方图可跳过缩放档位的顾虑；非方图交给 93 统一即可，别手动改子图内尺寸","批量产物直接进 LoRA 训练前，先肉眼筛掉手部崩坏的图，15 张里通常有个别失败"],"na":{"37":{"brief":"加载 qwen_image_edit_2511 lightning fp8 主干。","desc":"UNET 输出先过 691 多角度 LoRA 再过 89 速度 LoRA 后分发。lightning 蒸馏版少步出图，fp8 量化让消费级卡也能装下，是 15 路批量能在单卡跑完的前提。","params":[{"name":"unet_name","kind":"下拉选择","default":"qwen_image_edit_2511_fp8_e4m3fn_scaled…","desc":"2511 版编辑主干，多角度 LoRA 与之配套"}]},"38":{"brief":"加载 qwen_2.5_vl_7b 文本编码器(type=qwen_image)。","desc":"CLIP 经 Reroute(653) 喂给 15 个子图的 clip 槽。Qwen Edit 用视觉语言模型做编码，指令理解比普通 CLIP 强得多，文件较大注意提前下好。","params":[]},"39":{"brief":"加载 qwen_image_vae，供编码参考图与解码输出。","desc":"VAE 两路去向：702 编码参考潜空间、各子图内部解码。Qwen 系与 SD 系 VAE 不通用，装错文件会解码出噪声。","params":[]},"78":{"brief":"载入角色参考图 sonya.png，是整批数据一致性的源头。","desc":"IMAGE 输出经 93 缩放后编码为参考潜空间广播给 15 个子图。换角色就是换这个文件；图里脸越清晰正脸，15 个角度的还原度越高。","params":[{"name":"image","kind":"文件下拉","default":"sonya.png","desc":"参考角色图，建议选正面清晰的单人图"}]},"89":{"brief":"速度 LoRA 槽位，当前强度 0 等于停用。","desc":"挂着 Qwen-Image-Edit-Lightning-8steps 但 strength_model=0，模型行为不受影响。作者留的提速开关：拉回 1 走 8 步快出，代价是细节略降。","params":[{"name":"strength_model","kind":"浮点","default":"0","desc":"0 停用，1 启用 8 步加速"}]},"93":{"brief":"ImageScaleToTotalPixels，把参考图统一到 1MP 档。","desc":"lanczos 算法、2MP 目标档位。Qwen Edit 对输入分辨率敏感，统一像素量能让 15 个子图的参考潜空间尺寸一致，避免个别子图因图过大而爆显存。","params":[{"name":"megapixels","kind":"浮点","default":"1","desc":"保持 1MP 即可，图过小会丢脸部细节"}]},"463":{"brief":"652 子图对应的 SaveImage，按日期目录落盘。","desc":"images 接 652 的 IMAGE，filename_prefix 接 652 的 STRING，统一前缀 ConsistentFace_7 并按 %date% 建目录。其余 14 个保存节点一一对应各自子图。","params":[{"name":"filename_prefix","kind":"字符串","default":"%date:yyyy-MM-dd%/ConsistentFace_7","desc":"日期自动归档，前缀可改成角色名"}]},"567":{"brief":"PrimitiveString 写角色名 Sandrine。","desc":"字符串经 659 分发到每个子图的 string_1 槽，是提示词里的角色标识词。训练集标签与这里的名字应与后续 LoRA 触发词一致。","params":[{"name":"value","kind":"字符串","default":"Sandrine","desc":"角色触发词，与训练时保持一致"}]},"579":{"brief":"PrimitiveString 定输出子目录 LorasetSandrine/。","desc":"字符串经 660 进子图的 string_1_1 槽，参与 SaveImage 的路径拼装。换角色时同步改这里，避免不同角色的数据混在一个目录。","params":[{"name":"value","kind":"字符串","default":"LorasetSandrine/","desc":"输出子目录名，带尾部斜杠"}]},"611":{"brief":"FACIAL EXPRESSIONS 表情枚举选择器。","desc":"从 neutral/smiling/sad/angry/dominant 等枚举里选一个(当前 angry)，输出两路 STRING 经 Reroute 进子图的 text 槽。枚举值就是训练集的标签词，别自由发挥改写。","params":[{"name":"combo","kind":"下拉选择","default":"angry","desc":"当前批次的表情标签"}]},"626":{"brief":"Facial Micro-State 与景别枚举选择器。","desc":"第一路选 headshot/half body/full body 等景别，第二路输出经 661 进子图。与 611 一起拼成'表情+景别'的规整描述，15 个子图内再组合出不同角度。","params":[]},"652":{"brief":"15 个同构生成子图之一，输出一个角度变体。","desc":"九路输入齐收：CLIP/VAE/参考图/表情文本/景别文本/模型/参考潜空间/角色名/目录名，内部完成编辑采样后输出 IMAGE 与文件名 STRING。其余 663~676 结构相同只是内部参数不同；想增减角度就复制或停用这类节点。","params":[]},"691":{"brief":"叠 Qwen-Edit-2509-Multiple-angles 多角度 LoRA，强度 1。","desc":"全强度挂在主干上，让模型对'同角色换视角'的指令响应更稳。这是本工作流能一次出多角度数据集的核心权重，删掉它角度变化会明显变弱。","params":[{"name":"strength_model","kind":"浮点","default":"1","desc":"保持 1；角度漂移过强可试 0.8"}]},"702":{"brief":"VAEEncode，把参考图编码成潜空间。","desc":"pixels 接 93 的缩放图、vae 接 39，LATENT 经 Reroute(662) 分发给全部 15 个子图的 latent_image 槽。Qwen Edit 是编辑模型，参考潜空间就是它'照着改'的底稿。","params":[]}}}}