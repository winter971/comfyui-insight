780","fromOut":0,"to":"781","toIn":0},{"from":"781","fromOut":0,"to":"782","toIn":0},{"from":"706","fromOut":0,"to":"782","toIn":1},{"from":"698","fromOut":0,"to":"777","toIn":7},{"from":"660","fromOut":0,"to":"777","toIn":8},{"from":"537","fromOut":0,"to":"754","toIn":7},{"from":"255","fromOut":0,"to":"754","toIn":8},{"from":"764","fromOut":0,"to":"748","toIn":1},{"from":"764","fromOut":0,"to":"754","toIn":1},{"from":"730","fromOut":0,"to":"775","toIn":1},{"from":"730","fromOut":0,"to":"777","toIn":1},{"from":"454","fromOut":0,"to":"783","toIn":0},{"from":"452","fromOut":0,"to":"783","toIn":2},{"from":"544","fromOut":0,"to":"783","toIn":3},{"from":"66","fromOut":0,"to":"783","toIn":4},{"from":"242","fromOut":0,"to":"783","toIn":5},{"from":"627","fromOut":0,"to":"783","toIn":6},{"from":"537","fromOut":0,"to":"783","toIn":7},{"from":"255","fromOut":0,"to":"783","toIn":8},{"from":"765","fromOut":0,"to":"783","toIn":1},{"from":"765","fromOut":0,"to":"761","toIn":1},{"from":"783","fromOut":0,"to":"763","toIn":0},{"from":"762","fromOut":0,"to":"750","toIn":0},{"from":"766","fromOut":0,"to":"761","toIn":9},{"from":"787","fromOut":0,"to":"565","toIn":0},{"from":"788","fromOut":0,"to":"459","toIn":2},{"from":"467","fromOut":0,"to":"465","toIn":1},{"from":"468","fromOut":0,"to":"721","toIn":0},{"from":"696","fromOut":0,"to":"787","toIn":0},{"from":"276","fromOut":0,"to":"717","toIn":0},{"from":"276","fromOut":1,"to":"720","toIn":0}],"ai":{"s":"本工作流是 SDXL 1.0 生态中享誉社区的「全包罗（All-Inclusive）终极文生图与放大矩阵测试台」。主干链路采用「SDXL 主模协同三级 LoRA 与 ControlNet ➔ SDXL 双 CLIP 与 SD 1.5 跨架构双轨提示词编码 ➔ 四路并行横向 CFG 扫参评估矩阵 ➔ 主线基准采样 ➔ 潜空间放大（Latent）+ 确定性采样重绘（Sampler）+ 随机祖先采样重绘（Ancestral）全景三轨超分放大矩阵」的宏大拓扑架构。该管线不仅彻底解决了创作者在模型提示词权重、CFG 引导值与不同超分重绘算法之间的选择困难，更能单次推理横向输出多达数十种不同风格与精细度的成品大图，堪称 AIGC 工业级调参评测与生产落地的集大成之作。","u":["多参数横向扫描与模型微调评测（Prompt & CFG Sweeping）：单次生成即可直接横向比对 4 组阶梯 CFG（如 5/7/9/11）对构图、色彩与细节的即时影响，快速定位最优生成甜点区。","三轨超分画质深度对比与出版级放大：通过同源原图在「潜空间插值」、「模型确定性重绘」与「祖先随机噪声重绘」三种路线下的并行放大对比，满足从微观写实到艺术创作的多重画质需求。","跨模型多 LoRA 级联验证：支持在单 LoRA、双 LoRA、三 LoRA 级联链间灵活热插拔，精准评估多 LoRA 权重叠加对 SDXL 底座的面容保真度与画风污染程度。"],"d":2,"st":[{"name":"阶段一：模型基座加载、级联 LoRA 与 ControlNet 条件预设","desc":"通过 CheckpointLoaderSimple 载入 SDXL 1.0 官方或微调底模，外挂独立高保真 VAELoader；构建 1 至 3 级 LoRA 级联串联网络，支持平滑堆叠画风与人物特征；同时接入 ControlNetLoader 与 ControlNetApply 预留边缘或姿态引导接入端，并附带详尽新手指南。","nodes":["10","713","276","277","284","712","711","710","346"]},{"name":"阶段二：双架构文本提示词编码与 CLIP-L 独立增强","desc":"构建兼顾 SDXL 与 SD 1.5 的跨架构文本提示词系统。利用 CLIPTextEncodeSDXL 分离处理 CLIP-G 宏观语义与 CLIP-L 局部细节，同时特别为 CLIP-L 提供正负双向的 Positive/Negative Boost 增强控制器，精细化压制低频伪影并提升局部质感。","nodes":["455","459","464","465","467","488","457","788"]},{"name":"阶段三：基础潜空间构建与全局推理总控参数","desc":"使用 EmptyLatentImage 建立标准 1024x1024 黄金原生潜空间；通过可视化的全局元节点（Primitive Nodes）集中统控主干采样的随机种子（Seed）、迭代步数（Base Steps）、基础 CFG 引导、采样算法（Base Sampler）与调度策略（Base Scheduler）。","nodes":["5","66","242","249","537","255"]},{"name":"阶段四：四路并行 CFG 参数扫描矩阵 (CFG Sweep)","desc":"针对 CFG 调参痛点设计的多通道并行生成模块。在同一随机噪声与种子下，将条件与潜空间复制分发至 4 组阶梯递增的 KSampler（CFG A/B/C/D，如分别设置为 5.0、7.0、9.0、11.0）并分别通过 VAEDecode 解码保存，实现四分格画质与动态范围的直观评估。","nodes":["561","562","563","564","548","549","550","551","552","553","554","555","556","557","558","559","543"]},{"name":"阶段五：主干基准采样生成与像素解码","desc":"基于全局默认最优超参数配置执行 SDXL 主干高保真采样，经外部高质量 VAE 潜空间解码生成标准高分辨率基准原图并独立存档，作为后续多轨放大矩阵的统一图像源。","nodes":["628","629","630","724","725"]},{"name":"阶段六：全景三轨超分辨率放大矩阵 (Latent / Sampler / Ancestral)","desc":"集成了三条不同技术路径且各包含“标准”与“极速（Quick）”双重档位的高清放大矩阵：①潜空间双线性插值直接重绘（Latent Upscale，Denoise 55%）；②模型超分叠加确定性采样器精细重绘（Sampler Upscale，Denoise 30%）；③模型超分叠加祖先采样器创造性重绘（Ancestral Upscale，注入全新高频随机细节），实现画质的降维打击。","nodes":["626","627","698","699","660","641","637","701","766","705","700","702","703","763","748","749","750","648","650","655","636","638","639","757","759","760","754","755","756","640","642","643","780","781","782","775","776","777","778","783","779","649","761","762"]},{"name":"阶段七：全域信号路由与拓扑规整骨干网","desc":"构建庞大而井然有序的 Reroute 信号分发中继系统，将模型、CLIP、VAE、正负条件与潜空间数据无衰减、零交叉地分发到并行测试区与放大矩阵中，保证百节点巨型画布的整洁美观与低维护成本。","nodes":["451","452","453","454","468","471","472","473","544","565","631","695","696","706","709","717","719","720","721","730","764","765","787"]}],"p":"1. 基础生图阶段：Base Steps 推荐设为 25-30 步，Base CFG 建议设为 6.5-7.5；采样器（Base Sampler）推荐使用 dpmpp_2m 或 euler，调度器（Base Scheduler）采用 karras。\n2. CFG 扫描矩阵：推荐将 CFG A 设为 4.5（柔和胶片感），CFG B 设为 6.5（平衡标准），CFG C 设为 8.0（锐利对比），CFG D 设为 10.0（超强文本跟随），便于一览全貌。\n3. 超分辨率放大矩阵：\n   - 潜空间放大（Latent Upscale）：Denoise 建议控制在 0.50-0.55，步数 20 步；\n   - 确定性采样重绘（Sampler Upscale）：使用 4x-UltraSharp 放大模型，Denoise 推荐 0.28-0.35，Upscale CFG 设为 6.0，注重原画结构保真；\n   - 祖先采样重绘（Ancestral Upscale）：采样器切换为 euler_ancestral 或 dpmpp_2s_ancestral，Denoise 推荐 0.30-0.35，适合为毛发、织物及背景注入随机真实噪波。","t":["显存防爆与并行执行策略：本工作流包含 4 路 CFG 扫描及 3 轨超分采样器，若一次性全部排队运行可能导致低显存设备报 OOM。初次使用建议将不需要的放大支路通过快捷键 Ctrl+M 进行静音（Mute）或停用，单跑主线或单测 CFG 组，逐步释放算力。","CLIP-L 增强节点妙用：工作流中提供的 Positive Boost 与 Negative Boost 专为 CLIP-L 通道设计，可向其中注入如“photorealistic, 8k, sharp focus”或反向“deformed, blurry”等纯画质标签，与主文本框中的主题描述解耦，避免长提示词污染主题语义。","祖先采样与确定性采样的风格匹配：在放大环节，人物肖像与商业海报推荐使用 Sampler Upscale（确定性算法），五官与边缘稳定不飘；而在处理大自然风光、奇幻插画或复杂水体等高熵场景时，推荐使用 Ancestral Upscale（祖先随机算法），其新长出的细节丰富度远超常规插值放大。"],"n":"本工作流为包含 100+ 节点的超大型复合全景架构，显存推荐 12GB（如 RTX 3060/4070）或以上；前置依赖需安装 SDXL 1.0 官方基模（sd_xl_base_1.0.safetensors）、高质量 VAE（sdxl_vae.safetensors）以及 4x 超分模型（如 4x-UltraSharp.pth）；需确保安装 ComfyUI 基础自定义节点包，若使用 ControlNet 分支还须提前下载 SDXL 适配的 ControlNet 权重。","na":{"10":{"brief":"SDXL 基础模型加载器","detail":"加载 SDXL 1.0 核心 Checkpoint 权重，输出主干模型（MODEL）与底层双 CLIP 编码流，作为全管线所有采样与放大分支的算力底座。"},"455":{"brief":"SDXL 双通道正向文本编码器","detail":"支持同时解析 OpenCLIP ViT-bigG 与 CLIP ViT-L 两个独立文本编码器，结合剪裁坐标（Crop Coordinates）与目标尺寸，提供原生的高质量正向语义引导。"},"548":{"brief":"CFG 矩阵扫描采样器 A","detail":"四路横向评估支路的核心采样算子之一，接收低阶 CFG 设定，在相同初始潜空间与噪声下执行快速去噪，用于呈现低对比度柔和画风。"},"626":{"brief":"超分辨率模型加载器","detail":"载入 ESRGAN 系列高精度神经网络超分模型（如 4x-UltraSharp），为后续的 Sampler Upscale 与 Ancestral Upscale 提供像素级几何与结构基础放大。"},"628":{"brief":"主线基准 KSampler 采样核心","detail":"基于全局默认最优参数（Seed/Steps/CFG/Scheduler）执行一次性基础潜空间采样，产出整个工作流的核心基准母图。"},"636":{"brief":"确定性采样二次重绘核心","detail":"采用确定性采样算法（如 DPM++ 2M Karras）与低重绘幅度（0.30 左右），严格基于模型放大后的几何结构微调表面质感，最大化保持原画形体。"},"640":{"brief":"随机祖先采样二次创作核心","detail":"接入具有随机噪声扰动的 Ancestral 采样器（如 Euler Ancestral），在放大重绘过程中主动生成丰富、逼真且不可预测的全新高频纹理细节。"},"648":{"brief":"模型级像素超分放大算子","detail":"利用超分模型将基准图像无损放大 2x-4x 像素倍数，消除锯齿伪影并预先重建微观边缘，随后重新编码为潜空间送入二次采样器。"},"705":{"brief":"潜空间双线性放大器","detail":"直接在 Latent 潜空间层面执行数学双线性插值放大，绕过像素编码解码环节，搭配稍高去噪幅度（0.55）执行轻量级快速高清重构。"},"710":{"brief":"ControlNet 约束注入器","detail":"为整个工作流引入姿态、深度或边缘等外部先验约束，确保多路并行采样以及放大阶段的整体几何拓扑与目标图严格一致。"}}}}