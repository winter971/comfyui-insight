:"483","toIn":0},{"from":"483","fromOut":0,"to":"484","toIn":0},{"from":"476","fromOut":0,"to":"485","toIn":0},{"from":"487","fromOut":0,"to":"488","toIn":0},{"from":"487","fromOut":1,"to":"488","toIn":1},{"from":"489","fromOut":1,"to":"488","toIn":2},{"from":"492","fromOut":2,"to":"490","toIn":0},{"from":"492","fromOut":0,"to":"491","toIn":0},{"from":"476","fromOut":0,"to":"491","toIn":1},{"from":"488","fromOut":0,"to":"492","toIn":0},{"from":"488","fromOut":1,"to":"492","toIn":1},{"from":"488","fromOut":2,"to":"492","toIn":2},{"from":"491","fromOut":0,"to":"493","toIn":0},{"from":"506","fromOut":0,"to":"496","toIn":0},{"from":"504","fromOut":0,"to":"496","toIn":1},{"from":"504","fromOut":1,"to":"496","toIn":2},{"from":"504","fromOut":2,"to":"496","toIn":3},{"from":"503","fromOut":0,"to":"497","toIn":0},{"from":"496","fromOut":0,"to":"498","toIn":0},{"from":"502","fromOut":0,"to":"498","toIn":1},{"from":"498","fromOut":0,"to":"499","toIn":0},{"from":"503","fromOut":0,"to":"500","toIn":0},{"from":"508","fromOut":0,"to":"500","toIn":1},{"from":"500","fromOut":0,"to":"501","toIn":0},{"from":"501","fromOut":0,"to":"504","toIn":0},{"from":"497","fromOut":0,"to":"504","toIn":1},{"from":"502","fromOut":0,"to":"504","toIn":2},{"from":"514","fromOut":1,"to":"504","toIn":3},{"from":"512","fromOut":0,"to":"504","toIn":4},{"from":"516","fromOut":0,"to":"505","toIn":0},{"from":"505","fromOut":0,"to":"506","toIn":0},{"from":"498","fromOut":0,"to":"507","toIn":0},{"from":"509","fromOut":0,"to":"510","toIn":0},{"from":"509","fromOut":1,"to":"510","toIn":1},{"from":"511","fromOut":1,"to":"510","toIn":2},{"from":"514","fromOut":2,"to":"512","toIn":0},{"from":"514","fromOut":0,"to":"513","toIn":0},{"from":"498","fromOut":0,"to":"513","toIn":1},{"from":"510","fromOut":0,"to":"514","toIn":0},{"from":"510","fromOut":1,"to":"514","toIn":1},{"from":"510","fromOut":2,"to":"514","toIn":2},{"from":"513","fromOut":0,"to":"515","toIn":0}],"ai":{"s":"Flux Fill 五档精度对照测评工作流：同一张涂好遮罩的建筑图、同一句 A European building.，分别用 fp8 fast、BF16 gguf、Q8_0、Q6_K、Q4_K_M 五种 flux1-fill-dev 权重跑同一条重绘链路，实测显存、耗时与 PPL 质量差（结论写在各 Note：如 Q8_0 为 8-10G 显存 99 秒 PPL+0.0026，Q4_K_M 为 6-8G 显存 66 秒 PPL+0.1754）。每条支线同构：主遮罩与 context 遮罩经 InpaintResize 缩放，InpaintCrop 按 ranged size 1024 裁出重绘邻域，GrowMaskWithBlur(2/2) 微扩后交 InpaintModelConditioning 组装条件与裁剪潜空间；KSampler 20 步 euler、CFG=1、FluxGuidance=30 采样，VAEDecode 后由 InpaintStitch 用 bislerp 把裁剪区缝回原图。五条支线唯一变量是加载器里的模型文件——控制变量就靠这样连。","u":["为自己的显卡实测选出 flux1-fill-dev 的最合适量化档位","对比不同 GGUF 精度对局部重绘质量的实际影响","学习 InpaintCrop 加 InpaintStitch 的裁剪-重绘-缝合标准接法","大图小修：只算遮罩邻域省显存省时间"],"d":2,"st":[{"name":"输入与重绘区裁剪","desc":"载入带遮罩的原图与 context 遮罩，缩放后只裁出遮罩邻域参与采样，这是省显存省时间的核心设计。","nodes":["97","99","98","102","443","445","444","448","465","467","466","470","487","489","488","492","509","511","510","514"]},{"name":"遮罩微扩","desc":"expand2 加 blur2 把遮罩边缘外扩柔化，让重绘区与保留区过渡自然，五条支线统一参数保证可比性。","nodes":["100","446","468","490","512"]},{"name":"条件装配","desc":"每条支线独立的双 CLIP、正向提示词、guidance 30 与空负向，构成 Fill 模型要求的标准条件对。","nodes":["88","95","84","85","81","89","437","442","433","434","430","438","459","464","456","457","453","460","481","486","478","479","475","482","503","508","500","501","497","504"]},{"name":"五档模型加载与采样缝合输出","desc":"五份不同精度的 Fill 权重是唯一变量，采样缝合链完全同构，差异全部归因于量化档位。","nodes":["86","90","92","80","87","82","101","83","103","450","439","440","429","431","447","449","432","472","461","462","452","454","455","469","471","494","483","484","474","476","477","491","493","516","505","506","496","498","499","513","515"]}],"p":"","n":"需要 ComfyUI-GGUF 插件与 flux1-fill-dev 的 BF16/Q8_0/Q6_K/Q4_K_M 四个 gguf 加官方 fp8 共五份权重；InpaintCrop/InpaintStitch 来自 lqueso 的 Inpaint 节点包；五条支线互不依赖，可单独旁路执行。","f":["① 五条支线各自载入两张图：主图（97/443/465/487/509）带 MaskEditor 涂好的重绘遮罩，第二张（99/445/467/489/511）提供 context_mask 决定裁剪时给模型看多少周边","② InpaintResize（98/444/466/488/510）把图与两块遮罩缩到 ensure minimum size 1024","③ InpaintCrop（102/448/470/492/514）按 ranged size 1024（下限 512）裁出重绘邻域，输出裁剪图、裁剪遮罩与 STITCH 缝合记录","④ GrowMaskWithBlur（100/446/468/490/512）expand2+blur2 微扩遮罩，进 InpaintModelConditioning 的 mask 槽","⑤ 各支线双 CLIP（88/437/459/481/503）编码 PrimitiveNode 的 A European building.，经 CLIPTextEncode 与 FluxGuidance(30) 成正向；空文本 CLIPTextEncode 作负向","⑥ 五个加载器（86 fp8 fast / 450 BF16 gguf / 472 Q8_0 / 494 Q6_K / 516 Q4_K_M）各接 DifferentialDiffusion 与 MZ_Flux1PartialLoad_Patch(7,7) 后进各自 KSampler","⑦ KSampler（80/429/452/474/496）20 步 euler、CFG=1、denoise=1，VAEDecode 用各支线的 flux_ae 解码","⑧ InpaintStitch（101/447/469/491/513）按 STITCH 记录用 bislerp 把重绘结果缝回原图，预览并 SaveImage"],"t":["五条支线同跑显存叠加，建议整组旁路只留要测的一条","换测评对象：五对 LoadImage 换同一张新图并在 MaskEditor 重涂，五个 PrimitiveNode 的提示词同步改，保持控制变量","MZ_Flux1PartialLoad_Patch 的 7/7 分层加载档位是低显存关键，测显存下限时别关","选型直接看 Note 数据：12G 以上用 BF16/Q8_0 基本无损，6-8G 用 Q4_K_M 但要接受 PPL+0.1754 的可见劣化","context_mask 决定裁剪窗口给模型看多少周边，遮罩贴着画面边缘时务必给足 context，否则缝合处会跳"],"na":{"80":{"brief":"fp8 支线采样。","desc":"20 步 euler、CFG=1、denoise=1、种子固定；五条支线的种子只有末位不同，用于区分输出文件。","params":[{"name":"steps","kind":"整数","default":"20","desc":"测评固定步数，日常可降 12 提速"}]},"81":{"brief":"空文本负向条件。","desc":"CLIPTextEncode 不填文本作负向，Fill 重绘主要靠遮罩约束，负向保持空即可。"},"82":{"brief":"解码裁剪潜空间。","desc":"VAEDecode 输出的是裁剪窗口内的成图，还不是完整画面，必须经 101 缝回。"},"84":{"brief":"编码正向提示词（fp8 支线）。","desc":"CLIPTextEncode 接 95 的文本与 88 的 CLIP，经 85 FluxGuidance 包上 guidance=30 成 Fill 标准正向。"},"85":{"brief":"设定 guidance=30。","desc":"Flux Fill 用远高于普通 dev 的引导强度贴紧结构；测质量差异时它是固定量，别动。"},"86":{"brief":"fp8 fast 官方权重（对照组基准）。","desc":"flux1-fill-dev 的 fp8_e4m3fn_fast 加载，Note 428 记录约 72 秒、7-10GB；它与其余四档的差值就是量化损失。"},"87":{"brief":"fp8 支线的 Flux VAE。","desc":"flux_ae.sft 供编码与解码；其余支线各自持有同款（436/458/480/502），保证解码一致。"},"88":{"brief":"fp8 支线的双 CLIP。","desc":"clip_l + t5xxl_fp16 按 flux 类型加载；其余四条支线各有一份同配置的 DualCLIPLoader（437/459/481/503）。"},"89":{"brief":"组装 Fill 重绘条件与潜空间。","desc":"InpaintModelConditioning 拿 102 的裁剪图当 pixels、100 的遮罩当 mask、87 的 VAE 编码，输出条件对与裁剪潜空间给 80。"},"90":{"brief":"差异化扩散补丁（fp8 支线）。","desc":"DifferentialDiffusion 让遮罩边缘噪声按像素差异化，五条支线都挂了同款（439/461/483/505）。"},"92":{"brief":"分层加载主干省显存（fp8 支线）。","desc":"MZ_Flux1PartialLoad_Patch 两档 7，逐层换入换出 FLUX 主干；测显存数据时它必须保持一致才可比。"},"95":{"brief":"正向提示词原文。","desc":"PrimitiveNode 的 A European building. 是五条支线共用的测评文本，换成自己的描述时五处要同步。"},"97":{"brief":"载入带重绘遮罩的建筑图（fp8 支线）。","desc":"clipspace 缓存图，遮罩在 MaskEditor 里涂；每条支线各有一份同样的 LoadImage 保证五路输入完全一致。"},"98":{"brief":"图与双遮罩统一缩放。","desc":"InpaintResize 用 bicubic 缩到 ensure minimum size 1024，保证裁剪与缝合的坐标基准一致。"},"99":{"brief":"载入 context 遮罩（fp8 支线）。","desc":"第二张 clipspace 图的 alpha 作 optional_context_mask，决定 InpaintCrop 裁剪时把多大范围的原图喂给模型看。"},"100":{"brief":"微扩微糊重绘遮罩。","desc":"expand=2、blur=2 的保守参数，让遮罩边缘多覆盖一两个像素的过渡带，五条支线一致。"},"101":{"brief":"把重绘结果缝回原图。","desc":"InpaintStitch 按 102 的 STITCH 记录用 bislerp 插值缝合，窗口外像素原样保留，无坐标错位。"},"102":{"brief":"裁出重绘邻域并记录缝合信息。","desc":"InpaintCrop 按 ranged size 1024（下限 512）裁出遮罩周边区域，输出 STITCH 供 101 缝回、裁剪图与遮罩进采样链；大图小修的核心节点。","params":[{"name":"min_size/max_size","kind":"整数","default":"1024/512","desc":"裁剪窗口上下限，遮罩大就放大窗口"}]},"428":{"brief":"fp8 fast 的测评记录。","desc":"Note 写明 72 秒、7-10GB 与 PPL 观察区间，是对照组的基准数据。"},"450":{"brief":"BF16 gguf 权重（质量上限组）。","desc":"flux1-fill-dev-BF16.gguf 是精度最高的 gguf 档，Note 451 记录 200 秒、12-16G、PPL -0.0050，适合当质量基准。"},"451":{"brief":"BF16 gguf 的测评记录。","desc":"200 秒、12-16G、PPL -0.0050；最慢但质量最高，给有余力的卡。"},"452":{"brief":"Q8_0 支线采样。","desc":"与 80 完全同参数，唯一区别是上游加载器换成了 472 的 Q8_0 权重；其它支线同理，这正是对照实验的接法。"},"472":{"brief":"Q8_0 量化权重（推荐平衡档）。","desc":"Note 473 记录 8-10G 显存 99 秒、PPL +0.0026，质量几乎无损，是多数 12G 卡的最佳选择。"},"473":{"brief":"Q8_0 的测评记录。","desc":"8-10G 显存、99 秒、PPL +0.0026；性价比最高的档位结论。"},"494":{"brief":"Q6_K 量化权重。","desc":"Note 495 记录 7-9G 显存 96 秒、PPL +0.0217，轻度劣化，10G 以下卡的务实选择。"},"495":{"brief":"Q6_K 的测评记录。","desc":"7-9G 显存、96 秒、PPL +0.0217；轻度劣化换 2G 显存。"},"516":{"brief":"Q4_K_M 量化权重（极限省显存档）。","desc":"Note 517 记录 6-8G 显存 66 秒、PPL +0.1754，劣化肉眼可见，只给低显存应急。"},"517":{"brief":"Q4_K_M 的测评记录。","desc":"6-8G 显存、66 秒、PPL +0.1754；劣化明显，仅低显存应急。"}}}}