om":"62","fromOut":0,"to":"24","toIn":3},{"from":"226","fromOut":0,"to":"21","toIn":1},{"from":"1","fromOut":0,"to":"227","toIn":0},{"from":"227","fromOut":0,"to":"28","toIn":0},{"from":"173","fromOut":0,"to":"177","toIn":0},{"from":"175","fromOut":0,"to":"177","toIn":1},{"from":"6","fromOut":0,"to":"28","toIn":1},{"from":"6","fromOut":0,"to":"37","toIn":0},{"from":"181","fromOut":0,"to":"229","toIn":0},{"from":"229","fromOut":0,"to":"79","toIn":0},{"from":"229","fromOut":0,"to":"113","toIn":0},{"from":"173","fromOut":0,"to":"55","toIn":0},{"from":"173","fromOut":0,"to":"116","toIn":0},{"from":"116","fromOut":0,"to":"230","toIn":0},{"from":"230","fromOut":0,"to":"71","toIn":0},{"from":"199","fromOut":0,"to":"168","toIn":2},{"from":"192","fromOut":0,"to":"166","toIn":2},{"from":"22","fromOut":0,"to":"226","toIn":0},{"from":"213","fromOut":0,"to":"170","toIn":2},{"from":"112","fromOut":0,"to":"130","toIn":0},{"from":"230","fromOut":0,"to":"112","toIn":0},{"from":"221","fromOut":0,"to":"172","toIn":2},{"from":"130","fromOut":0,"to":"125","toIn":0},{"from":"111","fromOut":1,"to":"232","toIn":0},{"from":"232","fromOut":0,"to":"151","toIn":1},{"from":"126","fromOut":1,"to":"233","toIn":0},{"from":"233","fromOut":0,"to":"131","toIn":0}],"ai":{"s":"基于 SD 1.5 底模打造的经典程序化超高细节注入与图像重绘增强工作流。该方案彻底革新了传统工作流中繁琐的手动参数微调流程，创新性地设计了一套由单个「疯狂度/细节等级（How crazy I am，1-10 档）」滑块驱动的数学运算与双模态条件分支状态机。工作流无缝融合 Add Detail 细节 LoRA、ControlNet Tile 空间锁形以及模型物理超分辨率放大，在后台动态解算并联动控制重绘去噪比（Denoise）、LoRA 注入强度、Tile 下采样模糊因子及真实放大系数，实现从微观质感微妙修饰（Subtle）到高频几何纹理暴力涌现（Insane）的全自动自适应平滑演进。","u":["低分辨率或模糊 AI 图像的高清细节补全与微观质感重建（如人像皮肤毛孔、发丝、服装织物纤维与环境材质细化）","概念设计与复杂场景的超高频纹理重塑（如科幻机械接缝、机甲面板刻线、赛博朋克复杂夜景细节爆破）","批量自动化高质量图生图放大管线，免除在不同图像间反复调试重绘幅度与 LoRA 权重的试错成本"],"d":2,"st":[{"name":"模型与控制条件初始化","desc":"加载 SD 1.5 基础模型、外置高保真 VAE 与 ControlNet Tile 模型，对 CLIP 文本编码器进行末层截断设置；载入核心细节增强 LoRA，并对正负向多行提示词进行条件特征编码与初始路由分发。","nodes":["5","6","9","24","11","88","100","7","8","62","101","102"]},{"name":"动态细节度调度算法与数学逻辑引擎","desc":"工作流的自动化调度大脑。接收用户设定的疯狂度等级（1-10）与模式切换阈值，通过差值计算与字符串条件判断触发 Mode 1（轻度线性累加）与 Mode 2（强力非线性爆发）双状态机切换；经由数值开关矩阵（Number Input Switch）与算术节点群，动态解算出最终的 LoRA 强度、Denoise 去噪比、Tile 下采样因子及降采样尺寸补偿系数，并将运行状态实时打印至控制台。","nodes":["173","175","188","190","194","196","201","203","216","218","189","191","195","197","202","204","217","219","174","198","177","184","224","181","225","211","165","166","167","168","169","170","171","172","47","48","71","72","76","110","111","125","126","135","154","85","86","114","129","156","37","52","55","79","83","84","112","113","116","128","130","131","134","155","192","199","205","207","212","213","220","221","226","227","229","230","232","233"]},{"name":"图像预处理、超分辨率模型放大与 Tile 条件构建","desc":"载入原始图像并通过超分神经网络模型进行物理超分辨率拉伸，依据计算所得的真实缩放系数进行尺寸规整；随后将规整图像经过数学引擎计算的 Tile Desample 模糊/下采样处理，输入 ControlNetApplyAdvanced 构建既锁死大体构图轮廓、又为局部微观细节重构留出充分空间域的控制引导条件。","nodes":["1","18","17","19","151","12","22","26"]},{"name":"潜在空间双路重采样与重绘生成","desc":"将预处理图像通过 VAE 编码为潜在空间表征，结合 Latent 缩放节点与分支切换开关选择最优潜空间输入源；KSampler 结合动态 LoRA 模型注入、数学自适应 Denoise 去噪比与 Tile 空间条件，执行高频纹理重新合成与潜空间降噪去伪影。","nodes":["10","28","27","164","14"]},{"name":"图像解码与结果保存","desc":"将重绘完成的高精细潜空间张量送入专用 VAE 解码器恢复为全分辨率 RGB 像素图像，最终持久化保存生成成果。","nodes":["21","23"]}],"p":"【参数调优建议】1. 核心控制滑块「How crazy I am (173)」：基准推荐设为 2 至 5 档。人像修饰推荐 2-4 档，可在保持自然面部特征的同时强化睫毛、发丝与肤质；概念场景、机械机甲可开至 5-8 档激发丰富的细部构造；9-10 档属于极端过载模式，仅适合抽象或高密度几何重绘。2. 模式阈值「Toggle mode at (175)」：默认保持为 5 或 6，低于该值执行平稳线性渐进，高于该值跨入强力重塑。3. 尺寸补偿「Descale (174 / 198)」：若原图分辨率较高（大于 1024x1024），在使用 4x 超分模型时务必将 Descale 设为 0.25 至 0.5，避免中间潜空间尺寸暴涨导致显存溢出。4. KSampler (14)：建议步数保持 20-30 步，推荐采用 dpmpp_2m_sde_gpu 搭配 karras 调度器。","t":["【Tile Desample 下采样机理】ControlNet Tile 的下采样模糊因子并非越大越好。该数值越小，送入 Tile 的先验参考图越清晰，原图轮廓被强行锚定，新细节生长受限；当该数值经数学引擎适当提升后，图像宏观轮廓得以保留，但高频细节被模糊，为 Add Detail LoRA 与重绘噪声提供了极佳的细节涌现创作空间。","【避免高倍率物理超分导致的显存爆炸】工作流内部整合了 ImageUpscaleWithModel 与 LatentUpscaleBy 两级放大。如果直接输入高分辨率图像且未开启 Descale 降采样补偿，物理放大后像素将成倍翻番，后续 VAE 编码与重绘采样将极易触发 CUDA OOM。建议输入图像保持在 512~1024 像素基准尺寸。"],"n":"运行本工作流需预先准备 SD 1.5 基础大模型权重、Add Detail 专用细节增强 LoRA（如 add_detail.safetensors）、ControlNet Tile 模型（control_v11f1e_sd15_tile.pth）以及 ESRGAN/Upscale 模型（如 4x-UltraSharp）。由于工作流高度依赖数学逻辑、常数定义与控制台调试节点，请确保环境中已正确安装常用基础自定义扩展。重绘阶段显存峰值与最终像素尺寸正相关，建议在 8GB 及以上 VRAM 环境下运行。","na":{"12":{"brief":"ControlNet Tile 高阶应用节点","detail":"接收经过动态模糊/下采样处理的引导图像，在保留主体空间布局与结构特征的前提下，释放局部潜空间自由度以供高频细节填充。"},"14":{"brief":"核心 KSampler 重采样与重绘器","detail":"在动态解算的自适应 Denoise 去噪比控制下，综合正负向提示词、注入 LoRA 后的主模型以及 Tile 空间约束，执行最终的细节合成采样。"},"17":{"brief":"模型驱动超分辨率图像放大器","detail":"在图生图采样前使用 4x 超分模型对原图进行高品质物理拉伸，为后续重绘提供细密的高分辨率像素画布。"},"24":{"brief":"Add Detail 专用细节 LoRA 动态加载器","detail":"加载细节增强型低秩适应模型，其模型强度与 CLIP 强度直接由数学引擎解算得出的 LoRA strength 实时控制。"},"72":{"brief":"真实放大倍率动态解算节点","detail":"综合考虑用户设定目标倍率、超分模型固有放大因子以及大图 Descale 降采样系数，计算出传递给后续尺度规整节点的精准比例。"},"165":{"brief":"动态参数双模多路选择开关","detail":"根据模式切换判断条件（Mode 1 vs Mode 2），在轻度线性递增参数与重度非线性爆发参数之间自动切换通路。"},"173":{"brief":"全局疯狂度/细节等级核心控制常数","detail":"整个自动化工作流的核心交互接口。输入 1 至 10 的整数或浮点数，直接驱动下游数学运算网络，联动解算并控制 LoRA 权重、Denoise 去噪比、Tile 模糊因子与放大系数。"},"181":{"brief":"模式切换文本逻辑判定算子","detail":"作为巧妙的逻辑中继，通过判定差值计算结果中是否包含特定标识，输出布尔开关信号以驱动多路输入选择器。"}}}}