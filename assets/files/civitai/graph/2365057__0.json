Out":2,"to":"145","toIn":2},{"from":"140","fromOut":0,"to":"145","toIn":3},{"from":"158","fromOut":0,"to":"145","toIn":4},{"from":"155","fromOut":1,"to":"146","toIn":0},{"from":"148","fromOut":0,"to":"149","toIn":0},{"from":"155","fromOut":1,"to":"150","toIn":0},{"from":"155","fromOut":0,"to":"153","toIn":0},{"from":"153","fromOut":0,"to":"157","toIn":0},{"from":"145","fromOut":0,"to":"157","toIn":1},{"from":"145","fromOut":1,"to":"157","toIn":2},{"from":"139","fromOut":0,"to":"157","toIn":3},{"from":"144","fromOut":0,"to":"159","toIn":0},{"from":"54","fromOut":0,"to":"135","toIn":0},{"from":"164","fromOut":0,"to":"150","toIn":1},{"from":"136","fromOut":0,"to":"138","toIn":1},{"from":"8","fromOut":0,"to":"138","toIn":0},{"from":"136","fromOut":0,"to":"141","toIn":0},{"from":"136","fromOut":0,"to":"159","toIn":1},{"from":"136","fromOut":0,"to":"168","toIn":0}],"ai":{"s":"Flux 换背景加参考图打光的双段工作流：第一段把主体从原图抠出（RMBG-2.0），合成到白底画布后用 Flux 重绘背景——Florence2 自动描述主体生成提示词，Redux 风格模型把新背景参考图的语义注进条件，Union ControlNet 的深度图锁住主体轮廓，25 步换背景；ColorAdapter 把成图色调对齐到参考图。第二段切 SD1.5 加 IC-Light：换背景图放大后编码成前景潜空间，iclight_sd15_fc 按 0.3 系数重打光，让主体光影与新背景的「自然光线」一致，DetailTransfer 以 soft_light 把细节贴回，百度翻译节点把中文光照描述自动转英文进提示词。两段成图与对比图分别归档，是电商级「换背景还光线匹配」的完整方案。","u":["电商产品换背景：白底产品放进任意场景图，光影自动匹配","人像换景不穿帮：深度锁主体加 IC-Light 重打光，边缘与光感双自然","参考图驱动的氛围复刻：新背景的光线方向与色温跟参考图走","中文指令流：百度翻译把中文光照描述转英文，不懂英文提示词也能用"],"d":3,"st":[{"name":"主体抠图与画布合成","desc":"RMBG 抠主体、两级 GrowMask 修边、三次合成贴上白底画布——换背景的底稿与遮罩体系。","nodes":["1","8","15","67","64","69","85","62","70","54","45","48","75","71","74"]},{"name":"语义提示词与 Redux 风格注入","desc":"Florence2 自动描述加质量词前缀，Redux 把参考图视觉语义转成条件——新背景的「长相」与「氛围」双通道。","nodes":["13","20","18","16","21","36","37","5","59","60","58"]},{"name":"Flux 换背景采样","desc":"深度锁主体的 Union ControlNet 加遮罩潜空间，25 步换背景后贴回合成。","nodes":["7","120","29","122","3","42","41","57","56","43","6","46"]},{"name":"色彩对齐与 IC-Light 打光收尾","desc":"色调先对齐参考图，SD1.5 挂 IC-Light 按中文翻译指令重打光，细节回贴后归档。","nodes":["136","138","141","140","155","153","150","146","164","145","157","144","159","168","135","137","142","139"]}],"p":"抠图遮罩是地基；GrowMask 一负一正修边；ControlNet 0.5 限前 70%；IC-Light multiplier 0.3 轻打光；百度翻译需自备 Key（可手写英文替代）。","n":"需 Flux dev fp8、iclight_sd15_fc、SD1.5、RMBG-2.0、Florence-2、flux1-redux、sigclip vision、Union ControlNet 与大量节点包；百度翻译 API 凭据自备且勿外传；两段分属 Flux 与 SD1.5 显存可分段跑；主体抠图质量决定全程上限。","f":["① 主体抠图：1 载入原图经 8 对齐，15 RMBG-2.0 抠出主体 MASK，67/64 两级 GrowMask 微调边缘","② 画布合成：85 读新背景参考图尺寸，69 出白底画布，70/62/54 三次 ImageCompositeMasked 把主体按遮罩贴上画布——换背景的「底稿」成形","③ 提示词工程：20 Florence2 对合成图跑 more_detailed_caption（shoe 查询），与 18 的质量词前缀在 16 拼接（21 展示），36 编码进条件","④ Redux 风格注入：59/60 载入 flux1-redux 与 sigclip vision，58 ReduxAdvanced 把合成图的视觉语义（含遮罩限定的 0.1 边距）转成条件","⑤ Flux 换背景采样：62 的合成图经 120 出深度图，29 Union ControlNet（0.5、0→0.7）锁主体轮廓，41 InpaintModelConditioning 配 56 的遮罩潜空间，43 KSampler 25 步换背景，46 解码后 54 贴回合成","⑥ 色彩对齐：136 ColorAdapter 把成图色调向 48 的参考图对齐，137 存档、138 与原图对比","⑦ IC-Light 打光：141 放大到 2560 长边，140 用 SD1.5 VAE 编码成前景潜空间；153 给 SD1.5 挂 IC-Light UNet，145 ICLightConditioning 以 0.3 系数配 150 的光照提示词（164 百度翻译把「自然光线，柔和的光线」自动转英文）","⑧ 157 KSampler 20 步 dpmpp_2m 重打光采样，144 解码后 159 DetailTransfer 以 soft_light 0.2 把细节贴回，168 清显存收尾"],"t":["RMBG 的抠图质量是全程地基：发丝级主体先在 15 换模型档位，边缘不干净后面全白搭","64/67 两级 GrowMask 一负一正：先收缩防白边再外扩给融合余量，参数别同时为正","29 的 ControlNet 只作用 0→0.7 区间：换背景阶段后期放权给 Redux，主体轮廓前段锁够即可","58 的 Redux 遮罩边距 0.1：风格语义只从参考图中心取，边缘杂讯不进条件","136 的 ColorAdapter 在 IC-Light 之前做：色调先对齐再打光，两步顺序颠倒会互相打架","164 的百度翻译需自备 API 凭据：不想配 API 就把 150 的英文提示词手写","IC-Light 的 multiplier 0.3 是轻度打光：光影差异大升到 0.5，主体本来就该暗就降","159 的 soft_light 0.2 是细节回贴：打光后皮肤细节丢了靠它找回来"],"na":{"1":{"brief":"主体原图输入。","desc":"待换背景的图：进 8 对齐后一路抠图、一路做后续合成的基底。","params":[]},"8":{"brief":"原图对齐缩放。","desc":"LayerUtility 按 longest=1024 letterbox 对齐，MASK 口带出原图遮罩；全链的统一尺寸基准。","params":[]},"15":{"brief":"RMBG-2.0 主体抠图。","desc":"输出抠好的主体图与 MASK——发丝级分割是换背景不穿帮的地基，模型档位可在下拉里换。","params":[]},"16":{"brief":"提示词拼接。","desc":"质量词前缀与 Florence2 描述合成完整正向，进 21 展示与 36 编码。","params":[]},"20":{"brief":"Florence2 主体描述。","desc":"more_detailed_caption 加 shoe 查询词自动写主体描述——换什么主体改查询词即可。","params":[]},"29":{"brief":"Union ControlNet 轮廓锁定。","desc":"深度图以 0.5 强度、0→0.7 区间写进条件——主体轮廓前段锁死，后期放权给 Redux 自由画背景。","params":[]},"41":{"brief":"换背景条件打包。","desc":"InpaintModelConditioning 组合 Redux 后的条件、Flux VAE、合成图与遮罩；noise_mask=false 走全画布重绘。","params":[]},"43":{"brief":"Flux 换背景采样器。","desc":"25 步 euler CFG=1 从遮罩潜空间采出新背景；DifferentialDiffusion 在模型侧护航。","params":[]},"48":{"brief":"参考图输入（打光与色调基准）。","desc":"新背景的氛围来源：136 拿它对色调、IC-Light 段的光线方向以它为锚。","params":[]},"54":{"brief":"最终合成底稿。","desc":"三次合成后的完整画布：主体在白底上的「待换背景」状态，进 135 存档与对比。","params":[]},"58":{"brief":"Redux 风格语义注入。","desc":"ReduxAdvanced 拿合成图经 sigclip vision 转成风格条件（遮罩限定 0.1 边距），同时输出重绘区图与遮罩——新背景「长什么样」的语义来源。","params":[]},"59":{"brief":"加载 flux1-redux。","desc":"风格迁移模型给 58；与 sigclip vision 成对工作。","params":[]},"62":{"brief":"主体贴上画布（第一层合成）。","desc":"ImageCompositeMasked 把抠出的主体按遮罩贴到白底上；后续 70/54 继续叠加。","params":[]},"69":{"brief":"白底画布生成。","desc":"按 85 读出的参考图尺寸出白底 Image Blank——主体即将被贴上去的新画布。","params":[]},"70":{"brief":"遮罩层合成（第二层）。","desc":"把 RMBG 的遮罩可视化为合成图供 Florence2 描述与 Redux 取样——语义通道的素材。","params":[]},"122":{"brief":"Differential Diffusion 补丁。","desc":"让去噪逐像素尊重遮罩——主体与背景的交界过渡靠它平滑。","params":[]},"136":{"brief":"色调对齐参考图。","desc":"ColorAdapter 把换背景成图的色调向 48 参考图校准（31 档）——打光前的色彩统一。","params":[]},"141":{"brief":"打光段放大。","desc":"按 147 的 1536 基准放大到 2560 长边——IC-Light 需要足够分辨率才能打出细光影。","params":[]},"145":{"brief":"IC-Light 条件组装。","desc":"ICLightConditioning 以 0.3 系数把前景潜空间与光照条件打包——打光强度的总阀门。","params":[{"name":"multiplier","kind":"浮点","default":"0.3","desc":"打光强度；差异大升 0.5"}]},"150":{"brief":"光照正向提示词。","desc":"best quality 系加（经翻译的）光照描述；英文成稿由 164 供给。","params":[]},"153":{"brief":"挂载 IC-Light UNet。","desc":"LoadAndApplyICLightUnet 把 iclight_sd15_fc 的光照先验写进 SD1.5——第二段的模型改造点。","params":[]},"155":{"brief":"加载 SD1.5 检查点（打光段基座）。","desc":"v1-5 pruned 三路输出：模型给 IC-Light UNet、CLIP 给打光提示词、VAE 给前景编码与解码。","params":[]},"157":{"brief":"IC-Light 重打光采样器。","desc":"20 步 dpmpp_2m/karras CFG=3 在 SD1.5 上重打光——与第一段的 Flux 采样完全独立的第二引擎。","params":[]},"159":{"brief":"细节回贴。","desc":"DetailTransfer 以 soft_light 0.2 把打光前的细节贴回打光后的图——光影换了、纹理不丢。","params":[]},"164":{"brief":"百度翻译节点。","desc":"把中文光照描述（自然光线，柔和的光线）自动译成英文进 150——需在节点里自备 API 凭据；不想配 API 就手写英文。","params":[]}}}}