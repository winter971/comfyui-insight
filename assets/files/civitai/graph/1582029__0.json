:"519","fromOut":0,"to":"501","toIn":0},{"from":"364","fromOut":0,"to":"386","toIn":0},{"from":"364","fromOut":0,"to":"534","toIn":0},{"from":"534","fromOut":0,"to":"34","toIn":0},{"from":"534","fromOut":0,"to":"32","toIn":0},{"from":"534","fromOut":0,"to":"83","toIn":0},{"from":"534","fromOut":0,"to":"300","toIn":0},{"from":"364","fromOut":0,"to":"40","toIn":0},{"from":"532","fromOut":0,"to":"491","toIn":1},{"from":"424","fromOut":0,"to":"532","toIn":0},{"from":"519","fromOut":0,"to":"364","toIn":0},{"from":"316","fromOut":0,"to":"314","toIn":0},{"from":"323","fromOut":0,"to":"537","toIn":0},{"from":"537","fromOut":0,"to":"539","toIn":0},{"from":"539","fromOut":0,"to":"538","toIn":0},{"from":"538","fromOut":0,"to":"364","toIn":1},{"from":"538","fromOut":0,"to":"326","toIn":0},{"from":"540","fromOut":0,"to":"51","toIn":0},{"from":"540","fromOut":1,"to":"481","toIn":0},{"from":"437","fromOut":0,"to":"550","toIn":0},{"from":"381","fromOut":0,"to":"551","toIn":0},{"from":"463","fromOut":0,"to":"552","toIn":0},{"from":"461","fromOut":0,"to":"553","toIn":0},{"from":"455","fromOut":0,"to":"554","toIn":0},{"from":"40","fromOut":0,"to":"555","toIn":0},{"from":"314","fromOut":0,"to":"556","toIn":0},{"from":"312","fromOut":0,"to":"557","toIn":0}],"ai":{"s":"这是一条不挂任何扩散底模的漫画自动翻译流水线（索引 models 字段为空，全程靠 OCR、LaMa 修复与在线多模态接口）。输入一张漫画页（540）或整个目录（14）由 51 二选一，519 以 nearest-exact 放大 2 倍送进 424 EasyOCR（语言表 ch_sim,en）取文字遮罩；遮罩经 310 合并批、311 按 321 滑块下移 2 像素、312 相加，把同一气泡被切碎的行并成整块，316 再拆回独立连通块，314 转遮罩、315 数出块数，交给 64 与 63 组成的 easy 循环逐块处理。每轮先由 5 LamaRemover（实参 131 | 0 | false）抹掉原文还原底图，323 取单块遮罩经 537/539/538 与 364 CropByMask（按最小外接框裁切）裁出气泡，534 缩回原倍率后送 13 Gemini 2.0 Flash（模型实参 gemini-2.0-flash-exp，模式 analysis，另有 8192 与 1 两个数值项）翻译；提示词由 15 把 10/11/9/425 四个语言名与 93 的多行 prompt 拼成一句，386 与 381 把小于 4x4 占位图的空裁块换成黑块防止链路崩。译文经 467 按 99 滑块（2 秒量级）延时写入 452 Inspire 缓存，453 回读、455 择一，避免同块重复打接口。排版是全图最讲究的一段：20 量译文长度并经 416 转成布尔驱动 407 与 408 的跳过判断，34 用裁片面积与字数的平方根之比再加 68 的修正量反推字号（表达式在存档里被截断，外层还套了 max 兜底），33 依 24 滑块在自动与 43 的手动 24 号之间切换，32 定每行字数、83 定纵向偏移、232 与 233 让描边与行距跟随字号；40 以 irohamaru-mikami-Medium.ttf 居中排字，300 与 306 生成白色圆角底板，59 与 301 两次 ImageBlendAdvance V3 按 326 的百分比坐标叠回累积图，出循环后由 46 与 48 落盘、44 播放提示音。另有五个分组开关切换翻译语言、翻译模式、加载方式、遮罩模式与是否存图。","u":["把整册外语漫画或条漫批量翻成本地语言并保留气泡位置","没有独立显卡、只想靠 OCR 加在线多模态 API 做图片文字替换","给海报、界面截图、教学图做本地化重排并自动适配字号","需要逐块调试气泡排版与描边效果的文字回填实验"],"d":3,"st":[{"name":"输入装载与 OCR 检测","desc":"单图与文件夹两种入口经 Any Switch 二选一，放大 2 倍后交给 EasyOCR 出文字遮罩，放大倍率的支路全部由 ImageScaleBy 与开关还原。","nodes":["540","14","65","51","519","424","532","501","491","481","75","550"]},{"name":"遮罩清洗与逐块拆分","desc":"遮罩合并批、垂直偏移再相加，把断行文字连成整块，随后拆成独立连通块并统计块数，作为 for 循环的总次数与每轮切片来源。","nodes":["424","310","311","321","312","313","521","485","316","314","315","463","494","323","370","372","556","557","552","456","457"]},{"name":"擦字、裁块与在线翻译","desc":"每块先用 LaMa 抹掉原文还原底图，按最小外接框裁出气泡并做小图保护，再拼提示词调 Gemini，译文经延时写进缓存并按需读回。","nodes":["64","63","5","408","393","364","534","537","539","538","386","382","381","551","13","15","10","11","9","425","93","467","99","452","453","455","205","468","505"]},{"name":"字号与换行的自适应计算","desc":"由译文长度与裁片面积反推字号、每行字数、行距、描边与垂直偏移，并提供自动与手动字号二选一，空文本时以 max 兜底为 1。","nodes":["20","416","389","407","408","392","24","43","68","116","35","33","34","32","83","232","233","258","450","437"]},{"name":"文字渲染与底板回填","desc":"取色器给出字色与描边色，SimpleTextImage 出透明文字图，圆角白底板与文字按检测框百分比坐标两次混合贴回当前累积图。","nodes":["106","107","40","300","306","59","301","326","461","553","555","554","67","72","71","423","487"]},{"name":"循环节流、存图与提示音","desc":"循环结束后统一落盘：路径经文本替换改写，两个保存节点标题带静音标记，末了触发一次提示音，整组由 image save 分组开关控制。","nodes":["53","46","48","50","49","44","47","52","503","462","63"]}],"p":"字号先走自动：24 滑块设 1 时 33 的 If-Else 取 34 的公式值，只有气泡特别窄或文字被切掉时才切到 43 的手动值（当前 24）。描边宽度由 232 的 fsize*(strk/30) 跟随字号，116 调大描边同步变粗，笔画被糊住就往回调；35 的 leading 实参落在 2 与 2.5 之间，越大行距越松。译文溢出气泡时先微调 68 的 font size correction（当前是 0，往负向收缩；若滑块下限卡住 0，就直接改 43 降字号）。321 的垂直合并量决定相邻两行文字会不会被并成一块，条漫密排时从 2 往上试。99 的 API delay 不要低于 2 秒，免费额度下更低会直接 429，宁可加时也不要改成 0。370 保持 -1 走逐块自动，填 0 会让每轮都固定取同一块，适合单独调一个气泡的排版。显存不是瓶颈，瓶颈在批量内存：14 一次读整个目录，先在 552 看清 315 给出的块数再决定批量大小。","t":["作者把 Google API Key 直接填在 13 的密钥框里（站内存档已做消毒），复用前必须换成自己的 Key，否则 OCR 跑完、翻译这步整链报错。","540 与 14 靠 51 二选一，走批量时 65 的 PrimitiveNode 要保持 increment 模式，start_index 才会自增，改成固定值就会反复读同一张图。","EasyOCR 只挂了 ch_sim 与 en，其它语种原文识别会错位；424 的输入被 519 固定放大 2 倍，字很小的页面可再对比 501 那条 x1 支路（标题带静音标记）与 532 的半倍预览。","LaMa 擦厚描边或彩色网点背景最容易留残影，可加大 321 的合并量或调粗 116 的描边盖住；真正改变擦除范围的是 323 的切片，311 的偏移只影响合并结果。","缓存键由 372 的序号经 456 与 457 拼出来，改了译文却读回旧结果时先看 505 的 ShowCachedInfo 列了哪些键；50 与 49 是作者机器的绝对路径 X 盘目录，换机器不改会直接写不出去。","46、48、53、50、52、47 标题都带静音标记，落盘支路属于作者留的可选段，只要预览时可以整组不动；反过来批量跑之前务必确认它们已被分组开关放行。","20 与 416 把译文长度转成布尔再喂给 407 与 408 的判断口，这条线一断（或返回空串）就会出现底板不透明、背景不擦字的假象，排错先查 554 的文本输出。"],"n":"自定义节点依赖很重：ComfyUI-LayerStyle（SimpleTextImage、ImageBlendAdvance V3、CropByMask、MaskBoxDetect、RoundedRectangle、ColorImage、ColorPicker）、rgthree-comfy（Any Switch、Fast Groups Muter、Label、Mute Relay 与 Repeater）、ComfyUI-easy-use（forLoopStart、forLoopEnd、ifElse、int、showAnything）、custom-scripts pysssss（MathExpression、StringFunction、PlaySound、Text Multiline、ShowText）、comfyui_essentials（BatchCount、MaskFromBatch、MaskPreview）、ComfyUI-Inspire-Pack（LoadImageListFromDir、CacheBackendData、RetrieveBackendData、ShowCachedInfo）、mxToolkit 滑块，外加 EasyOCR、LaMa 修复与 Gemini 三个外部能力。图内不含 Checkpoint（大模型底模）与 LoRA，但需要能出网的 Google Gemini 权限、本机可写的输出目录，以及系统里有 irohamaru-mikami-Medium.ttf 这类支持目标语言的字体，缺字体时中文或日韩文会渲染成方块。作者原文只给了韩语演示视频并声明没有更新计划，五个分组开关与两处静音支路都要自己逐个试。","na":{"5":{"brief":"LaMa 擦除原文","detail":"以遮罩区域做修复回填，参数 131 | 0 | false，把漫画底图恢复成无字状态。"},"13":{"brief":"Gemini 翻译","detail":"模型项为 gemini-2.0-flash-exp，工作模式 analysis，输入裁片与拼接提示词输出译文文本，另有 8192 与 1 两个数值项。"},"14":{"brief":"批量读取目录图片","detail":"从 X:\\AI\\ComfyUI\\auto_IN 按 start_index 顺序取图，并输出文件路径供后续改写文件名。"},"15":{"brief":"拼接翻译提示词","detail":"把四个语言名与多行 prompt 尾串按 5 段合成一句翻译指令，切换目标语言只改这几处。"},"20":{"brief":"统计译文字符数","detail":"统计字符数，一方面给 258 兜底为 1，另一方面经 416 转成布尔参与跳过判断。"},"32":{"brief":"算出每行可容纳字数","detail":"sqrt(字数*(裁片宽*行距/裁片高))，决定 SimpleTextImage 的 char_per_line。"},"33":{"brief":"字号自动或手动","detail":"以 24 滑块为真值，在 34 的公式字号与 43 的手动 24 号之间切换。"},"34":{"brief":"按面积反推自动字号","detail":"表达式按标题写成面积平方根除以字数平方根再加修正量，实参以 0.9 起算、外层套 max 兜底，存档把它截断在括号内。"},"40":{"brief":"渲染透明文字图层","detail":"以 irohamaru-mikami-Medium.ttf 居中排版，字号、描边、行距、字色全部由上游表达式驱动。"},"44":{"brief":"跑完播放提示音","detail":"PlaySound 以 always 模式、0.3 音量播放 notify.mp3，批量跑批时用来标记一轮结束。"},"46":{"brief":"按改写路径存图","detail":"标题带静音标记的存盘节点，接收替换后的路径与最终合成图。"},"48":{"brief":"KJ 变体存图节点","detail":"前缀与输出目录来自 50 与 49 两个文本节点，作者写的是本机绝对路径。"},"51":{"brief":"输入源二选一","detail":"把 540 的单图与 14 的批量图流到同一个下游口，切换手动调试与整册跑批两种用法。"},"53":{"brief":"输出路径改写","detail":"对 14 给出的文件路径做查找替换，把输入目录名换成输出目录名。"},"59":{"brief":"把底板混合贴回","detail":"ImageBlendAdvance V3 按检测框百分比坐标贴底板，透明度由 407 的 100 或 0 决定。"},"301":{"brief":"把文字混合叠回","detail":"第二次混合，把文字图叠到已含底板的底图上，形成该轮的累积结果。"},"306":{"brief":"生成圆角白底板","detail":"把 ColorImage V2 生成的白图切成圆角矩形并按裁片尺寸自适应，作为译文背景面板。"},"310":{"brief":"遮罩合并成批","detail":"把 EasyOCR 的多条遮罩合成批张量，供 OffsetMask 与相加节点统一处理。"},"312":{"brief":"两版遮罩相加","detail":"原始遮罩与向下偏移 2 像素的副本叠加，把同一气泡的上下两行连成一整块。"},"315":{"brief":"统计文字块数","detail":"读取拆分后的批长度，输出整数作为 easy forLoopStart 的 total。"},"316":{"brief":"拆成独立连通块","detail":"把合并后的遮罩按独立连通块拆开，一块对应一个气泡，是逐块循环的次数来源。"},"323":{"brief":"切出当轮单块","detail":"按起始序号从批遮罩里切出单块遮罩，同时供 LaMa 擦字与裁块使用。"},"326":{"brief":"算出框心坐标","detail":"从单块遮罩算出 min_bounding_rect 的 x 与 y 百分比，两次贴合都靠它定位。"},"364":{"brief":"按遮罩裁气泡","detail":"以 min_bounding_rect 方式裁出当前块区域，实参另含 10 与 5 两个数值项，裁片尺寸直接决定后续字号计算。"},"386":{"brief":"小图保护判断","detail":"比较裁片与 4x4 占位图面积，裁片过小时让 381 改传占位图，避免翻译节点报错。"},"407":{"brief":"控制底板显隐","detail":"easy ifElse，条件来自译文长度布尔，真取 392 的 100 假取 393 的 0 控制底板不透明度。"},"408":{"brief":"是否用擦除图","detail":"真走 5 的 LaMa 结果、假走循环原图，作为底板与文字的背景来源。"},"424":{"brief":"OCR 文字检测","detail":"以 ch_sim 与 en 双语检测输入图，输出文字区域遮罩、带框标注图与 JSON，整条流水线的坐标源头。"},"452":{"brief":"把译文写入缓存","detail":"Inspire 后端缓存，数据为延时后的译文，键由序号拼出，让同一块结果可被复用。"},"453":{"brief":"从缓存回读译文","detail":"用同名键取回已存译文，与 452 一起构成断点续跑与去重机制。"},"455":{"brief":"译文来源开关","detail":"在刚拿到的译文与缓存回读值之间择一，输出给排版与文本长度测量。"},"467":{"brief":"API 调用节流","detail":"译文写缓存前插入延时，秒数由 99 滑块给出，避免连续请求触发配额限制。"},"519":{"brief":"OCR 前置放大","detail":"nearest-exact 放大 2 倍后喂给识别，小字命中率更高，但也让后续遮罩处于 2 倍坐标系。"}}}}