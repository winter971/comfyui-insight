"toIn":1},{"from":"11","fromOut":0,"to":"9","toIn":2},{"from":"12","fromOut":0,"to":"9","toIn":3},{"from":"7","fromOut":0,"to":"13","toIn":1},{"from":"7","fromOut":0,"to":"17","toIn":2},{"from":"13","fromOut":0,"to":"18","toIn":0},{"from":"18","fromOut":0,"to":"17","toIn":1},{"from":"23","fromOut":0,"to":"22","toIn":5},{"from":"24","fromOut":0,"to":"22","toIn":0},{"from":"7","fromOut":0,"to":"22","toIn":2},{"from":"25","fromOut":0,"to":"22","toIn":3},{"from":"26","fromOut":0,"to":"22","toIn":4},{"from":"17","fromOut":1,"to":"28","toIn":0},{"from":"22","fromOut":0,"to":"29","toIn":0},{"from":"30","fromOut":0,"to":"29","toIn":6},{"from":"29","fromOut":0,"to":"28","toIn":1},{"from":"35","fromOut":0,"to":"34","toIn":6},{"from":"28","fromOut":0,"to":"36","toIn":0},{"from":"34","fromOut":0,"to":"36","toIn":1},{"from":"22","fromOut":0,"to":"34","toIn":0},{"from":"5","fromOut":0,"to":"37","toIn":0},{"from":"43","fromOut":0,"to":"24","toIn":0},{"from":"37","fromOut":1,"to":"22","toIn":1},{"from":"37","fromOut":1,"to":"10","toIn":0},{"from":"37","fromOut":1,"to":"11","toIn":0},{"from":"6","fromOut":0,"to":"37","toIn":1},{"from":"37","fromOut":1,"to":"25","toIn":0},{"from":"37","fromOut":1,"to":"26","toIn":0},{"from":"43","fromOut":0,"to":"9","toIn":0},{"from":"38","fromOut":0,"to":"40","toIn":1},{"from":"40","fromOut":1,"to":"47","toIn":1},{"from":"7","fromOut":0,"to":"40","toIn":2},{"from":"9","fromOut":0,"to":"41","toIn":3},{"from":"41","fromOut":0,"to":"13","toIn":0},{"from":"10","fromOut":0,"to":"41","toIn":1},{"from":"11","fromOut":0,"to":"41","toIn":2},{"from":"43","fromOut":0,"to":"41","toIn":0},{"from":"42","fromOut":0,"to":"38","toIn":1},{"from":"42","fromOut":1,"to":"38","toIn":2},{"from":"37","fromOut":0,"to":"43","toIn":0},{"from":"13","fromOut":0,"to":"47","toIn":0},{"from":"47","fromOut":0,"to":"19","toIn":0},{"from":"36","fromOut":0,"to":"38","toIn":0}],"ai":{"s":"waiANIMA 动漫底模的精修型文生图。主干叠 Ranma LoRA 后过 FreeU_V2 提质，一支接 DifferentialDiffusion 打包进 Detailer 管道，另一支进两段 KSampler：先 32 步全去噪出图，再 16 步 denoise 0.2 精修，tiled 解码预览后由 easy hiresFix 用 Remacri 放大 50%。随后 FaceDetailerPipe 沿打包管道自动找脸、以 denoise 0.26 单独重绘面部，检测器与追加提示词由 EditDetailerPipe 注入；手部支线与之同构但默认旁路，启用后用 hand_yolov8s 检测修手。修完的图由 ApplySignature 盖上 LoadImage 提供的签名章（位置、旋转、大小可调），再过第二次 hires 放大，最后 ColorMatch 以第一次解码图为基准校色、SaveImageAdvanced 按 8-bit sRGB 落盘。两段采样加两级放大加自动修脸是骨架，签名盖章与校色是给批量出图署名的定制环节。","u":["用 waiANIMA 底模加 Ranma LoRA 画动漫角色立绘","多人群像或半身图自动修脸，避免五官崩坏","批量出图后自动盖个人签名章，省去后期逐一加水印","手部经常崩时启用旁路的手部检测修复支线"],"d":3,"st":[{"name":"模型与提示词","desc":"底模叠 LoRA 过 FreeU 提质；一路接 DifferentialDiffusion 供 Detailer 管道用，正负提示词集中编码。","nodes":["5","6","7","37","43","24","10","11"]},{"name":"两段采样与解码","desc":"空白潜空间先 32 步全去噪成型，再 16 步 0.2 幅度精修细节，tiled 解码省显存并预览。","nodes":["12","9","41","13","18"]},{"name":"第一次放大","desc":"Remacri 放大 50% 后低幅度重采样，把图抬到精修可用的分辨率。","nodes":["17"]},{"name":"Detailer 管道装配","desc":"ToDetailerPipe 打包模型套件，EditDetailerPipe 换上人脸检测器并追加 face, detailed face 等通配符提示词。","nodes":["23","22","25","26","30","29"]},{"name":"人脸与手部修复","desc":"自动检测人脸低幅度重绘；旁路的手部支线结构相同，启用后修手，输出串行流向签名环节。","nodes":["28","35","34","36"]},{"name":"签名、二次放大与保存","desc":"盖签名章后再放大 50%，ColorMatch 对齐回首次解码的色调防止偏色，按 sRGB 落盘。","nodes":["42","38","40","47","19"]}],"p":"一采 32 步 CFG 3.5、二采 16 步 denoise 0.2 是这套图的核心配方，二采只做细化别调高幅度；FaceDetailer denoise 0.26 保证修脸不换脸；两次 easy hiresFix 都是 Remacri 放大 50%，想出大图改这个百分比即可，链条后段（签名/校色）会自动跟着走。","n":"手部修复支线（hand_yolov8s + HandDetailerPipe）默认旁路，手部崩坏时再启用，会更耗时；签名章需要一张带透明通道的签名图，LoadImage 会同时取其 image 与 mask；需装 Impact Pack、easy-use、KJNodes，并下载 waiANIMA 底模、Ranma LoRA、Remacri 放大模型与 face_yolov8n_v2 检测器。"}}