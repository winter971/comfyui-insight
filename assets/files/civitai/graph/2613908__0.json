","fromOut":0,"to":"387","toIn":0},{"from":"374","fromOut":0,"to":"389","toIn":0},{"from":"387","fromOut":0,"to":"389","toIn":1},{"from":"389","fromOut":0,"to":"352","toIn":0},{"from":"387","fromOut":0,"to":"392","toIn":0},{"from":"374","fromOut":0,"to":"393","toIn":0},{"from":"394","fromOut":0,"to":"374","toIn":0},{"from":"394","fromOut":0,"to":"387","toIn":1},{"from":"256","fromOut":3,"to":"373","toIn":0},{"from":"256","fromOut":4,"to":"373","toIn":1},{"from":"256","fromOut":0,"to":"394","toIn":0},{"from":"378","fromOut":1,"to":"402","toIn":0},{"from":"402","fromOut":0,"to":"256","toIn":1},{"from":"326","fromOut":0,"to":"406","toIn":0},{"from":"22","fromOut":0,"to":"408","toIn":0},{"from":"408","fromOut":0,"to":"12","toIn":1},{"from":"12","fromOut":0,"to":"409","toIn":0},{"from":"409","fromOut":0,"to":"136","toIn":1},{"from":"407","fromOut":0,"to":"410","toIn":0},{"from":"12","fromOut":0,"to":"412","toIn":0},{"from":"412","fromOut":0,"to":"407","toIn":0},{"from":"416","fromOut":0,"to":"2","toIn":0},{"from":"416","fromOut":0,"to":"417","toIn":0},{"from":"418","fromOut":0,"to":"416","toIn":0},{"from":"418","fromOut":0,"to":"419","toIn":0},{"from":"421","fromOut":0,"to":"418","toIn":0},{"from":"422","fromOut":0,"to":"421","toIn":0},{"from":"20","fromOut":0,"to":"422","toIn":0},{"from":"422","fromOut":0,"to":"423","toIn":0},{"from":"421","fromOut":0,"to":"424","toIn":0},{"from":"256","fromOut":1,"to":"426","toIn":0},{"from":"426","fromOut":0,"to":"323","toIn":0},{"from":"357","fromOut":0,"to":"326","toIn":0},{"from":"331","fromOut":0,"to":"427","toIn":0}],"ai":{"s":"本工作流是作者 Zovetry 专为 Qwen-Image-Edit 架构打造的工业级‘保留场景+角色替换’（Keep Scene + Character Replacement）高阶图像编辑超级管线。拓扑核心突破性地将 BiRefNet 工业级高精发丝人像抠图、DWPose/SDPose 骨骼姿态迁移、Qwen 多参考潜空间上下文机制（FluxKontextMultiReferenceLatentMethod）与动态自适应画幅几何数学引擎深度咬合；采样端融入 ModelSamplingAuraFlow 时序位移校准与 CFGNorm 梯度归一化，确保在 100% 像素级冻结原始背景的前提下，将新角色以完全自洽的透视、姿态与环境光影融合生成；末端配合高级图层羽化回贴与对比监视器，为电商模特换装、影视分镜换角与高保真商业修图提供了极度严密的标准化范式。","u":["电商广告与服装模特摄影中，在绝对不改变原始摄影棚背景与构图的前提下实现模特无缝换脸换身","影视后期概念设计中特定演员/角色在既定复杂电影剧照或概念场景中的无痕替入与动作姿态自适应迁移","复杂透视场景下的主体精准重塑与环境光影自洽融合的高精商业级图像局部智能编辑"],"d":2,"st":[{"name":"工程规范、多级旁路总控与三模态底模加载","desc":"提供六组专属工程说明便签（327/397/399/405/411/415）与 Reroute 总线排线；通过 Fast Groups Bypasser 与 Fast Bypasser 矩阵（85/413/417/419/423/424）及 DuckHideNode（407）实现姿态、提示词与多 LoRA 分支的毫秒级旁路；独立装载 Qwen 扩散 UNET、CLIP 与 VAE，串联多级 LoRA（20/416 及旁路 418/421/422），并通过 easy setNode（88/98/158）广播 VAE、CLIP 与全局随机种子。","nodes":["327","397","399","405","411","415","85","413","417","419","423","424","407","394","408","409","412","77","76","22","20","416","418","421","422","88","98","158"]},{"name":"双图输入与动态画幅高精度数学拓扑系统","desc":"载入场景背景原图（304）与目标人物参考图（378）；结合 Crystools 节点读取高宽比，通过 7 组 SimpleMath+、3 组 SimpleMathCondition+ 与 2 组 ImpactCompare 构成严密的高阶画幅数学引擎；自动计算最佳扩图比例，经由 ImagePadForOutpaint（156）与 ImageScaleByAspectRatio V2 完成非失真等比扩展，由 easy Set/Get 节点集群在画布全局无线分发原图比例、拓图宽高及坐标锚点。","nodes":["304","378","163","249","320","221","224","228","236","237","238","373","191","243","244","183","242","252","256","156","197","214","87","143","329","220","222","234","219","173","248","217","223","235","241","229","240","247","250","262","269"]},{"name":"BiRefNet 超精抠图与 DWPose 姿态先验提取","desc":"利用 BiRefNetUltraV2（328）与加载器（330）对人物进行像素级超精边缘分割，结合 MaskFillHoles（402）与 GrowMaskWithBlur（426）修复孔洞并羽化边缘；同时由 DWPreprocessor（374）与 SDPoseOOD 系列节点深度提取人物骨骼关节点与手部姿态，通过 easy imageSwitch 动态决定姿态引导源，并通过 MaskPreview 与 PreviewImage（157/347/392/393/427）实施多阶段可视材质监视。","nodes":["330","328","402","426","334","157","374","387","388","389","323","324","352","354","347","392","393","427"]},{"name":"Qwen 语义编辑配置与多参考潜空间构建","desc":"部署 QwenEditConfigPreparer 三阶配置器与定制化文本编码节点（311），深度解析角色替换与场景保持的高阶语义意图；融合 CR Text、JWStringConcat 与 ConcatTextOfUtils 实现多提示词精准拼接，结合 ConditioningZeroOut（350）置零负向条件；依托 ReferenceLatent（382）与 FluxKontextMultiReferenceLatentMethod（383/384）将场景与目标人物潜空间构建为复合多参考特征上下文。","nodes":["312","313","353","311","382","383","384","283","355","357","326","406","345","350"]},{"name":"AuraFlow 流匹配采样与潜空间去噪推演","desc":"以 ModelSamplingAuraFlow（节点 2）与 CFGNorm（节点 1）对主模型实施流匹配（Flow Matching）时序调度与引导梯度归一化；在 KSampler（节点 14）中接收多参考潜空间与姿态约束，以高精度步长完成人物替换与环境融合的潜空间扩散推演；随后由 VAEDecode（节点 12）还原为 RGB 像素域，并在中间态监视器（159/148）中验证生成质感。","nodes":["2","1","14","12","160","161","322","101","117","305","145","146","159","148"]},{"name":"多图层无缝融合回贴、画幅重组与对比交付","desc":"采用 ImageCompositeMasked（385）与 ImageBlendAdvance（331）将去噪生成的新角色高保真回贴嵌入原始未变动的场景背景中，经 ColorImage V2（332）校准接缝光影；利用 LayerUtility 的 ImageReel 与 ImageReelComposit（141/142）重组画面版式；通过 Image Comparer（136）进行替换前后毫秒级滑动盲测对比，最终由 SaveImage 系列节点（78/147 及旁路 410）落盘归档至臻商业大片。","nodes":["385","331","332","141","142","136","78","147","410"]}],"p":"运行本管线时，KSampler 推荐采样步数（Steps）设定在 25-35 步之间，CFG 建议保持在 4.5-6.0，搭配 CFGNorm（节点 1）可有效防范局部色彩过焦；BiRefNetUltraV2 分割阈值保持默认，GrowMaskWithBlur 扩边建议设为 4-8 像素并配合 8-16 像素高斯羽化以确保图层拼缝完全隐形；ModelSamplingAuraFlow 的 shift 建议设为 1.73；若角色姿态跨度较大，需在 DWPreprocessor 与 SDPose 节点中开启 OpenPose 姿态自适应对齐。","t":["【画幅数学计算与扩图裁剪一致性】：工作流中内置多达十余个 SimpleMath 与 Crystools 节点用于动态推导扩图边界（ImagePadForOutpaint），若输入原图尺寸过于极端（如超长带状图），可能导致数学条件判断溢出产生画面拉伸；建议通过节点 252/256 确保输入图片的长宽比被约束在常见的 1:1、3:4 或 16:9 黄金比例区间内。","【多参考潜空间权重与光影割裂】：节点 383/384（FluxKontextMultiReferenceLatentMethod）负责协调背景与新角色的潜空间参考特征，若新角色参考图本身的光照方向（如逆光）与原始场景（如正面顺光）严重相悖，直接合成容易产生漂浮感；可在 QwenEditConfigPreparer 中增强环境光照融合提示词，并在节点 331（ImageBlendAdvance）中微调色温色调匹配。"],"n":"【环境扩展库与模型依赖警告】：本工作流属于重度集成的多组件复合管线，运行前必须确保已完整安装：① ComfyUI-BiRefNet（及其模型权重）；② ComfyUI-Qwen-Image-Edit 专用扩展与 Kontext 潜空间节点；③ ComfyUI-LayerStyle（LayerUtility 系列图层节点）；④ comfyui-impact-pack、rgthree-comfy 及 Crystools 扩展库；⑤ controlnet_aux（DWPose 预处理器）。缺失任何一组辅助预处理器或自研数学节点都会导致庞大的数据流中断。","na":{"311":{"brief":"Qwen 专属图像编辑多模态指令编码器","detail":"专为 Qwen-Image-Edit 设计的高级文本编码节点，不仅解析正向自然语言描述，更能识别‘replace character while keeping the scene’等编辑指令并将其精准投射为引导向量。"},"328":{"brief":"BiRefNet 超高精发丝级人像主体分割器","detail":"本工作流实现‘保留场景’的核心感知枢纽，利用双边参考网络对原始场景中的人物进行发丝级的微观边缘抠图，生成极高保真度的前景 Alpha 掩码。"},"383":{"brief":"FluxKontext 多参考潜空间上下文编排器","detail":"多模态潜空间对齐核心，在注意力层将场景背景潜空间、人物姿态约束与目标角色参考图进行交叉注意力解耦与重编排，实现人物无缝置换并完美继承原图景深与光线。"},"385":{"brief":"带遮罩高动态图层无痕复合器","detail":"后处理合成终点，将扩散模型去噪生成的新角色图像，通过羽化修边后的高质量掩码严丝合缝地贴合回原始冻结的背景中，从根本上杜绝全图重绘带来的背景漂移。"},"387":{"brief":"SDPose 人体骨骼姿态先验处理器","detail":"结合 DWPreprocessor 提取的关节点信息，生成符合扩散模型输入规范的标准姿态控制热图，确保新生成的人物动作在空间机位上与原图保持像素级严密对齐。"}}}}