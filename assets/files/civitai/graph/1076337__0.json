172","fromOut":0,"to":"142","toIn":0},{"from":"172","fromOut":0,"to":"164","toIn":0},{"from":"115","fromOut":5,"to":"121","toIn":1},{"from":"193","fromOut":0,"to":"115","toIn":2},{"from":"115","fromOut":2,"to":"195","toIn":0},{"from":"115","fromOut":5,"to":"167","toIn":1},{"from":"198","fromOut":0,"to":"197","toIn":1},{"from":"200","fromOut":1,"to":"197","toIn":2},{"from":"200","fromOut":0,"to":"198","toIn":0},{"from":"198","fromOut":1,"to":"199","toIn":0},{"from":"201","fromOut":0,"to":"200","toIn":0},{"from":"172","fromOut":0,"to":"197","toIn":0},{"from":"115","fromOut":5,"to":"200","toIn":1},{"from":"138","fromOut":0,"to":"233","toIn":0},{"from":"233","fromOut":0,"to":"234","toIn":0},{"from":"115","fromOut":3,"to":"239","toIn":0},{"from":"201","fromOut":0,"to":"241","toIn":0},{"from":"119","fromOut":0,"to":"238","toIn":0},{"from":"115","fromOut":4,"to":"201","toIn":0},{"from":"195","fromOut":0,"to":"167","toIn":0},{"from":"195","fromOut":0,"to":"240","toIn":0},{"from":"142","fromOut":0,"to":"248","toIn":0},{"from":"238","fromOut":0,"to":"248","toIn":1},{"from":"164","fromOut":0,"to":"249","toIn":0},{"from":"240","fromOut":0,"to":"249","toIn":1},{"from":"160","fromOut":0,"to":"250","toIn":0},{"from":"239","fromOut":0,"to":"250","toIn":1},{"from":"197","fromOut":0,"to":"251","toIn":0},{"from":"241","fromOut":0,"to":"251","toIn":1},{"from":"252","fromOut":0,"to":"193","toIn":0},{"from":"252","fromOut":0,"to":"194","toIn":0},{"from":"252","fromOut":0,"to":"115","toIn":1}],"ai":{"s":"音频反应式视频工作流：让已有视频的画面跟着音乐节拍正放、倒放，做出卡点效果。上传音频先由 Open-Unmix（umxl 模型）分离成多条乐器轨，并按音频时长生成对齐的空白帧辅助处理；当前激活的支线把鼓轨经 isolate_kick_drum 预置滤波抠出底鼓，AudioFeatureExtractor 提取响度包络并做 7 帧滑动平均平滑，FlexVideoDirection 拿这条曲线控制视频帧的播放方向——响度越过阈值正放、回落则倒退，画面随节拍往复跳动。最后 VHS_VideoCombine 把驱动后的帧序列与滤波后的音轨重新合成为视频。另有三条同构支线分别接其余音轨（人声、贝斯等），全部默认旁路，用 Fast Groups Bypasser 切换驱动源即可；每条支线配独立合成节点，互不干扰。","u":["给短视频做卡点：画面随鼓点节拍正放倒放，制造律动感","换驱动源调情绪：鼓点驱动硬切跳动，人声或贝斯驱动柔缓摆动","制作音乐可视化素材、VJ 现场循环画面","把已有实拍素材二次加工成音画同步的成片片段"],"d":3,"st":[{"name":"素材载入","desc":"视频取帧、音频上传两条输入；按音频时长生成 30fps 空白帧帮助分离器对齐帧数，同时预载 umxl 分离模型。","nodes":["106","252","193","117"]},{"name":"音轨分离","desc":"Open-Unmix 把整轨拆成多条乐器轨并输出特征管道，每条轨通向一条独立支线；当前激活的是鼓轨。","nodes":["115","194"]},{"name":"鼓点特征提取","desc":"预置滤波从鼓轨里再抠出底鼓，提取响度包络后做 7 帧滑动平均平滑，曲线更稳、画面不抖，附预览节点核对波形。","nodes":["120","119","121","153","157"]},{"name":"音频驱动与合成","desc":"FlexVideoDirection 按包络响度控制帧播放方向，合成器把驱动后的帧与滤波后的音轨重新配对输出成片。","nodes":["172","142","248"]},{"name":"旁路：其余音轨支线","desc":"三条同构支线分别吃分离出的其他音轨，各自提取特征、驱动画面并配独立合成节点；用 Bypasser 面板切换试听不同驱动源的效果。","nodes":["138","161","160","167","165","164","200","198","197","233"]}],"p":"FlexVideoDirection 的阈值 0.99（relative）决定反向触发的响度门槛，调低会更频繁倒放；FeatureSmoothing 窗口 7 帧、系数 0.3 控制动作平滑度，画面抖就加大窗口；EmptyImageFromAudio 的 30fps 要与最终输出帧率保持一致，否则音画错位。","n":"首次运行需联网下载 umxl（Open-Unmix）分离模型；FlexVideoDirection 等音频反应节点不在摘要所列的 VHS/rgthree 包内，需按作者说明另装对应节点包；画面会被音轨反复正放倒放，不适合有叙事连续性的素材。"}}