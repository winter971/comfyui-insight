:1430,"inputs":[{"name":"clip","type":"CLIP"}],"outputs":[{"name":"CONDITIONING","type":"CONDITIONING"}],"widgets":["[your positive prompt here] - this workflow i…"],"brief":"正向词即年龄性别描述（a boy/girl 4 year olds），是主要控制入口","desc":""}],"links":[{"from":"4","fromOut":0,"to":"1","toIn":1},{"from":"5","fromOut":0,"to":"1","toIn":2},{"from":"3","fromOut":0,"to":"1","toIn":3},{"from":"29","fromOut":1,"to":"1","toIn":4},{"from":"28","fromOut":2,"to":"1","toIn":5},{"from":"27","fromOut":1,"to":"4","toIn":0},{"from":"27","fromOut":1,"to":"5","toIn":0},{"from":"1","fromOut":0,"to":"6","toIn":0},{"from":"9","fromOut":0,"to":"6","toIn":1},{"from":"6","fromOut":0,"to":"7","toIn":0},{"from":"27","fromOut":1,"to":"8","toIn":1},{"from":"9","fromOut":0,"to":"8","toIn":2},{"from":"2","fromOut":1,"to":"10","toIn":1},{"from":"12","fromOut":1,"to":"10","toIn":2},{"from":"11","fromOut":1,"to":"10","toIn":3},{"from":"39","fromOut":0,"to":"13","toIn":0},{"from":"14","fromOut":0,"to":"13","toIn":1},{"from":"15","fromOut":1,"to":"13","toIn":2},{"from":"16","fromOut":1,"to":"13","toIn":3},{"from":"17","fromOut":1,"to":"13","toIn":4},{"from":"15","fromOut":1,"to":"18","toIn":0},{"from":"16","fromOut":1,"to":"19","toIn":0},{"from":"17","fromOut":1,"to":"20","toIn":0},{"from":"29","fromOut":1,"to":"21","toIn":0},{"from":"28","fromOut":2,"to":"22","toIn":0},{"from":"11","fromOut":1,"to":"23","toIn":0},{"from":"12","fromOut":1,"to":"24","toIn":0},{"from":"10","fromOut":0,"to":"27","toIn":0},{"from":"2","fromOut":1,"to":"27","toIn":1},{"from":"26","fromOut":1,"to":"27","toIn":2},{"from":"25","fromOut":1,"to":"27","toIn":3},{"from":"26","fromOut":1,"to":"30","toIn":0},{"from":"25","fromOut":1,"to":"31","toIn":0},{"from":"33","fromOut":1,"to":"32","toIn":0},{"from":"35","fromOut":1,"to":"36","toIn":0},{"from":"34","fromOut":1,"to":"37","toIn":0},{"from":"2","fromOut":0,"to":"39","toIn":0},{"from":"38","fromOut":0,"to":"39","toIn":1},{"from":"33","fromOut":1,"to":"39","toIn":2},{"from":"35","fromOut":1,"to":"39","toIn":3},{"from":"34","fromOut":1,"to":"39","toIn":4},{"from":"27","fromOut":0,"to":"45","toIn":0},{"from":"45","fromOut":0,"to":"1","toIn":0},{"from":"46","fromOut":1,"to":"45","toIn":1},{"from":"46","fromOut":1,"to":"47","toIn":0},{"from":"13","fromOut":0,"to":"10","toIn":0},{"from":"45","fromOut":0,"to":"8","toIn":0}],"ai":{"s":"SDXL 模型融合流水线的第一阶段：不训练、只调比例，把三个 checkpoint 混成一个新底模。REALVISXL V4 先与 JUGGERNAUT X 在 ModelMergeBlocks 里按 input/middle/out 三段比例合并，结果再与 CLARITY XL 做第二级合并；随后串上皮肤 LoRA 与 ADD-DETAIL LoRA，接 PerturbedAttentionGuidance 改善质感，最后 CheckpointSave 连同 SDXL VAE 存成可直接调用的 checkpoint。每段比例都来自 Random Number 节点（大多在 0.05-0.4 区间随机），并接到 Display Any 上实时显示，所以每次队列跑出来的都是一组新配方，适合批量抽卡找最佳混合比；看中哪组就把显示的数值抄回随机节点固定复现。被静音的 KSampler 分支是测试渲染线：填提示词、设步数后用合并模型试画一张验证效果，验证满意再保存。","u":["想同时要两个底模的优点（写实加细节加清晰）又不想花钱训练","批量随机抽卡搜索最优融合比例，找到后固定数值复现","给融合模型叠 LoRA 调味并打包成新 checkpoint 分发","研究模型结构：用分块权重观察 input/middle/out 各段对画风的影响"],"d":3,"st":[{"name":"底模加载","desc":"三个 SDXL checkpoint 并行载入，作为融合的原料，各带独立的 CLIP 与 VAE。","nodes":["2","38","14"]},{"name":"随机权重发生","desc":"一排随机数节点按预设区间发权重，喂给合并与 LoRA 强度，Display Any 同步显示当前值。","nodes":["11","12","15","16","17","25","26","33","34","35","46"]},{"name":"两级分块合并","desc":"先并前两个模型，结果再并第三个，input/middle/out 三段各吃一个随机比例。","nodes":["39","13"]},{"name":"LoRA 与 PAG 调味","desc":"皮肤与细节两支 LoRA 串联强化质感，PAG 进一步改善构图与光感。","nodes":["10","27","45"]},{"name":"保存与测试支线","desc":"融合模型加 VAE 存成新 checkpoint；静音的 KSampler 线用于试画验证，启用即可渲染对比。","nodes":["8","9","1","3","4","5","6","7"]}],"p":"随机区间就是配方范围：合并权重 0.05-0.4 控制各模型话语权，单段超过 0.5 容易画风崩坏；PAG scale 在 0.1-0.3 随机，0.5 以上画面易过曝；要复现某次结果，把 Display Any 显示的数值抄回 Random Number 并改成固定。","n":"需提前备好 REALVISXL、JUGGERNAUT、CLARITY 三个 SDXL checkpoint 与两支 LoRA；CheckpointSave 每跑一次就写一个数 GB 的新模型，批量抽卡注意磁盘空间；静音的测试渲染分支要自己填提示词才有效。"}}