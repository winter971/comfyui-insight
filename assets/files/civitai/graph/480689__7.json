toIn":0},{"from":"22","fromOut":0,"to":"23","toIn":0},{"from":"23","fromOut":0,"to":"24","toIn":0},{"from":"26","fromOut":0,"to":"25","toIn":1},{"from":"25","fromOut":0,"to":"14","toIn":0},{"from":"20","fromOut":0,"to":"31","toIn":0},{"from":"30","fromOut":0,"to":"13","toIn":0},{"from":"13","fromOut":0,"to":"14","toIn":3},{"from":"4","fromOut":1,"to":"32","toIn":0},{"from":"32","fromOut":0,"to":"33","toIn":0},{"from":"33","fromOut":0,"to":"34","toIn":0},{"from":"18","fromOut":0,"to":"35","toIn":0},{"from":"4","fromOut":1,"to":"36","toIn":0},{"from":"36","fromOut":0,"to":"37","toIn":0},{"from":"37","fromOut":0,"to":"38","toIn":0},{"from":"4","fromOut":1,"to":"6","toIn":0},{"from":"4","fromOut":1,"to":"7","toIn":0},{"from":"35","fromOut":0,"to":"39","toIn":0},{"from":"39","fromOut":0,"to":"40","toIn":0},{"from":"24","fromOut":0,"to":"41","toIn":0},{"from":"41","fromOut":0,"to":"42","toIn":0},{"from":"34","fromOut":0,"to":"43","toIn":0},{"from":"38","fromOut":0,"to":"44","toIn":0},{"from":"44","fromOut":0,"to":"15","toIn":0},{"from":"43","fromOut":0,"to":"16","toIn":0},{"from":"40","fromOut":0,"to":"25","toIn":0},{"from":"42","fromOut":0,"to":"47","toIn":0},{"from":"47","fromOut":0,"to":"20","toIn":1},{"from":"11","fromOut":0,"to":"48","toIn":0},{"from":"48","fromOut":0,"to":"49","toIn":0},{"from":"49","fromOut":0,"to":"50","toIn":0},{"from":"49","fromOut":0,"to":"51","toIn":0},{"from":"51","fromOut":0,"to":"13","toIn":1},{"from":"52","fromOut":0,"to":"53","toIn":3},{"from":"53","fromOut":0,"to":"54","toIn":0},{"from":"54","fromOut":0,"to":"9","toIn":0},{"from":"24","fromOut":0,"to":"54","toIn":1},{"from":"3","fromOut":0,"to":"52","toIn":0},{"from":"35","fromOut":0,"to":"53","toIn":0},{"from":"6","fromOut":0,"to":"53","toIn":1},{"from":"7","fromOut":0,"to":"53","toIn":2},{"from":"53","fromOut":0,"to":"30","toIn":0},{"from":"10","fromOut":0,"to":"53","toIn":4},{"from":"20","fromOut":0,"to":"55","toIn":0},{"from":"55","fromOut":0,"to":"56","toIn":0},{"from":"57","fromOut":0,"to":"22","toIn":0},{"from":"58","fromOut":0,"to":"25","toIn":2}],"ai":{"s":"AnimateDiff 运动笔刷工作流：先用不带运动模块的 KSampler 生成一张 512 静帧，CR Latent Batch Size 把单帧潜像复制成 16 帧；手涂遮罩经 MaskToImage 转 ImageBlur 模糊再转回遮罩柔化边缘，由 SetLatentNoiseMask 贴到潜空间——遮罩外原潜像原样保留，遮罩内 denoise 1.0 全量重噪。第二级 KSampler 换成挂了 mm_sd_v15 运动模块与 ZoomIn 运动 LoRA 的模型，用 ocean waves crashing 这类运动提示词重采样，只有笔刷区随帧运动、其余画面保持静帧，即局部动图。输出一路直接 VHS 合成视频，一路过 FILM 光流插帧更顺滑后再合成。旁路的 LatentUpscaleBy 加第二个 KSampler(0.7) 是 1.5 倍放大精修静帧的支线。","u":["把照片做成局部动态的 cinemagraph：涂遮罩圈住水流、云或火焰，其余画面完全静止","给静帧中的主体加动作（推近镜头、飘动），换运动提示词或 ZoomIn LoRA 即可改变动态方式","担心 AnimateDiff 全画面扭曲时，用笔刷把运动限制在小区域，保住整体画质","固定 rgthree Seed 后只改遮罩或运动提示词，批量对比不同动态效果"],"d":3,"st":[{"name":"静帧生成","desc":"按主提示词先出一张不带任何运动的底图，这是整条视频的静止背景，也是运动笔刷的画布。","nodes":["5","4","6","7","10","3"]},{"name":"运动笔刷遮罩","desc":"用户涂出的遮罩先转成图像做高斯模糊再转回遮罩，边缘柔化后静动过渡才不会出现硬接缝，模糊结果有预览可核对。","nodes":["11","48","49","51","50"]},{"name":"AnimateDiff 注入与帧数编排","desc":"运动模块挂到模型上并定义 16 帧上下文窗口；同时把单帧潜像批量复制成 16 份——帧数就是由这里的批量大小决定的，最后把柔化遮罩写进潜空间，划定哪些帧内容允许变化。","nodes":["25","26","58","30","13"]},{"name":"运动区采样与解码","desc":"第二级采样用运动提示词驱动遮罩内区域，denoise 1.0 保证笔刷内每帧噪声独立、产生连续动作；解码回图像供后续输出。","nodes":["16","15","19","14","20"]},{"name":"输出与补帧","desc":"16 帧序列一路直接合成视频，一路经 FILM 光流插帧倍增后合成更顺滑版本；解码使用独立加载的 TRCVAE。","nodes":["57","31","55","56"]},{"name":"旁路：静帧精修","desc":"默认旁路的 1.5 倍潜空间放大加 denoise 0.7 二次采样，启用后重画底图并保存，用于想要更清晰静止背景的场合。","nodes":["52","53","54","9"]}],"p":"帧数由 Frame Count（CR Latent Batch Size，当前 16）决定，加大时同步考虑 ADE 上下文窗口与显存；遮罩模糊半径 10 控制静动过渡带宽度，成片出现硬边就调大；第二级 KSampler 的 denoise 保持 1.0，调低会让遮罩区几乎不动。","n":"需先在 Create Mask（LoadImageMask）里上传或涂出运动区域；依赖 AnimateDiff-Evolved、VHS、Comfyroll、Frame-Interpolation、rgthree 五个节点包，motion 模型、ZoomIn LoRA、film_net、TRCVAE 均需另下；放大精修支线默认旁路，启用后显存和时间都会明显增加。"}}