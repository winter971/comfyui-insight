":"85","toIn":0},{"from":"123","fromOut":0,"to":"60","toIn":5},{"from":"64","fromOut":0,"to":"13","toIn":5},{"from":"85","fromOut":0,"to":"137","toIn":0},{"from":"140","fromOut":0,"to":"139","toIn":0},{"from":"38","fromOut":0,"to":"60","toIn":0},{"from":"13","fromOut":5,"to":"139","toIn":1},{"from":"139","fromOut":0,"to":"38","toIn":0},{"from":"18","fromOut":0,"to":"110","toIn":0},{"from":"18","fromOut":0,"to":"62","toIn":0},{"from":"18","fromOut":0,"to":"63","toIn":0},{"from":"141","fromOut":2,"to":"60","toIn":6},{"from":"141","fromOut":2,"to":"18","toIn":6},{"from":"141","fromOut":0,"to":"142","toIn":2},{"from":"141","fromOut":1,"to":"142","toIn":3},{"from":"141","fromOut":4,"to":"142","toIn":4},{"from":"142","fromOut":0,"to":"13","toIn":0},{"from":"142","fromOut":1,"to":"13","toIn":1},{"from":"142","fromOut":2,"to":"13","toIn":2},{"from":"142","fromOut":3,"to":"13","toIn":3},{"from":"142","fromOut":4,"to":"13","toIn":4},{"from":"142","fromOut":5,"to":"38","toIn":2},{"from":"143","fromOut":0,"to":"142","toIn":0}],"ai":{"s":"一条 SDXL 全自动人像出图管线：装载、生成、换脸、修脸、两段放大、加水印一次跑完。Efficient Loader 把检查点、VAE 替换、clip skip、正负提示词与 LoRA 栈打包输出，画幅由 CR Aspect Ratio 统一控制（当前是 1024 方图预设，切成宽幅预设就是它名字里的 Ultrawide 模式）。KSampler (Efficient) 30 步采样并挂 HighRes-Fix 脚本，自动完成 1.3 倍 latent 放大的二次采样。生成图先经 ReActor 换成 Face Input 上传的人脸（inswapper 加 GFPGAN 修复），再由 FaceDetailer 用人脸检测加 SAM 自动框脸、0.15 低去噪精修。之后两个 UltimateSDUpscale 串联，各挂一份 4x-UltraSharp 逐段放大补细节并归档 PNG；最后 Image Overlay 把水印图叠加到成品上，另存一份带水印 JPG。整条链路无需中途干预，产出即是可发布成品。","u":["一键出成品图：生成、换脸、修脸、放大、水印全自动，适合日更发图","用自己或固定模特的脸替换 AI 人物，保持角色跨图一致","做超宽幅壁纸或横幅：把画幅预设切成 ultrawide 一次成型","发布到 Discord 的成图自动叠水印并另存 JPG，省去后期"],"d":3,"st":[{"name":"装载与画幅","desc":"CR Aspect Ratio 统一给出宽高与放大倍数；Efficient Loader 一个节点装完检查点、VAE、clip skip、正负词并挂 LoRA 栈，成套输出给下游所有环节。","nodes":["141","143","142"]},{"name":"采样与内置高清修复","desc":"30 步主采样后由脚本节点自动接 1.3 倍 latent 放大和 12 步 0.56 去噪的二采，一个采样器跑完两遍，出图即有基础细节。","nodes":["64","13"]},{"name":"换脸支线","desc":"ReActor 把生成图的人脸替换成 Face Input 上传的人脸，inswapper 换脸加 GFPGAN 修复；不需要时在节点里关掉开关即可跳过。","nodes":["140","139"]},{"name":"面部精修","desc":"FaceDetailer 用人脸 yolov8 检测框加 SAM 精确分割，把脸单独放大重绘，0.15 去噪只磨皮肤五官细节、不动整体构图。","nodes":["39","40","38","51","52"]},{"name":"两段放大","desc":"两个 UltimateSDUpscale 串联接力，各挂一份 4x-UltraSharp：第一段放大后的图再进第二段补细节，分块采样让大图显存可控。","nodes":["123","16","60","18","61","66"]},{"name":"归档与水印","desc":"放大成品先存 PNG 归档，再由 Image Overlay 把载入的水印图缩放叠加，另存一份带水印 JPG 到发布目录。","nodes":["62","110","81","85","137"]}],"p":"主采样 30 步 cfg 6 配 dpmpp_2m_sde karras 是整条链的基础；HighRes-Fix 的 1.3 倍加 0.56 去噪决定二采强度，嫌脸糊可提到 0.6；FaceDetailer 0.15 去噪别动，调高会改五官；画幅与放大倍数都在 CR Aspect Ratio 里改，当前 1:1、放大 2 倍。","n":"ReActor 需另装 inswapper_128.onnx 与 GFPGAN，FaceDetailer 需 face_yolov8m 与 sam_vit_b 模型；换脸涉及真人肖像请注意授权；水印支线用的是 81 节点里载入的图片，成品会自动多存一份带水印 JPG。"}}