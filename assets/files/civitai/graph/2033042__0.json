,"toIn":0},{"from":"43","fromOut":0,"to":"49","toIn":0},{"from":"49","fromOut":0,"to":"40","toIn":0},{"from":"44","fromOut":0,"to":"50","toIn":0},{"from":"50","fromOut":0,"to":"41","toIn":0},{"from":"47","fromOut":0,"to":"39","toIn":0},{"from":"53","fromOut":0,"to":"39","toIn":1},{"from":"53","fromOut":0,"to":"40","toIn":1},{"from":"53","fromOut":0,"to":"41","toIn":1},{"from":"2","fromOut":0,"to":"55","toIn":0},{"from":"42","fromOut":0,"to":"12","toIn":0},{"from":"12","fromOut":1,"to":"61","toIn":1},{"from":"12","fromOut":2,"to":"61","toIn":2},{"from":"21","fromOut":0,"to":"61","toIn":0},{"from":"61","fromOut":0,"to":"18","toIn":5},{"from":"55","fromOut":0,"to":"65","toIn":0},{"from":"55","fromOut":0,"to":"64","toIn":0},{"from":"17","fromOut":0,"to":"4","toIn":0},{"from":"36","fromOut":1,"to":"18","toIn":8},{"from":"53","fromOut":0,"to":"55","toIn":1},{"from":"55","fromOut":0,"to":"69","toIn":0},{"from":"69","fromOut":0,"to":"56","toIn":0},{"from":"42","fromOut":0,"to":"71","toIn":0},{"from":"71","fromOut":0,"to":"47","toIn":1},{"from":"71","fromOut":1,"to":"47","toIn":2},{"from":"71","fromOut":0,"to":"49","toIn":1},{"from":"71","fromOut":1,"to":"49","toIn":2},{"from":"71","fromOut":0,"to":"50","toIn":1},{"from":"71","fromOut":1,"to":"50","toIn":2}],"ai":{"s":"Wan2.1 VACE 一致性姿势图生成器：让同一角色按三张姿势参考图（站立/跳跃/舞蹈）各出一帧静图。巧思在控制视频的制作：三张姿势图先以其中一张为基准统一尺寸，各自重复 8 帧（停格效果），Image Batch 拼成 24 帧序列后经 VHS 合成视频、再按文件路径重新载入——绕这一圈是因为 WanVaceToVideo 需要带正确帧数的控制视频，批量图直接喂不进去。角色照片 pad 到 600x600 作 reference_image，正词 'multiple poses stop_motion'，VACE 把动作走向与角色长相一起写进时空条件。模型是 Wan2.1 14B 的 LightX2V 蒸馏版 GGUF（Q5_K_M），过 torch.compile 提速与 SD3 shift 8，蒸馏档 4 步 CFG 1 即完成采样。解码后每 8 帧抽一张，恰好抽回每个姿势一张静帧，InspyrenetRembg 去背景后保存。视频合成再回读的循环设计是本图最值得学的一手。","u":["给角色设定图批量补姿势：丢三张姿势参考和一张角色图，一次产出全套一致性立绘","做定格动画素材：改 image repeat 的重复帧数即可控制每个姿势的持续时长","生成透明底姿势素材：自动去背景后直接进设计软件排版","学 Wan VACE 的控制视频做法：姿势序列、停格分段、帧数对齐的标准示范"],"d":3,"st":[{"name":"模型加载","desc":"Wan2.1 14B VACE 蒸馏版 GGUF 出模型，torch.compile 编译提速，SD3 采样位移 8；umt5_xxl 文本编码器与 Wan VAE 就位，蒸馏模型才撑得起 4 步采样。","nodes":["17","4","3","14","13"]},{"name":"姿势控制视频制作","desc":"三张姿势图以同一张为基准统一尺寸，各重复 8 帧成停格段，拼批量后经 VHS 合成视频、按文件名回读成控制视频流，帧数元数据一并传给 VACE。","nodes":["71","42","43","44","47","49","50","53","39","40","41","38","37","35","36"]},{"name":"角色参考与 VACE 编码","desc":"角色照片按 600x600 pad 对齐作参考图；WanVaceToVideo 把控制视频、参考图与正负词编码成条件与初始 latent，长度自动取控制视频帧数，画布宽高随姿势图尺寸。","nodes":["21","28","12","61","27","10","18"]},{"name":"采样","desc":"蒸馏模型 4 步 CFG 1 lcm 快速出整段视频 latent，TrimVideoLatent 预留首帧裁剪口子。","nodes":["15","1"]},{"name":"抽帧与抠图输出","desc":"解码后每 8 帧抽一张，正好每个姿势得一张静帧；InspyrenetRembg 抠掉背景保存成透明素材，完成后响铃并清理显存。","nodes":["2","55","69","56","65","64"]}],"p":"4 步 CFG 1 是 LightX2V 蒸馏档的定式，加步数反而过拟合发糊；image repeat 的 8 与抽帧间隔的 8 必须一致，改一个就同步改另一个；VACE strength 1.02 略高于 1 让姿势贴合更紧，动作变形就降回 1；分辨率由 PrimitiveInt 的 600 统一决定，显存紧张可降到 480。","n":"14B GGUF Q5_K_M 权重约 10GB，视频 latent 采样显存开销大，低配卡建议先降分辨率与帧数；VHS 视频合成回读依赖 ffmpeg；需 ComfyUI-GGUF、VideoHelperSuite、essentials、KJNodes、easy-use、pysssss；umt5_xxl、wan_2.1_vae、Inspyrenet 模型需另下或首跑自动下载。"}}