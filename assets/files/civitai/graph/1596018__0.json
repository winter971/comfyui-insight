":0,"to":"10","toIn":1},{"from":"12","fromOut":0,"to":"30","toIn":1},{"from":"12","fromOut":0,"to":"49","toIn":3},{"from":"12","fromOut":0,"to":"25","toIn":8},{"from":"12","fromOut":0,"to":"14","toIn":1},{"from":"12","fromOut":0,"to":"10","toIn":1},{"from":"12","fromOut":0,"to":"30","toIn":1},{"from":"12","fromOut":0,"to":"49","toIn":3},{"from":"12","fromOut":0,"to":"15","toIn":8},{"from":"12","fromOut":0,"to":"14","toIn":1},{"from":"12","fromOut":0,"to":"10","toIn":1},{"from":"12","fromOut":0,"to":"49","toIn":3},{"from":"12","fromOut":0,"to":"30","toIn":1},{"from":"12","fromOut":0,"to":"25","toIn":8},{"from":"12","fromOut":0,"to":"15","toIn":8},{"from":"12","fromOut":0,"to":"14","toIn":1},{"from":"12","fromOut":0,"to":"10","toIn":1},{"from":"12","fromOut":0,"to":"49","toIn":3},{"from":"12","fromOut":0,"to":"15","toIn":8},{"from":"12","fromOut":0,"to":"25","toIn":8},{"from":"12","fromOut":0,"to":"30","toIn":1},{"from":"12","fromOut":0,"to":"14","toIn":1},{"from":"12","fromOut":0,"to":"10","toIn":1},{"from":"12","fromOut":0,"to":"49","toIn":3},{"from":"12","fromOut":0,"to":"15","toIn":8},{"from":"12","fromOut":0,"to":"25","toIn":8},{"from":"12","fromOut":0,"to":"30","toIn":1},{"from":"12","fromOut":0,"to":"14","toIn":1},{"from":"12","fromOut":0,"to":"10","toIn":1},{"from":"12","fromOut":0,"to":"15","toIn":8},{"from":"12","fromOut":0,"to":"25","toIn":8},{"from":"12","fromOut":0,"to":"30","toIn":1},{"from":"12","fromOut":0,"to":"49","toIn":3}],"ai":{"s":"本工作流是一套基于 AnimateDiff 时序运动引擎、IP-Adapter 图像特征迁移与多路 Advanced ControlNet 深度协同的高阶视频油画风格迁移（Style Transfer）管线。其核心架构以 SDXL/SD1.5 扩散底模为基底，通过 VHS 节点读取并解析原视频逐帧序列，在 VAE 潜空间（Latent Space）进行重绘去噪。流程通过 IPAdapterAdvanced 将单张油画参考图的艺术笔触与色彩基调注入跨注意力层（Cross-Attention），结合多通道 Advanced ControlNet（如线稿与深度结构）锁定原视频的人物动态与三维场景几何，并挂载 AnimateDiff 运动模块与滑动窗口上下文策略（Context Options），在保证强艺术风格化重绘的同时消解帧间闪烁，最终由 VHS_VideoCombine 渲染输出高一致性的油画流体质感动态视频。","u":["真人动态视频油画化转换：将实拍人物舞蹈、日常 Vlog 或运动镜头重绘为具有厚重笔触与油画肌理的流动艺术动画","概念艺术短片与动画 MV 视觉制作：结合特定画家（如莫奈、梵高）静态名作参考，快速将实拍片段或 3D 灰模渲染序列统一为特定画派风格","商业广告特效与风格化转场：为艺术展览、时尚短片或商业宣传片打造具有高辨识度、光影生动且帧间连贯自然的插画/油画视觉特效"],"d":3,"st":[{"name":"模型与增强网络加载","desc":"载入主扩散底模（Checkpoint Loader），串联双路 LoRA 加载器分别微调基础风格与强化油画/笔触艺术表达，并加载匹配的独立 VAE 模型为后续编解码提供高动态色彩保真度支持。","nodes":["2","3","50","12"]},{"name":"提示词设定与辅助广播","desc":"构建正反向提示词（Positive / Negative Prompt）文本编码以建立基础语义引导；通过 Anything Everywhere 节点进行隐式全局数据广播分发，降低网状连线混乱度，并利用 Crystools JSON 节点实时监测数据流元数据。","nodes":["4","5","45","42"]},{"name":"视频输入与时空潜空间构建","desc":"通过 VHS 视频加载套件直接读取源视频路径并提取帧率（FPS）、总帧数与分辨率等元数据，随后经由 VAE 编码器将视频图像序列成批压入潜空间（Latent Space），奠定视频重绘的初始时空基底。","nodes":["30","43","14"]},{"name":"参考图特征提取与 IP-Adapter 风格注入","desc":"载入油画静态参考图，通过 PrepImageForClipVision 进行构图与色彩预处理，配合统一加载的 CLIP-Vision 模型提取高维视觉特征，再由 IPAdapterAdvanced 深度注入模型跨注意力层（Cross-Attention），精准定型笔触质感与油画色彩体系。","nodes":["22","21","23","20"]},{"name":"多通道 Advanced ControlNet 空间几何锁定","desc":"采用多路 AIO 前处理器提取原视频边缘线稿或深度几何信息，接入 Advanced ControlNet 约束链，结合 Union ControlNet 模式配置，在极大幅度风格重绘下去噪的同时，精准锁定人物动态形体与背景空间透视，杜绝画面崩塌。","nodes":["17","38","18","24","27","15","25","29"]},{"name":"AnimateDiff 时序运动引擎与时空上下文调度","desc":"挂载 AnimateDiff 运动模块并集成标准静态滑动窗口上下文策略（Static Context Options），划分时间维度的重叠采样窗口，驱动视频逐帧之间平滑渐变，消除独立单帧重绘造成的频闪与拓扑跳变。","nodes":["31","32"]},{"name":"潜空间联合去噪采样、解码与视频合成","desc":"在 KSampler 中聚合文本、风格参考、多路几何控制与时序运动先验，对视频潜空间执行去噪重绘；完成采样后经 VAE 解码器逆变换为 RGB 像素序列，最终由 VHS_VideoCombine 按照原视频帧率渲染输出无缝油画艺术视频。","nodes":["6","10","49"]}],"p":"【去噪幅度（Denoise）】：推荐设置在 0.65 - 0.85 之间。低于 0.6 原画重绘痕迹较轻、无法呈现油画堆叠质感；高于 0.85 易脱离原形体导致结构崩塌。\n【采样步数与算法】：推荐 25 - 35 步，采样器首选 Euler 或 DPM++ 2M SDE，搭配 Karras 调度器，兼顾生成质感与运算效率。\n【IP-Adapter 权重控制】：Weight 建议设为 0.70 - 0.85，选用 style transfer 模式，并将 Ending Step 限制在 0.80 左右，预留后续步数供模型平衡细节。\n【ControlNet 引导强度】：主约束（如 Lineart/Depth）强度建议在 0.75 - 0.90，生效区间设为 0.0 - 0.85，避免控制力过强锁死笔触变化。\n【AnimateDiff 上下文配置】：Context Length 推荐设为 16 帧，Context Stride 设为 1，Context Overlap 设为 4 帧，保障帧间过渡平滑且显存利用合理。","t":["【显存溢出与批量分段技巧】：视频潜空间去噪配合 AnimateDiff 注意力矩阵极度占用显存。建议先在 VHS_LoadVideoPath 中截取 32~48 帧低帧数进行小尺寸测试，正式出片时再提高分辨率或使用分段批处理。","【ControlNet 与油画风格的平衡博弈】：油画风格的核心在于色块溢出与笔触粗砺，若 ControlNet 权重过大（如接近 1.0），生成结果会像实拍照片贴上滤镜而非真正手绘。适当下调 ControlNet 并在去噪最后 15% 步数提前退出，可让油画笔触获得自然生长的写意空间。","【色彩过曝与色差漂移防护】：高色彩饱和度的油画参考图极易导致重绘视频画面发暗或局部偏色。可通过 PrepImageForClipVision 规范化输入画幅，并在负向提示词中显式添加 '(oversaturated, burnt edges, high contrast:1.2)' 进行反向钳制。"],"n":"本工作流属于高显存消耗型视频管线，建议在具备 16GB 及以上独立显存的 GPU（如 RTX 3090/4090）上运行。运行前请务必确认本地已通过 ComfyUI Manager 完整安装 ComfyUI-AnimateDiff-Evolved、ComfyUI_IPAdapter_plus、comfyui_controlnet_aux、ComfyUI-VideoHelperSuite 及 Crystools 扩展节点，并确保 AnimateDiff 运动模型、IP-Adapter 权重、CLIP-Vision 模型及对应 ControlNet/Union 模型放置在规范的子目录中。首次运行建议切勿直接加载超长 4K 视频，宜从 512x512 或 768x768 规格短片段起步验证流程连通性。","na":{"6":{"brief":"时空潜空间联合去噪采样核心","detail":"计算管线的汇聚中枢，在时空潜空间中协同融合文本 Prompt、IP-Adapter 艺术风格、多路 ControlNet 几何硬约束与 AnimateDiff 运动先验。"},"15":{"brief":"高级 ControlNet 几何结构约束器","detail":"接收由前处理器提取的时空结构引导信息（如边缘、骨架或深度），在强风格化重绘的同时牢牢锚定原视频的人物姿态与场景透视。"},"20":{"brief":"高级图像风格特征注入器","detail":"作为风格迁移中枢，将参考油画的高阶色彩与艺术笔触特征无缝映射至扩散模型的 Cross-Attention 模块，控制风格渗透强度与介入时机。"},"30":{"brief":"视频流文件路径加载器","detail":"直接从本地存储路径流式导入视频源文件，支持灵活设定抽帧步长、起止帧与分辨率缩放，是长视频管线的高效输入中枢。"},"31":{"brief":"AnimateDiff 时序运动引擎加载器","detail":"为 2D 基础底模注入时间维度的时序自注意力（Temporal Attention）机制，使逐帧重绘的潜空间具备连续物理运动规律，消除帧间剧烈闪烁。"},"32":{"brief":"静态滑动窗口上下文策略配置器","detail":"指定 AnimateDiff 处理序列时的滑动窗口尺寸与重叠帧步长，使得超出默认帧数限制的长视频能在有限显存内实现连贯平滑推演。"},"38":{"brief":"Union ControlNet 模式配置器","detail":"为多合一 ControlNet 模型指定具体的感知模式（如 Depth、Lineart 或 Canny），提升多重几何条件控制下的加载效率与显存复用率。"},"49":{"brief":"视频多帧渲染与封装器","detail":"将 VAE 逆变换生成的 RGB 像素图像序列按照原视频帧率重新封装打包，支持输出为高质量无缝油画艺术视频文件。"}}}}