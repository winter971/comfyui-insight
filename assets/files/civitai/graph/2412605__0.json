:"170","fromOut":0,"to":"161","toIn":0},{"from":"171","fromOut":0,"to":"161","toIn":1},{"from":"173","fromOut":0,"to":"161","toIn":2},{"from":"174","fromOut":0,"to":"162","toIn":2},{"from":"175","fromOut":0,"to":"163","toIn":2},{"from":"161","fromOut":0,"to":"162","toIn":0},{"from":"161","fromOut":1,"to":"162","toIn":1},{"from":"162","fromOut":0,"to":"163","toIn":0},{"from":"162","fromOut":1,"to":"163","toIn":1},{"from":"163","fromOut":0,"to":"176","toIn":0},{"from":"163","fromOut":1,"to":"177","toIn":0},{"from":"179","fromOut":0,"to":"161","toIn":4},{"from":"182","fromOut":0,"to":"10","toIn":1},{"from":"183","fromOut":0,"to":"10","toIn":2},{"from":"172","fromOut":0,"to":"184","toIn":0},{"from":"187","fromOut":0,"to":"173","toIn":0},{"from":"179","fromOut":0,"to":"162","toIn":4},{"from":"179","fromOut":0,"to":"163","toIn":4},{"from":"159","fromOut":0,"to":"164","toIn":0},{"from":"159","fromOut":0,"to":"165","toIn":0},{"from":"187","fromOut":0,"to":"175","toIn":0},{"from":"187","fromOut":0,"to":"174","toIn":0}],"ai":{"s":"一条把二次元插图打回写实照片的四段式 Flux 管线，底模全走 GGUF 量化。资产段：14 LoaderGGUF 读 flux1-dev-Q8_0.gguf，先串 36 PathchSageAttentionKJ（auto）做注意力加速，再进 35 Power Lora Loader 挂一支 Flux 子目录下的写实 LoRA（作者原文注明来自 civitai 726732，非本人作品），106 DualCLIPLoaderGGUF 用量化 T5 加 clip_l 组成 flux 型双文本编码器，16 单独加载 ae.safetensors 作 VAE（变分自编码器，负责像素与潜空间互转），110 与 111 把同一个种子广播给主采样与修脸。反推段：6 载入原图，81 按 nearest-exact 归一到约一百万像素写成 IMAGE 变量，27 拉 microsoft/Florence-2-base 交 26 以 more_detailed_caption 出英文长描述，135、32、136 三级 easy promptReplace 把 illustration、cartoon、character、anime-inspired 一类词逐个换成 photorealistic photograph 与 realistic，结果送 3 编码——但 3 的 text 口已被 78 连线占用，节点上残留的提示词只是历史值。保形段：172 只加载一份 FLUX.1-dev ControlNet Union Pro 2.0，靠 173、174、175 声明 openpose、canny 系与 depth 三种类型，配 157、164、165 三个 1024 分辨率预处理器，由 161 到 163 串联施加，每段强度 0.3、作用区间 0 到 0.5；条件侧 3 经 25 FluxGuidance 8 得 positivo，114 ReduxAdvanced 用 SigCLIP 视觉与 flux1-redux-dev 把原图风格再叠一层，121 与 131 两个 ConditioningZeroOut 清出负向，因为 10 的 cfg 只有 1，负向本就不参与运算。生成段：127 把 IMAGE 直接编码，10 以 steps 20、cfg 1、euler、simple、denoise 1 全量重绘，等于不留一格原像素地重画，构图全靠三张控制网拽住。后处理段：40 FaceDetailer 用人脸框检测加 SAM 分割，guide_size 768、max_size 1280、steps 30、cfg 5、denoise 0.35，正向改用 4 手写那条写实提示词经 129 的 FluxGuidance 3.5；49 UltimateSDUpscale 配照片向超分模型放大 2 倍，steps 20、cfg 1、euler、beta、denoise 0.5、Linear 模式，tile 宽高被 102 量出的整图尺寸连线覆盖。全图 19 个 setNode 与 40 个 getNode 构成变量网，四级预览与 34 的对比器负责核对每一步的失真。","u":["把手绘立绘、动画单帧或漫画分镜转成写实照片质感","显存有限、只能用 GGUF 量化 Flux 跑图生图的用户","需要保留原始姿势与构图、只替换画风的批量重绘","想要一条带自动打标、修脸与分块放大的完整后处理链"],"d":2,"st":[{"name":"GGUF 资产与模型链","desc":"量化底模经注意力加速与 LoRA 叠加，双编码器和独立 VAE 一并写入变量，种子集中一处广播给全图。","nodes":["14","36","35","63","106","62","16","61","115","116","110","111","126","123","82","83","124","54","64"]},{"name":"输入归一与自动打标","desc":"原图缩到约一百万像素写成 IMAGE 变量，Florence2 出英文长描述后经三级替换改写成写实提示词并回读。","nodes":["6","81","55","27","26","135","32","136","77","78","56","52","60","34","57","31","137"]},{"name":"条件构建与 Redux 风格注入","desc":"自动提示词与手写写实词各自走 FluxGuidance，Redux 用视觉编码器叠加原图风格，负向直接清零占位。","nodes":["3","4","25","129","75","76","130","132","121","131","114","117","118","119","120","71","72","122","170","171"]},{"name":"一份 Union 控制网三路保形","desc":"同一 Union 权重被声明成姿态、线稿、深度三种类型，各配预处理器后按 0.3 强度串联进条件。","nodes":["172","184","187","173","174","175","157","164","165","159","161","162","163","179","176","177","160","168","169","93","94"]},{"name":"潜空间全量重绘主采样","desc":"输入图直接编码进潜空间，以 cfg 1、denoise 1 走完 20 步，出图后解码写成主图变量供后两段取用。","nodes":["127","128","10","91","92","12","70","96","182","183","112"]},{"name":"人脸检测与局部精修","desc":"YOLO 框加 SAM 分割定位人脸，用独立的手写写实提示词与 0.35 去噪做二次重绘，遮罩与裁片单独预览。","nodes":["39","37","40","97","66","74","69","88","89","113","95","41","38","42","99","108","107","98"]},{"name":"分块放大与结果对照","desc":"超分模型配 UltimateSDUpscale 放大 2 倍做最后清晰化，瓦片尺寸由整图实际大小决定，四级输出并排比对。","nodes":["43","49","100","65","68","103","102","101","104","105","109"]}],"p":"主采样别急着降 denoise：10 现在是 1，画风转换靠它彻底重画，若想留住更多原图笔触就往下调到 0.75 到 0.85，但必须同时把 161、162、163 的强度从 0.3 提到 0.5 到 0.7，否则姿势与线稿会一起漂。三张控制网只做参考时可以把 174 与 175 的连线断开只留 openpose，线稿复杂的图则优先保留 canny 那一路。25 的 FluxGuidance 8 偏硬，人物脸部塑料感重就降到 3.5 到 5；129 那路只管修脸，3.5 是稳妥值。40 的 denoise 0.35 是这张图里最敏感的旋钮，往上到 0.5 会更像真人但容易换脸，往下 0.2 基本只是加细节；guide_size 768 配 max_size 1280 适合单人特写，多人小脸建议把 guide_size 提到 1024。49 的瓦片被 102 的实际尺寸连线顶掉了，显存吃紧时删掉这两条连线让 tile 落回 1024，或把 upscale_by 从 2 降到 1.5、denoise 从 0.5 降到 0.3 以躲开块间接缝。81 的 1 百万像素是总闸，调高会同时抬高全流程耗时。要复现同一张结果，改种只改 110 一处，别单独动 10 与 40 的种子框。","t":["模型清单是硬门槛：flux1-dev-Q8_0.gguf、t5-v1_1-xxl-encoder-Q8_0.gguf、clip_l、ae.safetensors、flux1-redux-dev、sigclip_vision_patch14_384、FLUX.1-dev-ControlNet-Union-Pro-2.0、bbox/face_yolov8m.pt、sam_vit_b_01ec64.pth 与 4xNomosWebPhoto_RealPLKSR 十件外加那支写实 LoRA，缺一不可，少一件就是红节点。","3 号 CLIPTextEncode 的文本口被 78 的变量取数占用，节点上写着的那句 photorealistic redhead woman in real life 完全不生效，直接改输入框会以为没反应，要改提示词得去 135、32、136 的替换表或断开这条连线。","变量名有坑：96 写出的 Control_net 装的其实是 VAEDecode 出来的主图，97 再把它喂给 FaceDetailer 的 image 口。这套 easy setNode 与 getNode 网络在图里几乎无连线，只能按变量名配对，改流程时同名变量要一起改。","10 的 cfg 是 1，负向条件实际不起作用，作者用两个 ConditioningZeroOut 把 negativo 与 perso_negative 清成空条件，这是 Flux 的常规接法；一旦把 cfg 抬到 1.5 以上，这两路就会真的开始拉图，脸部容易发灰。","49 的 tile 宽高被 102 量出的整图尺寸覆盖，等于整图一块；2 倍放大加 20 步在 12GB 以下显存容易直接爆，先断连线回到 1024 瓦片再试。","40 依赖两个检测与分割权重 bbox/face_yolov8m.pt 与 sam_vit_b_01ec64.pth，它们不像 27 那个 DownloadAndLoad 节点会自己联网拉模型，离线机器要提前按 Impact Pack 的权重目录约定放好，否则修脸这一段整条报错。","54 是整组旁路开关但自身无连线，站内图档不含分组归属信息，回到画布才能确认它管的是哪一段；同理 Florence2 的原始描述显示在 31、改写后的文本显示在 137，改词后先比对这两处再往下追。"],"n":"依赖按索引 packs 字段可逐一对上：ComfyUI-GGUF 两个加载器、ComfyUI-easy-use 三类节点（setNode、getNode、promptReplace，数量占了全图一半）、ComfyUI-Impact-Pack 三个（FaceDetailer、UltralyticsDetectorProvider、SAMLoader）、rgthree-comfy 三个（Power Lora Loader、Fast Groups Bypasser、Image Comparer）、ControlNet-Aux 三个预处理器、ComfyUI-KJNodes 两个（PathchSageAttentionKJ、GetImageSize+）、ComfyUI-UltimateSDUpscale，其余四类（Florence2 打标、ReduxAdvanced、SeedSelector、Get Image Size）被站内归在其他自定义下，需要自行按节点报错提示补装。模型侧需要 Flux.1 dev 的 GGUF 量化权重、GGUF 版 T5 加 clip_l、ae VAE、Redux 与 SigCLIP 视觉权重、Flux 专用 Union ControlNet、写实向 LoRA 与两个检测分割权重，共十件。本图把 2D 插画转成真人质感，产出的是可辨识人脸，素材若涉及真实人物或他人作品，换脸与商用合规责任在使用者。","na":{"3":{"brief":"编码自动提示词","detail":"text 口由 78 的变量供数，节点自身输入框的值不生效，输出后进 25 加 guidance。"},"4":{"brief":"手写一条写实词","detail":"以固定文本编码一条 realistic photograph 开头的提示词，专供 FaceDetailer 使用。"},"6":{"brief":"载入源插图文件","detail":"示例图 0yYayut.jpg，是全链唯一的真实输入口，换图只需替换这里。"},"10":{"brief":"全量重绘采样","detail":"steps 20、cfg 1、euler 加 simple、denoise 1，配三路控制网把画风完全换成写实。"},"12":{"brief":"解码输出主图像","detail":"VAEDecode 出图后由 96 写成变量，名字沿用 Control_net 但承载的其实是主图。"},"14":{"brief":"量化底模入口","detail":"以 GGUF 格式加载 flux1-dev-Q8_0，绕开完整 fp16 权重，是这张图能在低显存跑 Flux 的前提。"},"16":{"brief":"独立加载 VAE","detail":"指定 ae.safetensors，Flux 必须配自带 VAE，编码、解码、修脸与放大等多处下游共用同一个变量。"},"25":{"brief":"主链路引导值","detail":"FluxGuidance 设为 8，决定自动描述被 Flux 遵从的强度，与 cfg 无直接关系。"},"26":{"brief":"自动图像描述","detail":"任务设为 more_detailed_caption，输出 caption 文本作为提示词改写的原料，另带一个随机化的运行种子。"},"27":{"brief":"拉取 Florence2","detail":"加载 microsoft/Florence-2-base，精度 fp16、注意力 sdpa，负责给原图自动写英文长描述。"},"32":{"brief":"二轮词面替换","detail":"处理 digital illustration 与 character 等复合词，换成 photorealistic photograph 与 realistic live action person。"},"34":{"brief":"前后对比查看","detail":"Image Comparer 左取 IMAGE 原图、右取放大结果，一条拖动线核对失真程度。"},"35":{"brief":"写实 LoRA 叠加","detail":"Power Lora Loader 单槽开启，挂 Flux 子目录下的写实人像 LoRA，同一节点也负责把 CLIP 一并往下传。"},"36":{"brief":"注意力加速补丁","detail":"KJNodes 的 SageAttention 开关，实参 auto 由运行时决定后端，直接挂在底模之后提速。"},"37":{"brief":"SAM 分割模型","detail":"sam_vit_b_01ec64.pth 配 AUTO 模式，把检测框细化成人脸遮罩再回贴。"},"39":{"brief":"人脸框检测器","detail":"加载 bbox/face_yolov8m.pt 只出人面框，是 FaceDetailer 的定位前端。"},"40":{"brief":"自动脸部精修","detail":"guide_size 768、按引导尺寸自适应开、max_size 1280、steps 30、cfg 5、euler 加 simple、denoise 0.35，种子来自变量。"},"43":{"brief":"加载超分权重","detail":"4xNomosWebPhoto_RealPLKSR.pth 作为放大模型，偏照片质感，正好接在写实重绘之后。"},"49":{"brief":"分块二次放大","detail":"upscale_by 2、steps 20、cfg 1、euler 加 beta、denoise 0.5、Linear 模式，tile 尺寸被整图连线覆盖。"},"54":{"brief":"整组旁路开关","detail":"Fast Groups Bypasser 无任何连线，图档也不含分组归属，只能回画布确认它管哪一段。"},"81":{"brief":"输入像素归一","detail":"nearest-exact 缩放到约一百万总像素，控制潜空间尺寸与全流程显存峰值。"},"102":{"brief":"量图输出瓦片","detail":"读取 IMAGE 变量宽高，直接顶掉 49 的 tile_width 与 tile_height 输入框。"},"106":{"brief":"双文本编码器","detail":"GGUF 版 t5-v1_1-xxl 加 clip_l 组合成 flux 类型 CLIP，省下 T5 全精度的显存。"},"110":{"brief":"统一种子来源","detail":"全图唯一种子出口，配 randomize 模式，经 111 写成 seed 变量给主采样与修脸共用。"},"114":{"brief":"Redux 风格注入","detail":"用 sigclip_vision 读原图并经 flux1-redux-dev 叠加风格条件，强度 1、方形中心裁切，输出同时给预览。"},"121":{"brief":"主链路负向清零","detail":"把 redux 条件整体置零写成 negativo，配合 cfg 1 让负向不产生实际影响。"},"127":{"brief":"原图入潜空间","detail":"VAEEncode 把 IMAGE 变量直接编码，成为 KSampler 的 latent_image 起点。"},"129":{"brief":"修脸阶段引导值","detail":"第二支 FluxGuidance 设 3.5，作用在 4 的手写词上，让二次重绘更温和。"},"131":{"brief":"修脸负向清零","detail":"对 4 的输出做 ConditioningZeroOut 供出 perso_negative，作为修脸阶段的空负向占位。"},"135":{"brief":"首轮词面替换","detail":"把 illustration、cartoon、drawing 三类词统一换成 realistic photograph，是反二次元的第一步。"},"136":{"brief":"三轮词面替换","detail":"收尾把 digital、anime-inspired、animated 替换成 profesional 与 realistic，结果同时写回变量并显示。"},"157":{"brief":"姿态骨架预处理","detail":"Openpose 预处理器，骨骼、手、脸三档全开，处理分辨率 1024。"},"161":{"brief":"控制网串联头","detail":"三路 ControlNetApplyAdvanced 的第一级，强度 0.3、start 0、end 0.5，正负向同步透传到下一级。"},"164":{"brief":"Canny 边缘预处理","detail":"双阈值 100 与 200、分辨率 1024，把原画线稿转成控制图。"},"165":{"brief":"深度图预处理","detail":"MiDaS 深度图，实参含 6.2832 与 0.1、分辨率 1024，给写实重绘提供体积与前后景参考。"},"172":{"brief":"单份 Union 权重","detail":"加载 FLUX.1-dev-ControlNet-Union-Pro-2.0 一次，经变量广播给三种类型声明复用。"},"173":{"brief":"声明姿态类型","detail":"把 Union 控制网切到 openpose 模式，与 157 的骨骼图配对，负责保住原画姿势。"},"174":{"brief":"声明线稿类型","detail":"切到 canny/lineart 一类，与 164 的 Canny 边缘配对，锁轮廓与边缘细节。"},"175":{"brief":"声明深度类型","detail":"切到 depth，配 165 的 MiDaS 深度图，稳住体块与前后景关系。"}}}}