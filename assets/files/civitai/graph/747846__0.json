:"127","fromOut":1,"to":"234","toIn":1},{"from":"235","fromOut":0,"to":"222","toIn":5},{"from":"130","fromOut":0,"to":"234","toIn":3},{"from":"129","fromOut":0,"to":"234","toIn":4},{"from":"220","fromOut":3,"to":"234","toIn":5},{"from":"133","fromOut":0,"to":"234","toIn":6},{"from":"128","fromOut":0,"to":"234","toIn":7},{"from":"214","fromOut":3,"to":"234","toIn":8},{"from":"40","fromOut":0,"to":"236","toIn":0},{"from":"127","fromOut":1,"to":"236","toIn":1},{"from":"235","fromOut":1,"to":"236","toIn":2},{"from":"130","fromOut":0,"to":"236","toIn":3},{"from":"129","fromOut":0,"to":"236","toIn":4},{"from":"220","fromOut":3,"to":"236","toIn":5},{"from":"133","fromOut":0,"to":"236","toIn":6},{"from":"128","fromOut":0,"to":"236","toIn":7},{"from":"214","fromOut":3,"to":"236","toIn":8},{"from":"240","fromOut":0,"to":"35","toIn":7},{"from":"240","fromOut":1,"to":"35","toIn":8},{"from":"223","fromOut":2,"to":"35","toIn":9},{"from":"222","fromOut":0,"to":"8","toIn":0},{"from":"8","fromOut":0,"to":"244","toIn":0},{"from":"223","fromOut":2,"to":"244","toIn":1},{"from":"244","fromOut":0,"to":"240","toIn":0},{"from":"220","fromOut":2,"to":"245","toIn":0},{"from":"245","fromOut":0,"to":"222","toIn":1},{"from":"247","fromOut":0,"to":"220","toIn":1},{"from":"248","fromOut":0,"to":"8","toIn":1},{"from":"247","fromOut":0,"to":"251","toIn":0},{"from":"251","fromOut":0,"to":"222","toIn":2},{"from":"254","fromOut":0,"to":"220","toIn":0},{"from":"254","fromOut":0,"to":"222","toIn":0}],"ai":{"s":"双模型分工的 Flux 文生图加放大流水线：主体用 bnb-nf4 量化的 flux1-dev（低显存友好），正向提示词经 ImpactWildcardEncode 处理后一路喂 FluxGuidance(3)、一路以 STRING 发给存档节点写元数据；CR Aspect Ratio 按 720x1080 出 latent，KSampler 20 步 CFG 1 出底图。之后的放大与修脸整段换用 SDXL 检查点 Atomix XL V4：Ultimate SD Upscale 调 8x-NMKD 模型做 2 倍分块重采样（4 步、denoise 0.3、Chess 修接缝），Tile 尺寸按解码图放大 2 倍后的实测分辨率下发；再过 FaceDetailer 以 0.2 低去噪只修脸。三个 Image Saver 分别存原始图、放大图与修脸图，采样参数由 Image Saver 系列选择器统一下发，文件名与 PNG 元数据自动带全采样信息，交付与复现都很省心。","u":["低显存跑 Flux 出竖版人像，再放大到可打印分辨率","需要同时保留原始/放大/修脸三版归档的成图交付流程","放大后人脸细节发糊：UltimateSDUpscale 加 FaceDetailer 双保险","想要 PNG 元数据完整记录采样参数、方便复现的存档习惯"],"d":3,"st":[{"name":"提示词与 Flux 模型","desc":"NF4 量化 Flux 与 Flux 双 CLIP 装载；wildcard 正向与字面负向文本在这里定型，并输出 STRING 备给存档节点。","nodes":["254","247","220","133"]},{"name":"Flux 采样与解码","desc":"画幅预设直接给 latent，20 步 CFG 1 采样解码后先存一版原始图。","nodes":["245","251","223","222","248","8","55"]},{"name":"SDXL 侧条件","desc":"换载 Atomix XL V4，用 Flux 阶段产出的正负文本重编码，专供放大与修脸支线。","nodes":["214","201","202"]},{"name":"Ultimate SD Upscale","desc":"8x 模型分块重采样 2 倍，Tile 由实测分辨率动态决定，成图即存 S1。","nodes":["36","244","240","35","234","149"]},{"name":"面部修复与成片","desc":"face_yolov8n 检测后以 0.2 低去噪局部修脸，存 S2 定稿。","nodes":["39","40","150","236"]}],"p":"Flux 段 20 步 CFG 1 由选择器节点统一下发，改步数/CFG 要动 Int/Float Literal 那一组；UltimateSDUpscale 的 denoise 0.3 是放大质量的旋钮，调高细节更多也更容易跑偏；画幅在 CR Aspect Ratio 改，倍率会同步传给放大支线的 upscale_by。","n":"两套模型都要备：flux1-dev bnb-nf4 与 Atomix XL V4（SDXL）；需装 Impact-Pack、Image-Saver、Comfyroll、UltimateSDUpscale 四个包，并自备 8x-NMKD 与 face_yolov8n_v2 权重；FaceDetailer 在放大后跑，检测不到脸时该支线输出与放大图一致。"}}