":0,"to":"6","toIn":2},{"from":"10","fromOut":0,"to":"6","toIn":3},{"from":"6","fromOut":0,"to":"11","toIn":0},{"from":"11","fromOut":0,"to":"12","toIn":0},{"from":"17","fromOut":0,"to":"13","toIn":0},{"from":"14","fromOut":0,"to":"15","toIn":0},{"from":"16","fromOut":0,"to":"15","toIn":3},{"from":"15","fromOut":0,"to":"17","toIn":0},{"from":"4","fromOut":0,"to":"15","toIn":1},{"from":"5","fromOut":0,"to":"15","toIn":2},{"from":"22","fromOut":0,"to":"18","toIn":0},{"from":"19","fromOut":0,"to":"20","toIn":0},{"from":"21","fromOut":0,"to":"20","toIn":3},{"from":"20","fromOut":0,"to":"22","toIn":0},{"from":"27","fromOut":0,"to":"23","toIn":0},{"from":"26","fromOut":0,"to":"25","toIn":3},{"from":"25","fromOut":0,"to":"27","toIn":0},{"from":"32","fromOut":0,"to":"28","toIn":0},{"from":"29","fromOut":0,"to":"30","toIn":0},{"from":"31","fromOut":0,"to":"30","toIn":3},{"from":"30","fromOut":0,"to":"32","toIn":0},{"from":"37","fromOut":0,"to":"33","toIn":0},{"from":"34","fromOut":0,"to":"35","toIn":0},{"from":"36","fromOut":0,"to":"35","toIn":3},{"from":"35","fromOut":0,"to":"37","toIn":0},{"from":"42","fromOut":0,"to":"38","toIn":0},{"from":"41","fromOut":0,"to":"40","toIn":3},{"from":"40","fromOut":0,"to":"42","toIn":0},{"from":"4","fromOut":0,"to":"20","toIn":1},{"from":"4","fromOut":0,"to":"25","toIn":1},{"from":"4","fromOut":0,"to":"30","toIn":1},{"from":"4","fromOut":0,"to":"35","toIn":1},{"from":"4","fromOut":0,"to":"40","toIn":1},{"from":"5","fromOut":0,"to":"20","toIn":2},{"from":"5","fromOut":0,"to":"25","toIn":2},{"from":"5","fromOut":0,"to":"30","toIn":2},{"from":"5","fromOut":0,"to":"35","toIn":2},{"from":"5","fromOut":0,"to":"40","toIn":2},{"from":"24","fromOut":0,"to":"40","toIn":0},{"from":"39","fromOut":0,"to":"25","toIn":0},{"from":"1","fromOut":0,"to":"7","toIn":0},{"from":"3","fromOut":0,"to":"4","toIn":0},{"from":"3","fromOut":0,"to":"5","toIn":0},{"from":"2","fromOut":0,"to":"7","toIn":1}],"ai":{"s":"LoRA 对比网格工作流：同一段提示词、同一个 krea2 turbo 底模，七条完全并联的支线各挂一枚 LoRA——四条是 emma krea 2 训练到 2750/3000/3250 步与最终版的不同 checkpoint，另有 Michelle RAW 与两枚 jenna sdxl prodigy。底模、CLIP、VAE 各载一次，经 Anything Everywhere 无线广播给全部支线，免去重复连线。krea2 系支线用 8 步、CFG 1、er_sde/simple 快速出图；两条 jenna 支线改 30 步、CFG 3.5、dpmpp_2m_sde/karras 作高质量参照——同一批图两档采样并排，才能分清差异来自 LoRA还是采样器。每条支线 EmptyLatentImage 开 8-10 的批量一次出多张随机网格，VAE 解码后只进 PreviewImage，横向扫一眼定优劣。rgthree 的 Fast Groups Bypasser 按组开关支线，想细看哪条留哪条。","u":["训练 LoRA 后对比不同 step checkpoint 的收敛效果，挑最佳版本","多枚候选 LoRA 用同一提示词并排出图，快速决定用哪枚","交付前用 Fast Groups Bypasser 单开一条支线放大批量精修","教学演示 LoRA 对人设/画风的影响幅度"],"d":2,"st":[{"name":"共享模型广播","desc":"底模/CLIP/VAE 只装载一次，Anything Everywhere 把 MODEL 与 VAE 无线分发到所有支线，是七线并联还能保持整洁连线的核心。","nodes":["1","3","2","7"]},{"name":"统一提示词","desc":"一段正面与一段负向提示词同时喂给七条支线，保证对比的唯一变量是 LoRA 本身。","nodes":["4","5"]},{"name":"五条 krea2 快速支线","desc":"emma 系四档训练步数加 Michelle RAW，各配独立画布与 8 步 er_sde 快速采样，batch 8 出随机网格。","nodes":["8","6","10","11","12","14","15","16","17","13","19","20","21","22","18","39","25","26","27","23","29","30","31","32","28"]},{"name":"两条慢速参照支线","desc":"jenna 两枚 LoRA 用 30 步 dpmpp_2m_sde/karras 高质量档作对照，batch 10，与快速档并排看才不会被采样器差异误导。","nodes":["34","35","36","37","33","24","40","41","42","38"]},{"name":"支线开关","desc":"Fast Groups Bypasser 把每条支线编成组，一键旁路或恢复，控制本轮参与对比的支线数量。","nodes":["64"]}],"p":"krea2 支线 8 步 + CFG 1 + er_sde 是 turbo 底模的快速档，跑对比网格别用高步数浪费时间；jenna 两条支线 30 步 CFG 3.5 dpmpp_2m_sde/karras 是参照档，别与快速档混着比；batch 8-10 决定每支线出几张随机种子，显存吃紧先减 batch 而不是减支线。","n":"对比前把五枚 emma/Michelle LoRA 换成你自己的待测文件，两枚 jenna 同理；16 号画布是 512x512、其余 1024，分辨率不同的支线不要直接比清晰度；新增对比项照抄任意一条支线即可。"}}