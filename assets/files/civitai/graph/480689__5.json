":"28","toIn":2},{"from":"86","fromOut":0,"to":"28","toIn":0},{"from":"6","fromOut":0,"to":"245","toIn":0},{"from":"7","fromOut":0,"to":"246","toIn":0},{"from":"86","fromOut":0,"to":"219","toIn":0},{"from":"85","fromOut":0,"to":"28","toIn":1},{"from":"245","fromOut":0,"to":"219","toIn":1},{"from":"246","fromOut":0,"to":"219","toIn":2},{"from":"246","fromOut":0,"to":"28","toIn":3},{"from":"85","fromOut":0,"to":"248","toIn":0},{"from":"86","fromOut":0,"to":"249","toIn":0},{"from":"84","fromOut":0,"to":"250","toIn":0},{"from":"83","fromOut":0,"to":"251","toIn":0},{"from":"245","fromOut":0,"to":"252","toIn":0},{"from":"246","fromOut":0,"to":"253","toIn":0},{"from":"249","fromOut":0,"to":"223","toIn":0},{"from":"250","fromOut":0,"to":"221","toIn":1},{"from":"155","fromOut":0,"to":"247","toIn":0},{"from":"247","fromOut":0,"to":"219","toIn":4},{"from":"247","fromOut":0,"to":"255","toIn":0},{"from":"255","fromOut":0,"to":"31","toIn":2},{"from":"252","fromOut":0,"to":"223","toIn":1},{"from":"253","fromOut":0,"to":"223","toIn":2},{"from":"246","fromOut":0,"to":"28","toIn":4},{"from":"4","fromOut":1,"to":"6","toIn":0},{"from":"4","fromOut":1,"to":"7","toIn":0},{"from":"255","fromOut":0,"to":"223","toIn":4},{"from":"11","fromOut":0,"to":"260","toIn":0},{"from":"260","fromOut":0,"to":"261","toIn":0},{"from":"261","fromOut":0,"to":"17","toIn":0},{"from":"11","fromOut":0,"to":"225","toIn":2},{"from":"221","fromOut":0,"to":"262","toIn":0},{"from":"17","fromOut":0,"to":"240","toIn":1},{"from":"240","fromOut":0,"to":"60","toIn":0},{"from":"17","fromOut":0,"to":"257","toIn":0},{"from":"60","fromOut":0,"to":"263","toIn":1},{"from":"263","fromOut":0,"to":"239","toIn":0},{"from":"263","fromOut":0,"to":"244","toIn":0},{"from":"241","fromOut":0,"to":"263","toIn":0},{"from":"240","fromOut":0,"to":"259","toIn":0}],"ai":{"s":"SD1.5 换脸流水线：先让生成的图天然长着目标脸，再正式换脸并做双重修复。主线：面部参考图经 ip-adapter-plus-face 写进模型，512 空潜图 denoise 1 直出后 latent 放大到 1024 做 0.7 去噪精修，存 PreFaceSwap。随后 FaceDetailer 用 face_yolov8m+SAM 自动找脸，在局部放大区以 0.5 去噪重画修面部细节，修完的图交给 ReActor+inswapper 按参考图换脸。画质链是亮点：GFPGAN 先在原尺寸修一次，再 2 倍放大修第二次后缩回 0.5，小脸也能修干净（After Restore 与 After Restore+Upscale+Restore 两个预览对照效果）。最后把 FaceDetailer 输出的人脸掩膜转成图并模糊 10px 当蒙版，Mix Images By Mask 只把换好的脸部贴回全身图，其余像素不动，成片无痕。生图、精修、放大三处种子由 rgthree Seed 统一供给，整条链可复现。","u":["生成带指定人物长相的全新场景图：IPAdapter 先天注入身份，随机姿势构图都像本人","AI 生成图的换脸精修：先生成再换脸，最后 GFPGAN 两段修复保清晰","全身图脸部太小修不好时，抄这条'2 倍放大修复再缩回'的接法","需要只动脸不动身体的无痕合成，靠模糊人脸掩膜局部混合"],"d":3,"st":[{"name":"人脸身份注入","desc":"参考图经 ip-adapter-plus-face 与 CLIP-Vision 提取人脸特征写进模型，之后每次采样生成的人都自带这张脸。","nodes":["11","224","226","225","4"]},{"name":"两段式生图","desc":"512 直出后 latent 放大到 1024 以 0.7 去噪做 hi-res fix；提示词正负与种子各有 Reroute 总线分发，PreFaceSwap 先存一版。","nodes":["5","6","7","245","246","155","247","255","219","173","223","221","262"]},{"name":"面部精修","desc":"FaceDetailer 用 yolov8m+SAM 检测人脸，在裁切放大的脸部区域低噪重画，专门修 SD1.5 的面部崩坏，同时产出人脸掩膜备用。","nodes":["29","30","28","31","33"]},{"name":"换脸与双重修复","desc":"ReActor 用 inswapper 精确换上参考脸；GFPGAN 原尺寸修一次、2 倍放大再修一次后缩回 0.5，两级修复兼顾小脸清晰度。","nodes":["17","240","241","60","263","239","257","259","244"]},{"name":"遮罩混合输出","desc":"FaceDetailer 的人脸掩膜转图后模糊 10px 形成羽化过渡带，Mix Images By Mask 只把修复后的脸贴回全身图，Final 存档。","nodes":["108","119","109","110","122"]}],"p":"生图 30 步 CFG 8.5 加 hi-res 0.7 去噪是画质基准；IPAdapter weight 0.6 控制像不像参考脸，太低丢特征、太高构图被带偏；FaceDetailer 的 denoise 0.5 只微调五官，动太大反而给换脸添乱。","n":"需装 Impact Pack、IPAdapter plus、ReActor、rgthree 四个节点包，并另下 checkpoint、CLIP-Vision、IPAdapter、inswapper_128、GFPGAN、face_yolov8m、SAM 共 7 个模型；ReActor 依赖 onnxruntime；换用真人肖像时注意授权与合规。"}}