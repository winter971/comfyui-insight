,"toIn":0},{"from":"2310","fromOut":10,"to":"2397","toIn":0},{"from":"2396","fromOut":0,"to":"2390","toIn":7},{"from":"2398","fromOut":0,"to":"2390","toIn":5},{"from":"2397","fromOut":0,"to":"2390","toIn":6},{"from":"2399","fromOut":0,"to":"2400","toIn":1},{"from":"2399","fromOut":0,"to":"2400","toIn":2},{"from":"2310","fromOut":11,"to":"2400","toIn":0},{"from":"2400","fromOut":0,"to":"2390","toIn":8},{"from":"2338","fromOut":0,"to":"2390","toIn":2},{"from":"2319","fromOut":8,"to":"2396","toIn":1},{"from":"2319","fromOut":9,"to":"2398","toIn":1},{"from":"2319","fromOut":10,"to":"2397","toIn":1},{"from":"2328","fromOut":8,"to":"2396","toIn":2},{"from":"2328","fromOut":9,"to":"2398","toIn":2},{"from":"2328","fromOut":10,"to":"2397","toIn":2},{"from":"2363","fromOut":0,"to":"2410","toIn":0},{"from":"2413","fromOut":0,"to":"2390","toIn":0},{"from":"2414","fromOut":0,"to":"2390","toIn":1},{"from":"2388","fromOut":0,"to":"2419","toIn":0},{"from":"2388","fromOut":0,"to":"2435","toIn":1},{"from":"2366","fromOut":0,"to":"2435","toIn":0},{"from":"2437","fromOut":0,"to":"2436","toIn":1},{"from":"2437","fromOut":1,"to":"2436","toIn":2},{"from":"2438","fromOut":0,"to":"2436","toIn":8},{"from":"2436","fromOut":1,"to":"2437","toIn":0},{"from":"2436","fromOut":2,"to":"2437","toIn":1},{"from":"2437","fromOut":2,"to":"2438","toIn":0},{"from":"2427","fromOut":0,"to":"2388","toIn":0},{"from":"2366","fromOut":0,"to":"2436","toIn":0},{"from":"2338","fromOut":0,"to":"2436","toIn":6},{"from":"2436","fromOut":0,"to":"2440","toIn":0},{"from":"2440","fromOut":0,"to":"2427","toIn":0},{"from":"2366","fromOut":0,"to":"2440","toIn":1}],"ai":{"s":"geekier 的 Resampler 重采样工具流：输入一张已生成的图（建议带生成参数的 PNG），SimpleReadableMetadataSG 读出其内嵌参数与图像本体，原图经 Reroute 送入重采样核心子图，用当前启用的模型预设组提供的 MODEL/CLIP、挂上 LoRA 与触发词后重新生成；结果由 ColorMatchV2 以原图为参考对齐色调，再过后处理子图给出预览与 Image Comparer 前后对比。三个模型预设组各自封装推荐的模型、VAE、步数、CFG、采样器等，由 Model Selection (Only 1) 的 Fast Groups Bypasser 保证只启用一个，一排 Any Switch 把激活组的参数挑出来，连同正负提示词交给 Metadata Overwrite 合成新元数据，让重制图保存时不丢来源参数。整条流的价值不在画图本身，而在'换模型重出同一张图并保留参数'的工程化。","u":["看到别人带参数分享的成图，想用自己的checkpoint重出同构图时，走这条重采样流","用画质增强类 LoRA（默认 perfection style v2d 0.70）把已有出图细化升级","重制后想核对差异：Image Comparer 与 Original vs Extra 两个对比位直接查看前后","重制图仍要归档/分享参数：Metadata Overwrite 自动按激活预设写回正确元数据"],"d":3,"st":[{"name":"载入与参数读取","desc":"从输入图同时取图像与内嵌生成参数，参数以 WebUI 风格文本展示，供复现与核对；图像经 Reroute 分发到生成与对比两侧。","nodes":["2363","2410"]},{"name":"模型预设切换","desc":"三个预设组各封装一套推荐模型/VAE/步数/CFG/采样器，Bypasser 保证只活一个；Any Switch 组把激活组的 seed、steps、cfg、sampler、scheduler、模型名、clip_skip 挑出来，2399 是 clip_skip 未提供时的兜底常量。","nodes":["2347","2310","2319","2328","2334","2335","2338","2396","2397","2398","2400","2399"]},{"name":"LoRA 与提示词","desc":"Lora Loader 挂画质 LoRA，TriggerWord Toggle 决定注入哪些触发词；easy positive/negative 提供新一次生成的提示词。","nodes":["2437","2438","2413","2414"]},{"name":"重采样生成","desc":"核心子图吃原图、模型、CLIP、seed 与触发词重新采样出图；Resampler Muter 是控制面板，用于整体开关重采样相关组。","nodes":["2436","2344"]},{"name":"色彩对齐与对比输出","desc":"生成结果先以原图为参考做色彩匹配，避免换模型带来的色调漂移，随后进预览、前后对比与 Original vs Extra 合成查看。","nodes":["2440","2427","2419","2435","2365","2367"]},{"name":"元数据写回","desc":"把激活预设的 seed/steps/cfg/采样器/模型名/clip_skip 与新提示词合成 METADATA，保存重制图时写回，保持参数可追溯。","nodes":["2390"]}],"p":"画质主要由 LoRA 强度决定，默认 perfection style v2d 0.70，嫌糊嫌腻先降它；步数/CFG/采样器不必手填，切换预设组后 Any Switch 自动取该组推荐值；换目标模型用 Model Selection (Only 1) 面板，切勿同时启用两组。","n":"核心生成/后处理节点是打包子图，类型显示为 UUID，摘要看不到内部采样细节；依赖 rgthree、LoraManager、easy-use 等节点包；三个预设组同时启用会报错或取值混乱；输入图尽量用带完整生成参数的 PNG。"}}