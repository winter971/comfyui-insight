ut":1,"to":"63","toIn":8},{"from":"68","fromOut":2,"to":"63","toIn":9},{"from":"22","fromOut":0,"to":"70","toIn":0},{"from":"70","fromOut":0,"to":"27","toIn":0},{"from":"39","fromOut":0,"to":"70","toIn":1},{"from":"35","fromOut":0,"to":"22","toIn":0},{"from":"63","fromOut":0,"to":"71","toIn":0},{"from":"71","fromOut":0,"to":"27","toIn":1},{"from":"74","fromOut":0,"to":"71","toIn":1},{"from":"38","fromOut":0,"to":"74","toIn":0},{"from":"58","fromOut":0,"to":"75","toIn":0},{"from":"75","fromOut":0,"to":"68","toIn":0},{"from":"75","fromOut":1,"to":"68","toIn":1},{"from":"76","fromOut":0,"to":"22","toIn":2},{"from":"68","fromOut":3,"to":"77","toIn":0},{"from":"68","fromOut":0,"to":"78","toIn":0},{"from":"79","fromOut":0,"to":"75","toIn":9},{"from":"68","fromOut":3,"to":"80","toIn":0},{"from":"80","fromOut":0,"to":"81","toIn":0},{"from":"85","fromOut":0,"to":"71","toIn":3},{"from":"87","fromOut":0,"to":"85","toIn":0},{"from":"68","fromOut":0,"to":"85","toIn":1},{"from":"80","fromOut":0,"to":"71","toIn":2},{"from":"68","fromOut":0,"to":"74","toIn":1},{"from":"75","fromOut":0,"to":"65","toIn":1},{"from":"28","fromOut":0,"to":"107","toIn":0},{"from":"108","fromOut":0,"to":"68","toIn":2},{"from":"109","fromOut":0,"to":"68","toIn":3},{"from":"110","fromOut":0,"to":"85","toIn":2}],"ai":{"s":"BindWeave 单角色一致性图生视频：一张人物照生成整段视频，且角色全程不变形。参考图先走 RMBG-2.0 抠出主体、垫到深色底，ImageResizeKJv2 按目标画布缩放垫边，垫边遮罩经 InvertMask 反转后作为 ref_masks 告诉 BindWeave 主体在画面哪个区域。BindWeave 是 Wan I2V 的一致性变体，条件侧三路同时供参考：ClipVision 图像嵌入、WanVAE 编码的参考潜空间、Qwen2.5-VL 的图文联合嵌入（提示词与参考图一起编码），最终由 WanVideoAddBindweaveEmbeds 合并进图像条件——这正是它区别于普通 I2V 的地方：普通 I2V 只约束首帧，BindWeave 用多路参考把角色身份锁进整段视频。模型是 Bindweave 专用 14B fp8，叠 lightx2v 4 步蒸馏 LoRA，4 步、CFG 1、dpm++_sde 采样，48 个 Transformer 块换出显存，tiled 解码后 VHS 合成视频。","u":["单张人物照生成角色全程一致的动作视频，转身走位不崩脸","虚拟主播/数字人口播：换提示词复用同一参考图批量出同角色视频","低显存跑 Wan 14B：fp8 模型加 4 步蒸馏 LoRA 加 48 块 blockswap","参考图背景杂乱也没关系，自动抠人垫底后照样能驱动视频"],"d":2,"st":[{"name":"主体抠图与画布适配","desc":"RMBG-2.0 抠出人物垫到深色底，缩放垫边到目标画布；垫边遮罩反转成 ref_masks，标出主体真实区域供后续参照。","nodes":["58","75","79","68","77","80","81","78"]},{"name":"三路参考编码","desc":"ClipVision 出图像嵌入、WanVAE 编参考潜空间、QwenVL 做图文联合嵌入，最后由 I2V 编码节点合成图像条件——三路参考是 BindWeave 保一致性的本钱。","nodes":["65","74","85","87","110","63"]},{"name":"模型与文本","desc":"Bindweave fp8 14B 叠 lightx2v 4 步 LoRA 与 torch compile，48 块换出显存；umt5 编码正负提示词，文本编码时借模型权重卸载省显存。","nodes":["22","35","76","39","70","11","16"]},{"name":"采样与输出","desc":"合并后的图像嵌入加文本嵌入进 WanVideoSampler，4 步 dpm++_sde 低 CFG 采样，tiled 解码成帧后打包视频。","nodes":["27","28","107"]}],"p":"采样锁 4 步、CFG 1、dpm++_sde，这是 lightx2v 蒸馏 LoRA 的固定配置，加步数不会更好；输出分辨率由两个 easy int（720、1280）决定，模型是 480p 底子，1280 长边已是上限；帧数 81 约 5 秒，改 WanVideoImageToVideoEncode 的 length；抠图底色默认 #222222，浅色服装可换白色防止融合。","n":"需备 Bindweave 专用 14B fp8、lightx2v LoRA、umt5、qwen2.5-VL、clip_vision_h、Wan VAE 共六个模型文件，且必须用 Bindweave 版主干；需 kijai WanVideoWrapper 等五个节点包；节点 30/106 两个 VHS_VideoCombine 未接线属冗余。"}}