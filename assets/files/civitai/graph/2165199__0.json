,"toIn":1},{"from":"32","fromOut":0,"to":"25","toIn":0},{"from":"31","fromOut":0,"to":"25","toIn":1},{"from":"29","fromOut":1,"to":"25","toIn":3},{"from":"28","fromOut":0,"to":"26","toIn":0},{"from":"17","fromOut":0,"to":"27","toIn":0},{"from":"27","fromOut":1,"to":"28","toIn":0},{"from":"37","fromOut":1,"to":"38","toIn":1},{"from":"37","fromOut":2,"to":"38","toIn":2},{"from":"37","fromOut":3,"to":"38","toIn":3},{"from":"37","fromOut":4,"to":"38","toIn":4},{"from":"25","fromOut":0,"to":"37","toIn":0},{"from":"37","fromOut":0,"to":"38","toIn":0},{"from":"25","fromOut":2,"to":"37","toIn":4},{"from":"25","fromOut":0,"to":"37","toIn":1},{"from":"25","fromOut":1,"to":"37","toIn":2},{"from":"29","fromOut":0,"to":"37","toIn":3},{"from":"15","fromOut":1,"to":"37","toIn":5},{"from":"29","fromOut":0,"to":"15","toIn":0},{"from":"37","fromOut":3,"to":"16","toIn":0},{"from":"38","fromOut":0,"to":"24","toIn":0},{"from":"38","fromOut":1,"to":"12","toIn":0},{"from":"20","fromOut":1,"to":"39","toIn":0},{"from":"10","fromOut":1,"to":"40","toIn":0},{"from":"38","fromOut":3,"to":"7","toIn":0},{"from":"41","fromOut":0,"to":"37","toIn":6},{"from":"42","fromOut":0,"to":"38","toIn":6},{"from":"44","fromOut":0,"to":"25","toIn":2},{"from":"45","fromOut":0,"to":"17","toIn":1},{"from":"16","fromOut":1,"to":"38","toIn":5},{"from":"27","fromOut":1,"to":"47","toIn":0},{"from":"48","fromOut":0,"to":"29","toIn":0},{"from":"49","fromOut":0,"to":"27","toIn":1}],"ai":{"s":"多角色分区生成工作流（Latent Couple Pose 思路的自定义实现）。主线：先用 IllustriousXL 底模按整体提示词生成一张 1024 底图，随后把底图经 ImageSender 推送到浏览器/手机端，可回传后继续处理。核心在角色注入段：两个 PreviewBridge 分别在图上涂出各角色的区域遮罩，两个双管道节点把'角色 LoRA + 角色卡分段提示词'绑定到对应遮罩区域（Jane Doe 角色 LoRA 与初音未来角色卡），OpenPose ControlNet 全图锁姿势，再用预处理输出的潜空间整图一次采样——遮罩内区域各自吃到自己的角色条件，而不是分区多次采样。之后按 face/hand YOLO 检测框两级重修脸和手（denoise 0.5），1.5 倍 4x-UltraSharp 放大后用 ControlNet-XL Tile 低噪 0.4 精修收尾保存。图里大量 GUID 命名节点是作者自定义的分段封装，功能只能按端口与控件值推断。","u":["一张图同时生成两个指定角色，各自用不同 LoRA 和独立提示词，并保持姿势互动","用 '>1 CHARACTER >2 HEAD >3 EYEBALLS' 角色卡分段语法精细控制某个角色的头部、眼神、服装等部位","生成的底图推送到手机/浏览器查看并回传，在移动端确认构图后继续精修","多人构图的高清出图：人脸手部自动修复加超分 Tile 精修一条龙"],"d":3,"st":[{"name":"底图生成","desc":"底模加载节点把模型、CLIP、VAE 与正负条件打包成管道，合并整体提示词与角色卡后从空白潜空间采样，产出用于后续分区的底图。","nodes":["11","17","6","45","49","27"]},{"name":"姿态与区域准备","desc":"底图经发送/接收节点走外部回传环路或本地支路，第二条管道叠 OpenPose 控制网锁住全图姿势；两个 PreviewBridge 供用户在图上涂出各角色遮罩。","nodes":["47","48","29","28","32","31","44","25","15","16"]},{"name":"角色注入","desc":"两个双管道节点把角色 LoRA 与角色卡分段提示词分别挂到对应遮罩区域，管道逐级串联实现两个角色区域叠加，这是整图一次采样也能分区控制的关键。","nodes":["37","41","38","42"]},{"name":"整图采样","desc":"带角色条件的管道对准备好的潜空间做 img2img 采样，dpmpp_2s_ancestral_cfg_pp 配 AYS 调度一次画完整图。","nodes":["24"]},{"name":"脸手细节修复","desc":"face 与 hand 两级 YOLO 检测器自动框出人脸和手，各自以 0.5 去噪局部重采样，解决多人构图常见的脸手崩坏。","nodes":["20","10","39","40"]},{"name":"放大与精修","desc":"bicubic 放大 1.5 倍并用 4x-UltraSharp 锐化，ControlNet-XL Tile 以 0.4 低噪二次采样补足细节，Tile 控制网防止放大后结构漂移，最后保存。","nodes":["21","12","22"]}],"p":"两个主采样阶段都是 16 步 CFG 3 配 AYS SDXL 调度，底图阶段用 dpmpp_3m_sde、整图阶段用 dpmpp_2s_ancestral_cfg_pp，照抄即可；Tile 精修 denoise 0.4 别超过 0.5，否则放大后构图会漂；角色区域强度由注入节点里的 LoRA 权重（Jane Doe 为 1）和角色卡分段共同决定。","n":"节点包依赖多：Impact/Inspire/Subpack、controlnet_aux、Custom-Scripts、WAS 等，GUID 命名节点需用 ComfyUI Manager 的 Install Missing Custom Nodes 补齐；两个 PreviewBridge 的角色遮罩必须手涂；ImageSender/Receiver 外部回传环路可整段绕开，直接用本地支路；需自备 Mistbloom 底模、Jane Doe 角色 LoRA、OpenPose 与 Tile 两张 CN-XL、4x-UltraSharp 及 face/hand YOLO 检测模型。"}}