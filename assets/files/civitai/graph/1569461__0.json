":0},{"from":"1585","fromOut":0,"to":"1586","toIn":0},{"from":"1031","fromOut":0,"to":"1585","toIn":0},{"from":"1579","fromOut":1,"to":"1039","toIn":0},{"from":"998","fromOut":0,"to":"1588","toIn":2},{"from":"1039","fromOut":0,"to":"1588","toIn":1},{"from":"1052","fromOut":1,"to":"1588","toIn":0},{"from":"1052","fromOut":0,"to":"1588","toIn":4},{"from":"1029","fromOut":0,"to":"1588","toIn":3},{"from":"1585","fromOut":0,"to":"1589","toIn":3},{"from":"1587","fromOut":0,"to":"1589","toIn":2},{"from":"1588","fromOut":0,"to":"1589","toIn":0},{"from":"1588","fromOut":1,"to":"1589","toIn":1},{"from":"1588","fromOut":2,"to":"1589","toIn":4},{"from":"1589","fromOut":0,"to":"1035","toIn":0},{"from":"1589","fromOut":1,"to":"1033","toIn":0},{"from":"1589","fromOut":2,"to":"1048","toIn":0},{"from":"1051","fromOut":0,"to":"1575","toIn":0},{"from":"1590","fromOut":0,"to":"1592","toIn":3},{"from":"1593","fromOut":0,"to":"1592","toIn":2},{"from":"1048","fromOut":1,"to":"1592","toIn":0},{"from":"1048","fromOut":2,"to":"1592","toIn":1},{"from":"1592","fromOut":0,"to":"1050","toIn":1},{"from":"1592","fromOut":1,"to":"1050","toIn":2},{"from":"1592","fromOut":2,"to":"1050","toIn":0},{"from":"1048","fromOut":0,"to":"1592","toIn":4},{"from":"1048","fromOut":5,"to":"1590","toIn":0},{"from":"1590","fromOut":0,"to":"1594","toIn":0},{"from":"1623","fromOut":1,"to":"1617","toIn":0},{"from":"1640","fromOut":0,"to":"1620","toIn":0},{"from":"1640","fromOut":3,"to":"1622","toIn":0},{"from":"1637","fromOut":1,"to":"1625","toIn":0},{"from":"1636","fromOut":1,"to":"1627","toIn":0},{"from":"1629","fromOut":0,"to":"1628","toIn":0},{"from":"1640","fromOut":0,"to":"1629","toIn":0},{"from":"1617","fromOut":0,"to":"1629","toIn":1},{"from":"1637","fromOut":0,"to":"1629","toIn":2},{"from":"1637","fromOut":1,"to":"1629","toIn":3},{"from":"1626","fromOut":0,"to":"1629","toIn":4},{"from":"1639","fromOut":0,"to":"1629","toIn":5},{"from":"1625","fromOut":0,"to":"1629","toIn":6},{"from":"1621","fromOut":0,"to":"1629","toIn":7},{"from":"1619","fromOut":0,"to":"1632","toIn":0},{"from":"1619","fromOut":1,"to":"1632","toIn":1},{"from":"1624","fromOut":0,"to":"1632","toIn":2},{"from":"1624","fromOut":0,"to":"1632","toIn":3},{"from":"1630","fromOut":0,"to":"1633","toIn":0},{"from":"1630","fromOut":1,"to":"1633","toIn":1},{"from":"1624","fromOut":0,"to":"1633","toIn":2},{"from":"1624","fromOut":0,"to":"1633","toIn":3},{"from":"1633","fromOut":0,"to":"1634","toIn":0},{"from":"1633","fromOut":1,"to":"1634","toIn":1},{"from":"1632","fromOut":0,"to":"1635","toIn":0},{"from":"1632","fromOut":1,"to":"1635","toIn":1},{"from":"1634","fromOut":0,"to":"1636","toIn":0},{"from":"1634","fromOut":1,"to":"1636","toIn":1},{"from":"1635","fromOut":0,"to":"1637","toIn":0},{"from":"1635","fromOut":1,"to":"1637","toIn":1},{"from":"1636","fromOut":1,"to":"1638","toIn":0},{"from":"1637","fromOut":1,"to":"1639","toIn":0},{"from":"1623","fromOut":0,"to":"1640","toIn":0},{"from":"1617","fromOut":0,"to":"1640","toIn":1},{"from":"1636","fromOut":0,"to":"1640","toIn":2},{"from":"1636","fromOut":1,"to":"1640","toIn":3},{"from":"1626","fromOut":0,"to":"1640","toIn":4},{"from":"1638","fromOut":0,"to":"1640","toIn":5},{"from":"1627","fromOut":0,"to":"1640","toIn":6},{"from":"1631","fromOut":0,"to":"1640","toIn":7},{"from":"1578","fromOut":0,"to":"1052","toIn":0}],"ai":{"s":"本工作流是作者 Kakitsu 针对动漫底模 Illustrious 打造的高阶多角色区域提示（Regional Prompter）与两段式超分重绘综合管线。其拓扑核心采用 PainterNode 手动画板结合 MaskFromRGBCMYBW+ 色彩分流算子，将画面精准切割为多通道角色与背景遮罩；经由 MaskBlur+ 边缘平滑羽化后，注入双层 DenseDiffusion 空间注意力网络，实现多角色、多专属 LoRA 之间零特征污染（No Concept Bleed）的精准区域控制；主干链路深度串联多路 ControlNet 锁死人物骨骼与构图，经初阶段 KSampler 采样后，无缝接入 LatentUpscaleBy 潜空间放大与二阶段 KSampler 精细重绘，末端更预置了由 Impact Pack 驱动的局部面部 SEGS Detailer 修复旁路。","u":["复杂同框双人/多人插画精准生图：彻底根除同画面中不同角色的发色、瞳色、服装特征相互串色（Concept Bleeding）的痛点，确保角色 A 与角色 B 各自对应其专属 LoRA 与特征。","精确空间构图与角色互动分镜设计：通过 PainterNode 在画板上直观绘制色块划分角色站位与景别，结合 DenseDiffusion 与 ControlNet 精准控制双人互动的身体姿态与视线朝向。","动漫插画高精度两阶段放大与面部重绘：通过两段式采样（一阶段基础构图 -> Latent 潜空间放大 -> 二阶段低去噪重绘 -> SEGS 面部 Detailer 增强），输出商业壁纸级高清动漫作品。"],"d":2,"st":[{"name":"模型底模加载与角色/风格多重 LoRA 堆叠","desc":"利用 CheckpointLoaderSimple 加载 Illustrious 系列动漫底模与配套 VAE；利用 Power LoRA Loader 与多路标准 LoraLoader 针对画面中不同角色、服装及艺术风格进行多通道模型权重挂载，为后续区域专属特征注入提供底层先验支撑。","nodes":["1017","1006","1023","1571","1572","1013","1024","1037","1038","1041","1042","1575","1579"]},{"name":"画板手绘分区、色彩遮罩解构与羽化平滑","desc":"创作者在 PainterNode (1264x832) 画板上以不同颜色涂抹角色与背景占位；MaskFromRGBCMYBW+ 将颜色自动提取为独立的黑白遮罩切片；经多路 MaskBlur+ 节点进行边缘渐变高斯羽化，消除不同区域相接处的生硬缝隙，并通过 MaskToImage 实时预览各通道遮罩。","nodes":["1031","1001","1011","1019","1020","1412","1574","1002","1003","1581","1583","997","1004","1007","1008"]},{"name":"DenseDiffusion 区域条件绑定与空间注意力调制","desc":"为每个独立区域配置专有的 CLIPTextEncode 正负提示词，送入 DenseDiffusionAddCondNode 逐一绑定对应的羽化遮罩；最后汇聚至 DenseDiffusionApplyNode，直接在扩散注意力图（Attention Map）上对各提示词空间权重实施矩阵加权，杜绝多角色特征溢出。","nodes":["1016","1039","1040","1044","1045","1046","1047","1411","1573","1005","1015","1051","1577","1578","1052"]},{"name":"多路 ControlNet 姿态与结构刚性引导","desc":"加载 OpenPose/DWPose、Depth 及 LineArt 等 ControlNet 算子；配合 AIO_Preprocessor 对人体骨架与空间纵深进行预处理抽取；经由 ACN_AdvancedControlNetApply 高级接入算子将多路几何骨骼约束叠加至扩散主干，锁定角色肢体动态不发生畸变变形。","nodes":["998","1587","1593","1029","1585","1590","1588","1589","1592","1028","1043","1582","1584","1586","1594"]},{"name":"潜空间构建、初采样与二段式潜空间重绘放大","desc":"从 EmptyLatentImage 建立潜空间画布，送入一阶段 KSampler (Efficient) 配合区域条件完成基础去噪；随后由 LatentUpscaleBy 进行等比潜空间放大（如 1.5x），再送入二阶段 KSampler 进行低去噪幅度（Denoise 0.35-0.45）细节精修，一举解决动漫多角色放大崩面问题。","nodes":["1012","1048","1049","1010","1050","1014","1018","1034","1033","1035","1580"]},{"name":"局部细节细化与面部特写旁路增强","desc":"工作流预置的旁路增强模块（默认静默状态）。通过 MaskToSEGS 将面部区域转为局部片段，利用独立加载的二阶段模型、微调 LoRA 与 DetailerForEachDebug 对角色五官与手部细节执行像素级二次高保真修补。","nodes":["1617","1618","1619","1630","1626","1621","1631","1623","1624","1625","1627","1638","1639","1632","1633","1634","1635","1636","1637","1629","1640","1620","1622","1628"]}],"p":"【区域遮罩羽化控制】MaskBlur+ 的 blur 模糊半径建议设置在 16 - 32 像素之间。若羽化值过小（<10），两角色交界处会产生明显的硬切接缝；若羽化值过大（>50），两角色的提示词特征会在交界带发生模糊串色。\n【DenseDiffusion 引导权重】DenseDiffusionAddCondNode 的 weight 建议保持在 0.8 - 1.2 之间。角色主体区域权重给 1.0，背景环境区域可下调至 0.6 - 0.8，避免背景词反客为主压制前景角色。\n【两段式采样参数梯度】一阶段 KSampler 推荐步数（Steps）24-28 步，CFG 设为 6.0-7.0，Denoise 设为 1.0；二阶段 KSampler（节点 1050）经 LatentUpscaleBy 放大后，Denoise 强烈建议压低至 0.35 - 0.45，步数设为 18-20 步，增添细腻发丝与光影细节同时严防构图漂移。\n【画布与分辨率对齐】PainterNode 的手绘画布尺寸（默认 1264×832）必须与 EmptyLatentImage 的初始宽高保持严格 1:1 像素对齐，否则遮罩映射至潜空间时会出现严重位移偏斜。","t":["提示词语法严格分层：在全局提示词（CLIPTextEncode 1016）中只写全图通用的画风（如 'masterpiece, anime visual novel style'）与总体场景；严禁在全局提示词中写具体角色的发色、眼瞳或服饰，所有角色专属细节必须严格隔离在对应区域的 DenseDiffusion 局部提示词中。","多 LoRA 权重与角色隔离：当为不同角色分别挂载专有 LoRA 时，若发现角色 A 的脸套用了角色 B 的特征，请检查是否在全局模型链上一次性启用了过高权重的两个角色 LoRA；建议将各角色 LoRA 的权重控制在 0.6-0.75 之间，并通过 ControlNet 姿态强制约束面部位置。","画板颜色与提取器通道对应：使用 PainterNode 绘制角色区块时，务必使用纯色（如纯红 #FF0000、纯绿 #00FF00、纯蓝 #0000FF），避免带有透明度或过渡杂色，否则 MaskFromRGBCMYBW+ 会无法精准归类并生成散碎杂点遮罩。","SEGS Detailer 旁路启用时机：末端的 Detailer 局部修补组默认为旁路（Bypassed）状态，建议先跑通两段式采样确认大构图与角色互动完美后，再按需激活 Detailer 组进行五官手部精修，以大幅提升探索迭代效率。"],"n":"本工作流依赖 SDXL/Illustrious 生态、DenseDiffusion 区域控制与多路 ControlNet 扩展。运行前请确认：① 显卡物理显存至少需要 16GB VRAM（推荐 24GB RTX 3090/4090），因多角色 LoRA 堆叠与两段式潜空间重绘显存峰值较高；② 必须通过 ComfyUI Manager 提前安装 ComfyUI-Impact-Pack、comfyui-densediffusion、comfyui-art-venture (PainterNode)、rgthree-comfy 以及 Advanced-ControlNet 节点扩展；③ 需下载 Illustrious XL 动漫底模，以及对应的 SDXL ControlNet（OpenPose、Depth、LineArt）模型权重放置于 models/controlnet 目录，否则多路结构引导将报错失效。","na":{"1001":{"brief":"多通道色彩语义遮罩分流器","detail":"自动解析手绘画板中的 RGB 与 CMYBW 各色彩通道，将复合彩色画布一键解构分离为彼此独立的黑白单通道区域遮罩，支撑多角色提示词的空间绑定。"},"1010":{"brief":"潜空间等比放大重绘器","detail":"将初阶段生成的多角色低分辨率潜空间张量无损放大指定倍率，无缝桥接一阶段全局构图与二阶段微观去噪，避免直接超分导致的动漫面部线条软化模糊。"},"1031":{"brief":"交互式多角色区域手绘画板","detail":"支持在 ComfyUI 界面中直接进行 1264x832 画幅手绘涂鸦，创作者通过不同纯色块勾勒各角色的空间占位与轮廓边界，为后续区域遮罩分离提供直观的几何引导输入。"},"1050":{"brief":"二阶段高清细节重绘核心采样器","detail":"在放大后的高维潜空间中执行低去噪幅度（0.35-0.45）二次精细重绘，在严格维持一阶段既定角色构图与五官的前提下，为 Illustrious 动漫画面注入极致的高清线条与阴影质感。"},"1052":{"brief":"DenseDiffusion 空间区域注意力统合生效算子","detail":"在扩散模型交叉注意力层（Cross-Attention）中强制执行遮罩引导的空间注意力调制，使各区域提示词仅在对应的遮罩区域内激活，彻底杜绝不同角色的特征串色与交叉污染。"},"1571":{"brief":"多重角色 LoRA 模块化堆叠器","detail":"基于 rgthree 高效架构集中管理并加权加载多个角色的特定画风与人设 LoRA 权重，支持独立调控各 LoRA 的模型与文本引导强度。"},"1588":{"brief":"高级 ControlNet 骨骼姿态注入器","detail":"将 DWPose 提取的人体多骨骼关节关键点无缝注入扩散主干，强力锁死多角色同框时的互动肢体与手部动态，防止构图在采样过程中发生扭曲或肢体错位。"}}}}