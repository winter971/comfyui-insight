Out":0,"to":"352","toIn":0},{"from":"358","fromOut":0,"to":"353","toIn":0},{"from":"368","fromOut":1,"to":"353","toIn":1},{"from":"368","fromOut":2,"to":"353","toIn":2},{"from":"353","fromOut":0,"to":"354","toIn":0},{"from":"382","fromOut":0,"to":"356","toIn":1},{"from":"382","fromOut":1,"to":"356","toIn":2},{"from":"376","fromOut":0,"to":"356","toIn":3},{"from":"377","fromOut":0,"to":"356","toIn":6},{"from":"378","fromOut":0,"to":"356","toIn":10},{"from":"355","fromOut":0,"to":"357","toIn":0},{"from":"356","fromOut":0,"to":"358","toIn":0},{"from":"351","fromOut":0,"to":"358","toIn":1},{"from":"368","fromOut":0,"to":"367","toIn":0},{"from":"373","fromOut":0,"to":"368","toIn":0},{"from":"372","fromOut":2,"to":"370","toIn":0},{"from":"372","fromOut":3,"to":"371","toIn":0},{"from":"367","fromOut":0,"to":"372","toIn":0},{"from":"344","fromOut":0,"to":"375","toIn":0},{"from":"382","fromOut":0,"to":"376","toIn":1},{"from":"382","fromOut":1,"to":"376","toIn":2},{"from":"382","fromOut":2,"to":"376","toIn":3},{"from":"377","fromOut":0,"to":"376","toIn":6},{"from":"378","fromOut":0,"to":"376","toIn":11},{"from":"357","fromOut":0,"to":"382","toIn":0},{"from":"352","fromOut":0,"to":"382","toIn":1},{"from":"351","fromOut":0,"to":"382","toIn":2},{"from":"372","fromOut":2,"to":"382","toIn":6},{"from":"372","fromOut":3,"to":"382","toIn":7},{"from":"369","fromOut":0,"to":"382","toIn":8},{"from":"383","fromOut":0,"to":"384","toIn":0},{"from":"384","fromOut":0,"to":"382","toIn":4},{"from":"368","fromOut":0,"to":"382","toIn":3},{"from":"402","fromOut":0,"to":"398","toIn":0},{"from":"403","fromOut":0,"to":"399","toIn":0},{"from":"400","fromOut":0,"to":"402","toIn":0},{"from":"401","fromOut":0,"to":"403","toIn":0},{"from":"375","fromOut":0,"to":"400","toIn":0},{"from":"343","fromOut":0,"to":"401","toIn":0},{"from":"398","fromOut":0,"to":"376","toIn":0},{"from":"399","fromOut":0,"to":"356","toIn":0}],"ai":{"s":"Bernini-R 参考视频条件编辑工作流，基于 Wan2.2 A14B 双模型。主线：源视频经 LoadVideo 抽帧后，首帧交给 image_scale_pixel_v2 按 0.6 系数缩到 64 倍数，得出的宽高喂给 BerniniConditioning 决定潜空间尺寸；源视频与参考视频一起被 VAE 编码成带参考条件的初始潜空间。文本侧用 umt5 编码，正向是系统指令式提示词（节点内 MarkdownNote 给出各任务的前缀表），负向固定 bad video。模型侧 HIGH/LOW 两个 fp8 UNET 各串一条 LoRA 链（lightx2v 4 步蒸馏、cfg 蒸馏、UnifiedReward-Flex）并打 SageAttention 补丁。采样分两段接力：高噪声模型从 0 跑到第 4 步并保留余噪，低噪声模型从第 4 步接到底，总步数 6、CFG 压到 1——A14B 架构必须双模型分工，蒸馏 LoRA 又要求低 CFG。最后 VAE 解码，CreateVideo 把生成帧与源视频原有的音频、帧率合回成片保存。参考视频的帧会被批量打包成多重参考，这就是它改视频不改运动的原因。","u":["给已有视频里的主体换角色或换外观：源视频定运动轨迹，参考视频提供目标角色形象","保持时序不变的实拍转风格化成片：参考视频充当风格与形象来源","多图角色一致性编辑：把多张参考图打包成参考视频批量输入（Note 注明支持批量）","长视频重绘需省显存时：SageAttention 补丁加 0.6 缩放系数控制算力开销"],"d":3,"st":[{"name":"视频输入与尺寸预算","desc":"源视频抽帧供条件编码，首帧缩放 0.6 并取整到 64 倍数，产出的宽高决定潜空间画布，避免手填错尺寸导致音画错位；参考视频单独抽帧作多重参考。","nodes":["373","368","367","372","383","384"]},{"name":"文本编码","desc":"umt5 把指令式正向提示词与固定负向编码成条件；Wan 系提示词按任务带系统前缀，是条件编辑能否听话的关键。","nodes":["355","357","352"]},{"name":"模型装配","desc":"HIGH/LOW 两个 fp8 UNET 各自串 4 步蒸馏、cfg 蒸馏与 UnifiedReward-Flex 三层 LoRA，再打 SageAttention 补丁：少步数、CFG 1 与画质对齐全靠这条链。","nodes":["344","345","375","343","400","402","398","401","403","399"]},{"name":"条件与潜空间组装","desc":"BerniniConditioning 把源视频、参考视频、文本条件与宽高、帧数 81 组装成条件对和初始潜空间，是整个参考编辑机制的核心。","nodes":["382","369","377","378"]},{"name":"双段采样","desc":"高噪声模型跑前 4 步并保留余噪，低噪声模型从第 4 步接力到第 6 步：A14B 按噪声档位分工，必须这样交接才能出片。","nodes":["376","356"]},{"name":"解码与成片","desc":"VAE 解码回图像后，CreateVideo 混回源视频的音频与帧率再保存，输出是可直接播放的视频文件。","nodes":["358","353","354"]}],"p":"总步数与分界由两个 PrimitiveInt 控制（6 步、第 4 步切换模型），CFG 固定 1，调高反而劣化；输出分辨率跟源视频走，改 image_scale_pixel_v2 的 0.6 系数即可整体缩放；换任务类型时按 MarkdownNote 的前缀表改写正向提示词。","n":"需要双 14B fp8 模型加 6 个 LoRA，显存建议 24GB 起，且依赖安装 SageAttention；输出固定 81 帧，改长度要同步 PrimitiveInt；参考视频与源视频是两个不同 LoadVideo，别接反。"}}