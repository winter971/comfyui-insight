In":2},{"from":"11","fromOut":0,"to":"77","toIn":0},{"from":"39","fromOut":0,"to":"77","toIn":1},{"from":"77","fromOut":0,"to":"76","toIn":4},{"from":"21","fromOut":0,"to":"76","toIn":3},{"from":"16","fromOut":0,"to":"76","toIn":2},{"from":"39","fromOut":0,"to":"76","toIn":1},{"from":"64","fromOut":0,"to":"76","toIn":0},{"from":"75","fromOut":0,"to":"78","toIn":0},{"from":"39","fromOut":0,"to":"78","toIn":1},{"from":"77","fromOut":0,"to":"80","toIn":0},{"from":"80","fromOut":0,"to":"75","toIn":3},{"from":"15","fromOut":0,"to":"33","toIn":0},{"from":"85","fromOut":0,"to":"83","toIn":0},{"from":"84","fromOut":0,"to":"83","toIn":1},{"from":"83","fromOut":0,"to":"86","toIn":0},{"from":"11","fromOut":0,"to":"83","toIn":2},{"from":"83","fromOut":1,"to":"87","toIn":0},{"from":"87","fromOut":0,"to":"80","toIn":1},{"from":"15","fromOut":0,"to":"66","toIn":2},{"from":"66","fromOut":1,"to":"45","toIn":6},{"from":"15","fromOut":0,"to":"88","toIn":0},{"from":"78","fromOut":0,"to":"88","toIn":1},{"from":"88","fromOut":0,"to":"89","toIn":0},{"from":"78","fromOut":0,"to":"90","toIn":0}],"ai":{"s":"Flex.2-preview 一体化模型的两阶段局部重绘。第一阶段把缩到 1MP 的原图、GroundingDINO+SAM2 按提示词'hair'自动抠出的遮罩、DepthAnything 深度图一并喂给 Flex2Conditioner，空白 latent 按图像实际尺寸生成，30 步 deis 全量重绘——深度控制锁构图、遮罩外条件锁原图，只把头发按'a girl with golden hair'重画。第二阶段把结果重新编码，在新图上再次自动检测头发区域，经遮罩后处理后用 SetLatentNoiseMask 限定范围，以 0.7 去噪低强度重采样，解决一阶段发丝与周边融合生硬的问题，是先大改后精修的分层思路。模型侧挂 FBCache 特征缓存提速，输出自动把原图与结果左右拼接对比。代价是要装检测模型全家桶，且 EG_ZZ_SSKZ 这类自定义节点来路不明。","u":["给照片人物换发色、发型：文本'hair'自动锁定头发区域重绘，免手涂遮罩","把检测提示词换成 glasses、hat 等，改任意可描述的部位或配饰","一阶段重绘边缘生硬时，靠二阶段低去噪自动磨平融合","保留原图构图只动局部：深度图控制确保姿势与背景不跑"],"d":3,"st":[{"name":"输入与自动遮罩","desc":"载入原图并统一缩到 1MP；GroundingDINO+SAM2 在原图上按'hair'检测分割，自动产出目标遮罩，免去手涂。","nodes":["15","33","66","67","68"]},{"name":"深度控制与潜空间准备","desc":"DepthAnything 提取深度图并缩放到同尺寸作控制输入，同时读出宽高生成匹配的空白 latent，保证条件与画布对齐。","nodes":["61","43","73","48"]},{"name":"一阶段：全量重生成","desc":"Flex.2 底模挂 FBCache 提速，Flex2Conditioner 把重绘图、遮罩、深度与提示词打包进条件，30 步 deis 全重绘后解码。","nodes":["40","64","41","16","21","45","20","11"]},{"name":"二阶段：区域精修","desc":"结果重编码后在新图上重检头发遮罩，处理扩边后用 SetLatentNoiseMask 锁定范围，0.7 去噪低强度重采样磨平融合痕迹。","nodes":["77","83","85","84","87","80","76","75","78"]},{"name":"输出与对比","desc":"结果单独保存，同时与原图左右拼接成对比图另存，一眼核对改动范围是否符合预期。","nodes":["88","89","90"]}],"p":"二阶段去噪 0.7 是关键旋钮：低了融合不自然，高了会改掉一阶段的发型走向；一阶段 30 步 CFG 1 配 deis+beta 是 Flex.2 的常规组合，引导强度由 Flex2Conditioner 里的 3.5 控制。两个 GroundingDinoSAM2Segment 的提示词'hair'与阈值 0.3 决定重绘区域，想换目标就改这里。","n":"需另下 Flex.2-preview、T5 fp16、SAM2 hiera large、DepthAnything 与 GroundingDINO（694MB）多份模型；遮罩靠文本自动检测，检测不准时预览节点里先核对；EG_ZZ_SSKZ 为来源不明的第三方节点，建议确认来源后再用。"},"sameAs":"1718389__0.json"}