at":"latent","x":486,"y":1643,"inputs":[],"outputs":[{"name":"LATENT","type":"LATENT"}],"widgets":["1024","1024","1"],"brief":"两张空白潜空间定画幅：1024x1440 竖图与 1024x1024 方图","desc":""},{"id":"194","title":"InpaintStitch","type":"InpaintStitch","cat":"util","x":1500,"y":1258,"inputs":[{"name":"stitch","type":"STITCH"},{"name":"inpainted_image","type":"IMAGE"}],"outputs":[{"name":"image","type":"IMAGE"}],"widgets":["bislerp"],"brief":"把重绘结果按 bislerp 缝回原大图，避免接缝与重复采样","desc":""},{"id":"195","title":"InpaintCrop","type":"InpaintCrop","cat":"util","x":-534,"y":1458,"inputs":[{"name":"image","type":"IMAGE"},{"name":"mask","type":"MASK"}],"outputs":[{"name":"stitch","type":"STITCH"},{"name":"cropped_image","type":"IMAGE"},{"name":"cropped_mask","type":"MASK"}],"widgets":["0","1","true","16","false","16","bicubic","ranged size","1024","1024"],"brief":"按掩码裁出重绘区并记录原位，重绘后靠它缝回去","desc":""},{"id":"196","title":"LoraLoaderModelOnly","type":"LoraLoaderModelOnly","cat":"load","x":484,"y":1519,"inputs":[{"name":"model","type":"MODEL"}],"outputs":[{"name":"MODEL","type":"MODEL"}],"widgets":["object_replace2-2400.safetensors","1"],"brief":"FaceID 适配器必须配套的 LoRA，缺了脸会崩","desc":""},{"id":"197","title":"LoadImage","type":"LoadImage","cat":"load","x":1666,"y":171,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE"},{"name":"MASK","type":"MASK"}],"widgets":["0f3ed0e078aa0e62b9dda05edfb30e97d2554efd9c134…","image"],"brief":"节点 45/46 是旁路的额外参考图，启用后进入多参考编辑","desc":""},{"id":"198","title":"LoadImage","type":"LoadImage","cat":"load","x":1137,"y":170,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE"},{"name":"MASK","type":"MASK"}],"widgets":["clipspace/9eca38b9d22951af351bef99a6ee7720_d4…","image"],"brief":"节点 45/46 是旁路的额外参考图，启用后进入多参考编辑","desc":""},{"id":"199","title":"ImageStitch","type":"ImageStitch","cat":"image","x":121,"y":1555,"inputs":[{"name":"image1","type":"IMAGE"},{"name":"image2","type":"IMAGE"}],"outputs":[{"name":"IMAGE","type":"IMAGE"}],"widgets":["right","true","0","white"],"brief":"把原图与重绘结果左右拼接成对比图","desc":""},{"id":"200","title":"ImageStitch","type":"ImageStitch","cat":"image","x":114,"y":1267,"inputs":[{"name":"image1","type":"IMAGE"},{"name":"image2","type":"IMAGE"}],"outputs":[{"name":"IMAGE","type":"IMAGE"}],"widgets":["right","true","0","white"],"brief":"把原图与重绘结果左右拼接成对比图","desc":""}],"links":[{"from":"181","fromOut":0,"to":"174","toIn":0},{"from":"183","fromOut":0,"to":"174","toIn":1},{"from":"200","fromOut":0,"to":"176","toIn":0},{"from":"183","fromOut":0,"to":"176","toIn":1},{"from":"178","fromOut":0,"to":"177","toIn":0},{"from":"175","fromOut":0,"to":"178","toIn":0},{"from":"180","fromOut":0,"to":"179","toIn":0},{"from":"178","fromOut":0,"to":"180","toIn":0},{"from":"176","fromOut":0,"to":"180","toIn":1},{"from":"196","fromOut":0,"to":"181","toIn":0},{"from":"179","fromOut":0,"to":"181","toIn":1},{"from":"177","fromOut":0,"to":"181","toIn":2},{"from":"193","fromOut":0,"to":"181","toIn":3},{"from":"194","fromOut":0,"to":"182","toIn":0},{"from":"189","fromOut":1,"to":"184","toIn":0},{"from":"189","fromOut":1,"to":"185","toIn":0},{"from":"189","fromOut":0,"to":"186","toIn":0},{"from":"185","fromOut":0,"to":"187","toIn":0},{"from":"184","fromOut":0,"to":"187","toIn":1},{"from":"197","fromOut":0,"to":"188","toIn":0},{"from":"195","fromOut":1,"to":"188","toIn":1},{"from":"198","fromOut":0,"to":"189","toIn":0},{"from":"198","fromOut":1,"to":"189","toIn":1},{"from":"189","fromOut":0,"to":"190","toIn":0},{"from":"186","fromOut":0,"to":"190","toIn":1},{"from":"187","fromOut":0,"to":"190","toIn":2},{"from":"195","fromOut":1,"to":"191","toIn":0},{"from":"199","fromOut":0,"to":"192","toIn":0},{"from":"195","fromOut":0,"to":"194","toIn":0},{"from":"174","fromOut":0,"to":"194","toIn":1},{"from":"190","fromOut":0,"to":"195","toIn":0},{"from":"189","fromOut":1,"to":"195","toIn":1},{"from":"173","fromOut":0,"to":"196","toIn":0},{"from":"200","fromOut":0,"to":"199","toIn":0},{"from":"174","fromOut":0,"to":"199","toIn":1},{"from":"195","fromOut":1,"to":"200","toIn":0},{"from":"188","fromOut":0,"to":"200","toIn":1}],"ai":{"s":"Flux Kontext 材质替换工作流：在 198 的 LoadImage 里涂遮罩圈出要换材质的区域后，流程把遮罩分别外扩 3 与 14 像素再相减成环带，将纯红色沿环带画到图上——因为 Kontext 只吃图像加指令、不吃遮罩输入，必须把位置信息变成它看得见的红线。InpaintCrop 按遮罩裁出区域并记录原位参数，裁片与 197 里的材质参考图横向拼成一张画布，经 ReferenceLatent 写入条件，指令 Replace the material within the red line 告诉模型把红线内替换成参考图的材质。Kontext dev 叠 object_replace2 LoRA 增强 Replace 能力，30 步 cfg 1 生成后由 InpaintStitch 以 bislerp 混合贴回原图全分辨率画布保存。裁片、参考图与成品都有预览可核对，环形红线宽度与裁剪范围均可调。","u":["给照片里的物体换材质：涂出区域再给一张目标材质参考图，如木桌换大理石","电商图材质升级：把皮革、金属、织物等换成参考图质感而构图不动","建筑/室内效果图的表面材质快速替换预览","不想手涂精细遮罩：红线只圈大概范围，边界由模型按指令重画"],"d":3,"st":[{"name":"遮罩转红线","desc":"MaskEditor 的遮罩经比例缩放后，两个 GrowMaskWithBlur 外扩 3/14 像素相减出环带，纯红图沿环带合成到图上。这一步把遮罩翻译成 Kontext 能看懂的红圈，是整条流程能跑的前提。","nodes":["198","189","186","184","185","187","190"]},{"name":"裁剪与画布拼接","desc":"InpaintCrop 围绕遮罩裁出 1024 级别的工作区并记录回贴参数；材质参考图缩放到同高后与裁片横向拼接，让模型在一张图里同时看到替换位置与目标材质。","nodes":["195","197","188","200","191"]},{"name":"Kontext 条件组装","desc":"指令文本编码后挂上 ReferenceLatent（携带拼接画布的潜空间），FluxGuidance 写 2.5，负向由 ConditioningZeroOut 清零，object_replace2 LoRA 强化材质替换服从度。","nodes":["173","196","175","178","180","179","177"]},{"name":"采样","desc":"1024 空白潜空间起步，Kontext 参照参考潜空间按指令重画，30 步 euler simple、cfg 1 是 Flux 系标配。","nodes":["193","181"]},{"name":"解码与回贴","desc":"VAE 解码后 InpaintStitch 按裁剪记录把成品以 bislerp 混合贴回原画布，输出仍是原始全图分辨率而非 1024。","nodes":["183","174","194","182"]},{"name":"对照预览","desc":"把拼接画布与最终成品、裁片与原图分别排在一起，确认红线位置与材质效果是否对得上。","nodes":["199","192"]}],"p":"FluxGuidance 2.5 是材质替换的稳定档，出格或不动可微调至 2-3；红线粗细改两个 GrowMaskWithBlur 的 grow 值（3/14），只动外扩差值；InpaintCrop 的 ranged size 1024 控制送给 Kontext 的视野，区域复杂可加大但更慢；指令文本务必写明参考图材质，模糊指令会导致整图重绘。","n":"运行前要在 198 节点右键打开 MaskEditor 涂出替换区域，197 需换成目标材质参考图；需要 flux1-kontext-dev、object_replace2 LoRA、t5xxl fp8 与 ae，另装 LayerStyle 与 KJNodes；红线画到目标物上会污染替换结果，涂遮罩时留出边界余量。"}}