32","toIn":0},{"from":"37","fromOut":0,"to":"33","toIn":0},{"from":"38","fromOut":0,"to":"33","toIn":1},{"from":"33","fromOut":0,"to":"34","toIn":0},{"from":"33","fromOut":1,"to":"34","toIn":1},{"from":"33","fromOut":2,"to":"34","toIn":2},{"from":"33","fromOut":4,"to":"34","toIn":4},{"from":"36","fromOut":0,"to":"34","toIn":6},{"from":"33","fromOut":4,"to":"35","toIn":1},{"from":"40","fromOut":0,"to":"33","toIn":2},{"from":"42","fromOut":0,"to":"33","toIn":3},{"from":"10","fromOut":0,"to":"3","toIn":0},{"from":"30","fromOut":0,"to":"12","toIn":0},{"from":"35","fromOut":0,"to":"34","toIn":3},{"from":"54","fromOut":0,"to":"53","toIn":0},{"from":"53","fromOut":0,"to":"55","toIn":0},{"from":"57","fromOut":0,"to":"56","toIn":1},{"from":"56","fromOut":0,"to":"59","toIn":0},{"from":"31","fromOut":0,"to":"20","toIn":0},{"from":"8","fromOut":1,"to":"9","toIn":0},{"from":"8","fromOut":2,"to":"6","toIn":1},{"from":"43","fromOut":0,"to":"3","toIn":4},{"from":"6","fromOut":0,"to":"35","toIn":0},{"from":"8","fromOut":0,"to":"73","toIn":0},{"from":"73","fromOut":0,"to":"5","toIn":0},{"from":"73","fromOut":0,"to":"2","toIn":0},{"from":"6","fromOut":0,"to":"53","toIn":1},{"from":"73","fromOut":0,"to":"23","toIn":0},{"from":"73","fromOut":0,"to":"22","toIn":0},{"from":"73","fromOut":0,"to":"15","toIn":0},{"from":"73","fromOut":0,"to":"14","toIn":0},{"from":"75","fromOut":0,"to":"51","toIn":0},{"from":"75","fromOut":0,"to":"76","toIn":1},{"from":"13","fromOut":0,"to":"76","toIn":0},{"from":"21","fromOut":0,"to":"75","toIn":1},{"from":"76","fromOut":0,"to":"49","toIn":0},{"from":"6","fromOut":0,"to":"75","toIn":0}],"ai":{"s":"TheGeekyGhost 的低显存 Flux Schnell 分层海报生成器。底模用 NF4 量化的 flux1-schnell 单文件（CheckpointLoaderNF4），过 ModelSamplingFlux 调度偏移后供三条支线，显存压力大幅降低。画面拆三层并行生图：主体层（anime woman）、背景层（green smiley）、文字层（neon 字），每层都是 RandomNoise+BasicGuider(CFG 1)+KSamplerSelect(euler)+BasicScheduler 的 SamplerCustomAdvanced 链——这是 Flux Schnell 少步数的标准接法，BasicGuider 不走 CFG 所以不需要负向词。三层出图后用两个 GeekyRemB 抠图合成：bria 模型抠出主体贴到背景层上，u2net 再把文字抠出叠上去，层级由连线先后决定。旁边一整组旁路节点是 LCM 图生图（从主体层输出编码回潜空间）+ReActor 换脸+8x 放大的可选扩展，需要精修时才解旁路。","u":["生成主体/背景/文字各画各的多层海报或贴纸，逐层改提示词互不干扰","显存不足（8GB 级）也想跑 Flux Schnell：NF4 量化底模为低显存而生","想要透明/纯色底的主体素材：靠 GeekyRemB 抠图支线输出","批量出图后精修：解旁路启用 LCM 图生图、换脸与 8x 放大扩展"],"d":3,"st":[{"name":"低显存主干","desc":"NF4 量化底模一次载入，ModelSamplingFlux 按分辨率设定 Flux 调度偏移，三支线的调度器与引导器都从这里拿模型。","nodes":["8","73"]},{"name":"主体层生图","desc":"Schnell 四步直出主体形象，输出既保存也作为抠图与旁路扩展组的素材源。","nodes":["11","9","10","4","5","43","3","6","7"]},{"name":"背景层生图","desc":"独立提示词画整幅背景，步数给到 22 保证大面积内容的完成度。","nodes":["25","26","31","29","23","24","20","21","27"]},{"name":"文字层生图","desc":"另一条四步支线专画霓虹文字，独立采样保证文字内容可单独重roll。","nodes":["17","18","30","28","15","16","12","13","19"]},{"name":"抠图合成","desc":"GeekyRemB 先把主体从其背景中抠出贴到背景层上，第二级再把文字抠出叠加，两级预览核对层级是否干净。","nodes":["75","76","51","49"]},{"name":"旁路扩展组（默认关闭）","desc":"LCM 底模加载器与高效采样器接 VAEEncode 做图生图，配 add_details LoRA、QRCode 控制网栈、ReActor 换脸（inswapper）与 8x_NMKD 放大；想精修或换脸时手动解旁路。","nodes":["33","34","35","36","37","38","54","53","57","56","55"]}],"p":"Flux Schnell 走 CFG 1 + euler + simple：主体与文字层 4 步即出，背景层 22 步可酌减提速；三个 String Literal 的提示词分别决定三层内容，是改图的主要入口；出图 1024x1024 与 ModelSamplingFlux 的 shift 1.42/0.42 匹配，改分辨率时两者要一起调。","n":"NF4 底模需较新版 ComfyUI 才能加载；抠图依赖 GeekyRemB 的 bria/u2net 模型；旁路组启用还需 GeekyGhost_LCM_v2、inswapper_128.onnx（ReActor）、8x_NMKD 放大模型与 add_details/qrCodeMonster 等 LoRA 控制网。"}}