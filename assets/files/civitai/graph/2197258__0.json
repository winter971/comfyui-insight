},{"from":"91","fromOut":0,"to":"92","toIn":0},{"from":"3","fromOut":0,"to":"89","toIn":0},{"from":"92","fromOut":0,"to":"4","toIn":0},{"from":"93","fromOut":0,"to":"94","toIn":0},{"from":"4","fromOut":0,"to":"93","toIn":0},{"from":"96","fromOut":0,"to":"95","toIn":0},{"from":"94","fromOut":0,"to":"96","toIn":0},{"from":"95","fromOut":0,"to":"5","toIn":0},{"from":"75","fromOut":0,"to":"76","toIn":0},{"from":"76","fromOut":0,"to":"100","toIn":0},{"from":"102","fromOut":0,"to":"27","toIn":0},{"from":"100","fromOut":0,"to":"102","toIn":0},{"from":"24","fromOut":0,"to":"65","toIn":0},{"from":"15","fromOut":0,"to":"103","toIn":0},{"from":"103","fromOut":0,"to":"73","toIn":0},{"from":"12","fromOut":0,"to":"105","toIn":0},{"from":"105","fromOut":0,"to":"104","toIn":0},{"from":"104","fromOut":0,"to":"27","toIn":3},{"from":"18","fromOut":0,"to":"99","toIn":0},{"from":"99","fromOut":0,"to":"48","toIn":0},{"from":"48","fromOut":0,"to":"106","toIn":0},{"from":"106","fromOut":0,"to":"107","toIn":0},{"from":"8","fromOut":0,"to":"108","toIn":0},{"from":"108","fromOut":0,"to":"101","toIn":0},{"from":"101","fromOut":0,"to":"109","toIn":0},{"from":"109","fromOut":0,"to":"18","toIn":1},{"from":"19","fromOut":0,"to":"111","toIn":0},{"from":"111","fromOut":0,"to":"110","toIn":0},{"from":"110","fromOut":0,"to":"112","toIn":0},{"from":"112","fromOut":0,"to":"75","toIn":0},{"from":"107","fromOut":0,"to":"113","toIn":0}],"ai":{"s":"本工作流是作者 NavyFreestyle 将阿里顶级 14B 视频大模型 Wan 2.2 T2V 跨界用于超高精细文生图（Text to Image）的工业级工程加速巅峰之作。针对 14B 庞大参数量带来的算力与显存瓶颈，管线集成了“GGUF 低比特量化 + LightX 4 步蒸馏 LoRA + SageAttention 内核加速 + TorchCompile 图编译优化”的重磅加速组合拳，并由 PatchModelPatcherOrder 规范补丁层叠时序；条件端引入 WanVideoNAG（负向注意力引导）实现精准语义对齐；采样阶段结合专属 BongSampler 与 mxSlider 图形化参数滑块，仅需 4 步即可在数秒内完成商业摄影级 14B 大底模单帧高保真图像渲染，打造出消费级显卡畅跑巨量 DiT 模型的极速生产力模范。","u":["利用 Wan 2.2 14B 视频级视觉大底模顶级的自然语言理解与物理光影质感，进行秒级商业摄影与写实插画创作。","在消费级中端显卡（RTX 3060/4060/4070 8GB~12GB）上体验 14B 级超大参数 DiT 模型的高吞吐量极速推理。","AI 视频创作者在启动长视频生成前，进行首帧构图、人物动态与环境光影的 4 步超低成本极速打样与预演。"],"d":2,"st":[{"name":"极限工程算子编译与底层加速补丁","desc":"全图核心的硬件吞吐优化阶段。通过 UnetLoaderGGUF 与 CLIPLoaderGGUF 分离加载低显存量化权重；由 LoraLoaderModelOnly 注入 LightX 4 步极速蒸馏 LoRA；全链路叠加 SageAttention 内存级自注意力优化补丁与 TorchCompileModelWanVideoV2 原生 PyTorch 算子融合编译；最后通过 PatchModelPatcherOrder 严格规范模型补丁的执行挂载时序，杜绝底层 Hook 冲突。","nodes":["1","7","8","2","3","4","5"]},{"name":"交互式滑块总控、NAG语义编译与潜空间构建","desc":"用户界面交互与条件编排阶段。前端通过 mxSlider 图形化滑块直观设定画幅宽（34）、高（37）、步数（23）与 CFG（24），配合 rgthree Seed 种子发生器确立 EmptyLatentImage 空白潜空间；双路 CLIPTextEncode 编译正负提示词，并经由 WanVideoNAG 对注意力图谱实施动态归一化增益控制，极大压制负面伪影。","nodes":["15","16","19","12","20","23","24","34","37"]},{"name":"专属采样求解、高保真解码与图像导出","desc":"4 步极速收敛成片交付阶段。由专为 Wan 架构深度定制的 BongSampler 采样求解器在结合了蒸馏 LoRA 与 NAG 引导的潜空间中执行仅 4 步的快速去噪；随之交由 VAEDecode 将特征张量还原为高清 RGB 图像，最终由 SaveImage 持久化保存并嵌入全套生成拓扑元数据。","nodes":["27","18","44"]}],"p":"去噪步数（Steps）：由节点 23（mxSlider）严格锁定为 4 步（与 LightX 4-step LoRA 强绑定，不可设置过高或过低）；CFG 引导值（节点 24）：推荐设为 1.0~1.8（蒸馏模型切忌高 CFG，配合 NAG 节点已具备极强负向约束）；分辨率长宽（节点 34/37）：推荐设定为 1024x1024、832x1216 或 1216x832 等 Wan 模型原生友好的比例；LoRA 权重建议保持 1.0 满载；SageAttention 保持 AUTO 模式；TorchCompile 模式首选 default 或 reduce-overhead。","t":["【首次运行 TorchCompile 编译冷启动】节点 4（TorchCompileModelWanVideoV2）在首次执行时需要对 PyTorch 算子图进行底层 JIT 编译，首次生成会有 1~3 分钟的“假死”或高 CPU 占用，此属正常现象，编译完成后后续生图将实现数倍硬件级暴速。","【PatchModelPatcherOrder 绝对不可删除】节点 5 用于严格编排 SageAttention、LoRA 与 TorchCompile 的注入顺序。若跳过该节点，会导致 PyTorch 编译图被动态 LoRA 打破，引发底层 C++ CUDA 报错或内存段错误。","【严禁改动 4 步步数约定】本工作流核心依托 LightX 4 步蒸馏技术，若使用常规 20~30 步，画面会出现严重的高频过曝光与结构瓦解；若需常规多步采样，必须同步 Bypass 节点 2（LightX LoRA）。"],"n":"运行本工作流需要提前下载 Wan 2.2 14B 的 GGUF 量化模型权重（放置于 models/unet 目录）、GGUF 版文本编码器（models/clip）、Wan 专属 VAE 模型（models/vae）以及专属的 LightX 4-step LoRA（models/loras）。必须通过 ComfyUI Manager 安装 ComfyUI-GGUF、ComfyUI-KJNodes（SageAttention）、ComfyUI-WanVideoIntegration、ComfyUI-Custom-Scripts（mxSlider）以及 rgthree 扩展。TorchCompile 功能要求本地 Python 环境配备完整 C++ 编译器（如 Visual Studio Build Tools 或 Linux GCC）以及兼容的 Triton 依赖，若环境缺失可将 TorchCompile 节点临时设为 Bypass。","na":{"1":{"brief":"Wan 2.2 GGUF 极限低显存量化主干加载","detail":"负责加载 14B 视频大模型的 GGUF 量化版本（如 Q4_K_M 或 Q5_K_M），大幅压榨显存占用，使 8GB~12GB 显卡具备运行可能。"},"2":{"brief":"LightX 4步极速蒸馏 LoRA 注入器","detail":"关键加速补丁，将 Wan 2.2 原始需要 30~50 步的扩散流轨迹强行蒸馏压缩至仅需 4 步即可收敛成型，实现质的推理速度跃迁。"},"3":{"brief":"SageAttention 注意力硬件加速内核","detail":"动态注入 SageAttention 算子，重构 DiT 内部庞大的自注意力与交叉注意力计算流，显著降低显存带宽压力并提升计算吞吐。"},"4":{"brief":"Wan 视频架构专用 Torch 算子编译优化","detail":"调用 PyTorch 2.x 的 torch.compile 机制，针对 Wan 2.2 Transformer 结构执行跨算子内核融合与内存复用，压榨硬件极限执行速度。"},"5":{"brief":"模型补丁时序控制器（PatcherOrder）","detail":"统一调度 LoRA 权重补丁、SageAttention 注意力重写与 TorchCompile 编译的层叠挂载顺序，杜绝底层 Hook 冲突报错。"},"7":{"brief":"GGUF 文本语义编码器加载","detail":"以轻量级内存开销加载适配 Wan 架构的双语文本理解大模型，将用户输入转换为高维语义特征。"},"8":{"brief":"Wan 专属高保真 VAE 模型加载","detail":"加载与 Wan 2.2 潜在空间维度完全匹配的变分自编码器权重，负责潜空间张量与 RGB 像素图像的转换。"},"12":{"brief":"2D 潜空间空白画布初始化","detail":"接收长宽尺寸参数，构建匹配模型通道特性的 2D 潜在空间空白张量，确立目标生成构图基础。"},"18":{"brief":"潜空间高动态范围像素解码器","detail":"调用加载的 VAE 模型将 BongSampler 输出的去噪潜空间特征图解压还原为高质量 RGB 静态位图。"},"19":{"brief":"WanVideo NAG 归一化注意力引导","detail":"利用 Normalized/Negative Attention Guidance 机制对正负提示词施加自适应增益调控，在极低 CFG 下保持画面的锐利纯净度。"},"20":{"brief":"rgthree 随机种子控制器","detail":"提供固定、递增、随机等多种模式的 Seed 发生器，便于锁定满意的构图结果进行微调打靶。"},"23":{"brief":"采样步数图形化滑块控制器","detail":"通过 mxSlider 控件直观展示并锁定生成步数（固定设为 4 步），避免用户误设导致蒸馏崩溃。"},"24":{"brief":"CFG 引导值图形化滑块控制器","detail":"提供前端直观的 CFG 调节标尺（建议 1.0~1.8），实现低引导尺度下的灵敏微调。"},"27":{"brief":"BongSampler 专属高效采样求解器","detail":"专为 Wan 模型与蒸馏流优化的连续采样求解核心，精准执行 4 步极简迭代去噪。"},"34":{"brief":"画幅宽度图形化滑块控制器","detail":"以可视化滑块动态调节生成图像的水平像素分辨率，自动保障步长对齐。"},"37":{"brief":"画幅高度图形化滑块控制器","detail":"以可视化滑块动态调节生成图像的垂直像素分辨率，与宽度滑块协同锁定画幅比例。"},"44":{"brief":"最终高清图像持久化存档","detail":"将极速渲染出的单帧高保真摄影作品保存至 output 目录，并自动嵌入全套加速参数与拓扑元数据。"}}}}