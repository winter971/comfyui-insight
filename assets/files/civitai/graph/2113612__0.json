比","desc":""}],"links":[{"from":"11","fromOut":0,"to":"16","toIn":0},{"from":"16","fromOut":0,"to":"27","toIn":1},{"from":"38","fromOut":0,"to":"28","toIn":0},{"from":"28","fromOut":0,"to":"69","toIn":0},{"from":"69","fromOut":0,"to":"60","toIn":0},{"from":"80","fromOut":0,"to":"27","toIn":0},{"from":"56","fromOut":0,"to":"80","toIn":1},{"from":"35","fromOut":0,"to":"22","toIn":0},{"from":"35","fromOut":0,"to":"71","toIn":0},{"from":"38","fromOut":0,"to":"89","toIn":0},{"from":"89","fromOut":0,"to":"27","toIn":2},{"from":"27","fromOut":0,"to":"90","toIn":3},{"from":"79","fromOut":0,"to":"90","toIn":0},{"from":"89","fromOut":0,"to":"90","toIn":2},{"from":"90","fromOut":0,"to":"28","toIn":1},{"from":"16","fromOut":0,"to":"90","toIn":1},{"from":"91","fromOut":0,"to":"27","toIn":28},{"from":"91","fromOut":0,"to":"90","toIn":27},{"from":"22","fromOut":0,"to":"92","toIn":0},{"from":"39","fromOut":0,"to":"92","toIn":1},{"from":"92","fromOut":0,"to":"80","toIn":0},{"from":"39","fromOut":0,"to":"93","toIn":1},{"from":"71","fromOut":0,"to":"93","toIn":0},{"from":"93","fromOut":0,"to":"79","toIn":0},{"from":"94","fromOut":0,"to":"27","toIn":17},{"from":"94","fromOut":0,"to":"90","toIn":17},{"from":"94","fromOut":0,"to":"95","toIn":0},{"from":"95","fromOut":0,"to":"27","toIn":18},{"from":"97","fromOut":0,"to":"79","toIn":1},{"from":"99","fromOut":0,"to":"98","toIn":0},{"from":"99","fromOut":1,"to":"98","toIn":2},{"from":"99","fromOut":2,"to":"98","toIn":3},{"from":"67","fromOut":0,"to":"99","toIn":0},{"from":"98","fromOut":0,"to":"89","toIn":2},{"from":"98","fromOut":1,"to":"89","toIn":8},{"from":"98","fromOut":2,"to":"89","toIn":9},{"from":"108","fromOut":0,"to":"109","toIn":0},{"from":"109","fromOut":0,"to":"89","toIn":10},{"from":"110","fromOut":0,"to":"27","toIn":4},{"from":"111","fromOut":0,"to":"90","toIn":4},{"from":"90","fromOut":0,"to":"112","toIn":0},{"from":"27","fromOut":0,"to":"113","toIn":0}],"ai":{"s":"Wan2.2 Fun InP 图生视频工作流：一张首帧图经两级 Resize 对齐到 16 倍数尺寸，连同 81 帧帧数（Int 5 经 a*16+1 算出）一起交给 WanVideoImageToVideoEncode 编成视频条件，提示词由 umt5-xxl 编码。模型侧把 A14B 的 HIGH/LOW 两个 fp8 专家各自装配一条链：torch compile 设置、20 块 Block Swap 换显存、lightx2v 步数蒸馏 LoRA 分别挂到两链。采样必须拆成两个 WanVideoSampler 接力——HIGH 专家管前 3 步定大结构，LOW 专家管后 3 步出细节，潜空间从前者流向后者，CFG 由 CreateCFGScheduleFloatList 按步生成并压到 1（蒸馏 LoRA 的要求），另用 FETA 增强清晰度，两段之间插 PurgeVRAM 清显存；解码后经 VHS_VideoCombine 导出视频。不拆两段就发挥不了 14B 双专家架构，这是本图存在的核心理由。","u":["把一张静态图（人像、场景图）变成约 5 秒的动态视频，首帧完全由这张图决定","给已生成的二次元或写实图补镜头运动：只改正向提示词描述想要的动作即可","用 lightx2v 蒸馏 LoRA 6 步快速预览视频构图，确认后再加大帧数出成品","显存吃紧但想跑 14B 的用户：Block Swap 20 块 + fp8 + PurgeVRAM 的组合配置可直接照抄"],"d":3,"st":[{"name":"图像输入与尺寸对齐","desc":"载入首帧图，先重算成 16 倍数尺寸，再按同一宽高二次缩放并输出尺寸整数；帧数用 5*16+1 的公式从 Int 推出，改一个数即改视频长度。","nodes":["67","99","98","108","109"]},{"name":"视频条件与文本编码","desc":"首帧图经 Wan VAE 编码成图生视频条件，决定整段视频的运动起点；umt5-xxl 把正负提示词编成视频文本条件，正向写动作、负向排除过曝模糊。","nodes":["38","89","11","16"]},{"name":"双专家模型装配","desc":"HIGH/LOW 两个专家模型各自成链：共享 torch compile 设置，各接 20 块 Block Swap 降显存峰值，再分别挂 lightx2v 蒸馏 LoRA 实现少步数采样。","nodes":["22","71","35","39","92","93","97","56","80","79"]},{"name":"两段接力采样","desc":"总步数 6、切换点 3 由两个 INT 常量统一分发，CFG 调度表按步生成；HIGH 采样器跑前半程把潜空间交给 LOW 采样器续跑，FETA 增强细节，阶段间强制清显存防 OOM。","nodes":["91","94","95","110","27","90","111","112","113"]},{"name":"解码与导出","desc":"Wan VAE 把潜空间解回图像帧序列，读出尺寸与帧数后交给 VHS_VideoCombine 打包成视频文件。","nodes":["28","69","60"]}],"p":"总步数 6（HIGH 前 3 步 + LOW 后 3 步）配合 CFG 1 + unipc + shift 8 是蒸馏 LoRA 的固定搭配，不要调高 CFG；帧数改 Int 常量 5（帧数=5*16+1=81，约 5 秒），改大前先确认显存；首帧分辨率由第一级 Resize 的 832 基准控制，保持 16 倍数。","n":"需要下载 HIGH/LOW 两个 fp8 专家模型、umt5-xxl、Wan2.1 VAE 和 lightx2v 蒸馏 LoRA 共五份文件，并装 WanVideoWrapper、KJNodes、LayerStyle、VHS 四个节点包；81 帧 480p 起步显存压力大，Block Swap 与 PurgeVRAM 已开但 12GB 以下显卡仍可能 OOM。"}}