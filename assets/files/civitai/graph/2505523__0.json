9","fromOut":0,"to":"232","toIn":10},{"from":"160","fromOut":0,"to":"232","toIn":11},{"from":"279","fromOut":0,"to":"232","toIn":12},{"from":"160","fromOut":0,"to":"287","toIn":3},{"from":"159","fromOut":0,"to":"287","toIn":2},{"from":"159","fromOut":0,"to":"308","toIn":1},{"from":"160","fromOut":0,"to":"308","toIn":2},{"from":"308","fromOut":2,"to":"232","toIn":6},{"from":"308","fromOut":3,"to":"232","toIn":7},{"from":"310","fromOut":0,"to":"9","toIn":0},{"from":"311","fromOut":0,"to":"232","toIn":1},{"from":"315","fromOut":0,"to":"1","toIn":0},{"from":"315","fromOut":0,"to":"21","toIn":0},{"from":"312","fromOut":0,"to":"232","toIn":0},{"from":"317","fromOut":0,"to":"232","toIn":13},{"from":"324","fromOut":0,"to":"325","toIn":0},{"from":"340","fromOut":0,"to":"232","toIn":14},{"from":"232","fromOut":0,"to":"342","toIn":0},{"from":"342","fromOut":0,"to":"324","toIn":0},{"from":"308","fromOut":2,"to":"346","toIn":0},{"from":"308","fromOut":3,"to":"346","toIn":1},{"from":"339","fromOut":0,"to":"348","toIn":0},{"from":"348","fromOut":0,"to":"312","toIn":0},{"from":"160","fromOut":0,"to":"350","toIn":2},{"from":"350","fromOut":0,"to":"308","toIn":3},{"from":"159","fromOut":0,"to":"350","toIn":1},{"from":"287","fromOut":0,"to":"308","toIn":0},{"from":"317","fromOut":0,"to":"358","toIn":0},{"from":"340","fromOut":0,"to":"358","toIn":1},{"from":"358","fromOut":0,"to":"287","toIn":4},{"from":"350","fromOut":1,"to":"308","toIn":4},{"from":"360","fromOut":0,"to":"232","toIn":4},{"from":"9","fromOut":0,"to":"360","toIn":0},{"from":"362","fromOut":0,"to":"339","toIn":0},{"from":"287","fromOut":0,"to":"350","toIn":0}],"ai":{"s":"Wan2.2 Animate 角色动作迁移工作流，带不限时长的循环分段机制：用驱动视频里人物的动作，套到参考图角色身上。VHS 载入驱动视频后，PointsEditor 在画面上打正负点定位角色，官方裁切组件按坐标输出面部与姿态两路引导视频；角色参考图经 clip_vision_h 编码成身份条件。模型链是 Q8 量化的 Wan2.2-Animate-14B GGUF，叠 Lightning 两步加速 LoRA 与 relight 光照 LoRA，再做 ModelSamplingSD3 shift 6。核心机关在循环：单段 26 帧、循环 7 段，pysssss 数学节点算出总加载帧数（26x7+26=208），WanAnimateToVideo 按段处理直到剩余段数清零，时长因此不受单次 26 帧限制。生成帧经 RIFE 补帧平滑后按 30fps 打包存成视频。负向提示词用中文书写是 Wan 系惯例，保留即可。","u":["动作迁移：让参考图角色复刻驱动视频里的人物动作","长视频动画替换：循环分段机制不受单段 26 帧限制","舞蹈或表演素材二次创作：换角色、保留原运镜与动作","低显存跑 Wan2.2 Animate：Q8 GGUF 加 Lightning 加速"],"d":3,"st":[{"name":"驱动视频与角色输入","desc":"VHS 载入视频，PointsEditor 打点定位角色，裁切组件按坐标产出面部与姿态两路引导并排预览；角色参考图另走 CLIP-Vision 提取身份。","nodes":["287","350","308","346","10","9","310","360"]},{"name":"模型链","desc":"Q8 量化动画主干先叠 Lightning 加速 LoRA 再叠 relight 光照 LoRA，配 shift 6 采样分布；umt5 编码器与 Wan2.1 VAE 一并就位。","nodes":["362","339","348","312","315","311"]},{"name":"正负条件","desc":"正向描述目标画面质感，负向用中文列禁项，Wan 系标准写法。","nodes":["21","1"]},{"name":"循环分段采样","desc":"尺寸、种子为常量；单段帧数与循环数经数学节点折算总加载帧数，WanAnimateToVideo 按段驱动动画直到剩余段清零。","nodes":["317","340","279","358","232","159","160"]},{"name":"补帧与成片","desc":"RIFE 插帧让 26 帧段之间的动作衔接平滑，再按 30fps 打包存成视频文件。","nodes":["342","324","325"]}],"p":"输出 1280x720、单段 26 帧、循环 7 段决定总时长与显存压力，先降单段帧数最见效；PointsEditor 的正负点位置决定动作贴到谁身上，点偏了角色就贴错；负向中文提示词照抄即可，Lightning LoRA 下不需要拉高步数。","n":"需 KJNodes、pysssss、VideoHelperSuite、Frame-Interpolation 四个包；Wan2.2-Animate-14B Q8、Lightning 与 relight 两枚 LoRA、umt5 编码器、Wan2.1 VAE、clip_vision_h、rife49 都要提前下载；建议 12GB 以上显存；角色参考图要清晰正面，驱动视频人物应完整入画。"}}