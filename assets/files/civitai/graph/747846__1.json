":"234","toIn":5},{"from":"133","fromOut":0,"to":"234","toIn":6},{"from":"128","fromOut":0,"to":"234","toIn":7},{"from":"214","fromOut":3,"to":"234","toIn":8},{"from":"40","fromOut":0,"to":"236","toIn":0},{"from":"127","fromOut":1,"to":"236","toIn":1},{"from":"235","fromOut":1,"to":"236","toIn":2},{"from":"130","fromOut":0,"to":"236","toIn":3},{"from":"129","fromOut":0,"to":"236","toIn":4},{"from":"220","fromOut":3,"to":"236","toIn":5},{"from":"133","fromOut":0,"to":"236","toIn":6},{"from":"128","fromOut":0,"to":"236","toIn":7},{"from":"214","fromOut":3,"to":"236","toIn":8},{"from":"240","fromOut":0,"to":"35","toIn":7},{"from":"240","fromOut":1,"to":"35","toIn":8},{"from":"223","fromOut":2,"to":"35","toIn":9},{"from":"222","fromOut":0,"to":"8","toIn":0},{"from":"8","fromOut":0,"to":"244","toIn":0},{"from":"223","fromOut":2,"to":"244","toIn":1},{"from":"244","fromOut":0,"to":"240","toIn":0}],"ai":{"s":"Atomix Flux NF4 文生图加两级放大的出图流水线。主线从 NF4 量化的 Flux checkpoint 出发，ImpactWildcardEncode 展开 wildcard 正向提示并直接输出条件，CR Aspect Ratio 按竖版 720x1080 提供空 latent，采样器、种子、步数等参数由 Selector/Literal 小节点统一分发到 KSampler（20 步、cfg 1），解码后先存原图。放大阶段刻意换成 Atomix XL V4 这颗 SDXL checkpoint：8x NMKD 超分模型先拉大约 3 倍，UltimateSDUpscale 再以 0.1 低去噪分块重绘回填细节，去噪极低所以只锐化不换构图；ImageScaleBy 配合 Crystools 读出放大后分辨率反喂 tile 尺寸，等效整图单块一次处理。人脸细化支线默认静音，启用后 FaceDetailer 用 face_yolov8n 自动裁脸低噪重绘；两个 Image Saver 按阶段前缀落盘并写入种子与参数元数据。","u":["用 Flux 出竖版插画并自动放大到 2K 以上，全程不用手动算分辨率","低显存显卡跑 Flux：NF4 量化 checkpoint 负责生成，细节交给后续 SDXL 低噪放大补","成图脸部崩坏时，启用静音的 FaceDetailer 支线自动修脸，不用另开工修图","希望 PNG 自带种子、采样器、模型名等元数据，方便日后精确复现"],"d":2,"st":[{"name":"Flux 文生图","desc":"NF4 量化 Flux 出底图，wildcard 正向与字符串负向分别编码；CR Aspect Ratio 给 720x1080 空 latent，一排 Selector/Literal 把采样参数同时喂给 KSampler 和保存器，保证出图与元数据一致。","nodes":["216","220","133","226","223","127","128","129","130","131","235","222"]},{"name":"解码与原图保存","desc":"潜空间先解码成图并立即保存一份，作为放大前的原始结果留档。","nodes":["8","55"]},{"name":"低噪放大重绘","desc":"8x NMKD 先把图拉大，UltimateSDUpscale 换用 SDXL checkpoint 在 0.1 去噪下重绘；ImageScaleBy 与 Crystools 预算目标分辨率喂作 tile 尺寸，让放大图整块处理不切块。","nodes":["36","214","201","202","244","240","35","149"]},{"name":"人脸细化（默认关闭）","desc":"FaceDetailer 支线被静音：启用后按 face_yolov8n 检测裁出脸部，用同套 SDXL 模型低去噪重采样再贴回，专治远景小脸崩坏。","nodes":["39","40","150"]},{"name":"带元数据落盘","desc":"Image Saver 按阶段前缀保存，把种子、采样器、模型名、提示词写进 PNG；没有它这些参数只存在于会话里。","nodes":["234","236"]}],"p":"主采样 20 步、cfg 1 是 Flux 的惯例配置不必动；放大阶段 denoise 0.1 配 4 步 dpmpp_2m 只做细节回填，调大会掺入 SDXL 画风造成前后不一致；放大倍率在 CR Aspect Ratio 里改，tile 尺寸会跟随实际分辨率自动对齐。","n":"需安装 Impact Pack、UltimateSDUpscale、Comfyroll、Image-Saver、Crystools 节点包；Flux NF4 与 Atomix XL V4 两份 checkpoint、8x NMKD 超分模型、face_yolov8n 检测模型都要提前就位；FaceDetailer 默认静音，启用后 S2 保存器才有输出。"}}