":"35","toIn":0},{"from":"36","fromOut":0,"to":"38","toIn":0},{"from":"34","fromOut":0,"to":"39","toIn":0},{"from":"38","fromOut":0,"to":"40","toIn":0},{"from":"21","fromOut":0,"to":"40","toIn":1},{"from":"44","fromOut":0,"to":"41","toIn":0},{"from":"40","fromOut":0,"to":"41","toIn":1},{"from":"35","fromOut":0,"to":"42","toIn":0},{"from":"21","fromOut":0,"to":"42","toIn":1},{"from":"39","fromOut":0,"to":"43","toIn":0},{"from":"21","fromOut":0,"to":"43","toIn":1},{"from":"65","fromOut":0,"to":"44","toIn":0},{"from":"43","fromOut":0,"to":"44","toIn":1},{"from":"56","fromOut":0,"to":"46","toIn":1},{"from":"45","fromOut":0,"to":"48","toIn":0},{"from":"22","fromOut":0,"to":"50","toIn":0},{"from":"22","fromOut":1,"to":"50","toIn":1},{"from":"13","fromOut":0,"to":"51","toIn":0},{"from":"21","fromOut":0,"to":"51","toIn":1},{"from":"66","fromOut":0,"to":"55","toIn":0},{"from":"55","fromOut":0,"to":"56","toIn":0},{"from":"21","fromOut":0,"to":"56","toIn":1},{"from":"22","fromOut":0,"to":"59","toIn":1},{"from":"22","fromOut":1,"to":"59","toIn":2},{"from":"46","fromOut":0,"to":"60","toIn":1},{"from":"23","fromOut":0,"to":"60","toIn":2},{"from":"30","fromOut":0,"to":"65","toIn":0},{"from":"42","fromOut":0,"to":"65","toIn":1},{"from":"48","fromOut":0,"to":"66","toIn":0},{"from":"81","fromOut":0,"to":"60","toIn":0},{"from":"41","fromOut":0,"to":"46","toIn":0},{"from":"51","fromOut":0,"to":"84","toIn":0},{"from":"86","fromOut":0,"to":"85","toIn":0},{"from":"84","fromOut":0,"to":"86","toIn":0}],"ai":{"s":"Flux.2 Klein 4B GGUF 四图合成'换装写真'工作流。人脸、服装、背景、姿态四张参考图各压到 1MP 后分别 VAE 编码，按'脸→裙→背景→姿态'的固定顺序串进四节 ReferenceLatent 链写进正向条件——Klein 靠条件里的参考潜空间同时读四张图，各自扮演什么角色在提示词里点名（Face/Dress/Background/Pose）。姿态参考先经 Image Padding 垫边，再由 DWPose 提成人体骨架图：骨架只保留肢体动作、去掉外观干扰，比直接给真人姿态照更稳。输出画布与 Flux2Scheduler 的宽高都取自人脸图的实际尺寸（GetImageSize），即以人脸图为'底片'定构图。采样是 klein-4b Q8_0 GGUF + CFGGuider(1) + euler + 4 步的 SamplerCustomAdvanced 快速配方，负向 ConditioningZeroOut 清零。出图按时间戳保存后自动清显存内存。结构是 noob friendly 风格的干净直线，效果好坏取决于四张参考图质量与提示词是否逐一点名。","u":["AI 换装写真：指定人脸 + 一张服装图 + 场景图，生成穿着该服装的整身照片","需要控制姿势的合成：给姿态参考图，DWPose 锁定肢体摆位","虚拟模特/电商展示：同一件衣服换不同人脸与场景批量出片","低显存跑 Flux.2：4B Q8 量化加 4 步采样，配置门槛低"],"d":2,"st":[{"name":"四路参考输入","desc":"脸、裙、背景三图统一压到 1MP 保证参考信号密度一致；四张图的角色分工要在提示词里逐一点名。","nodes":["33","34","36","45","35","38","39"]},{"name":"姿态骨架化","desc":"姿态图垫边后由 DWPose 提取人体骨架，只留动作信息，避免参考图的衣着外观污染生成。","nodes":["48","66","55"]},{"name":"编码与参考链","desc":"四张参考各自 VAE 编码成潜空间，按序挂进 ReferenceLatent 链写入正向条件，负向清零是 Flux.2 固有接法。","nodes":["21","42","43","40","56","30","65","44","41","46","23"]},{"name":"采样","desc":"画布与调度宽高跟随人脸图实际尺寸；Klein 4B Q8 模型在 CFG 1、4 步内完成四参考合成。","nodes":["81","22","50","59","32","12","60","13"]},{"name":"输出与清理","desc":"解码后按时间戳文件名保存，保存动作触发 VRAM/RAM 顺序清理，低配机连跑不积压。","nodes":["51","84","86","85"]}],"p":"Flux2Scheduler 默认 4 步配 euler、CFG 1，是 Klein 4B 的快速配方，追求细节可升到 8 步；输出分辨率等于人脸参考图尺寸，想要高输出请备高分辨率人脸图；姿态图垫边 120px 保证骨架完整不贴边。","n":"需下载 flux-2-klein-4b-Q8_0.gguf、qwen_3_4b 编码器与 flux2-vae，并装 ComfyUI-GGUF 与 ControlNet-Aux（DWPose 依赖）；四张参考图务必与提示词中的称呼一一对应，顺序错乱会导致张冠李戴；显存占用小但参考图多时编码阶段仍有峰值。"}}