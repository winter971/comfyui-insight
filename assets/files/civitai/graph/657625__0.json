38","toIn":3},{"from":"248","fromOut":0,"to":"238","toIn":0},{"from":"44","fromOut":5,"to":"51","toIn":2},{"from":"42","fromOut":5,"to":"235","toIn":0},{"from":"127","fromOut":5,"to":"249","toIn":0},{"from":"249","fromOut":0,"to":"126","toIn":0},{"from":"153","fromOut":0,"to":"250","toIn":0},{"from":"250","fromOut":0,"to":"251","toIn":0},{"from":"114","fromOut":0,"to":"124","toIn":1},{"from":"218","fromOut":0,"to":"253","toIn":0},{"from":"218","fromOut":0,"to":"253","toIn":1},{"from":"253","fromOut":0,"to":"231","toIn":0},{"from":"253","fromOut":0,"to":"217","toIn":0},{"from":"253","fromOut":1,"to":"216","toIn":0},{"from":"216","fromOut":0,"to":"215","toIn":0}],"ai":{"s":"这是 TheGeekyGhost 为 Project Odyssey 竞赛攒的个人工具箱：97 个节点拆成近十条互不相连的完整管线，除抠图改绘链外全部标题带 ⏸，靠 rgthree 分组开关或手动旁路按需激活。枢纽是 workflow/Control Center（152），把正词（以 Ghost:1.6 与 Geeky Ghost 戴眼镜起头）、负词（nsfw、watermark、dof、human、person 等，说明他主要生成非人物场景）与一个统一 INT 种子同时广播给全图多台采样器与四台 Efficient Loader。唯一无暂停标记的活链：Efficient Loader 载 aZovya RPG 检查点，输入图先过 GeekyRemB（u2netp、反向遮罩、透明化）抠出主体并经 MaskToImage 与两台 PreviewImage 回显，结果 VAEEncode 进潜空间，IPAdapterUnifiedLoader 选 LIGHT 模式配 IPAdapterTiled（强度 1、ease in-out、V only、以同图作风格参考），KSampler (Efficient) 22 步 cfg 6.5 euler_ancestral karras、denoise 0.2 轻改绘后 SaveImage。停用的支路各是一件成品工具：AnimateDiff 链把四张临时图 ImageBatch 拼成批量，经 IPAdapterBatch 与 lcm 12 步 2 强度采样，首尾各挂一台 RIFE（rife47）插帧再合成两段视频；Stable Cascade 双段链用 stage_c 42 步、stage_b 10 步级联，其解码图还反手充当 SVD 支路的 init_image；SVD 支路以 AnimateLCM-SVD 检查点配 img2vid 条件（1024×576、32 帧、motion_bucket_id 127、fps 10）加 CAIN 插帧；Wav2Lip 口型链从视频拆帧对音频改嘴，再串 ReActor（inswapper_128 加 codeformer、保真 0.5）换脸并带音轨合成；LivePortrait 链用驱动视频加单图源图做面部动画，配 IF_WhisperSpeech 造配音；另有 38、44 两台 LCM 四步采样器经 VAEEncode 与 IPAdapterTiled 互相回灌做循环 dream，末端接 UltimateSDUpscale（8x_NMKD 放大模型、512 分块）出高清。孤立的 AnyNodeLocal 还演示了连本地 ollama 的通用节点。","u":["游戏美术竞赛中一图多用的角色场景改绘与抠图流水线","AnimateDiff 与 SVD 两套短视频生成支路的切换示范","Wav2Lip 口型加 ReActor 换脸的说话人视频后期管线","Stable Cascade 级联生成再喂给视频模型的链式玩法","用单一控制中心统一提示词与种子管理多条采样管线"],"d":3,"st":[{"name":"控制中心统一广播","desc":"一台 Control Center 输出正负词与统一种子，喂给全图六台采样器与四台加载器。","nodes":["152"]},{"name":"活链：抠图改绘与风格迁移","desc":"GeekyRemB 抠主体进潜空间，IPAdapter LIGHT 加 Tiled 强度 1 参考，22 步 denoise 0.2 轻改绘出图。","nodes":["206","218","253","216","217","215","231","187","189","204","200"]},{"name":"AnimateDiff 批量转视频支路","desc":"四张图拼批量经 IPAdapterBatch 与 lcm 12 步采样，首尾各一次 RIFE 插帧后分别合成。","nodes":["85","88","105","86","89","84","100","73","74","75","76","78","79","80","77","81","102"]},{"name":"Stable Cascade 双段级联支路","desc":"stage_c 与 stage_b 两台采样级联，1024×576 空潜与 stageB 条件接力，解码图兼作 SVD 输入。","nodes":["116","117","115","121","109","110","119","129","120","130","114","122"]},{"name":"SVD 图生视频支路","desc":"AnimateLCM-SVD 检查点一次给齐模型、视觉与 VAE，img2vid 条件 32 帧 10fps 采样后 CAIN 插帧合成。","nodes":["125","124","127","249","126"]},{"name":"口型与换脸说话人支路","desc":"视频拆帧后 Wav2Lip 依上传音频改嘴，ReActor 以 inswapper 加 codeformer 换脸，合成保留音轨。","nodes":["140","136","134","138","137","139"]},{"name":"LivePortrait 面部驱动支路","desc":"下载式管线加载 LivePortrait，单图源图配驱动视频做表情迁移，另接 Whisper 造语音并循环试听。","nodes":["132","131","141","142","143","144"]},{"name":"LCM 循环改绘与高清放大支路","desc":"两台四步 LCM 采样器经 VAEEncode 与 IPAdapter 互相回灌 dream，末端 UltimateSDUpscale 分块放大存图。","nodes":["237","238","239","248","245","38","44","42","242","246","51","243","69","236","235","30","31","40","241"]},{"name":"杂项检测与孤立备胎","desc":"视频帧数经 BatchCount 回显、另一台 u2net 抠图链带暂停，组开关与 ollama 节点孤立备用。","nodes":["153","250","251","68","232","58","150","145","133","210","252"]}],"p":"先用 Fast Groups Bypasser 或手动只放行一条链再排队，全图齐跑会同时加载 SD1.5、SDXL、Cascade、SVD 多套底模；活链的 denoise 0.2 是轻改绘起点，想大幅重绘升到 0.4 以上但会丢原图构图；种子统一来自 152，改一处即可全链对齐复现；AnimateDiff 支路的 context 与 lcm 12 步组合要求底模是 GeekyGhost_LCM_v2 这类 LCM 融合，普通 1.5 检查点请回到 20 步以上；换脸与口型链对 512 以下素材效果好，高清化放在最后一段做。","t":["这是工具箱不是一键流程：除抠图改绘链外节点标题几乎都带暂停标记，且图文件没有 mute 字段，激活哪条全凭在 UI 里手动旁路，直接 Queue Prompt 会得到与作者预期完全不同的产物","依赖包极多：Efficiency-Nodes、IPAdapter_plus、AnimateDiff-Evolved、Frame-Interpolation、UltimateSDUpscale、ReActor、LivePortrait、Wav2Lip、IF_AI、GeekyRemB 等缺一不可，装齐前别按单条链排错","作者自己在 Note 里写明 Cascade 与 SVD 的参数是绑他的机器调的，照搬到别的显存档大概率需要重调帧数与分辨率","ReActor 换脸与 Wav2Lip 口型涉及真人肖像，inswapper_128.onnx 等模型需自行获取，使用前必须拿到素材人物授权，合规责任在使用者","u2net、rife47、pretrained_cain 等杂项模型均为首次运行自动下载，离线机器要提前铺好文件，否则支路启动即报缺模型"],"n":"需要十余个自定义包：Efficiency-Nodes、ComfyUI_IPAdapter_plus、AnimateDiff-Evolved、VideoHelperSuite、Frame-Interpolation、UltimateSDUpscale、ReActor、Comfyroll、KJNodes、GeekyGhost 自家 RemB 与控制中枢、LivePortrait 与 Wav2Lip 包装等；模型横跨 SD1.5（aZovya RPG、GeekyGhost_LCM_v2）、SDXL（GeekySDXL_Mixv2）、Stable Cascade stage_a/b/c、AnimateLCM-SVD、inswapper_128.onnx 加 codeformer.pth、rife47.pth、8x_NMKD-Superscale 等；多条支路含真人肖像素材玩法，使用需自负合规。","na":{"38":{"brief":"回灌改绘采样对","detail":"与 44 互为上下游：lcm 四步 cfg 1、denoise 0.2，两台图像经 VAEEncode 与 IPAdapter 交替回灌做循环 dream。"},"77":{"brief":"双 RIFE 插帧","detail":"两台 RIFE VFI（rife47.pth，倍帧 10 与 30、4 差异配置）一头挂批量源头一头挂采样输出。"},"80":{"brief":"批量拼合终点","detail":"三层 ImageBatch 把四张临时图合成单一批量张量，喂给 RIFE 与编码两条下游。"},"84":{"brief":"动画段采样器","detail":"lcm 12 步 cfg 2、denoise 0.6，latent 来自 100 编码的视频帧批量。"},"85":{"brief":"AnimateDiff 底模","detail":"Efficient Loader 换 GeekyGhost_LCM_v2，配 lcm 调度专供四步与十二步低步数动画。"},"86":{"brief":"动效模型加载","detail":"ADE_AnimateDiffLoaderGen1 挂 AnimateLCM_sd15_t2v.ckpt 与 sqrt_linear 调度，标题带暂停标记。"},"89":{"brief":"上下文窗口参数","detail":"Uniform Context Options 16 帧窗口 4 步推进，控制动画的时序连贯范围。"},"105":{"brief":"批量图参考注入","detail":"IPAdapterBatch 以 ease in-out 权重吃下拼好的四图批量，image 与 image_negative 同图不同极。"},"114":{"brief":"一图两用的解码","detail":"VAEDecode 的出图既进 SaveImage 存档，又接去 SVD 支路的 init_image，是两条链的接口。"},"119":{"brief":"级联双段空潜码","detail":"StableCascade_EmptyLatentImage 一次给 stage_c 与 stage_b 两路潜空间，画幅 1024×576。"},"120":{"brief":"跨段条件桥接","detail":"StageB_Conditioning 把文本条件与 C 段结果潜码绑成 B 段可用的条件张量。"},"124":{"brief":"SVD 条件打包","detail":"img2vid 条件设 1024×576、32 帧、motion_bucket_id 127、fps 10、增强 0，三路输出直进采样器。"},"125":{"brief":"SVD 一体加载","detail":"ImageOnlyCheckpointLoader 读 AnimateLCM-SVD fp16 合并权重，同出模型、CLIP Vision 与 VAE。"},"129":{"brief":"Cascade C 段","detail":"stage_c UNET 以 22 步 cfg 4 采样粗潜码，euler_ancestral karras，denoise 1 全量生成。"},"130":{"brief":"Cascade B 段","detail":"stage_b 接 stageB 条件与 C 段潜码，10 步 cfg 1.1 精修后交 VAEDecode 出图。"},"134":{"brief":"Wav2Lip 口型重绘","detail":"Wav2Lip sequential 模式吃 VHS 拆的帧与上传音频，8 批 30 上下文半强度改嘴。"},"137":{"brief":"ReActor 换脸执行","detail":"ReActorFaceSwapOpt 用 inswapper_128.onnx 加 retinaface 检测与 codeformer 修复，保真 0.5。"},"150":{"brief":"分组旁路开关","detail":"Fast Groups Bypasser 孤立未接任何数据口，但它按组名控制全图 ⏸ 支路的启停，是这本工具箱的主开关。"},"152":{"brief":"全图提示词中枢","detail":"workflow/Control Center 输出正负词与统一种子，STRING 与 INT 三路共十余条连线广播给全图采样器与加载器。"},"187":{"brief":"轻量 IPAdapter","detail":"统一加载器选 LIGHT - SD1.5 only 低强度档，与活链的 RPG 底模配套最稳。"},"189":{"brief":"分块风格参考","detail":"IPAdapterTiled 强度 1、ease in-out、V only，以 218 的图做风格参考，权重随注意力分层。"},"204":{"brief":"活链主采样器","detail":"KSampler (Efficient) 22 步 cfg 6.5 euler_ancestral karras、denoise 0.2，种子也被 152 覆写。"},"206":{"brief":"活链底模加载","detail":"Efficient Loader 载 aZovyaRPGArtistTools v4 检查点，Baked VAE，一站给齐模型条件与潜空间。"},"216":{"brief":"抠图遮罩回显","detail":"MaskToImage 把抠图遮罩转成灰度图供预览，便于核对 u2netp 抠出的边界质量。"},"231":{"brief":"改绘潜空间入口","detail":"VAEEncode 把抠完的主体编进潜空间，denoise 0.2 决定了这是轻改绘而非重画。"},"235":{"brief":"分块高清放大","detail":"UltimateSDUpscale 以 8x_NMKD-Superscale 模型、512 分块、0.1 denoise 收尾输出成品。"},"249":{"brief":"CAIN 补帧","detail":"与 RIFE 并存的第二种插帧选择，pretrained_cain.pth，挂在 SVD 采样之后。"},"250":{"brief":"视频帧数探针","detail":"BatchCount+ 数 VHS 载入视频批量的帧数，经 Show any 回显，供手算时长用。"},"253":{"brief":"抠图与反遮罩","detail":"GeekyRemB 用 u2netp 把同一张输入图同时作前景与背景参照，reverse 输出透明图与 MASK 两路。"}}}}