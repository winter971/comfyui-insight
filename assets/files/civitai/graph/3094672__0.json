,"fromOut":0,"to":"1166","toIn":1},{"from":"1169","fromOut":0,"to":"1166","toIn":0},{"from":"1038","fromOut":1,"to":"1171","toIn":0},{"from":"1038","fromOut":2,"to":"1171","toIn":1},{"from":"1038","fromOut":3,"to":"1171","toIn":2},{"from":"1038","fromOut":4,"to":"1171","toIn":3},{"from":"1038","fromOut":5,"to":"1171","toIn":4},{"from":"1143","fromOut":0,"to":"1171","toIn":5},{"from":"1038","fromOut":15,"to":"1171","toIn":7},{"from":"1038","fromOut":16,"to":"1171","toIn":8},{"from":"1171","fromOut":7,"to":"1169","toIn":0},{"from":"1171","fromOut":1,"to":"1169","toIn":1},{"from":"1171","fromOut":4,"to":"1169","toIn":2},{"from":"1171","fromOut":5,"to":"1169","toIn":3},{"from":"1171","fromOut":3,"to":"1169","toIn":4},{"from":"1171","fromOut":8,"to":"1169","toIn":5},{"from":"1038","fromOut":8,"to":"1171","toIn":6},{"from":"1163","fromOut":0,"to":"284","toIn":1},{"from":"1163","fromOut":0,"to":"1062","toIn":5},{"from":"1038","fromOut":8,"to":"1143","toIn":7},{"from":"1168","fromOut":2,"to":"1002","toIn":2},{"from":"1168","fromOut":2,"to":"223","toIn":4}],"ai":{"s":"Cyberdelia 出品的 CyberIllustrious 四阶段精修工作流：一图生成→放大→修脸→分块细化，每一阶段之间都有并排对比器。主线是 CyberIllustrious_Anime_V6 底模（CLIP skip -2）在 832x1216 竖版潜空间上用 dpmpp_2m_sde_heun_gpu/sgm_uniform 40 步、CFG 6 采样；放大走 Ultimate SD Upscale（RealESRGAN_x4plus_anime_6B 预放大、2 倍系数、denoise 0.23）；修脸用 BboxDetectorSEGS 找脸后 DetailerForEach 以 0.3 去噪逐脸精修，且正负提示词可用 ComfySwitchNode 切换'继承主提示词'或'脸部专用提示词'；最后一步很有特色——UltimateSDUpscaleNoUpscale 在不放大尺寸的前提下做 12 步、denoise 0.2 的全图分块细化，专门抹掉放大带来的块间接缝。全图用 Context Big 链逐级传递模型与条件，种子由 Global Seed 统一供给；ControlNet(Union-Pro depth 模式) 支线预制旁路。工程结构清晰，是 Illustrious 写实/动漫通用的成品级模板。","u":["Illustrious 系底模出竖版角色图并一步到位放大到可用分辨率，无需外接其它工具","多人构图的成图修脸：SEGS 检测逐脸处理，每张脸独立重绘不互相影响","脸部想用与主图不同的提示词精修：切换 Use Custom Face Prompt 开关填专用正负词","放大后出现分块接缝或细节发糊：最后的 No-Upscale 细化阶段专门修这个","按参考图构图出图：启用旁路的 ControlNet depth 支线"],"d":2,"st":[{"name":"模型与上下文组装","desc":"底模、CLIP 截层、可选 LoRA、提示词与全局种子经四级 Context Big 链逐级打包传递——每一阶段只从上游 Context 拉一根线，四阶段共享同一套模型与条件。","nodes":["1168","1149","1047","218","219","8","250","1002","1061","1003","1158","1004"]},{"name":"一图生成","desc":"832x1216 竖版潜空间 40 步全去噪采样，dpmpp_2m_sde_heun_gpu 在 Illustrious 系上细节扎实；解码预览后进入放大。","nodes":["224","220","12"]},{"name":"放大","desc":"RealESRGAN 先 4x 预放大，UltimateSDUpscale 以 2 倍系数、0.23 低去噪分块重绘——放大补细节的同时几乎不改变内容。","nodes":["1154","1165","1163","1150"]},{"name":"修脸","desc":"检测器框出每张脸，DetailerForEach 独立重绘；两路 ComfySwitch 让脸部条件可以继承主提示词或切换专用词——这是多人图脸部质量的专门处理。","nodes":["1145","1144","1143","1146","1147","1148","262","263","284"]},{"name":"分块细化与输出","desc":"No-Upscale 版 UltimateSDUpscale 在原尺寸上做低去噪分块细化，抹平放大接缝并统一质感，最后带元数据落盘。","nodes":["1171","1169","1166","1048"]},{"name":"旁路 ControlNet 支线","desc":"参考图经 DepthAnything 抽深度，Union-Pro 控制网以 depth 模式、0.3 强度、0→0.4 前段写入条件——构图锁定用，默认关闭。","nodes":["1043","221","225","222","223"]}],"p":"一图 40 步/CFG 6/dpmpp_2m_sde_heun_gpu 保持默认；放大 denoise 0.23 与倍率 2 是质量平衡点；修脸 denoise 0.3；细化 denoise 0.2、padding 192——四个 denoise 各管一个阶段，逐级递减是这条链的设计逻辑。","n":"需要 CyberIllustrious_Anime_V6 主模、RealESRGAN_x4plus_anime_6B、face_yolov8m 检测器；ControlNet 支线默认旁路，启用需 Union-Pro promax 控制网与 DepthAnything 预处理器；832x1216 起步 + 2 倍放大约产出 1664x2432，显存 8GB 起步。","f":["① 模型装载：CheckpointLoader(1168) 加载 CyberIllustrious_Anime_V6，MODEL 进可选 LoRA 面板(1047)，CLIP 经 CLIPSetLastLayer(1149) 截 -2 层后进 1047","② 提示词：Positive(218) 与 Negative(219) 经 1047 的 CLIP 编码；Global Seed(8) 统一出种子","③ 上下文组装：Context Big(1002) 收模型/CLIP/VAE/基础潜空间(250, 832x1216 竖版)与种子，逐级传给 1061（叠入 ControlNet 或主提示词条件）再传 1003（条件定型）","④ 一图采样：KSampler(224) 40 步、CFG 6、dpmpp_2m_sde_heun_gpu/sgm_uniform 全去噪，LATENT 经 VAEDecode(220) 解码，PreviewImage(12) 预览","⑤ 放大：Ultimate SD Upscale(1163) 接 Context(1004) 的模型条件、RealESRGAN_x4plus_anime_6B(1154) 预放大、upscale_by 2、denoise 0.23、tile 1024，输出经对比器(1150) 与一图并排","⑥ 修脸：BboxDetectorSEGS(1144, 阈值 0.7) 在放大图上找脸产 SEGS，DetailerForEach(1143) 以 512 引导尺寸、24 步、CFG 4.5、denoise 0.3 逐脸精修；正负条件分别经 ComfySwitchNode(1147/1148) 按 Use Custom Face Prompt(1146) 决定继承主提示词还是用脸部专用词(262/263)；结果进对比器(284)","⑦ 分块细化：UltimateSDUpscaleNoUpscale(1169) 接修脸后的图（经 Context 1171），12 步、CFG 4、dpmpp_2m/karras、denoise 0.2、tile 1024、padding 192——尺寸不变只细化质感，产物进对比器(1166)","⑧ 保存：SaveImageWithMetaData(1048) 按日期目录与时间戳文件名落盘，参数-only 元数据写入 PNG"],"t":[" Illustrious 系务必保留 CLIP skip -2(1149)，漏掉会出脏色；这是作者预设好的，别动","1163 的 denoise 0.23 决定放大是'加细节'还是'改内容'：只想要清晰度保持 0.2-0.25，想借放大改细节最多 0.35","1169 的 No-Upscale 细化是可选收尾：denoise 0.2 以下几乎纯提质，发现整体风格被稀释就把它旁路","多人图脸部崩坏集中在某几张时，把 1144 的阈值从 0.7 提到 0.8 减少误检，或用 SEGS 预览确认框对了脸","脸部专用提示词(262)只描述'一张完美的脸'级别的通用词即可，别重复主图场景描述——1146 开关切换后 1143 只看得到这一路条件"],"na":{"8":{"brief":"全局种子。","desc":"rgthree Seed 设 -1 随机，INT 进 Context(1002) 后全链共享：一图、放大、细化各阶段用同一颗种子，保证阶段间内容连续。修脸的 DetailerForEach 有独立种子。","params":[{"name":"seed","kind":"整数","default":"-1","desc":"复现改 fixed 具体值"}]},"218":{"brief":"主正向提示词编码。","desc":"CLIPTextEncode 接 1047 的 CLIP（已截层），CONDITIONING 进 Context(1061)，可选择经 ControlNet 改写。作为全链正向条件的源头。","params":[{"name":"text","kind":"字符串","default":"Illustrious 系质量词+场景描述","desc":"按底模口味堆质量词"}]},"219":{"brief":"主负向提示词编码。","desc":"固定 'lowres, worst_quality, bad_quality' 三件套——Illustrious 系负向不用堆长串，这三个最关键。经 Context 传向一图采样、放大与细化。"},"220":{"brief":"解码一图结果。","desc":"VAEDecode 输出三路：预览(12)、放大级 Context(1158) 的 images 槽、对比器(1150) 的 image_b——它是后续所有阶段的基准图。"},"221":{"brief":"旁路的深度预处理器。","desc":"AIO_Preprocessor 用 DepthAnything(1024) 把参考图转深度图，送 223 作控制图像。深度约束构图比骨架宽容。"},"223":{"brief":"旁路的 ControlNet 条件写入。","desc":"ControlNetApplyAdvanced 接主正负提示词、控制网、深度图与 VAE，strength 0.3、0→0.4 前段生效，输出替换 1061 的条件槽。轻强度+短程生效是'借构图不改风格'的配置。","params":[{"name":"strength","kind":"浮点","default":"0.3","desc":"构图偏离大升 0.5"},{"name":"end_percent","kind":"浮点","default":"0.4","desc":"前 40% 锁构图后段放开"}]},"224":{"brief":"一图采样器，40 步 CFG 6。","desc":"KSampler 接 1003 的模型/条件/潜空间/种子，dpmpp_2m_sde_heun_gpu 配 sgm_uniform、denoise 1。heun 系采样器在 Illustrious 上细节密度高，40 步对它合适。","params":[{"name":"steps","kind":"整数","default":"40","desc":"赶时间 28，质量优先保持 40"},{"name":"cfg","kind":"浮点","default":"6","desc":"Illustrious 5-7 区间"}]},"225":{"brief":"旁路的 Union-Pro 控制网加载。","desc":"加载 promax 版 Union 控制网，经 222 切 depth 模式。一份权重覆盖多种控制类型，扩展性好。"},"250":{"brief":"基础分辨率选择 832x1216。","desc":"SDXL Empty Latent Image (rgthree) 出竖版潜空间与宽高 INT，一起进 Context。832x1216 是 SDXL 竖版标准档，Illustrious 在这档最稳。","params":[{"name":"resolution","kind":"下拉选择","default":"832 x 1216 (portrait)","desc":"横图换 1216x832"}]},"262":{"brief":"脸部专用正向词。","desc":"CLIPTextEncode 编码脸部描述（如完美的眼睛与皮肤），经 1147 进修脸采样。写通用脸部质量词即可，不需要场景信息。"},"263":{"brief":"脸部专用负向词。","desc":"比主负向更长的低质描述，经 1148 进修脸采样。与 262 成对使用，开关 1146 关闭时不生效。"},"284":{"brief":"放大图与修脸后对比。","desc":"并排查看每张脸的修复效果，确认 denoise 0.3 没有改变脸型只清理了崩坏。"},"1002":{"brief":"第一级 Context Big，基础上下文。","desc":"收模型/CLIP/VAE/潜空间/种子/宽高，把全部采样要素打包成一根线传给 1061。Context 链的第一环，后续阶段都从这里继承。"},"1003":{"brief":"第三级 Context Big，一图采样条件定型。","desc":"收 1061 的模型与条件，输出直接供 KSampler(224) 与放大级 Context(1158)。一图阶段的全部参数在这里就位。"},"1043":{"brief":"旁路的 ControlNet 参考图输入。","desc":"LoadImage 读入构图参考，送 221 抽深度。旁路状态；启用组后作为构图锁定的源头。"},"1047":{"brief":"可选 LoRA 面板，当前空载。","desc":"Power Lora Loader 接底模 MODEL 与截层后的 CLIP，预设行（Natsuki）默认 off。MODEL/CLIP 双输出进 Context(1002)，加 LoRA 时全链自动生效。","params":[{"name":"on/off","kind":"开关","default":"off","desc":"用时拨 on，strength 从 0.8 起调"}]},"1048":{"brief":"带元数据保存最终图。","desc":"SaveImageWithMetaData 写 parameters_only 元数据，文件名用时间戳、目录按日期组织，成图批量管理友好。","params":[{"name":"filename_prefix","kind":"字符串","default":"%date:hhmmss%","desc":"时间戳命名天然去重"}]},"1061":{"brief":"第二级 Context Big，条件写入点。","desc":"收 1002 的全套，正向/负向两个 CONDITIONING 槽分别接 ControlNet 改写输出(223)或主提示词直连——ControlNet 启用时条件在这里被替换。产物传给 1003。","params":[]},"1143":{"brief":"DetailerForEach 逐脸精修。","desc":"接 Context(1038) 的模型与放大图、1144 的 SEGS、种子与经开关路由的正负条件，guide_size 512、24 步、CFG 4.5、denoise 0.3。每张脸独立重采样，互不干扰。","params":[{"name":"denoise","kind":"浮点","default":"0.3","desc":"崩脸明显升 0.45"},{"name":"guide_size","kind":"浮点","default":"512","desc":"小脸细节不足时提到 768"}]},"1144":{"brief":"框出人脸 SEGS。","desc":"BboxDetectorSEGS 阈值 0.7、crop 28 像素边距，在放大图上产出每张脸的区域组。0.7 偏保守，宁可少修不误检。","params":[{"name":"threshold","kind":"浮点","default":"0.7","desc":"漏检降到 0.5，误检升到 0.8"}]},"1145":{"brief":"加载 face_yolov8m 检测器。","desc":"UltralyticsDetectorProvider 提供 BBOX/SEGM 检测能力给 1144。yolov8m 比 n 版准，多人图漏检少。"},"1146":{"brief":"脸部专用提示词开关。","desc":"PrimitiveBoolean 同时控制 1147 与 1148 两个条件开关。false 时修脸继承主图正负提示词，true 时切换到 262/263 的脸部专用词——多人图只想修脸不改场景时的正确做法。","params":[{"name":"value","kind":"布尔","default":"false","desc":"脸部有特殊需求才开 true"}]},"1149":{"brief":"CLIP 末层截断 -2。","desc":"标题带剪刀 emoji 提醒这是必需项。Illustrious 系训练特性决定了不截层会出灰脏色与构图劣化，输出供 LoRA 面板与两个主提示词编码。","params":[{"name":"stop_at_clip_layer","kind":"整数","default":"-2","desc":"Illustrious 固定 -2"}]},"1150":{"brief":"一图与放大图对比。","desc":"rgthree Image Comparer 左右并排，验收放大阶段是否只加细节不改内容；发现内容漂移就调低 1163 的 denoise。"},"1154":{"brief":"加载 RealESRGAN_x4plus_anime_6B。","desc":"anime 6B 版对二次元线条友好，4x 预放大给 UltimateSDUpscale 提供高分辨率底版。写实图可换普通 x4plus。","params":[{"name":"model_name","kind":"下拉选择","default":"RealESRGAN_x4plus_anime_6B.pth","desc":"按画风选择 anime 或通用版"}]},"1163":{"brief":"Ultimate SD Upscale 分块放大。","desc":"接 Context(1004) 的模型条件、放大模型与倍率，denoise 0.23、tile 1024、Linear 排布、20 步 CFG 5.5。低去噪保证构图不变，分块重绘补出真实纹理。","params":[{"name":"denoise","kind":"浮点","default":"0.23","desc":"0.2-0.25 只提质不改内容"},{"name":"tile_width","kind":"整数","default":"1024","desc":"接缝明显可加大 tile"}]},"1165":{"brief":"放大倍率滑杆 2 倍。","desc":"easy float 输出接 1163 的 upscale_by。832x1216 放大 2 倍后约 1664x2432，再大建议分两次。","params":[{"name":"value","kind":"浮点","default":"2","desc":"1.5 更稳，2 是常用上限"}]},"1166":{"brief":"修脸图与最终细化图对比。","desc":"最后一级验收：No-Upscale 细化应当只提升质感。两张图几乎一样才对，差异明显说明 1169 的 denoise 偏高。"},"1168":{"brief":"加载 CyberIllustrious_Anime_V6 底模。","desc":"CheckpointLoaderSimple 输出三路：MODEL 给 LoRA 面板，CLIP 给 1149 截层，VAE 给解码与 ControlNet。作者自家的 Illustrious 融合模，工作流参数全部按它调校。","params":[{"name":"ckpt_name","kind":"下拉选择","default":"CyberIllustrious_Anime_V6.safetensors","desc":"换底模时采样器/CFG 需要重新适配"}]},"1169":{"brief":"No-Upscale 分块细化，本工作流的特色收尾。","desc":"UltimateSDUpscaleNoUpscale 接修脸后的图，upscale 因子 1（尺寸不变）但保留分块重绘：12 步、CFG 4、dpmpp_2m/karras、denoise 0.2、tile 1024、padding 192。专门抹平 USU 放大的块间接缝与塑料感，产物即最终成图。","params":[{"name":"denoise","kind":"浮点","default":"0.2","desc":"纯提质档；想加细节 0.25"},{"name":"padding","kind":"整数","default":"192","desc":"大 padding 接缝更隐形，代价是变慢"}]},"1179":{"brief":"组开关总面板。","desc":"Fast Groups Bypasser 按阶段名批量启停：ControlNet 支线、修脸、细化等组的开关集中于此，工作流的日常操作入口。"}}}}