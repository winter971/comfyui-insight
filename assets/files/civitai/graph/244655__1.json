5","fromOut":0,"to":"83","toIn":0},{"from":"81","fromOut":0,"to":"88","toIn":1},{"from":"92","fromOut":0,"to":"88","toIn":3},{"from":"92","fromOut":0,"to":"89","toIn":3},{"from":"17","fromOut":0,"to":"93","toIn":0},{"from":"53","fromOut":0,"to":"94","toIn":0},{"from":"94","fromOut":0,"to":"88","toIn":2},{"from":"93","fromOut":0,"to":"89","toIn":2},{"from":"83","fromOut":0,"to":"89","toIn":1},{"from":"88","fromOut":0,"to":"101","toIn":0},{"from":"101","fromOut":0,"to":"102","toIn":0},{"from":"89","fromOut":0,"to":"104","toIn":0},{"from":"104","fromOut":0,"to":"105","toIn":0},{"from":"5","fromOut":0,"to":"78","toIn":0},{"from":"102","fromOut":0,"to":"134","toIn":0},{"from":"105","fromOut":0,"to":"134","toIn":1},{"from":"134","fromOut":1,"to":"136","toIn":3},{"from":"136","fromOut":0,"to":"137","toIn":0},{"from":"134","fromOut":0,"to":"136","toIn":0},{"from":"102","fromOut":0,"to":"142","toIn":0},{"from":"105","fromOut":0,"to":"143","toIn":0},{"from":"73","fromOut":0,"to":"145","toIn":0},{"from":"146","fromOut":0,"to":"88","toIn":0},{"from":"146","fromOut":2,"to":"102","toIn":1},{"from":"146","fromOut":1,"to":"84","toIn":0},{"from":"147","fromOut":0,"to":"89","toIn":0},{"from":"147","fromOut":1,"to":"85","toIn":0},{"from":"147","fromOut":2,"to":"105","toIn":1}],"ai":{"s":"SD1.5 分屏合成工作流（包内附加图）。先用主提示词在 768x512 空白潜空间正常出一张底图，解码后对底图提取 Canny 边缘作为整张图的构图骨架。左右两条支线各自带独立 Checkpoint 与'左半/右半'提示词，经 ControlNetApply 把同一份 canny 边缘以强度 1 写进条件，在各自的 768x512 潜空间上各生成一张完整图，再用 LatentCrop 分别裁出 x=0 与 x=384 的左右半幅潜空间，解码后 Join Image Lists 拼列表、Stack Images 水平堆叠，得到一张左半与右半内容不同的合成图。先采全图再裁是关键：每个分支都在完整构图约束下采样，接缝两侧内容才呼应。三个 CheckpointLoader 是旧式写法，各自给一条支线供模，实际加载的是同一个模型。整体是 ControlNet 教程级结构，逻辑清晰但无遮罩、无细化步骤。","u":["一张图左右两种设定：如左半白人黑发、右半黑人白发，用两段提示词控制各半","以一张草稿图的构图为骨架，分别重铸左右两半的内容","学习 ControlNet 边缘约束与 LatentCrop 裁剪拼接的入门案例","对比测试不同提示词在同一构图下的表现"],"d":3,"st":[{"name":"底图生成","desc":"主提示词 + 空白潜空间先产出一张完整底图，它不进最终输出，唯一作用是提供构图。","nodes":["6","9","7","8","4","5"]},{"name":"边缘提取与条件注入","desc":"对底图提 Canny 轮廓，左右两段提示词各自与这份边缘绑定成条件，把'构图不变'写进采样。","nodes":["73","82","81","83","84","85"]},{"name":"双支线采样","desc":"左右各一个 KSampler，共用同一尺寸空白潜空间与主负向词，各按自己的提示词生成整幅图，为后续裁半做准备。","nodes":["146","147","92","88","89"]},{"name":"裁半与拼合","desc":"LatentCrop 从左右结果中各裁出 384x512 半幅，解码后合并列表并水平堆叠，拼成最终合成图。","nodes":["101","104","102","105","134","136"]},{"name":"预览","desc":"底图、左右半幅、canny 边缘与最终拼图各有预览，方便逐环节核对。","nodes":["78","142","143","145","137"]}],"p":"SD1.5 老配方：CFG 8 + euler/normal + 20 步，觉得过饱和可降到 5-7；两个 ControlNetApply 的 strength 都是 1，接缝生硬时降到 0.8 左右；左右内容完全由 Left/Right Half Prompt 决定，底图主提示词决定构图走向。","n":"需在 checkpoints 目录备有 epicphotogasm_z 模型（被重复加载了三次）与 control_v11p_sd15_canny；负向词含 naked/nsfw 过滤；左右两半独立采样，中间接缝可能有色差，属此结构固有现象。"}}