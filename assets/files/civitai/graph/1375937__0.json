sc":""},{"id":"31","title":"SaveImage","type":"SaveImage","cat":"image","x":3154,"y":227,"inputs":[{"name":"images","type":"IMAGE"}],"outputs":[],"widgets":["ComfyUI"],"brief":"按 cn-masks/pose-算法名 归档，18 路结果互不覆盖","desc":""},{"id":"30","title":"SaveImage","type":"SaveImage","cat":"image","x":3110,"y":-91,"inputs":[{"name":"images","type":"IMAGE"}],"outputs":[],"widgets":["ComfyUI"],"brief":"按 cn-masks/pose-算法名 归档，18 路结果互不覆盖","desc":""},{"id":"9","title":"LoadImage","type":"LoadImage","cat":"load","x":3471,"y":-56,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE"},{"name":"MASK","type":"MASK"}],"widgets":["IPAdapter_00008_.png","image"],"brief":"节点 45/46 是旁路的额外参考图，启用后进入多参考编辑","desc":""}],"links":[{"from":"1","fromOut":0,"to":"2","toIn":0},{"from":"4","fromOut":0,"to":"8","toIn":0},{"from":"5","fromOut":0,"to":"8","toIn":1},{"from":"6","fromOut":0,"to":"8","toIn":2},{"from":"7","fromOut":0,"to":"8","toIn":3},{"from":"9","fromOut":0,"to":"8","toIn":4},{"from":"8","fromOut":0,"to":"10","toIn":0},{"from":"10","fromOut":0,"to":"11","toIn":0},{"from":"8","fromOut":0,"to":"13","toIn":0},{"from":"8","fromOut":0,"to":"14","toIn":0},{"from":"2","fromOut":0,"to":"15","toIn":0},{"from":"15","fromOut":0,"to":"13","toIn":1},{"from":"15","fromOut":0,"to":"16","toIn":1},{"from":"15","fromOut":0,"to":"17","toIn":1},{"from":"22","fromOut":0,"to":"23","toIn":0},{"from":"22","fromOut":0,"to":"24","toIn":0},{"from":"22","fromOut":0,"to":"25","toIn":0},{"from":"8","fromOut":0,"to":"26","toIn":0},{"from":"26","fromOut":0,"to":"16","toIn":0},{"from":"26","fromOut":0,"to":"19","toIn":0},{"from":"11","fromOut":0,"to":"17","toIn":0},{"from":"11","fromOut":0,"to":"18","toIn":0},{"from":"23","fromOut":0,"to":"27","toIn":0},{"from":"24","fromOut":0,"to":"28","toIn":0},{"from":"25","fromOut":0,"to":"29","toIn":0},{"from":"27","fromOut":0,"to":"30","toIn":0},{"from":"28","fromOut":0,"to":"31","toIn":0},{"from":"29","fromOut":0,"to":"32","toIn":0},{"from":"20","fromOut":0,"to":"23","toIn":2},{"from":"20","fromOut":0,"to":"24","toIn":2},{"from":"20","fromOut":0,"to":"25","toIn":2},{"from":"19","fromOut":0,"to":"25","toIn":3},{"from":"18","fromOut":0,"to":"24","toIn":3},{"from":"14","fromOut":0,"to":"23","toIn":3},{"from":"21","fromOut":0,"to":"23","toIn":4},{"from":"21","fromOut":0,"to":"24","toIn":4},{"from":"21","fromOut":0,"to":"25","toIn":4},{"from":"33","fromOut":0,"to":"27","toIn":1},{"from":"33","fromOut":0,"to":"28","toIn":1},{"from":"33","fromOut":0,"to":"29","toIn":1},{"from":"13","fromOut":0,"to":"23","toIn":1},{"from":"17","fromOut":0,"to":"24","toIn":1},{"from":"16","fromOut":0,"to":"25","toIn":1}],"ai":{"s":"PuLID-Flux 人脸一致性工作流，核心是一组缓存加速对照实验。参考照片经 InsightFace 与 EVA CLIP 双路分析，PuLID 模型把脸部特征写进 Flux dev fp8 主干，正向提示词经 FluxGuidance 2.5 编码（无负向，Flux 常规接法）。之后模型分出三条完全平行的采样支线：种子、768x1024 潜空间、28 步 euler 调度全部共享，唯一变量是缓存补丁——原版全量计算、TeaCache 0.4、FBCache 0.12。这类缓存靠跳过部分 DiT 块的前向计算换速度，代价是细节损失，损失多少必须同种子横向对比才有意义，所以作者让三条线并排跑、分别解码落盘。跑完把三张图摆在一起，就能判断该选哪档加速。日常出图时旁路掉两条支线只留一档，就是普通 PuLID 工作流。","u":["上传一张人脸照生成同一人物的全新场景图，角色一致性靠 PuLID 锁定","同种子对比 TeaCache 与 FBCache 两种加速方案的画质差异，再决定用哪档","跑不动全量 Flux 时挑一档缓存补丁提速，省下的时间肉眼可见","固定人物换姿势换服装批量出图，换参考图即换人"],"d":2,"st":[{"name":"人脸参考与模型注入","desc":"参考照由 InsightFace 与 EVA CLIP 双路提取特征，PuLID 模型经前向补丁合并进 Flux 主干，产出的人像身份与参考照一致。","nodes":["9","5","6","7","4","8","10"]},{"name":"共享编码与采样设定","desc":"T5+clip_l 双编码器编码提示词并设引导 2.5，种子、空白潜空间、采样器三条支线共用，确保对照实验只有一个变量。","nodes":["1","2","15","22","20","21"]},{"name":"三条对照采样支线","desc":"原版全量、TeaCache 0.4、FBCache 0.12 三档各配自己的 Guider 与调度器并行采样，其余参数完全一致，速度与画质差异一目了然。","nodes":["13","14","23","11","17","18","24","26","16","19","25"]},{"name":"解码与分别保存","desc":"三个潜空间各自解码并落盘，方便把三张图并排比较缓存带来的细节损失。","nodes":["27","28","29","30","31","32"]}],"p":"FluxGuidance 2.5 是人像写实的稳妥值；TeaCache 阈值 0.4 越高越快但越糊，FBCache 0.12 起步温和，两者都建议从对照结果里选；28 步 euler/simple 是 Flux dev 常规配置，改步数三档要同步改，否则对比失效。","n":"一次运行会跑三遍采样，显存与时间开销约三倍，日常用建议旁路两条支线；参考照选正面、五官清晰的照片效果最好；需装 ComfyUI-PuLID-Flux（InstantID 依赖）并自备 flux1-dev-fp8、fp8 T5、PuLID 模型。"}}