m":"189","fromOut":0,"to":"160","toIn":0},{"from":"165","fromOut":1,"to":"39","toIn":0},{"from":"165","fromOut":1,"to":"45","toIn":0},{"from":"165","fromOut":1,"to":"37","toIn":0},{"from":"171","fromOut":0,"to":"192","toIn":1},{"from":"174","fromOut":0,"to":"193","toIn":1},{"from":"6","fromOut":0,"to":"193","toIn":2},{"from":"18","fromOut":0,"to":"193","toIn":3},{"from":"162","fromOut":0,"to":"193","toIn":0},{"from":"162","fromOut":0,"to":"195","toIn":0},{"from":"174","fromOut":0,"to":"195","toIn":1},{"from":"6","fromOut":0,"to":"195","toIn":2},{"from":"195","fromOut":0,"to":"192","toIn":0},{"from":"192","fromOut":0,"to":"179","toIn":0},{"from":"192","fromOut":0,"to":"196","toIn":0},{"from":"193","fromOut":0,"to":"13","toIn":0},{"from":"193","fromOut":0,"to":"195","toIn":3}],"ai":{"s":"本工作流构建了一套创新的跨架构级联写实人像渲染管线。首阶段基于阿里 Z-Image Turbo 极速骨干网络搭配 Qwen 文本编码器与专用 VAE，利用 SDXLEmptyLatentSizePicker+ 智能画布尺寸规划，以极少步数在潜空间（Latent）快速锁定画面的大结构构图与肢体动态；中段通过 KSamplerAdvanced 将潜空间无缝转交至专精写实摄影质感的 GonzaLomo SDXL Photo 专家模型，结合 ConditioningConcat 多重条件级联与 SDXL 精修 LoRA 栈执行二次微距重绘；尾端部署双级 YOLO+SAM 级联 FaceDetailer 针对五官微表情与表皮毛孔进行毫米级增强，配合 rgthree 旁路开关，实现了极速出图效率与顶级光学写实质感的完美平衡。","u":["电影感、胶片质感及商业时尚级超写实人像摄影大片创作","复杂构图、特定姿态的大幅面人像概念草图极速生成与定稿验证","对人物眼部神态、唇纹细节及微观皮肤毛孔质感有严苛挑剔要求的特写精修"],"d":2,"st":[{"name":"一阶段 Z-Image Turbo 极速骨架生成与草图验证","desc":"由 UNETLoader 加载阿里 Z-Image Turbo 主干模型，配合 Qwen 文本编码器与专用 VAE，挂载 Power LoRA 增强模块；利用 SDXLEmptyLatentSizePicker+ 智能规划标准化宽高潜空间，经由 KSamplerAdvanced 快速完成 6-8 步潜空间粗去噪，输出第一阶段草图并经由 Flux Preview Image 进行构图即时验证。","nodes":["169","170","171","165","18","6","174","193","192","14"]},{"name":"二阶段 SDXL 专家精修模型与条件级联注入","desc":"加载专精写实摄影质感的 GonzaLomo SDXL Photo 权重与精修 LoRA 栈；正向提示词采用分层结构，将 Base Prompt（基础人物/构图）与 Refining Prompt（微观光影/皮肤材质）通过 ConditioningConcat 进行张量级联融合，结合专用负向提示词构建高表现力条件引导。","nodes":["36","162","37","45","43","39"]},{"name":"潜空间跨模态重绘采样与高清解码","desc":"采用第二阶段 KSamplerAdvanced 接收一阶段生成的潜空间张量，以设定的中低去噪幅度（Denoise 约 0.30-0.42）进行二次精细化采样重绘，消除 Turbo 架构的平滑塑料感；随后通过 SDXL 专用 VAEDecode 将潜空间还原为全分辨率 RGB 图像。","nodes":["195","13"]},{"name":"双级 YOLO+SAM 级联面部细化增强","desc":"部署两级级联 FaceDetailer 局部精修管线：一级采用 Ultralytics YOLO 检测人脸并结合 SAM 进行精确面部掩码裁剪与轮廓重绘；二级采用更高检测精度的检测器与分割模型，对眼睛、牙齿、唇纹及皮肤毛孔进行毫米级细节增强。","nodes":["139","140","137","187","188","189"]},{"name":"管线旁路集控与最终高精成片输出","desc":"通过 rgthree 的 Fast Groups Bypasser 实现二阶段精修与两级 FaceDetailer 模块的一键静音旁路控制，允许创作者在极速草稿模式与满血摄影级渲染模式间无缝切换，最终由 SaveImage 节点保存高动态范围与微观皮肤质感的成片。","nodes":["180","128"]}],"p":"一阶段 Z-Image Turbo 推荐采用 Euler / SGM Uniform 调度，步数压缩至 6-8 步，CFG 保持在 1.5-2.0，画布尺寸通过节点 18 锁定在标准 SDXL 比例（如 896×1152 或 1024×1024）；二阶段 SDXL 精修采样器（节点 195）推荐步数 25 步，去噪幅度（Denoise）严格控制在 0.30-0.42 之间，过低无法消除 Turbo 涂抹感，过高会导致人物面容与原构图脱节；一级 FaceDetailer 去噪幅度建议设为 0.35 修正五官对称与眼眸神态，二级 FaceDetailer 去噪幅度下调至 0.20-0.25 专攻毛孔微距增强。","t":["【跨架构潜空间过渡与尺寸陷阱】：虽然 Z-Image Turbo 具有独立 VAE，但由于二阶段直接衔接 SDXL 生态，首阶段潜空间尺寸必须严格使用 SDXLEmptyLatentSizePicker+ 规范的 1024 级标准分辨率；若自定义任意非标尺寸，会导致二阶段 SDXL 采样时出现肢体畸变或多头异化。","【ConditioningConcat 权重失衡】：节点 43 将 Base Prompt 与 Refining Prompt 进行级联，请确保 Refining Prompt 专注于光学镜头、胶片颗粒及皮质纹理等修饰词，切勿在二阶段重复书写与一阶段冲突的主体特征或背景描述，避免条件张量干涉造成画面过锐发焦。"],"n":"【显存与模型依赖说明】：本工作流跨越两个大模型生态，显存占用峰值较高，建议至少具备 16GB（推荐 24GB）显存。运行前必须确保本地已下载：① Z-Image Turbo UNET 权重、Qwen 文本编码器与专用 VAE；② GonzaLomo SDXL Photo 检查点；③ Ultralytics YOLO 人脸检测模型（face_yolov8n.pt 等）及 Segment Anything（SAM）模型。若缺少 Impact Pack 或 rgthree 节点插件，画布将报红无法启动。","na":{"43":{"brief":"多重文本条件级联融合器","detail":"将一阶段宏观构图的 Base Prompt 条件与二阶段特异化的微观摄影质感 Refining Prompt 条件在张量维度进行无缝串联拼接，赋予 SDXL 模型丰富而有层次的语义引导。"},"137":{"brief":"YOLO+SAM 一级面部精修核心","detail":"自动通过 YOLO 识别画面中面部边界框，驱动 SAM 提取高精度像素掩码，并在独立裁剪空间以特定分辨率进行眼球、虹膜高光及面部结构对称性的第一轮定向重绘。"},"180":{"brief":"全管线模块化快速旁路开关","detail":"rgthree 提供的组级快速旁路控制器，创作者可通过单击单选框瞬时切断或激活二阶段精修组与双 FaceDetailer 组，极大提升构图打样与最终批量渲染之间的切换效率。"},"193":{"brief":"Z-Image Turbo 极速骨架去噪器","detail":"负责执行首阶段极低步数（通常 6-8 步）的流匹配/扩散采样，在潜空间中快速固化画面的透视、人物比例、动态姿势与大范围明暗关系，为二阶段重绘建立稳固底模。"},"195":{"brief":"SDXL 高级精修重绘采样器","detail":"承接一阶段潜空间，在受控去噪幅度（Denoise ~0.35）下注入 GonzaLomo 写实摄影权重与精修 LoRA，修复 Turbo 模型的涂抹感与生硬边缘，完成由数码插画感向胶片光学摄影质感的质变飞跃。"}}}}