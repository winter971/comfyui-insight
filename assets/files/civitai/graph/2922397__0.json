DEL"},{"name":"positive","type":"CONDITIONING"},{"name":"negative","type":"CONDITIONING"},{"name":"latent_image","type":"LATENT"}],"outputs":[{"name":"LATENT","type":"LATENT"}],"widgets":["280019842888252","fixed","8","1","er_sde","simple","0.75"],"brief":"两台各跑一段：先生成合脸人像，再做风格化重绘","desc":""},{"id":"232","title":"Model link","type":"MarkdownNote","cat":"util","x":-2170,"y":-343,"inputs":[],"outputs":[],"widgets":["## Model links **text_encoders** - [Qwen3-4B-…"],"brief":"Markdown 注释节点。","desc":""}],"links":[{"from":"204","fromOut":0,"to":"8","toIn":0},{"from":"8","fromOut":0,"to":"206","toIn":0},{"from":"210","fromOut":0,"to":"208","toIn":6},{"from":"209","fromOut":0,"to":"208","toIn":7},{"from":"206","fromOut":0,"to":"208","toIn":0},{"from":"208","fromOut":0,"to":"205","toIn":0},{"from":"179","fromOut":0,"to":"211","toIn":0},{"from":"6","fromOut":0,"to":"211","toIn":3},{"from":"7","fromOut":0,"to":"211","toIn":4},{"from":"39","fromOut":0,"to":"211","toIn":2},{"from":"211","fromOut":0,"to":"212","toIn":0},{"from":"211","fromOut":0,"to":"213","toIn":0},{"from":"211","fromOut":0,"to":"214","toIn":0},{"from":"212","fromOut":0,"to":"204","toIn":0},{"from":"213","fromOut":0,"to":"206","toIn":1},{"from":"213","fromOut":3,"to":"206","toIn":2},{"from":"213","fromOut":4,"to":"206","toIn":3},{"from":"213","fromOut":2,"to":"206","toIn":4},{"from":"214","fromOut":0,"to":"208","toIn":1},{"from":"214","fromOut":1,"to":"208","toIn":2},{"from":"214","fromOut":3,"to":"208","toIn":4},{"from":"214","fromOut":4,"to":"208","toIn":5},{"from":"214","fromOut":2,"to":"208","toIn":3},{"from":"207","fromOut":0,"to":"215","toIn":0},{"from":"215","fromOut":0,"to":"216","toIn":0},{"from":"216","fromOut":0,"to":"206","toIn":5},{"from":"212","fromOut":2,"to":"8","toIn":1},{"from":"195","fromOut":0,"to":"95","toIn":0},{"from":"196","fromOut":0,"to":"95","toIn":1},{"from":"219","fromOut":0,"to":"206","toIn":6},{"from":"219","fromOut":0,"to":"217","toIn":0},{"from":"195","fromOut":0,"to":"217","toIn":1},{"from":"219","fromOut":0,"to":"220","toIn":0},{"from":"196","fromOut":0,"to":"220","toIn":1},{"from":"217","fromOut":0,"to":"206","toIn":14},{"from":"220","fromOut":0,"to":"206","toIn":15},{"from":"8","fromOut":0,"to":"221","toIn":0},{"from":"206","fromOut":0,"to":"222","toIn":0},{"from":"224","fromOut":0,"to":"179","toIn":0},{"from":"225","fromOut":0,"to":"224","toIn":0},{"from":"226","fromOut":0,"to":"211","toIn":1},{"from":"226","fromOut":0,"to":"6","toIn":0},{"from":"226","fromOut":0,"to":"7","toIn":0},{"from":"227","fromOut":0,"to":"228","toIn":3},{"from":"227","fromOut":1,"to":"228","toIn":4},{"from":"228","fromOut":0,"to":"204","toIn":1},{"from":"228","fromOut":1,"to":"204","toIn":2},{"from":"39","fromOut":0,"to":"228","toIn":2},{"from":"6","fromOut":0,"to":"228","toIn":0},{"from":"7","fromOut":0,"to":"228","toIn":1},{"from":"228","fromOut":2,"to":"230","toIn":1},{"from":"95","fromOut":0,"to":"230","toIn":0},{"from":"230","fromOut":0,"to":"204","toIn":3}],"ai":{"s":"面向 4GB 显存笔记本的 Z-Image Turbo 全能工作流。GGUF 量化主干（Q3_K_S）叠 LoRA、Qwen3-4B 文本编码器（按 lumina2 类型加载）与 ae VAE 先由 ToBasicPipe 打包成一个 BASIC_PIPE，再分三路 FromBasicPipe 喂给采样、分块放大与人脸修复——同一套模型供三个消费端复用，避免三份重复连线。潜空间来源二选一：txt2img 用 EmptyLatentImage（宽高由 Primitive 分发），img2img/局部重绘用 LoadImage 的图与遮罩经 InpaintModelConditioning 转成潜空间与条件，LazySwitchKJ 懒切换后进 KSampler（8 步 / CFG 1 / er_sde，turbo 配方）。解码后图像串行穿过 UltimateSDUpscale 和 FaceDetailer 再 SaveImage：两者默认旁路，图像直通即普通保存；在 Fast Groups Bypasser 面板点亮对应分组即启用放大或面部修复。两个旁路的 SimpleMath 公式按放大倍数自动算分块宽高。","u":["在低显存笔记本上跑量化版 Z-Image Turbo 文生图，改 Primitive 宽高与提示词即可出图","图生图改图：LoadImage 载入图片，切到 IMG2IMG 用 denoise 控制改动幅度","局部重绘：在 LoadImage 里涂遮罩，只重绘指定区域其余像素原样保留","出图后一键接 1.5 倍分块放大或 face_yolov8m 自动人脸精修"],"d":3,"st":[{"name":"模型装配","desc":"GGUF 量化主干叠 LoRA，配 Qwen3-4B 编码器与 ae VAE，正负提示词编码后全部打进一条 BASIC_PIPE，供后续三条支线统一取用。","nodes":["225","224","179","226","39","6","7","211"]},{"name":"潜空间来源切换","desc":"文生图走空白潜空间，图生图/重绘走 InpaintModelConditioning 把图与遮罩转成潜空间；懒切换节点只计算被选中那一路，省显存。","nodes":["195","196","95","227","228","230"]},{"name":"采样与解码","desc":"从管道取模型跑 turbo 快速采样，8 步 CFG 1 出图，VAE 解码后预览，图像继续流向后面的增强支线。","nodes":["212","204","8","221"]},{"name":"分块放大支线（默认旁路）","desc":"UpscaleModelLoader 出 4x_NMKD-Siax，UltimateSDUpscale 按块重采样实现低显存放大；旁路时图像原样直通，要放大再启用。","nodes":["213","207","215","216","219","217","220","206","222"]},{"name":"人脸修复与保存","desc":"FaceDetailer 用 YOLO 检测人脸、SAM 精确分割后单独重绘面部；最终图像统一从这条链尾的 SaveImage 落盘，分组开关在此控制启用哪些增强。","nodes":["214","210","209","208","205","223"]}],"p":"采样固定 CFG 1 + er_sde + 8 步，这是 Z-Image Turbo 的少步配方，别调高 CFG；img2img/重绘靠 denoise 0.75 控制改动幅度，想更贴近原图就调低；放大支线由 Upscale By 浮点（默认 1.5）控制倍率，其内部 denoise 0.25 保证只增强不重画。","n":"UltimateSDUpscale 与 FaceDetailer 默认旁路，在 Fast Groups Bypasser 里点亮才生效；做重绘需右键 LoadImage 进 MaskEditor 涂遮罩；需另下 z-image-turbo GGUF、Qwen3-4B 编码器、4x_NMKD-Siax、SAM 与 face_yolov8m，并装 GGUF、Impact Pack、UltimateSDUpscale、KJNodes、rgthree 等节点包。"}}