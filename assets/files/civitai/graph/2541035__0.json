o":"204","toIn":0},{"from":"212","fromOut":3,"to":"204","toIn":1},{"from":"212","fromOut":4,"to":"204","toIn":2},{"from":"213","fromOut":0,"to":"206","toIn":1},{"from":"213","fromOut":3,"to":"206","toIn":2},{"from":"213","fromOut":4,"to":"206","toIn":3},{"from":"213","fromOut":2,"to":"206","toIn":4},{"from":"214","fromOut":0,"to":"208","toIn":1},{"from":"214","fromOut":1,"to":"208","toIn":2},{"from":"214","fromOut":3,"to":"208","toIn":4},{"from":"214","fromOut":4,"to":"208","toIn":5},{"from":"214","fromOut":2,"to":"208","toIn":3},{"from":"207","fromOut":0,"to":"215","toIn":0},{"from":"215","fromOut":0,"to":"216","toIn":0},{"from":"216","fromOut":0,"to":"206","toIn":5},{"from":"212","fromOut":2,"to":"8","toIn":1},{"from":"195","fromOut":0,"to":"95","toIn":0},{"from":"196","fromOut":0,"to":"95","toIn":1},{"from":"219","fromOut":0,"to":"206","toIn":6},{"from":"219","fromOut":0,"to":"217","toIn":0},{"from":"195","fromOut":0,"to":"217","toIn":1},{"from":"219","fromOut":0,"to":"220","toIn":0},{"from":"196","fromOut":0,"to":"220","toIn":1},{"from":"217","fromOut":0,"to":"206","toIn":14},{"from":"220","fromOut":0,"to":"206","toIn":15},{"from":"8","fromOut":0,"to":"221","toIn":0},{"from":"206","fromOut":0,"to":"222","toIn":0},{"from":"96","fromOut":0,"to":"224","toIn":0},{"from":"224","fromOut":0,"to":"179","toIn":0}],"ai":{"s":"ChillDesire 的 Z-Image Turbo 出图三连：先用 Turbo 蒸馏模型 12 步、cfg 1、er_sde 从 1080x1920 竖版潜空间直出照片；随后 UltimateSDUpscale 借 4x_NMKD-Siax 按 1.5 倍 Chess 排布分块重绘，denoise 0.25 只补细节不动构图，分块宽高由 SimpleMath 按画幅与倍率自动算出；最后 FaceDetailer 用 face_yolov8m 找脸、SAM 勾边界，脸部以 0.5 去噪单独精修，专治放大后五官发糊。整条链把模型、CLIP、VAE 与正负条件打成一条 BasicPipe，再由三个 FromBasicPipe 分发给采样、放大、修脸三站，连线清爽且参数只需改一处全局生效。直出、放大、修脸的顺序不能颠倒，脸修必须吃放大后的高清底图才有效；Feature Toggles 分组开关可随时跳过放大或修脸环节。","u":["竖版 9:16 人像写真直出即高清：1080x1920 一键成片","放大后脸部发糊的自动补救：FaceDetailer 只重绘脸不碰背景","Z-Image Turbo 批量出图想配完整后处理流水线","学习 BasicPipe 布线范式的清爽模板"],"d":2,"st":[{"name":"模型与条件管道","desc":"Turbo 模型过 rgthree 的 LoRA 挂载位（当前为空）后直通，qwen_3_4b 按 lumina2 类型编码正负词，与 VAE 一起封进 BasicPipe，后续三站都从这条管道取件。","nodes":["96","224","179","99","6","7","39","211"]},{"name":"首次出图","desc":"宽高原语下发 1080x1920 空白潜空间，KSampler 以 12 步 cfg 1 的 er_sde 直出，蒸馏模型步数低但成图完整，解码后预览。","nodes":["195","196","95","212","204","8"]},{"name":"分块放大精修","desc":"Siax 放大模型先拉伸 1.5 倍，Chess 排布分块逐块低去噪重绘；分块尺寸由 SimpleMath 依倍率与画幅自动计算，画幅一改分块跟着变。","nodes":["207","215","216","219","217","220","213","206"]},{"name":"脸部修复","desc":"face_yolov8m 检测人脸、SAM 精细分割边界，脸部分支以 0.5 去噪、8 步单独重绘，兼顾清晰度与身份不变。","nodes":["210","209","214","208"]},{"name":"输出","desc":"直出图与放大图各有预览可对比，最终成品存到 Z-Image 目录。","nodes":["221","222","205"]}],"p":"Z-Image Turbo 锁 12 步、cfg 1、er_sde，别按普通模型加步数加 CFG；UltimateSDUpscale 去噪 0.25 调高会重画构图，Upscale By 1.5 改动后分块尺寸会自动跟算；FaceDetailer 去噪 0.5 是脸部重绘的平衡点，五官走样就调低；画幅只改 Image Width/Height 两个原语。","n":"需 z_image_turbo、qwen_3_4b、ae、4x_NMKD-Siax，FaceDetailer 首跑还要 face_yolov8m 与 sam_vit_b（Impact Pack）；图内 Feature Toggles 可整组关闭放大或修脸，只想要快图就关掉后两站；LoRA 在 Power Lora Loader 里按行添加，当前未挂任何 LoRA。"}}