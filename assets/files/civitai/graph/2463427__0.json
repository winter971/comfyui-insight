与模型通道","desc":""}],"links":[{"from":"6","fromOut":0,"to":"3","toIn":1},{"from":"8","fromOut":0,"to":"9","toIn":0},{"from":"13","fromOut":0,"to":"3","toIn":3},{"from":"17","fromOut":0,"to":"8","toIn":1},{"from":"3","fromOut":0,"to":"8","toIn":0},{"from":"28","fromOut":0,"to":"11","toIn":0},{"from":"29","fromOut":0,"to":"13","toIn":0},{"from":"29","fromOut":1,"to":"13","toIn":1},{"from":"38","fromOut":0,"to":"3","toIn":2},{"from":"47","fromOut":0,"to":"41","toIn":0},{"from":"49","fromOut":0,"to":"42","toIn":0},{"from":"45","fromOut":0,"to":"42","toIn":1},{"from":"51","fromOut":0,"to":"49","toIn":1},{"from":"48","fromOut":0,"to":"49","toIn":2},{"from":"42","fromOut":0,"to":"54","toIn":0},{"from":"56","fromOut":0,"to":"49","toIn":3},{"from":"57","fromOut":0,"to":"56","toIn":0},{"from":"45","fromOut":0,"to":"56","toIn":1},{"from":"61","fromOut":0,"to":"58","toIn":0},{"from":"71","fromOut":0,"to":"59","toIn":0},{"from":"68","fromOut":0,"to":"59","toIn":1},{"from":"72","fromOut":0,"to":"73","toIn":0},{"from":"72","fromOut":1,"to":"75","toIn":3},{"from":"72","fromOut":2,"to":"75","toIn":4},{"from":"73","fromOut":0,"to":"66","toIn":0},{"from":"75","fromOut":0,"to":"71","toIn":1},{"from":"75","fromOut":1,"to":"71","toIn":2},{"from":"75","fromOut":2,"to":"71","toIn":3},{"from":"59","fromOut":0,"to":"73","toIn":1},{"from":"67","fromOut":0,"to":"72","toIn":0},{"from":"72","fromOut":2,"to":"76","toIn":0},{"from":"76","fromOut":0,"to":"78","toIn":0},{"from":"63","fromOut":0,"to":"75","toIn":0},{"from":"62","fromOut":0,"to":"75","toIn":1},{"from":"68","fromOut":0,"to":"75","toIn":2},{"from":"67","fromOut":0,"to":"82","toIn":0},{"from":"73","fromOut":0,"to":"82","toIn":1},{"from":"67","fromOut":1,"to":"72","toIn":1},{"from":"36","fromOut":0,"to":"83","toIn":1},{"from":"83","fromOut":0,"to":"3","toIn":0},{"from":"83","fromOut":1,"to":"6","toIn":0},{"from":"83","fromOut":1,"to":"38","toIn":0},{"from":"33","fromOut":0,"to":"28","toIn":0},{"from":"11","fromOut":0,"to":"83","toIn":0},{"from":"42","fromOut":0,"to":"84","toIn":1},{"from":"57","fromOut":0,"to":"84","toIn":0},{"from":"52","fromOut":0,"to":"85","toIn":1},{"from":"85","fromOut":0,"to":"49","toIn":0},{"from":"85","fromOut":1,"to":"51","toIn":0},{"from":"85","fromOut":1,"to":"48","toIn":0},{"from":"86","fromOut":0,"to":"71","toIn":0},{"from":"86","fromOut":1,"to":"63","toIn":0},{"from":"86","fromOut":1,"to":"62","toIn":0},{"from":"64","fromOut":0,"to":"86","toIn":1},{"from":"53","fromOut":0,"to":"47","toIn":0},{"from":"41","fromOut":0,"to":"85","toIn":0},{"from":"65","fromOut":0,"to":"61","toIn":0},{"from":"58","fromOut":0,"to":"86","toIn":0}],"ai":{"s":"Z-Image Turbo 三合一工具图：txt2img、img2img、inpaint 三条完整支线并列，各自配一套 GGUF 主干 + SageAttention + AuraFlow 偏移 + LoRA 架子 + Qwen3-4B 编码器 + ae VAE，互不共享。Fast Groups Bypasser 把三条线编组，跑哪条开哪条。txt2img 由 FluxResolutionNode 定档位、空白潜空间 8 步直出；img2img 把输入图 VAEEncode 后 0.9 去噪整体重绘，与原图进 Comparer 对比；inpaint 在 LoadImage 手涂遮罩，InpaintCropImproved 裁出遮罩区单独重绘（0.4 去噪），InpaintStitchImproved 再按裁切记录拼回原图，只动该动的地方。三条线采样都是 8 步 CFG 1 euler/simple 的 Turbo 配置。结构直白，价值在一图三用；缺点是同一批模型和编码器重复加载了三份，显存占用和维护都翻倍。","u":["日常 Z-Image Turbo 出图：txt2img 支线选比例 8 步直出","参考图大改风格：img2img 支线 0.9 去噪整图重绘，Comparer 里对比验收","只改画面局部：inpaint 支线涂遮罩后裁区重绘，边缘自动拼回无缝","作为三用模板改造成自己的常驻工作台"],"d":3,"st":[{"name":"总控开关","desc":"Fast Groups Bypasser 把三条支线各编成组一键启停，跑哪条开哪条，避免三线齐跑浪费显存与时间。","nodes":["55"]},{"name":"Txt2Img 支线","desc":"分辨率节点按比例出宽高给空白潜空间；GGUF 主干过 SageAttention 与 AuraFlow 偏移后挂 LoRA，8 步 CFG 1 解码存图。","nodes":["29","13","33","28","11","83","36","6","38","3","8","17","9"]},{"name":"Img2Img 支线","desc":"输入图直接编码成潜空间，0.9 高去噪整体重绘；解码结果与原图并排进 Comparer，改动幅度一目了然。","nodes":["57","56","53","47","41","85","52","51","48","49","42","54","84"]},{"name":"Inpaint 输入与裁切","desc":"LoadImage 内手涂遮罩后，裁切节点框出遮罩周边区域并输出拼接器记录；MaskToImage 转换桩只作排查用，不接主线。","nodes":["67","72","76","78"]},{"name":"Inpaint 模型与条件","desc":"独立模型链装配后，InpaintModelConditioning 把裁切图、遮罩与正负词绑定成对齐的条件与潜空间，重绘范围由此锁定。","nodes":["65","61","58","86","64","63","62","75","68"]},{"name":"Inpaint 采样与拼回","desc":"0.4 去噪只重画遮罩区，解码后由拼接节点按裁切记录贴回原图全幅，另与原图对比预览。","nodes":["71","59","73","66","82"]}],"p":"三线统一 8 步 CFG 1 euler/simple，是 Z-Image Turbo 标配别乱动；去噪强度按用途分：txt2img 1、img2img 0.9 大改、inpaint 0.4 只补遮罩区，inpaint 调高会越过遮罩边界改构图；分辨率用 FluxResolutionNode 选比例即可。","n":"inpaint 需在 LoadImage 节点右键打开 MaskEditor 手涂遮罩；三条支线不关会同时执行、各自存图且显存吃紧，用 Fast Groups Bypasser 只留当前支线；需 z_image_turbo 与 Qwen3-4B 的 GGUF 文件及 ae.safetensors。"}}