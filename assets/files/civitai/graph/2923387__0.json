_Debug","type":"VRAM_Debug","cat":"util","x":-37,"y":-1206,"inputs":[{"name":"image_pass","type":"IMAGE"}],"outputs":[{"name":"any_output","type":"*"},{"name":"image_pass","type":"IMAGE"},{"name":"model_pass","type":"MODEL"},{"name":"freemem_before","type":"INT"},{"name":"freemem_after","type":"INT"}],"widgets":["true","true","false"],"brief":"调试中转节点，顺路报告显存占用","desc":""}],"links":[{"from":"307","fromOut":0,"to":"306","toIn":0},{"from":"307","fromOut":1,"to":"306","toIn":1},{"from":"287","fromOut":0,"to":"301","toIn":0},{"from":"301","fromOut":0,"to":"303","toIn":3},{"from":"289","fromOut":0,"to":"287","toIn":1},{"from":"289","fromOut":0,"to":"303","toIn":1},{"from":"290","fromOut":0,"to":"287","toIn":2},{"from":"290","fromOut":0,"to":"303","toIn":2},{"from":"306","fromOut":0,"to":"287","toIn":3},{"from":"297","fromOut":0,"to":"294","toIn":6},{"from":"298","fromOut":0,"to":"294","toIn":7},{"from":"294","fromOut":0,"to":"296","toIn":0},{"from":"295","fromOut":0,"to":"296","toIn":6},{"from":"264","fromOut":0,"to":"296","toIn":7},{"from":"305","fromOut":0,"to":"287","toIn":4},{"from":"305","fromOut":1,"to":"303","toIn":4},{"from":"305","fromOut":2,"to":"287","toIn":5},{"from":"305","fromOut":2,"to":"303","toIn":5},{"from":"305","fromOut":3,"to":"287","toIn":6},{"from":"305","fromOut":4,"to":"287","toIn":7},{"from":"305","fromOut":3,"to":"303","toIn":6},{"from":"305","fromOut":4,"to":"303","toIn":7},{"from":"287","fromOut":0,"to":"300","toIn":0},{"from":"303","fromOut":0,"to":"299","toIn":0},{"from":"302","fromOut":2,"to":"300","toIn":1},{"from":"302","fromOut":2,"to":"299","toIn":1},{"from":"304","fromOut":0,"to":"290","toIn":0},{"from":"304","fromOut":0,"to":"289","toIn":0},{"from":"302","fromOut":1,"to":"308","toIn":1},{"from":"302","fromOut":0,"to":"308","toIn":0},{"from":"302","fromOut":0,"to":"287","toIn":0},{"from":"302","fromOut":0,"to":"303","toIn":0},{"from":"300","fromOut":0,"to":"81","toIn":0},{"from":"299","fromOut":0,"to":"310","toIn":0},{"from":"310","fromOut":0,"to":"294","toIn":0},{"from":"308","fromOut":1,"to":"304","toIn":0},{"from":"289","fromOut":0,"to":"296","toIn":4},{"from":"308","fromOut":0,"to":"294","toIn":1},{"from":"308","fromOut":0,"to":"296","toIn":1},{"from":"302","fromOut":2,"to":"294","toIn":3},{"from":"302","fromOut":2,"to":"296","toIn":3},{"from":"290","fromOut":0,"to":"294","toIn":5},{"from":"290","fromOut":0,"to":"296","toIn":5},{"from":"304","fromOut":0,"to":"294","toIn":2},{"from":"304","fromOut":0,"to":"296","toIn":2},{"from":"296","fromOut":0,"to":"339","toIn":1},{"from":"339","fromOut":1,"to":"28","toIn":0},{"from":"289","fromOut":0,"to":"294","toIn":4}],"ai":{"s":"SDXL 动画风一键出图流水线：novaAnimeXL（Illustrious 系）挂三枚 LoRA，CLIPSetLastLayer -2 是这类模型的常规调法。第一遍 KSampler 从 EmptyLatentImage 直出底图，LatentUpscaleBy 把潜空间放大 1.25 倍后接第二遍 15 步低去噪采样，完成 hires fix——放大后的潜图只有粗结构，必须低强度再采样才能长出高分辨率细节。解码后依次过手部与面部两个 FaceDetailer：检测器裁出崩坏区域放大局部重绘（手 0.6、脸 0.45 去噪），是 SDXL 崩手崩脸的标配补救。rgthree 的 KSampler Config 把两段采样的步数/CFG/采样器集中一个面板下发，ResolutionSelector 一处改分辨率，easy cleanGpuUsed 在修手前清显存防溢出。整体是给新手封装的少改参数出图模板。","u":["新手用 Illustrious/动画系 SDXL 出完整插画，只需改提示词和选分辨率","崩手崩脸自动修复，不用手动涂遮罩或开修图软件","需要 hires fix 二次采样提升细节的成图流程","想把采样参数集中到一个面板管理的日常出图模板"],"d":2,"st":[{"name":"模型与提示词","desc":"checkpoint 载入后过 LoRA 堆栈再进采样器；CLIPSetLastLayer -2 针对 Illustrious 系微调文本层提升服从性。","nodes":["302","308","304","289","290"]},{"name":"第一遍底图采样","desc":"分辨率面板决定画布尺寸；KSampler Config 把步数/CFG/采样器同时发给两段采样，保证参数只改一处。","nodes":["307","306","287","300","81","305"]},{"name":"hires fix 二遍","desc":"潜空间放大 1.25 倍后低去噪重采样，高分辨率的精度靠这一步而不是直接放大像素。","nodes":["301","303","299"]},{"name":"手脸自动修复","desc":"两个 FaceDetailer 先手后脸，检测框裁剪局部放大重绘再贴回；检测模型分别来自 hand/face YOLO 与 SAM。","nodes":["310","294","297","298","296","295","264"]},{"name":"输出","desc":"修完的图经 VRAM_Debug 透传落盘，与一遍底图预览形成对照。","nodes":["339","28"]}],"p":"两段采样的步数与 CFG 全部由 rgthree KSampler Config 下发（30 步 CFG 4.5 起底、二遍 15 步）；手部 Detailer 去噪 0.6、脸部 0.45，调高会改表情与手型结构；LatentUpscaleBy 的 1.25 倍决定最终分辨率，想更大倍率先算好显存。","n":"需装 Impact-Pack 并自备 bbox/face_yolov8m、bbox/hand_yolov8s 与 sam_vit_b 三个检测模型；Illustrious 系 checkpoint 与三枚 LoRA 需另下；分辨率以 ResolutionSelector 为准，EmptyLatentImage 上的占位宽高会被它覆盖。"}}