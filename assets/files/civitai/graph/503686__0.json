":0,"to":"13","toIn":0},{"from":"264","fromOut":0,"to":"265","toIn":0},{"from":"265","fromOut":0,"to":"261","toIn":1},{"from":"269","fromOut":0,"to":"261","toIn":2},{"from":"270","fromOut":1,"to":"273","toIn":0},{"from":"274","fromOut":0,"to":"270","toIn":4},{"from":"272","fromOut":0,"to":"288","toIn":0},{"from":"270","fromOut":1,"to":"288","toIn":2},{"from":"288","fromOut":1,"to":"290","toIn":0},{"from":"293","fromOut":0,"to":"294","toIn":0},{"from":"292","fromOut":0,"to":"294","toIn":1},{"from":"106","fromOut":0,"to":"13","toIn":1},{"from":"106","fromOut":1,"to":"13","toIn":2},{"from":"317","fromOut":0,"to":"265","toIn":1},{"from":"294","fromOut":0,"to":"220","toIn":0},{"from":"13","fromOut":4,"to":"324","toIn":0},{"from":"13","fromOut":5,"to":"328","toIn":0},{"from":"198","fromOut":0,"to":"331","toIn":0},{"from":"106","fromOut":0,"to":"393","toIn":0},{"from":"106","fromOut":1,"to":"394","toIn":0},{"from":"136","fromOut":0,"to":"395","toIn":0},{"from":"13","fromOut":1,"to":"396","toIn":0},{"from":"13","fromOut":2,"to":"397","toIn":0},{"from":"13","fromOut":0,"to":"398","toIn":0},{"from":"399","fromOut":0,"to":"244","toIn":0},{"from":"400","fromOut":0,"to":"244","toIn":1},{"from":"401","fromOut":0,"to":"244","toIn":4},{"from":"244","fromOut":0,"to":"404","toIn":0},{"from":"244","fromOut":1,"to":"405","toIn":0},{"from":"120","fromOut":0,"to":"406","toIn":0},{"from":"244","fromOut":2,"to":"407","toIn":0},{"from":"408","fromOut":0,"to":"261","toIn":0},{"from":"261","fromOut":0,"to":"413","toIn":0},{"from":"414","fromOut":0,"to":"231","toIn":0},{"from":"420","fromOut":0,"to":"273","toIn":1},{"from":"421","fromOut":0,"to":"290","toIn":1},{"from":"274","fromOut":0,"to":"288","toIn":1},{"from":"422","fromOut":0,"to":"274","toIn":0},{"from":"424","fromOut":0,"to":"288","toIn":3},{"from":"273","fromOut":0,"to":"425","toIn":0},{"from":"290","fromOut":0,"to":"426","toIn":0},{"from":"427","fromOut":0,"to":"292","toIn":0},{"from":"220","fromOut":0,"to":"428","toIn":0},{"from":"429","fromOut":0,"to":"18","toIn":0},{"from":"430","fromOut":0,"to":"207","toIn":0},{"from":"431","fromOut":0,"to":"221","toIn":0},{"from":"434","fromOut":0,"to":"433","toIn":0},{"from":"272","fromOut":0,"to":"270","toIn":3},{"from":"423","fromOut":0,"to":"270","toIn":6},{"from":"419","fromOut":0,"to":"270","toIn":0},{"from":"13","fromOut":3,"to":"435","toIn":0},{"from":"416","fromOut":0,"to":"270","toIn":1},{"from":"417","fromOut":0,"to":"270","toIn":2},{"from":"436","fromOut":0,"to":"270","toIn":5},{"from":"248","fromOut":0,"to":"437","toIn":0},{"from":"438","fromOut":0,"to":"412","toIn":0}],"ai":{"s":"本工作流由 jafarscharm 匠心设计，是一套将 AnimateLCM 极速视频生成技术与多重时空一致性约束完美结合的工业级图生视频（Img2Vid）生产管线。系统以 SD 1.5 标杆写实大模 Juggernaut Reborn 为骨架，通过 LoRA Stacker 深度融合 AnimateLCM 动作模型与运动 LoRA；管线创新构建了「双重几何与特征锁」——利用 DepthAnything ControlNet 锁定空间构图深度，结合 IP-Adapter Advanced 锁定人物质感与面部身份；采样端开创性采用 LCMScheduler 与 SamplerLCMCycle 组成两段式级联采样（Dual-Stage Sampling），在仅需 2-4 步的极速去噪中完成初生与去噪细化；最终经由 4x-Ultrasharp 空间超分与 RIFE 神经网络光流插帧，彻底攻克了传统 AnimateDiff 生成慢、易闪烁形变且分辨率受限的痛点。","u":["单张静态角色立绘的高一致性动态化演变：在严格锁定原图面容特征、发型与服饰纹理的前提下，生成运动平滑连贯的短视频动画。","影视级 3D 深度推拉镜头与场景动态漫游：结合 DepthAnything 提取的环境纵深几何，驱动摄像机生成具备真实空间透视的位移动画。","中低显存环境下的极速高帧率视频生产：依托 LCM 4-8 步极速蒸馏算法与 RIFE 插帧，在主流消费级显卡上实现数倍于传统管线的视频渲染效率。"],"d":2,"st":[{"name":"基础底模、动效引擎与 LoRA 动力学加载阶段","desc":"基于 Efficient Loader 载入 Juggernaut Reborn 摄影大底模并挂载 AnimateLCM 专用运动 LoRA；集成 AnimateLCM 时序扩散主干模型，配置 16 帧首尾闭环（Looped Uniform）滑动上下文窗口；利用 easy set/get 总线将基础模型、VAE、CLIP 及初始潜空间参数广播至全局。","nodes":["13","138","106","136","317","264","265","269","261","324","328","393","394","395","396","397","398","401","413","414","435"]},{"name":"图像前处理、深度控制与 IP-Adapter 身份锚定阶段","desc":"导入核心立绘参考图，经由尺寸规整、CLIP-Vision 裁剪与色彩对比度校正后注入 IPAdapterAdvanced 风格特征；并行调用 DepthAnything 预处理器提取全序列深度几何特征并送入 ControlNetLoader，由 ACN_AdvancedControlNetApply 深度约束正负向条件，确保生成视频严密锁定原图的轮廓几何与角色身份。","nodes":["120","235","232","241","238","204","231","198","331","406","419","248","250","244","437","438","412","399","400","404","405","407","408","416","417","422"]},{"name":"循环 LCM 调度器与两段式自定义重绘采样阶段","desc":"核心两段式视频采样生成中枢。利用专为蒸馏模型打造的 LCMScheduler 结合 SamplerLCMCycle 周期采样求解器；一阶段 SamplerCustom 在 2-4 步极低步数内快速固化多帧连贯潜空间，解码并在 PreviewImage 中实时监视；二阶段复用该采样体系执行细化去噪，有效消解低步数生成的噪点与面部轻微形变。","nodes":["274","272","270","273","420","423","425","433","434","436","288","290","421","424","426","427"]},{"name":"空间超分重建、RIFE 光流插帧与视频最终封装阶段","desc":"视频后处理与视效跃迁阶段。接收二次精修后的视频序列，调用 4x-Ultrasharp 深度学习模型执行空间画质超分；由 RIFE VFI 神经网络计算高阶光流并完成 2 倍帧率智能插补；最终通过多组 VHS_VideoCombine 分别导出各阶段对比及最终丝滑高帧率视频文件。","nodes":["292","293","294","220","428","429","430","431","18","207","221"]}],"p":"1. 步数与 CFG 设置：由于采用 AnimateLCM 架构，CFG 务必保持在 1.0 - 2.0 之间的超低区间（推荐 1.4-1.6），避免画面色彩灼烧过曝；LCMScheduler 步数设为 8-10 步即可，SamplerLCMCycle 内部线性循环周期推荐设为 2。2. 分辨率规划：初始潜空间 SeargeIntegerPair 建议设为 360×640 或 512×512，避免初始尺寸过大导致运动畸变；后期经由 4x-Ultrasharp 放大 2x 并经 ImageScaleBy 输出标准的 720P/1080P。3. ControlNet 与 IP-Adapter 引导比重：Depth ControlNet 强度推荐 0.8-1.0，结束步长设为 0.75-1.0；IP-Adapter 权重建议保持在 0.7-0.9，并选择 style transfer 或 average 权重分发模式。","t":["【闭环循环动画（Loop Animation）无缝衔接】：工作流在 ADE_LoopedUniformContextOptions 节点中默认开启了 loop=true，能让视频最后一帧完美衔接第一帧。如果需要生成非循环的自然线性动作镜头，务必将该参数手动置为 false，并适当调大 overlap 重叠帧数（如设为 4-6）以增强时序长线一致性。","【两段式采样（Dual-Stage）去噪幅度防糊指南】：一阶段采样生成基底视频帧，二阶段采样负责细节重塑。二阶段的去噪幅度切忌超过 0.5，过大会破坏一阶段已锚定的动作连续性，若发现放大后画面出现轻微闪烁，应在 RIFE VFI 节点中调高帧间光流平滑阈值。","【色彩对比度预处理避坑】：节点 241（LayerColor: Brightness & Contrast）预先增强了参考图的明暗反差（亮度 1.75 / 对比度 0.9）。若输入图本身曝光过度或饱和度过高，输入该节点后容易导致 IP-Adapter 生成人物面部死白，此时应适当回调该节点的 Brightness 乘数至 1.0-1.2。"],"n":"必须安装 AnimateDiff-Evolved、ComfyUI_IPAdapter_plus、ComfyUI-VideoHelperSuite (VHS)、ComfyUI-easy-use、ComfyUI-LayerStyle 以及 Frame-Interpolation (ComfyUI-Frame-Interpolation) 扩展包。需在 models 目录下分别放置 Juggernaut Reborn 模型、AnimateLCM 动作模型与 LoRA、Depth ControlNet 模型、CLIP-ViT-bigG 视觉权重及 RIFE 47 插帧权重。建议配备 12GB 以上显存的 GPU 以获得流畅的视频渲染体验。","na":{"13":{"brief":"全能模型与潜空间加载器","detail":"集成本地扩散底模、Baked VAE、初始文本提示词以及动态长宽尺寸输入，构筑基础管线。"},"198":{"brief":"高级 IP-Adapter 样式注入器","detail":"接收经过校色的参考图与视觉编码特征，以风格迁移模式将角色的质感、五官与着装风格强力锚定至动画中。"},"220":{"brief":"RIFE 深度光流神经网络插帧器","detail":"基于 rife47 算法对超分后的视频帧序列执行 2 倍光流运动矢量内插，使成片帧率翻倍并消除肉眼卡顿。"},"244":{"brief":"高级 ControlNet 应用节点","detail":"将 DepthAnything 提取出的深度图序列与模型正负向条件深度融合，在 3D 几何空间上严密锁定运动轮廓。"},"264":{"brief":"AnimateLCM 运动模型加载器","detail":"载入专为一致性蒸馏微调的 AnimateLCM 运动先验权重，为静帧图像注入跨帧时序动态。"},"269":{"brief":"闭环均匀滑动上下文控制器","detail":"配置 16 帧上下文窗口与 4 帧重叠度，开启首尾循环支持，使生成的动态短片可无缝无限循环播放。"},"270":{"brief":"一阶段初生自定义采样器","detail":"执行第一轮潜在扩散采样，在深度图与 IP-Adapter 双重护航下快速成形连贯的基底视频帧潜变量。"},"272":{"brief":"LCM 周期采样器选择器","detail":"配套自定义采样架构的高阶求解器，通过循环计算保证在极低迭代步数下的轨迹收敛稳定性。"},"274":{"brief":"LCM 专用噪声调度器 (LCMScheduler)","detail":"针对潜空间一致性模型优化的专用 Sigmas 计算器，以极短的时间步长区间驱动超快去噪过程。"},"294":{"brief":"模型辅助图像超分辨率放大器","detail":"调用 4x-Ultrasharp 深度学习模型对二阶段精修后的视频各帧进行无损清晰度重建与高频微观纹理修复。"}}}}