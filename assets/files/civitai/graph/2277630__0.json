t":0,"to":"262","toIn":0},{"from":"258","fromOut":0,"to":"262","toIn":1},{"from":"142","fromOut":0,"to":"268","toIn":0},{"from":"139","fromOut":0,"to":"268","toIn":1},{"from":"128","fromOut":0,"to":"268","toIn":2},{"from":"127","fromOut":0,"to":"268","toIn":3},{"from":"155","fromOut":0,"to":"268","toIn":4},{"from":"268","fromOut":0,"to":"183","toIn":0},{"from":"270","fromOut":0,"to":"199","toIn":4},{"from":"273","fromOut":0,"to":"274","toIn":0},{"from":"241","fromOut":0,"to":"238","toIn":0},{"from":"277","fromOut":0,"to":"241","toIn":0},{"from":"277","fromOut":0,"to":"240","toIn":0},{"from":"244","fromOut":0,"to":"278","toIn":0},{"from":"278","fromOut":0,"to":"277","toIn":0},{"from":"245","fromOut":0,"to":"283","toIn":0},{"from":"284","fromOut":0,"to":"282","toIn":1},{"from":"282","fromOut":0,"to":"246","toIn":0},{"from":"284","fromOut":0,"to":"280","toIn":0},{"from":"280","fromOut":0,"to":"282","toIn":0},{"from":"286","fromOut":0,"to":"287","toIn":0},{"from":"290","fromOut":0,"to":"243","toIn":0},{"from":"290","fromOut":0,"to":"241","toIn":1},{"from":"290","fromOut":0,"to":"245","toIn":2},{"from":"242","fromOut":0,"to":"290","toIn":0},{"from":"291","fromOut":0,"to":"273","toIn":0}],"ai":{"s":"本工作流是由社区创作者 JCB2 专为轻量级视频生成基座 Wan 2.2 TI2V-5B（万象视频 2.2 图生视频 5B 参数版本）量身打造的高效自适应管线。架构技术特色极为突出：全流程摒弃传统杂乱的物理连线，基于 ComfyUI-Easy-Use 扩展套件构建了整洁的模块化无线总线（setNode / getNode），实现跨区域多模态信号的解耦通信；主链路集成动态宽高自适应计算与 easy ifElse 逻辑条件选择器，能够智能根据输入参考图画幅动态匹配 16 像素倍数最佳分辨率，并驱动 Wan 2.2 专用的多维视频扩散采样与 Wan 3D 时空 VAE 编解码。该方案在极大地降低图生视频部署显存门槛的同时，保持了工业级的运动平滑度与时间一致性。","u":["【消费级显卡轻量级图生视频渲染】：借助 Wan 2.2 5B 轻量化底模优势与自适应缩放算法，在 12GB~16GB 消费级显卡上实现高帧率、低延迟的单图动态化视频生成。","【自适应多画幅短视频与动态壁纸创作】：自动兼容竖屏 9:16（短视频/手机动态壁纸）、横屏 16:9（影视/桌面）及正方形等任意输入比例图片，消除画面被暴力裁剪或拉伸畸变的痛点。","【整洁规范的工程化无线工作流集成】：通过 easy-use 无线节点与 ifElse 逻辑网关组织复杂管线，极大降低视频生产流水线的视觉认知负荷，适合团队协作与二开封装。"],"d":2,"st":[{"name":"核心多模态基础模型加载与无线总线发射","desc":"加载 Wan 2.2 专用文本编码器（CLIP）与时空 3D 视频变分自编码器（Wan VAE），并通过 setNode 无线发射节点将模型条件分发至全域总线，实现跨区域模块间的高内聚低耦合通信。","nodes":["38","39","148","141"]},{"name":"参考图输入与动态画幅自适应计算","desc":"接收用户上传的原图并广播至图像总线，配合几何计算模块解析图像宽高比，输出符合视频扩散模型 16 像素对齐规范的自适应新高度与新宽度接收变量。","nodes":["125","127","128","139"]},{"name":"逻辑分支决策与潜空间特征流转","desc":"通过 easy ifElse 条件分支选择器动态判定生成模式或分辨率分支路径，并在视频扩散采样后将高维时空潜空间（Latent）张量广播至下游解码链路。","nodes":["205","183"]},{"name":"时空 3D 潜空间视频解码","desc":"终末阶段通过无线节点精确拉取 Wan 专用 3D VAE 模型句柄，将多帧连续潜空间特征反变换为流畅连贯的时间序列视频帧并完成渲染。","nodes":["142"]}],"p":"【视频采样与帧率控制】：Wan 2.2 5B 推荐采样步数（Steps）设为 25~35 步；CFG 推荐 5.0~6.0（过高会带来运动帧间频闪与过饱和，过低会导致提示词运动响应迟钝）；帧率（FPS）建议设置为 16 或 24 fps；单次生成总帧数推荐 49 或 81 帧（对应 2~4 秒高质量连续动态镜头，必须符合 4n+1 帧的 Wan 时空采样数学结构）。\n【自适应分辨率配置】：节点 127/128 计算得到的短边建议限制在 512~720px 之间（如 512×896 或 720×1280），严格遵守 16 像素对齐；切勿强开 1080P 原生采样，否则 5B 视频模型容易出现肢体融化、多头多手或显存激增崩溃。","t":["【总线无线变量对应关系严禁错位】：本工作流大量使用 easy-use 系列无线发射（setNode）与接收（getNode）节点。修改或扩展流程时，必须确保接收端变量名与发射端完全严格吻合（如 ➡️IMAGE 必须精确对应 ⬅️IMAGE，➡️VAE 对应 ⬅️VAE），若出现同名冲突或空连接会导致静默报错中断。","【Wan 2.2 必须匹配专用 3D VAE】：切勿将 SD 1.5 或 SDXL 的标准 2D 图像 VAE 接入 141/142 节点；Wan 2.2 采用跨时间轴的 3D 因果卷积自编码器（3D Causal VAE），若误接 2D VAE 会直接引发张量维度不匹配（Shape Mismatch）异常中断运行。","【首帧输入图质量决定成片上限】：图生视频（I2V）强烈受制于初始输入图像，应尽量提供主体清晰、无多余肢体穿模的高质量图片；对于包含微小面部的输入图，建议先在外部完成人脸高清修复后再喂入节点 125。"],"n":"本工作流强制依赖 ComfyUI-Easy-Use 节点套件（提供 setNode/getNode 无线总线与 ifElse 逻辑控制器），缺失将导致红框报错无法运行；底模需预先下载 Wan 2.2 TI2V-5B 扩散权重并存放于 ComfyUI/models/diffusion_models/ 或 checkpoints/，专属 3D VAE 放置于 ComfyUI/models/vae/，文本编码器需对应配置；运行 5B 视频扩散显存底线为 12GB VRAM（建议开启 --lowvram 或使用 GGUF/NF4 量化权重以提升显存容忍度）。","na":{"38":{"brief":"Wan 文本编码器加载","detail":"加载专属于 Wan 2.2 的大语言模型/CLIP 文本编码器，将提示词转化为多模态时间语义向量，用于指引视频运动轨迹与场景变化。"},"39":{"brief":"Wan 专用 3D 时空 VAE 加载","detail":"载入 Wan 2.2 专用的三维因果卷积 VAE 模型权重，负责时间轴连续特征与空间像素矩阵之间的跨维度编解码。"},"125":{"brief":"输入参考图无线发射","detail":"捕获图生视频源图片并广播至图像总线，作为视频生成起始首帧锚点与画幅计算的原始数据源。"},"127":{"brief":"自适应高度接收端","detail":"通过 easy getNode 实时拉取算法动态折算后的最优目标高度像素值，确保符合 16 像素对齐约束。"},"128":{"brief":"自适应宽度接收端","detail":"通过 easy getNode 动态拉取适配原图比例的最佳宽度像素值，杜绝画面拉伸并兼顾显存配比。"},"139":{"brief":"输入图像接收端","detail":"在图像处理与潜空间编码子图内拉取首帧参考图数据，供 VAE 编码为视频潜空间时空特征起始帧。"},"141":{"brief":"VAE 无线发射总线","detail":"通过 easy setNode 将 3D VAE 模型句柄分发至全局命名信道，为图像潜空间编码与最终视频解码提供共享接入点。"},"142":{"brief":"VAE 无线接收端","detail":"在视频渲染解码模块终端拉取 3D VAE 实例，执行最终潜空间到视频序列帧的高精度时空解码。"},"148":{"brief":"CLIP 无线发射总线","detail":"通过 easy setNode 将文本编码器实例广播至全局无线总线，供下游提示词编码节点随需调取，消除跨屏飞线。"},"183":{"brief":"潜空间结果发射总线","detail":"将视频扩散采样器生成的连续高维多帧潜空间张量打入无线总线，传输至下游解码与后处理模块。"},"205":{"brief":"条件分支逻辑选择器","detail":"基于 easy ifElse 提供二选一流程控制网关，支持根据分辨率档位或运行模式自动路由工作流分支。"}}}}