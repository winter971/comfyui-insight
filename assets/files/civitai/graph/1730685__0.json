from":"4","fromOut":2,"to":"8","toIn":1},{"from":"8","fromOut":0,"to":"15","toIn":0},{"from":"4","fromOut":1,"to":"39","toIn":0},{"from":"4","fromOut":1,"to":"40","toIn":0},{"from":"13","fromOut":0,"to":"67","toIn":4},{"from":"68","fromOut":0,"to":"67","toIn":5},{"from":"39","fromOut":0,"to":"67","toIn":2},{"from":"40","fromOut":0,"to":"67","toIn":3},{"from":"16","fromOut":0,"to":"67","toIn":0},{"from":"4","fromOut":0,"to":"67","toIn":1},{"from":"67","fromOut":0,"to":"3","toIn":0},{"from":"67","fromOut":1,"to":"3","toIn":1},{"from":"67","fromOut":2,"to":"3","toIn":2},{"from":"13","fromOut":0,"to":"69","toIn":0},{"from":"69","fromOut":0,"to":"70","toIn":0},{"from":"8","fromOut":0,"to":"69","toIn":1},{"from":"8","fromOut":0,"to":"71","toIn":0},{"from":"68","fromOut":0,"to":"88","toIn":0},{"from":"8","fromOut":0,"to":"88","toIn":1},{"from":"88","fromOut":0,"to":"90","toIn":0},{"from":"98","fromOut":0,"to":"91","toIn":0},{"from":"97","fromOut":0,"to":"92","toIn":0},{"from":"97","fromOut":1,"to":"92","toIn":1},{"from":"97","fromOut":2,"to":"92","toIn":2},{"from":"93","fromOut":0,"to":"92","toIn":3},{"from":"94","fromOut":1,"to":"95","toIn":0},{"from":"94","fromOut":1,"to":"96","toIn":0},{"from":"106","fromOut":0,"to":"97","toIn":0},{"from":"94","fromOut":0,"to":"97","toIn":1},{"from":"95","fromOut":0,"to":"97","toIn":2},{"from":"96","fromOut":0,"to":"97","toIn":3},{"from":"99","fromOut":0,"to":"97","toIn":4},{"from":"92","fromOut":0,"to":"98","toIn":0},{"from":"94","fromOut":2,"to":"98","toIn":1},{"from":"99","fromOut":0,"to":"101","toIn":0},{"from":"98","fromOut":0,"to":"101","toIn":1},{"from":"101","fromOut":0,"to":"102","toIn":0},{"from":"98","fromOut":0,"to":"103","toIn":0},{"from":"107","fromOut":0,"to":"97","toIn":5},{"from":"13","fromOut":0,"to":"163","toIn":0},{"from":"68","fromOut":0,"to":"163","toIn":2},{"from":"8","fromOut":0,"to":"163","toIn":1},{"from":"163","fromOut":0,"to":"164","toIn":0},{"from":"167","fromOut":0,"to":"168","toIn":0},{"from":"99","fromOut":0,"to":"167","toIn":0},{"from":"98","fromOut":0,"to":"167","toIn":1}],"ai":{"s":"双分支的'预测孩子长相'工作流。每条分支结构相同：两张家长正面照连同 RealVisXL_V4.0 主干、ControlNet 与 ip-adapter.bin 一起进入 ZenIDCombineFace，该节点把两张脸的身份特征按 0.3/0.3 权重融进模型与正负条件，再由 KSampler（30 步、CFG 4.5、ddpm+karras）从空白潜空间生成指定面孔——'a boy/girl 4 year olds' 提示词是年龄与性别的唯一控制点，两条分支分别出男孩和女孩。解码后 Face Similarity 用 face_recognition 分别计算生成脸与每位家长照片的相似度，分数由 easy showAnything 显示（示例 58.23/45.67/32.05）；ImageConcatMulti 把家长与孩子拼成一排目检，PurgeVRAM 在每条分支解码后强制清显存，让双分支共存不溢出。为什么必须用 ZenIDCombineFace：普通文生图没有身份锚点，只有把两张参考脸写进条件与模型，'像爸妈'才有着落。","u":["情侣或夫妻想知道孩子大概长什么样，各传一张正面照生成 4 岁男孩/女孩假想脸","改提示词里的年龄性别（如 a girl 16 year olds）生成不同成长阶段的假想面孔","用相似度分数客观比较哪组参数生成的孩子更像某位家长","做双人身份混合头像：把 image_1/image_2 换成任意两张脸，权重调比例"],"d":3,"st":[{"name":"家长照片载入","desc":"两个 LoadImage 各放一张正面照；注意 gao512 被三个节点重复加载，换照片要同步改多处。","nodes":["13","68","99","107"]},{"name":"身份混合装配","desc":"两条分支各一套 RealVisXL+ControlNet+IP-Adapter：ZenIDCombineFace 把两张脸的身份按权重写进模型与条件，男孩/女孩提示词在此分岔。","nodes":["4","16","67","39","40","94","106","97","95","96"]},{"name":"采样与解码","desc":"各自从 1024 空白潜空间 30 步全去噪采样，ddpm+karras 组合保证写实细节，VAE 解码后先预览。","nodes":["5","3","8","15","93","92","98","91"]},{"name":"相似度评估","desc":"生成脸分别与两位家长比对余弦相似度，数值直接显示在画布上，是调权重的依据。","nodes":["69","88","101","70","90","102"]},{"name":"拼图对比与清理","desc":"家长与孩子横向拼排直观对比；PurgeVRAM 清理两分支的显存残留。","nodes":["163","164","167","168","71","103"]}],"p":"ZenIDCombineFace 的两个 0.3 权重分别控制两位家长的相貌贡献，想更像谁就调高对应权重，配合相似度分数反复微调；KSampler 30 步 / CFG 4.5 / ddpm+karras 是写实出图的稳定组合；提示词里的年龄与性别（a boy/girl 4 year olds）决定生成对象，改这里比改参数影响更大。","n":"需准备两张正面清晰人脸；RealVisXL_V4.0、ip-adapter.bin 与 ControlNet 模型要提前下载，Face Similarity 依赖 face_recognition 人脸识别库首次运行会自动安装；gao512.jpg 被三个 LoadImage 重复引用，换家长照片务必逐个替换；元数据标注 Flux 但图中实际底模是 SDXL 系 RealVisXL。"}}