,"to":"3","toIn":2},{"from":"22","fromOut":0,"to":"23","toIn":1},{"from":"20","fromOut":0,"to":"23","toIn":0},{"from":"27","fromOut":0,"to":"26","toIn":2},{"from":"19","fromOut":0,"to":"26","toIn":1},{"from":"17","fromOut":0,"to":"26","toIn":0},{"from":"23","fromOut":0,"to":"19","toIn":4},{"from":"26","fromOut":0,"to":"3","toIn":1},{"from":"8","fromOut":0,"to":"28","toIn":0},{"from":"30","fromOut":0,"to":"28","toIn":2},{"from":"29","fromOut":0,"to":"28","toIn":1},{"from":"20","fromOut":0,"to":"38","toIn":0},{"from":"38","fromOut":0,"to":"17","toIn":0},{"from":"23","fromOut":0,"to":"19","toIn":0},{"from":"23","fromOut":0,"to":"19","toIn":3},{"from":"23","fromOut":0,"to":"19","toIn":1},{"from":"23","fromOut":0,"to":"19","toIn":2},{"from":"23","fromOut":0,"to":"17","toIn":4},{"from":"45","fromOut":0,"to":"17","toIn":1},{"from":"33","fromOut":0,"to":"48","toIn":0},{"from":"33","fromOut":0,"to":"46","toIn":0},{"from":"32","fromOut":0,"to":"46","toIn":1},{"from":"32","fromOut":0,"to":"48","toIn":1},{"from":"48","fromOut":0,"to":"45","toIn":1},{"from":"48","fromOut":0,"to":"45","toIn":2},{"from":"20","fromOut":0,"to":"45","toIn":0},{"from":"46","fromOut":0,"to":"38","toIn":1},{"from":"46","fromOut":0,"to":"38","toIn":2},{"from":"33","fromOut":0,"to":"50","toIn":1},{"from":"33","fromOut":0,"to":"50","toIn":2},{"from":"32","fromOut":0,"to":"49","toIn":1},{"from":"32","fromOut":0,"to":"49","toIn":2},{"from":"50","fromOut":0,"to":"51","toIn":0},{"from":"49","fromOut":0,"to":"51","toIn":1},{"from":"51","fromOut":0,"to":"17","toIn":2},{"from":"20","fromOut":0,"to":"49","toIn":0},{"from":"20","fromOut":0,"to":"50","toIn":0},{"from":"24","fromOut":0,"to":"52","toIn":0},{"from":"25","fromOut":0,"to":"53","toIn":0},{"from":"50","fromOut":0,"to":"54","toIn":0},{"from":"49","fromOut":0,"to":"54","toIn":1},{"from":"54","fromOut":0,"to":"17","toIn":3},{"from":"52","fromOut":0,"to":"33","toIn":0},{"from":"53","fromOut":0,"to":"32","toIn":0}],"ai":{"s":"Searge-SDXL 包自带的条件装配测试图（包内路径 testing/test-conditioning），不是拿来出图的成品。它把同一组测试文本用四种方式转成 SDXL 条件：CLIPTextEncodeSDXL 的 G/L 双编码、字符串拼接后再 G/L 编码、ConditioningConcat 拼接、ConditioningCombine 叠加，四种结果全部接进 SeargeConditioningMuxer5，再经 Muxer2 二选一送进 KSampler 正向口；负向口直接接一段空文本编码。三个选择器（两个 Muxer5、一个 Muxer2）都由固定为 0 的 Primitive 控制，当前实际生效的只有第一条 G/L 支线，其余装配方式只是挂在路由上待切换验证。采样是标准 SDXL 配置：1024 空白潜空间、25 步、CFG 7.5、dpmpp_2m+karras，解码后由 Searge 封装的保存节点落盘。文本内容如 wrinkled face、poorly lit photo 全是测试字符串，出图没有实际意义；这份图的价值是演示 Searge 条件路由节点的接法。","u":["研究 Searge 工作流源码时，对照看四种条件装配方式的接线差异","想切换 SDXL 条件方案时，把 Muxer 选择器从 0 改成 1-4 逐个对比出图差异","学习 ConditioningConcat 与 ConditioningCombine 的区别：拼接与叠加效果不同","给 Searge-SDXL 主工作流做二次开发前的路由节点验证"],"d":1,"st":[{"name":"测试文本与拼接","desc":"两段 SeargePromptText 存放测试字符串，PromptCombiner 用分隔符拼成一段，供多条编码支线共用。","nodes":["21","24","25","46","48"]},{"name":"四种条件装配备选","desc":"同一文本分别走 G/L 双编码、拼接编码、条件拼接、条件叠加四条支线，是本图要对比的实验对象。","nodes":["38","45","50","49","51","54"]},{"name":"条件路由","desc":"两级 Muxer 加一个二选一 Muxer2 组成路由树，选择器固定 0，测试时改 Primitive 值即可换装配方式。","nodes":["17","19","26","18","27","23"]},{"name":"采样与解码","desc":"SDXL base 加空白潜空间按 25 步标准参数采样，dpmpp_2m+karras 解码预览。","nodes":["4","5","3","8","16"]},{"name":"保存","desc":"Searge 封装保存节点带启用开关与输出文件夹选择，按日期归档。","nodes":["28","29","30"]}],"p":"KSampler 25 步 / CFG 7.5 / dpmpp_2m+karras 是 SDXL 标准配方；真正要动的是三个 Primitive 选择器（当前全 0），改成 1-4 即可切换四种条件装配方式做对比测试；提示词本身是测试字符串，正式出图前需替换。","n":"这是作者的测试图而非用户工作流，文件名与包内 testing 目录都说明了用途；文本内容无实际语义，直接跑出的图没有意义；需要安装 Searge 自定义节点包；负向条件当前是空文本，别指望负向词生效。"}}