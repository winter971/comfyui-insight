In":0},{"from":"5","fromOut":1,"to":"76","toIn":0},{"from":"5","fromOut":1,"to":"77","toIn":0},{"from":"21","fromOut":0,"to":"75","toIn":3},{"from":"6","fromOut":0,"to":"113","toIn":0},{"from":"19","fromOut":0,"to":"113","toIn":1},{"from":"115","fromOut":0,"to":"113","toIn":2},{"from":"107","fromOut":0,"to":"113","toIn":3},{"from":"5","fromOut":0,"to":"21","toIn":0},{"from":"5","fromOut":0,"to":"75","toIn":0},{"from":"72","fromOut":0,"to":"124","toIn":0},{"from":"124","fromOut":0,"to":"73","toIn":0},{"from":"1","fromOut":1,"to":"126","toIn":0},{"from":"126","fromOut":0,"to":"4","toIn":1},{"from":"1","fromOut":2,"to":"113","toIn":4},{"from":"65","fromOut":0,"to":"144","toIn":0},{"from":"66","fromOut":0,"to":"144","toIn":1},{"from":"144","fromOut":0,"to":"6","toIn":1},{"from":"144","fromOut":0,"to":"6","toIn":2},{"from":"144","fromOut":1,"to":"19","toIn":1},{"from":"144","fromOut":1,"to":"19","toIn":2},{"from":"146","fromOut":0,"to":"21","toIn":1},{"from":"146","fromOut":1,"to":"21","toIn":2},{"from":"145","fromOut":0,"to":"146","toIn":3},{"from":"1","fromOut":2,"to":"146","toIn":4},{"from":"115","fromOut":0,"to":"146","toIn":2},{"from":"106","fromOut":0,"to":"107","toIn":0},{"from":"106","fromOut":0,"to":"145","toIn":0},{"from":"140","fromOut":0,"to":"21","toIn":3},{"from":"113","fromOut":0,"to":"146","toIn":0},{"from":"113","fromOut":1,"to":"146","toIn":1}],"ai":{"s":"Fashion 摄影向 SDXL 双段采样工作流，主打照着参考照摆拍。一张参考照片同时喂两个预处理器：openpose 提取骨架、pidi 提取线稿，经两个 ControlNetApplyAdvanced 以 1.0 与 0.8 强度先后写进正负两路条件——骨架锁姿势、线稿锁轮廓，共用 SDXL union 一个控制网模型。提示词由两个 Primitive 提供原始文案，SDXLPromptStyler 套上 ads-fashion editorial 模板后，分别交给 CLIPTextEncodeSDXL（全局+局部双编码，供第一段）与 CLIPTextEncodeSDXLRefiner（ascore 6，供第二段），两段条件各走各的编码器是 SDXL 主模+精修模的标准做法。模型侧 zavychromaxl 底模串 LoRA 链：add-detail-xl 拉到 2 倍强度、extremely_detailed、FaeTastic 生效，另外三个风格 LoRA 旁路备用。第一段 20 步从 1544x1024 空白潜空间 denoise 1 生成，第二段换 dpmpp_sde 只做 denoise 0.4 精修，解码后 ImageSharpen 轻锐化出预览。","u":["照着一张实拍参考的姿势与轮廓生成时装大片：双 ControlNet 同时锁姿态和外形","广告编辑风格的时尚海报：换 SDXLPromptStyler 里的风格模板即可","成片细节不够：add-detail-xl 以 2 倍强度补质感，嫌过头可降回 1","启用旁路 LoRA 换风格：FluxStyle、art-full 等都在链上，点亮即用"],"d":2,"st":[{"name":"提示词与风格模板","desc":"Primitive 存原始文案，SDXLPromptStyler 套广告编辑模板后双路输出，分别经 SDXL 双编码器和 Refiner 编码器成条件，两段采样各用一套。","nodes":["65","66","144","6","19","76","77"]},{"name":"模型与 LoRA 链","desc":"底模先过激活的细节类 LoRA 再穿三个旁路的风格 LoRA 直通，链式结构让启用/停用只需开关单个节点；旁路的 CLIPSetLastLayer 同理。","nodes":["1","4","81","78","79","80","5","126"]},{"name":"双 ControlNet 约束","desc":"参考照分别提骨架与线稿，串联写进条件：openpose 强度 1 控姿态，pidi 0.8 控轮廓层次，保证生成的模特站姿和服装剪裁贴参考。","nodes":["106","107","145","115","113","146"]},{"name":"两段采样","desc":"1544x1024 空白潜空间先完整生成，再以 0.4 去噪用 dpmpp_sde 精修——构图第一段定，质感第二段补。","nodes":["140","21","75","72"]},{"name":"后处理与预览","desc":"轻度锐化收尾并预览，未直接挂保存节点，满意后手动接 SaveImage 或右键保存。","nodes":["124","73"]}],"p":"base 段 20 步、cfg 4.5、dpmpp_2m karras；精修段 denoise 0.4 控制翻新幅度，加大到 0.6 会偏离 ControlNet 构图；两路控制网强度 1.0/0.8，线稿感太重就把 pidi 降到 0.6；add-detail-xl 强度 2 远超常规 1，出图油腻就往回调。","n":"需安装 ControlNet-Aux 节点包并下载 union-sdxl-1.0 promax 控制网；6 个 LoRA 文件要齐，其中 detailxl、xl_more_art、aidmaFluxStyleXL 默认旁路；参考照人物姿态要清晰，否则 openpose 提取会失败；输出只有预览，没有 SaveImage。"}}