,"type":"CONDITIONING"},{"name":"model_opt","type":"MODEL"}],"widgets":["1","0","1",""],"brief":"高级 ControlNet 接入口，支持软权重与时间步关键帧","desc":""}],"links":[{"from":"5","fromOut":0,"to":"3","toIn":3},{"from":"4","fromOut":1,"to":"6","toIn":0},{"from":"10","fromOut":0,"to":"11","toIn":0},{"from":"10","fromOut":1,"to":"11","toIn":1},{"from":"11","fromOut":0,"to":"12","toIn":0},{"from":"10","fromOut":1,"to":"12","toIn":1},{"from":"12","fromOut":0,"to":"13","toIn":0},{"from":"10","fromOut":1,"to":"13","toIn":1},{"from":"13","fromOut":0,"to":"14","toIn":0},{"from":"10","fromOut":1,"to":"14","toIn":1},{"from":"4","fromOut":0,"to":"10","toIn":0},{"from":"16","fromOut":0,"to":"3","toIn":0},{"from":"14","fromOut":0,"to":"17","toIn":0},{"from":"17","fromOut":0,"to":"16","toIn":0},{"from":"18","fromOut":0,"to":"11","toIn":2},{"from":"19","fromOut":0,"to":"12","toIn":2},{"from":"20","fromOut":0,"to":"13","toIn":2},{"from":"21","fromOut":0,"to":"14","toIn":2},{"from":"22","fromOut":0,"to":"6","toIn":1},{"from":"23","fromOut":0,"to":"24","toIn":1},{"from":"4","fromOut":1,"to":"24","toIn":0},{"from":"8","fromOut":0,"to":"25","toIn":0},{"from":"16","fromOut":0,"to":"27","toIn":0},{"from":"6","fromOut":0,"to":"27","toIn":1},{"from":"24","fromOut":0,"to":"27","toIn":2},{"from":"36","fromOut":0,"to":"27","toIn":3},{"from":"3","fromOut":0,"to":"36","toIn":1},{"from":"27","fromOut":0,"to":"8","toIn":0},{"from":"37","fromOut":0,"to":"39","toIn":0},{"from":"39","fromOut":0,"to":"41","toIn":2},{"from":"38","fromOut":0,"to":"42","toIn":0},{"from":"42","fromOut":0,"to":"41","toIn":3},{"from":"6","fromOut":0,"to":"41","toIn":0},{"from":"24","fromOut":0,"to":"41","toIn":1},{"from":"41","fromOut":0,"to":"3","toIn":1},{"from":"41","fromOut":1,"to":"3","toIn":2},{"from":"42","fromOut":0,"to":"43","toIn":0},{"from":"48","fromOut":0,"to":"36","toIn":0},{"from":"48","fromOut":0,"to":"8","toIn":1}],"ai":{"s":"Envy 出品的画风迁移模板：把美国哥特式名画的构图搬进任意风格重画。两条参考线并行：构图线把原画经 XDoG 转成线稿，喂给 SDXL Union ControlNet（切到 scribble 模式）并对正负条件同时生效，锁定布局与笔势；风格线用 IPAdapter PLUS 从另一张风格参考图提取画风——Mad Scientist 版节点把 0-5 号浅层权重全部关掉、只留深层，专搬色彩笔触不搬内容，后接注意力扰动节点微调贴合度。提示词由两个带 wildcard 的 DPRandomGenerator 随机供给，抽卡即换题材。采样两段式：720x1024、12 步 dpmpp_sde 出图，latent 经 4x ESRGAN 放大 2 倍，再 4 步 0.5 去噪精修后保存。图中三个被旁路的 IPAdapterMS 各挂一张参考图，是多重风格叠加的备用槽，启用即混合多图风格。","u":["拿名画、照片或任意图片当构图底稿，换成自己想要的画风重绘","只搬画风不搬内容：深层 IPAdapter 权重法的标准参考示例","wildcard 抽卡批量换题材，构图和布局保持不变","生成后自动放大 2 倍再精修，直接产出高清成品"],"d":2,"st":[{"name":"风格参考装配","desc":"checkpoint 载入后接 IPAdapter：只启用 6 号之后的深层权重，从参考图提取色彩与笔触；注意力扰动节点在采样中微调风格贴合度，避免风格喧宾夺主。","nodes":["4","10","18","11","17"]},{"name":"构图锁定","desc":"参考画转黑白线稿后经 Union ControlNet 的 scribble 模式写进正负两路条件，让重绘严格沿用原画的构图轮廓。","nodes":["38","42","37","39","41"]},{"name":"随机提示词","desc":"两个带 wildcard 的随机文本源分别供正负词，全局种子控制器统一各节点种子，改词不改种子即可稳定换风格题材。","nodes":["22","23","6","24","26"]},{"name":"两段采样与放大","desc":"空白潜空间 12 步出图后，latent 用 ESRGAN 放大 2 倍，再低去噪 4 步精修细节，一段管构图一段管质感。","nodes":["5","3","36","27","48"]},{"name":"输出","desc":"解码后按日期归档保存，线稿预处理结果有独立预览方便核对构图锁定是否到位。","nodes":["8","25","43"]}],"p":"主采样 12 步、cfg 1.5 配 dpmpp_sde，Envy 星光系检查点低步低 CFG 即可；二采 denoise 0.5 控制放大后的细节重绘幅度；ControlNet strength 1 全程锁构图，想保留更多自由度降到 0.7 左右；IPAdapter weight 1 但只开深层，风格不够浓时提高 weight 或在层权重里放开浅层。","n":"需装 ComfyUI_IPAdapter_plus、Inspire Pack、ControlNet-Aux 三个节点包，并备好 SDXL Union ControlNet 与 IPAdapter PLUS 模型；三个被旁路的 IPAdapterMS 是额外风格参考槽，全部启用会叠加四张图的风格，注意会互相稀释。"}}