:"146","toIn":1},{"from":"53","fromOut":2,"to":"146","toIn":2},{"from":"120","fromOut":0,"to":"146","toIn":3},{"from":"53","fromOut":4,"to":"146","toIn":4},{"from":"146","fromOut":5,"to":"147","toIn":0},{"from":"117","fromOut":0,"to":"148","toIn":0},{"from":"124","fromOut":0,"to":"148","toIn":1},{"from":"5","fromOut":0,"to":"149","toIn":1},{"from":"53","fromOut":3,"to":"149","toIn":0},{"from":"148","fromOut":0,"to":"150","toIn":0},{"from":"150","fromOut":0,"to":"151","toIn":3},{"from":"53","fromOut":0,"to":"151","toIn":0},{"from":"53","fromOut":1,"to":"151","toIn":1},{"from":"53","fromOut":2,"to":"151","toIn":2},{"from":"53","fromOut":4,"to":"151","toIn":4},{"from":"151","fromOut":5,"to":"152","toIn":0},{"from":"164","fromOut":0,"to":"120","toIn":1},{"from":"165","fromOut":0,"to":"120","toIn":2},{"from":"164","fromOut":0,"to":"133","toIn":1},{"from":"165","fromOut":0,"to":"133","toIn":2},{"from":"164","fromOut":0,"to":"150","toIn":1},{"from":"165","fromOut":0,"to":"150","toIn":2},{"from":"155","fromOut":0,"to":"166","toIn":0},{"from":"166","fromOut":0,"to":"130","toIn":5},{"from":"166","fromOut":0,"to":"136","toIn":5},{"from":"166","fromOut":0,"to":"139","toIn":5},{"from":"166","fromOut":0,"to":"151","toIn":5},{"from":"166","fromOut":0,"to":"64","toIn":5},{"from":"166","fromOut":0,"to":"146","toIn":5},{"from":"168","fromOut":0,"to":"169","toIn":0},{"from":"169","fromOut":0,"to":"151","toIn":6},{"from":"169","fromOut":0,"to":"130","toIn":6},{"from":"169","fromOut":0,"to":"136","toIn":6},{"from":"169","fromOut":0,"to":"64","toIn":6},{"from":"169","fromOut":0,"to":"146","toIn":6},{"from":"172","fromOut":0,"to":"164","toIn":0},{"from":"173","fromOut":0,"to":"165","toIn":0},{"from":"149","fromOut":0,"to":"174","toIn":1},{"from":"117","fromOut":0,"to":"174","toIn":0},{"from":"174","fromOut":0,"to":"175","toIn":0},{"from":"164","fromOut":0,"to":"175","toIn":1},{"from":"165","fromOut":0,"to":"175","toIn":2},{"from":"175","fromOut":0,"to":"176","toIn":3},{"from":"176","fromOut":5,"to":"177","toIn":0},{"from":"53","fromOut":0,"to":"176","toIn":0},{"from":"53","fromOut":1,"to":"176","toIn":1},{"from":"53","fromOut":2,"to":"176","toIn":2},{"from":"53","fromOut":4,"to":"176","toIn":4},{"from":"169","fromOut":0,"to":"139","toIn":6},{"from":"4","fromOut":1,"to":"6","toIn":0},{"from":"53","fromOut":4,"to":"181","toIn":1},{"from":"53","fromOut":3,"to":"182","toIn":0},{"from":"182","fromOut":0,"to":"181","toIn":0},{"from":"181","fromOut":0,"to":"183","toIn":1},{"from":"117","fromOut":0,"to":"183","toIn":0},{"from":"183","fromOut":0,"to":"184","toIn":0},{"from":"164","fromOut":0,"to":"184","toIn":1},{"from":"165","fromOut":0,"to":"184","toIn":2},{"from":"53","fromOut":0,"to":"185","toIn":0},{"from":"53","fromOut":4,"to":"185","toIn":4},{"from":"53","fromOut":1,"to":"185","toIn":1},{"from":"53","fromOut":2,"to":"185","toIn":2},{"from":"169","fromOut":0,"to":"185","toIn":6},{"from":"166","fromOut":0,"to":"185","toIn":5},{"from":"184","fromOut":0,"to":"185","toIn":3},{"from":"185","fromOut":5,"to":"186","toIn":0},{"from":"169","fromOut":0,"to":"176","toIn":6},{"from":"166","fromOut":0,"to":"176","toIn":5}],"ai":{"s":"这是一条围绕 Latent Mirror 系列潜空间操控节点搭建的实验沙盒：作者 wuxiasuibianai515 用 Illustrious 系底模 illuspony_v10 加 neptuniaXLVAE_contrastColors 对比色 VAE，先在 896 见方空潜空间上以 30 步、CFG 5.5、dpmpp_2m 加 karras 采出第一张底图，随后把同一块底图潜空间同时铺开七条并行支路，分别做水平或垂直镜像（强度 0.15 至 0.3）、潜空间位移（0.15 与 0.3 组合）、双镜像按比例插值、以及 LatentInterpolateTransform 加 TransformHijack 的变换劫持，每条支路统一经 LatentUpscale 双线性放大后送入各自的 KSampler Adv. (Efficient) 做二遍细化重采样，最后由九个 SaveImage 分支落盘，让镜像、移位、插值、劫持各种组合对构图的影响一次看全。设计核心有两点：一是利用效率采样器的 MODEL、正负 CONDITIONING、VAE 直通输出口，把第一遍采样的全套上下文分发给下游所有采样器，省去重复接线；二是把统一的 CFG 5.5（StaticNumberFloat 155）与 steps 30（StaticNumberInt 168）经 Reroute 广播到每条支路，调参只动两个数值节点。作者的注释直白标注了哪些组合会出奇怪或万花筒式图像、哪些会出伪影——暴露这些失真正是沙盒的目的，作者也欢迎在此基础上继续改进。","u":["横向对比镜像、移位、插值、变换劫持四类潜空间操控对构图的扭曲规律，为对称构图或万花筒效果挑选合适的操控组合与强度。","学习 Efficiency-Nodes 多支路共享参数的接线范式：看直通输出的 MODEL、CONDITIONING、VAE 如何一次喂饱九台采样器并用 Reroute 统一 CFG 与步数。","以 Illustrious 或 Pony 系底模生成 896 方形草图后，用潜空间放大加二次采样批量产出多种构图变体，作为选图与创意发散的前置工序。"],"d":2,"st":[{"name":"底模装载与第一遍基础采样","desc":"CheckpointLoaderSimple 载 illuspony_v10 拆出 MODEL 与 CLIP，VAELoader 单独载入对比色 VAE 覆盖底模自带解码器；正负提示词经 Reroute 汇聚后，EmptyLatentImage 896 方形进入 KSampler Adv. (Efficient) 53 采出底图，其 IMAGE 直存一份、MODEL 等四路输出广播给全部支路。","nodes":["4","121","6","7","5","26","27","143","144","118","53","137"]},{"name":"镜像移位插值与变换劫持变体","desc":"底图潜空间分七路做变体：LatentShift 0.15/0.3 位移后接垂直 0.3 或水平 0.15/0.3 镜像，LatentInterpolate 以权重 1 混接两路镜像，LatentInterpolateTransform 把操控记录成 TRANSFORM 再经 TransformHijack 叠加回放大潜空间，尝试把镜像构图拉回原位。","nodes":["128","182","117","124","149","181","123","148","174","183","134","140","135","141"]},{"name":"潜空间放大与二次细化采样","desc":"五种变体各接一台 LatentUpscale（bilinear，宽高由输入端口而非面板默认值决定），放大后的潜空间进入七台 KSampler Adv. (Efficient) 二遍重采样，采样器分别在 euler_ancestral 加 sgm_uniform 与 dpmpp_2m 加 karras 等调度间切换，用于对照不同 scheduler 对操控痕迹的修复程度。","nodes":["120","133","150","175","184","64","130","136","139","146","151","176","185"]},{"name":"统一数值控制与九路落盘","desc":"StaticNumberInt 172、173 提供 896 宽高，168 提供 steps 30，StaticNumberFloat 155 提供 CFG 5.5，经 Reroute 广播全部支路；九个 SaveImage 分别落盘底图与各变体。带静音标记的 768x1280 竖版预设未接任何端口，属闲置留件。","nodes":["172","173","164","165","155","166","168","169","157","158","125","132","138","142","147","152","177","186"]}],"p":"全局共享参数只有四个源头：172 与 173 的宽高当前均为 896，改大则全部二遍采样同步变贵；155 的 CFG 5.5 与 168 的 steps 30 经 Reroute 分发到每台二遍采样器，整箱调参只动这两处。注意 LatentUpscale 面板上显示的 920x1616 是残留默认值，实际尺寸由输入端口决定，别被面板误导。LatentInterpolate 权重目前全为 1，即纯取 samples2 一路，想真正混入镜像前的原始潜空间需把权重调回 0 到 1 之间。镜像强度分布在各 LatentMirror 面板（垂直 0.3，水平 0.15 与 0.3），调低强度可减轻拼接痕迹。竖版实验可拆下 157、158 的 768x1280 预设替换 172、173。","t":["LatentMirror、LatentShift、LatentInterpolateTransform、TransformHijack 均来自 Latent Mirror 自定义节点包，缺包时图上会出现大片红色缺失节点；KSampler Adv. (Efficient) 还需 Efficiency-Nodes，两者缺一不可。","所有下游支路吃的都是第一遍效率采样器的 MODEL、CONDITIONING、VAE 直通输出口，若把 53 换成普通 KSampler，这些输出口不存在，整张图会断线，改动必须保留效率节点结构。","名为 Width 768 与 Height 1280 的两个数值节点标题带静音标记且没有任何连线，它们是遗留预设而非生效配置，误以为竖版尺寸在起作用会得出错误结论。","对比色 VAE neptuniaXLVAE_contrastColors 与 Illustrious 系底模绑定，换底模时请同步换回该底模自带或匹配的 VAE，否则整体色偏会让九路对比失去意义。","图以 UI 格式存档且无 mute 或 bypass 字段，支路是否停用只能看标题标记与连线状态，自行增删支路后建议整箱重跑一遍再比较。"],"n":"依赖两个自定义节点包：Latent Mirror 包（镜像、移位、插值、变换劫持节点）与 Efficiency-Nodes（KSampler Adv. Efficient）；模型需 illuspony_v10.safetensors（Illustrious 或 Pony 系底模）与 neptuniaXLVAE_contrastColors.safetensors 专用 VAE 两个文件。一次运行产出九张图，注意输出目录磁盘与等待时间；底模与 VAE 文件名以 CivitAI 原页或作者说明为准，仓库不托管模型下载。","na":{"4":{"brief":"底模三路分发","detail":"CheckpointLoaderSimple 载入 illuspony_v10.safetensors，MODEL 与 CLIP 经 Reroute 广播到全部采样器与两路提示词编码。"},"53":{"brief":"首遍母采样器","detail":"KSampler Adv. (Efficient) 以 30 步 CFG 5.5、dpmpp_2m 加 karras 采出底图，并向下游广播 MODEL、正负条件、VAE、LATENT 全套输出。"},"64":{"brief":"对照调度采样","detail":"euler_ancestral 加 sgm_uniform 二遍采样放大后的混排潜空间，与 146 的 dpmpp_2m 加 karras 形成同料不同调度的对照。"},"117":{"brief":"垂直镜像主力","detail":"LatentMirror 垂直方向强度 0.3，可选接 VAE 辅助回译，是四个支路共用的镜像源，其输出被多个插值节点复用。"},"118":{"brief":"896 空潜画布","detail":"EmptyLatentImage 生成 896x896 批量 1 的空白潜空间，是整箱七个变体支路共同的底图起点。"},"120":{"brief":"共用放大实例","detail":"LatentUpscale bilinear，宽高来自 Reroute 广播的 896，123 插值结果经它放大后同时喂 64 与 146 两台采样器。"},"121":{"brief":"对比色专用 VAE","detail":"单独载入 neptuniaXLVAE_contrastColors.safetensors 顶替底模自带 VAE，其输出经 Reroute 供镜像节点与首采样器使用。"},"123":{"brief":"镜像两路插值","detail":"LatentInterpolate 权重 1，接收 117 与 124 两路镜像，当前等于纯取水平镜像一路，放大后进 64 采样。"},"124":{"brief":"水平弱镜像路","detail":"水平镜像强度 0.15，接在位移之后，与 117 一起喂给插值与变换劫持支路，弱强度使痕迹更含蓄。"},"128":{"brief":"底图潜空间位移","detail":"LatentShift 以 0.15 与 0.3 的偏移量平移底图潜空间内容，随后接水平或垂直镜像，制造错位拼接的变体。"},"134":{"brief":"原始潜空间变换记录","detail":"LatentInterpolateTransform 参数 0、1、0.25、1，把首采样器原始潜空间记成 TRANSFORM，供劫持节点还原构图。"},"135":{"brief":"变换劫持还原","detail":"TransformHijack 把 134 记录的变换叠加回放大后的镜像潜空间，尝试让二次采样在还原构图上进行，注释提示仍可能出怪图。"},"140":{"brief":"镜像潜空间变换记录","detail":"对水平镜像支路（124 输出）记录同样参数的 TRANSFORM，与 134 形成原始对镜像的劫持对照。"},"141":{"brief":"第二条劫持支路","detail":"接收 140 的 TRANSFORM 与同一份放大潜空间，对应镜像源不同的另一条劫持实验，结果由 139 采样后落盘。"},"143":{"brief":"负向提示词编码","detail":"CLIP Text Encode 写入 lowres、bad anatomy、text、blurry 等排除词（截断），经 Reroute 26 分发给全部支路的 negative 端口。"},"144":{"brief":"正向提示词编码","detail":"写入 masterpiece、best quality、ultra detailed 等质量词（存档截断），与负向一起经 Reroute 27 构成全箱统一的语义约束。"},"148":{"brief":"同对另一插值","detail":"同样取 117 与 124 两路、权重 1 的插值实例，但输出走 150 放大与 151 采样，形成与 123 支路的调度对照。"},"149":{"brief":"无位移水平镜像","detail":"直接对底图潜空间做水平 0.3 镜像（不经 LatentShift），与 117 组合进 174 插值，用于对照位移环节的贡献。"},"155":{"brief":"全箱 CFG 源头","detail":"StaticNumberFloat 固定 5.5，经 Reroute 166 分发到所有二遍采样器的 cfg 输入端。"},"168":{"brief":"全箱步数源头","detail":"StaticNumberInt 固定 30，经 Reroute 169 覆盖除首采样器外全部采样器的 steps，改一处即整箱生效。"},"174":{"brief":"垂直配直镜插值","detail":"混合 117 垂直镜像与 149 未经位移的水平镜像，检验位移与否对插值结果的影响。"},"181":{"brief":"二遍链尾镜像","detail":"水平 0.3 镜像，VAE 取自首采样器直通输出而非独立 VAE 支路，接在 182 位移之后构成第七条变体。"},"182":{"brief":"第二组位移节点","detail":"LatentShift 0.15 与 0.3，与 128 参数相同但独立实例，专供 181 镜像支路，方便单独改动不影响其他支路。"},"183":{"brief":"跨支链插值混合","detail":"混合 117 与 181 两路镜像结果，其中 181 挂在第二组位移与效率采样器 VAE 上，是变体最全的一条插值。"}}}}