":"52","fromOut":0,"to":"56","toIn":1},{"from":"52","fromOut":1,"to":"56","toIn":2},{"from":"47","fromOut":2,"to":"58","toIn":1},{"from":"60","fromOut":0,"to":"58","toIn":2},{"from":"62","fromOut":0,"to":"59","toIn":0},{"from":"76","fromOut":0,"to":"59","toIn":1},{"from":"59","fromOut":0,"to":"60","toIn":0},{"from":"77","fromOut":0,"to":"62","toIn":0},{"from":"77","fromOut":1,"to":"62","toIn":1},{"from":"71","fromOut":0,"to":"63","toIn":0},{"from":"52","fromOut":2,"to":"64","toIn":0},{"from":"78","fromOut":0,"to":"64","toIn":1},{"from":"69","fromOut":0,"to":"65","toIn":0},{"from":"65","fromOut":0,"to":"66","toIn":0},{"from":"75","fromOut":0,"to":"67","toIn":0},{"from":"75","fromOut":0,"to":"68","toIn":0},{"from":"47","fromOut":0,"to":"69","toIn":0},{"from":"57","fromOut":0,"to":"70","toIn":0},{"from":"53","fromOut":0,"to":"71","toIn":0},{"from":"56","fromOut":0,"to":"71","toIn":1},{"from":"50","fromOut":0,"to":"71","toIn":2},{"from":"61","fromOut":0,"to":"71","toIn":3},{"from":"64","fromOut":0,"to":"71","toIn":4},{"from":"73","fromOut":2,"to":"72","toIn":0},{"from":"47","fromOut":2,"to":"72","toIn":1},{"from":"52","fromOut":0,"to":"73","toIn":0},{"from":"52","fromOut":1,"to":"73","toIn":1},{"from":"63","fromOut":0,"to":"73","toIn":2},{"from":"46","fromOut":0,"to":"78","toIn":0},{"from":"76","fromOut":0,"to":"78","toIn":1},{"from":"82","fromOut":0,"to":"78","toIn":2},{"from":"82","fromOut":0,"to":"79","toIn":3},{"from":"72","fromOut":0,"to":"80","toIn":0},{"from":"82","fromOut":1,"to":"80","toIn":4},{"from":"81","fromOut":0,"to":"82","toIn":0},{"from":"83","fromOut":0,"to":"52","toIn":4},{"from":"83","fromOut":0,"to":"57","toIn":0},{"from":"83","fromOut":0,"to":"58","toIn":0},{"from":"83","fromOut":0,"to":"76","toIn":0},{"from":"83","fromOut":0,"to":"77","toIn":0},{"from":"79","fromOut":0,"to":"83","toIn":0},{"from":"66","fromOut":0,"to":"56","toIn":0},{"from":"79","fromOut":2,"to":"80","toIn":1},{"from":"84","fromOut":0,"to":"83","toIn":3}],"ai":{"s":"LTX 2.3 视频修复增强工作流（IC Edit）。VHS 载入视频后按 2MP 像素预算重排分辨率，帧率统一 24。核心思路是把原视频当待重绘的底：白图按帧数批量复制转成全幅遮罩，VAEEncodeForInpaint 把原视频编成带全遮罩的潜空间；另一路抽首帧经 LTXVPreprocess 做 img2video 条件，LTXAddVideoICLoRAGuide 再把缩放后的原视频帧作为 IC 引导写进条件——模型等于看着原视频逐帧重画一遍，实现修复加高清化。模型侧串挂 ic-video-upscale-general 与 video-upscale-v2 两个 IC LoRA 加 SageAttention 补丁，CFG 1 配 5 步 ManualSigmas 是蒸馏模型的快速接法。LTX 2.3 是视听一体模型：采样前视频潜空间要与空音频潜空间 Concat 成 AV 潜空间，出样后再 Separate、CropGuides 摘掉引导 token，平铺解码后回 VHS 合成并保留原视频音频。","u":["老视频或低清素材的高清化修复：原片当引导整片重绘，输出保留原声","AI 生成视频的二次增强，消除模糊、过饱和与像素感","按 2MP 像素预算自动适配输出分辨率，兼顾清晰度与显存","给实拍素材做风格级重绘，靠正向词描述目标观感"],"d":3,"st":[{"name":"视频输入与尺寸预算","desc":"载入视频并统一到 24fps，按总像素预算缩放每帧，同时数出帧数供后续批量复制与音频潜空间对齐。","nodes":["79","83","84","77","76","82","81"]},{"name":"引导与待重绘潜空间","desc":"白图复制成帧转全幅遮罩，原视频被编码成待重绘潜空间；抽首帧做 img2video 条件，IC 引导节点把缩放后的原片帧写进条件与潜空间，让模型照着重画。","nodes":["62","59","60","58","57","70","55","52"]},{"name":"模型与条件","desc":"LTX 2.3 主干串挂两个视频增强 IC LoRA 并打 SageAttention 补丁，Gemma 文本编码器编好正负词后由 LTXVConditioning 注入帧率，CFG 1 锁定蒸馏用法。","nodes":["47","75","67","68","48","69","65","66","56"]},{"name":"采样与 AV 潜空间拼装","desc":"固定种子噪声、euler_ancestral 与 5 步手工 sigma 走 SamplerCustomAdvanced；因为 LTX 2.3 视听一体，采样前要把空音频潜空间与视频潜空间拼成 AV 潜空间。","nodes":["46","78","53","54","61","50","71","64"]},{"name":"拆分解码与合成","desc":"出样后拆开 AV 潜空间、裁掉 IC 引导 token 才能正常解码，平铺解码省显存，最后 VHS 合成视频并接回原音频。","nodes":["63","73","72","80"]}],"p":"ManualSigmas 只给 5 步（1.0 递减到 0），配合 CFG 1 是蒸馏模型设定，加步数收益很低；image_scale_pixel_v2 的总像素 2（百万像素）直接决定输出分辨率与显存占用，显存紧就降到 1.5；两个 IC LoRA 强度保持 1，低于 0.8 会丢引导一致性。","n":"LTX-2.3 22B 主干加 Gemma 3 12B 文本编码器加两个 IC LoRA，显存需求高，建议 24GB 以上并确认 SageAttention 可用；音频 VAE 也需随包就位。51 号 ManualSigmas 被旁路，是作者留的更密采样调度，想要更慢更稳的采样可启用换掉 61 号。"}}