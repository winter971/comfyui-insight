"type":"CONDITIONING"}],"widgets":["1","0","0.9"],"brief":"ControlNet 标准接法：正/负条件分别融合控制网，v/union 控制网可指定作用端口。","desc":""},{"id":"377","title":"SaveImage","type":"SaveImage","cat":"image","x":5777,"y":-1223,"inputs":[{"name":"images","type":"IMAGE"}],"outputs":[],"widgets":["ComfyUI - Pass 2"],"brief":"把图像保存到 output 目录。","desc":""},{"id":"215","title":"Negative Prompt 1","type":"String Literal","cat":"util","x":2180,"y":-635,"inputs":[],"outputs":[{"name":"STRING","type":"STRING"}],"widgets":["monochrome, greyscale, watermark, 3d, bad han…"],"brief":"社区自定义节点（String Literal），具体用法见其项目文档。","desc":""},{"id":"216","title":"Negative Prompt 2","type":"String Literal","cat":"util","x":2178,"y":-365,"inputs":[],"outputs":[{"name":"STRING","type":"STRING"}],"widgets":["monochrome, greyscale, watermark, 3d, bad han…"],"brief":"社区自定义节点（String Literal），具体用法见其项目文档。","desc":""},{"id":"426","title":"💊  LoRA Stack","type":"CR LoRA Stack","cat":"util","x":1387,"y":-1215,"inputs":[],"outputs":[{"name":"LORA_STACK","type":"LORA_STACK"},{"name":"show_help","type":"STRING"}],"widgets":["Off","None","1","1","Off","None","1","1","Off","None"],"brief":"Comfyroll：堆叠 LoRA。","desc":""},{"id":"412","title":"💊  LoRA Stack","type":"CR LoRA Stack","cat":"util","x":1749,"y":-1214,"inputs":[{"name":"lora_stack","type":"LORA_STACK"}],"outputs":[{"name":"LORA_STACK","type":"LORA_STACK"},{"name":"show_help","type":"STRING"}],"widgets":["Off","None","1","1","Off","None","1","1","Off","None"],"brief":"Comfyroll：堆叠 LoRA。","desc":""},{"id":"226","title":"Positive (Condition D)","type":"String Literal","cat":"util","x":2175,"y":-1077,"inputs":[],"outputs":[{"name":"STRING","type":"STRING"}],"widgets":["score_9, score_8_up, score_7_up, score_6_up, …"],"brief":"社区自定义节点（String Literal），具体用法见其项目文档。","desc":""},{"id":"227","title":"Positive (Condition C)","type":"String Literal","cat":"util","x":2176,"y":-1325,"inputs":[],"outputs":[{"name":"STRING","type":"STRING"}],"widgets":["score_9, score_8_up, score_7_up, sco