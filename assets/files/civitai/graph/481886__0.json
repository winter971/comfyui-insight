oIn":0},{"from":"383","fromOut":0,"to":"202","toIn":2},{"from":"380","fromOut":0,"to":"383","toIn":0},{"from":"384","fromOut":0,"to":"376","toIn":1},{"from":"381","fromOut":0,"to":"384","toIn":0},{"from":"385","fromOut":0,"to":"202","toIn":0},{"from":"208","fromOut":0,"to":"385","toIn":0},{"from":"386","fromOut":0,"to":"210","toIn":0},{"from":"386","fromOut":0,"to":"213","toIn":0},{"from":"386","fromOut":0,"to":"202","toIn":1},{"from":"386","fromOut":0,"to":"195","toIn":0},{"from":"208","fromOut":1,"to":"386","toIn":0},{"from":"387","fromOut":0,"to":"293","toIn":0},{"from":"387","fromOut":0,"to":"336","toIn":0},{"from":"202","fromOut":0,"to":"387","toIn":0},{"from":"293","fromOut":0,"to":"370","toIn":0},{"from":"293","fromOut":0,"to":"388","toIn":0},{"from":"388","fromOut":0,"to":"344","toIn":1},{"from":"373","fromOut":0,"to":"344","toIn":0},{"from":"391","fromOut":0,"to":"392","toIn":0},{"from":"60","fromOut":0,"to":"395","toIn":0},{"from":"395","fromOut":0,"to":"338","toIn":0},{"from":"237","fromOut":1,"to":"382","toIn":0},{"from":"206","fromOut":0,"to":"380","toIn":0},{"from":"311","fromOut":1,"to":"407","toIn":0},{"from":"311","fromOut":1,"to":"408","toIn":0},{"from":"391","fromOut":0,"to":"377","toIn":0},{"from":"311","fromOut":2,"to":"408","toIn":1},{"from":"412","fromOut":0,"to":"208","toIn":2},{"from":"414","fromOut":0,"to":"418","toIn":2},{"from":"408","fromOut":0,"to":"418","toIn":3},{"from":"421","fromOut":0,"to":"424","toIn":0},{"from":"421","fromOut":2,"to":"424","toIn":4},{"from":"407","fromOut":0,"to":"424","toIn":3},{"from":"424","fromOut":5,"to":"391","toIn":0},{"from":"311","fromOut":0,"to":"421","toIn":0},{"from":"421","fromOut":3,"to":"418","toIn":0},{"from":"421","fromOut":4,"to":"418","toIn":1},{"from":"418","fromOut":0,"to":"424","toIn":1},{"from":"418","fromOut":1,"to":"424","toIn":2},{"from":"426","fromOut":0,"to":"412","toIn":0},{"from":"427","fromOut":0,"to":"225","toIn":2},{"from":"336","fromOut":3,"to":"344","toIn":4},{"from":"392","fromOut":0,"to":"394","toIn":0},{"from":"395","fromOut":0,"to":"394","toIn":1},{"from":"408","fromOut":0,"to":"429","toIn":0},{"from":"391","fromOut":0,"to":"429","toIn":1},{"from":"190","fromOut":0,"to":"443","toIn":1},{"from":"391","fromOut":0,"to":"443","toIn":0},{"from":"443","fromOut":0,"to":"352","toIn":1}],"ai":{"s":"本工作流是作者 Sayori_Kurchatov 针对 SDXL 架构代表作 Pony Diffusion V6 打造的出版级高画质精修与平铺放大管线。架构采用模块化 Basic Pipe 管道解包设计，在采样主干中创造性地引入 Self-Attention Guidance (SAG 自注意力引导) 算子，通过 U-Net 自注意力热力图增强主体对比度与边缘锐度，有效规避了 Pony 模型常见的高饱和过曝与肢体崩坏；后段摒弃了生硬的简单插值，而是构建了“4x 模型超分 -> 像素等比规整 -> 双段 UltimateSDUpscaleNoUpscale 平铺重绘 -> 物理锐化滤镜”的级联高清修复链路，在受限显存下输出细节丰富、质感细腻的 4K 级二次元与超写实融合大作。","u":["Pony V6 大底模下二次元角色、动漫插画与 2.5D 写实人像的超高分辨率（2K~4K）精细化出图。","受限显存（8GB~12GB）环境下突破物理分辨率上限，进行大画幅壁纸、同人本印刷级海报的无损高清平铺放大。","消除 Pony 基础出图的塑料平涂感，以二次平铺重绘注入复杂的发丝纤维、皮肤微纹理与织物暗纹质感。"],"d":2,"st":[{"name":"基础管道解包与自注意力引导注入","desc":"利用 FromBasicPipe (336) 一键解包主干网络传输的 Pony 基础大模型、CLIP 条件特征与 VAE 实例；通过注入 SelfAttentionGuidance (388) 提取 U-Net 内部自注意力图谱实施动态引导增益，在抑制二次元高饱和过曝伪影的同时强化人物轮廓；同时通过 UltralyticsDetectorProvider (334) 载入 YOLO 目标检测模型，为后续潜在的面部与解剖结构定位提供感知底座。","nodes":["336","388","334"]},{"name":"神经模型物理超分辨率放大与像素重构","desc":"通过 UpscaleModelLoader (353) 加载 4x 经典超分模型（如 4x-UltraSharp），配合 ImageUpscaleWithModel (352) 将初阶段图像进行高倍物理像素上采样；经由 PreviewImage (354) 进行阶段画质核验后，利用 ImageScaleToTotalPixels (355) 根据预设总像素阈值等比精确收拢画幅，为分块平铺重绘建立规整的像素网格。","nodes":["353","352","354","355"]},{"name":"双级平铺分块重绘与微观纹理精修","desc":"核心高清修复阶段。连续采用两级 UltimateSDUpscaleNoUpscale (367 / 371) 算子执行分块平铺（Tiled Diffusion）重绘。在不改变外部已放大像素比例的前提下，以低去噪幅度（Denoise 0.25~0.35）驱动 Pony 模型对各局部切片进行二次扩散去噪，在保留宏观构图的同时，彻底攻克大图显存暴涨瓶颈，海量注入发丝微结构与服装材质细节。","nodes":["367","371"]},{"name":"边缘清晰度锐化与最终超清预览","desc":"图像后处理交付阶段。利用 ImageSharpen (60) 算子对经过多轮平铺重绘后的画面施加微观边缘锐化，彻底消除 VAE 解码与平铺接缝处残存的轻微灰雾与模糊感；最终通过 PreviewImage (368) 呈现分辨率高达 4K 级别的出版级超清二次元/写实混合视觉大作。","nodes":["60","368"]}],"p":"SAG 自注意力引导强度建议控制在 scale 0.5~0.75，blur_sigma 建议 2.0，避免强度过高引发边缘生硬暗影；模型超分推荐选用 4x-UltraSharp 或 4x_NMKD-Superscale；ImageScaleToTotalPixels 推荐将总像素限制在 4,000,000~8,000,000 像素之间（对应 2K~4K 级画幅）；UltimateSDUpscaleNoUpscale 分块尺寸建议设为 1024x1024，重叠边缘（Padding）设为 32~64 像素；重绘去噪幅度（Denoise）第一级（367）设为 0.3~0.35，第二级精雕（371）设为 0.15~0.25；ImageSharpen 锐化强度设为 0.15~0.30 即可。","t":["【UltimateSDUpscaleNoUpscale 模式辨析】该工作流使用的是“NoUpscale”版本的平铺节点，其前提必须是由前置的 ImageUpscaleWithModel (352) 与 ImageScaleToTotalPixels (355) 已经完成像素物理放大；若直接给其输入未放大的原图，该节点仅会执行原分辨率下的切片平铺重绘，无法起到倍率放大效果。","【SAG 与 Pony 基础 CFG 的反向制衡】Pony 模型在常规出图中容易因高 CFG（如超过 8）产生色阶断层与肢体抽搐。启用 SAG (388) 后，模型自身引导力显著增强，建议将主采样器的 CFG 适当回调至 5.0~6.5，利用 SAG 提升对比度与主体结构，既能获得极佳立体感又可规避画面焦糊。","【平铺重叠接缝模糊规避】分块重绘节点在拼接处容易因去噪步数不同产生接缝接痕，务必保证 Tile Width/Height 为 1024（匹配 SDXL 原生分辨率），并将 Mask Blur 设置为 8~16 像素，最后由 ImageSharpen 节点统一拉伸局部反差，彻底消除接缝灰雾。"],"n":"运行本工作流需要提前部署 Pony Diffusion V6 系列 SDXL Checkpoint 大模型、4x 级超分辨率模型（放置于 models/upscale_models 目录）以及 Ultralytics YOLO 检测权重（models/ultralytics）。必须通过 ComfyUI Manager 安装 ComfyUI-Impact-Pack、ComfyUI_UltimateSDUpscale 以及 ComfyUI-Post-Processing-Nodes 等必要扩展。全流程包含双级平铺重绘，显存推荐 12GB 以上，8GB 显存设备在分块重绘时请将 Tile 尺寸维持在 1024 并在系统开启换页虚拟内存以防 OOM。","na":{"60":{"brief":"边缘微观锐化滤镜","detail":"对多轮重绘后的最终大图应用轻量级反遮罩锐化（Unsharp Mask），消除 VAE 往返编解码产生的局部肉感与灰雾感。"},"334":{"brief":"Ultralytics 目标检测模型加载器","detail":"加载 YOLO 系列目标检测权重（如 bbox/segm），为可能级联的面部、手部局部检测与潜在修手修脸流程提供底层模型支撑。"},"336":{"brief":"基础管道解包节点","detail":"源自 Impact Pack，用于一键解包包含 MODEL、CLIP、VAE 及正负提示词条件的综合管道（Basic Pipe），保持全图布线整洁高效。"},"352":{"brief":"物理模型超分辨率放大器","detail":"调用加载的 4x 神经网络模型对初阶段生成的图像进行物理像素点阵扩展，重构清晰平滑的高倍基础像素画幅。"},"353":{"brief":"超分辨率模型加载器","detail":"从 models/upscale_models 加载高质量超分神经网络权重（如 4x-UltraSharp），为物理级像素放大提供先验知识库。"},"354":{"brief":"初阶段物理超分画质预览","detail":"用于实时预览第一阶段模型物理超分后的边缘状态，便于创作者核验基础画质是否具备平铺重绘价值。"},"355":{"brief":"画幅总像素等比缩放控制器","detail":"在模型超分后根据目标总像素值（如 400 万至 800 万像素）精确约束图像长宽尺寸，保持原始宽高比的同时规避分辨率失控。"},"367":{"brief":"第一级分块平铺二次重绘器","detail":"采用 Ultimate SD Upscale 算子在无需二次放大的前提下，以 1024 分块和低 Denoise 对超分大图进行切片去噪重绘，注入深层细节。"},"368":{"brief":"终阶段 4K 超清大图预览","detail":"直观展示全流程平铺二次重绘与微观锐化后的最终成片，支持高倍放大审视发丝与微观纹理细节。"},"371":{"brief":"第二级分块平铺微观精雕器","detail":"级联在第一级重绘之后，采用更低的重绘幅度进一步抚平平铺接缝并精雕发丝微光与衣物材质，完成出版级细节升华。"},"388":{"brief":"自注意力引导增强器（SAG）","detail":"直接作用于 Pony 模型的 U-Net 主干，通过分析注意力自相似矩阵提取前景主体显著性，在不产生高 CFG 色彩畸变的前提下强化角色边缘与立体轮廓。"}}}}