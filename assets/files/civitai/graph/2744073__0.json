fromOut":0,"to":"104","toIn":0},{"from":"104","fromOut":0,"to":"65","toIn":0},{"from":"8","fromOut":1,"to":"7","toIn":0},{"from":"155","fromOut":0,"to":"158","toIn":1},{"from":"8","fromOut":0,"to":"158","toIn":2},{"from":"4","fromOut":0,"to":"158","toIn":3},{"from":"156","fromOut":0,"to":"158","toIn":4},{"from":"158","fromOut":0,"to":"157","toIn":0},{"from":"158","fromOut":1,"to":"80","toIn":1},{"from":"63","fromOut":0,"to":"158","toIn":0},{"from":"135","fromOut":0,"to":"185","toIn":1},{"from":"185","fromOut":0,"to":"208","toIn":0},{"from":"208","fromOut":0,"to":"213","toIn":1},{"from":"185","fromOut":0,"to":"213","toIn":0},{"from":"208","fromOut":0,"to":"214","toIn":0},{"from":"84","fromOut":0,"to":"138","toIn":0},{"from":"185","fromOut":0,"to":"92","toIn":1},{"from":"208","fromOut":0,"to":"122","toIn":0},{"from":"226","fromOut":0,"to":"222","toIn":1},{"from":"222","fromOut":0,"to":"227","toIn":0},{"from":"208","fromOut":0,"to":"222","toIn":0},{"from":"7","fromOut":0,"to":"236","toIn":0},{"from":"236","fromOut":0,"to":"80","toIn":3},{"from":"8","fromOut":0,"to":"237","toIn":0},{"from":"7","fromOut":0,"to":"237","toIn":1},{"from":"236","fromOut":0,"to":"237","toIn":2},{"from":"39","fromOut":0,"to":"237","toIn":3},{"from":"4","fromOut":0,"to":"237","toIn":4},{"from":"240","fromOut":0,"to":"185","toIn":0},{"from":"237","fromOut":1,"to":"240","toIn":1},{"from":"237","fromOut":1,"to":"102","toIn":0},{"from":"237","fromOut":1,"to":"138","toIn":1},{"from":"8","fromOut":0,"to":"247","toIn":0},{"from":"7","fromOut":0,"to":"247","toIn":1},{"from":"236","fromOut":0,"to":"247","toIn":2},{"from":"65","fromOut":0,"to":"247","toIn":3},{"from":"83","fromOut":0,"to":"247","toIn":4},{"from":"4","fromOut":0,"to":"247","toIn":5},{"from":"36","fromOut":0,"to":"247","toIn":6},{"from":"27","fromOut":0,"to":"247","toIn":7},{"from":"247","fromOut":0,"to":"84","toIn":1}],"ai":{"s":"Z-Image Turbo 系多段精修工作流：首传出图、放大二传、后处理三段，用分组开关与滑条拼装。ResolutionMaster 按参考图算出目标分辨率喂给空白潜空间，GUID 封装的采样节点按种子与批量滑条跑文生图首传；ControlNet 支线内置 DW 预处理、默认旁路，启用后锁定姿态结构。首传图按 Upscale by 滑条放大 1.5 倍，经第二个 img2img 采样器精修细节后对比验收。后处理为锐化滑条、AutoTone 影调与 CineStill LUT 三道可选工序（后两者默认旁路），按 ZIT_ComfyUI 前缀保存。另有静音的 i2i 备选首传：参考图缩放编码后按 denoise 滑条重绘，用 Fast Groups Muter 切换。模型侧 Qwen3-4B 编码器走 lumina2 接法、负向清零，七个 LoRA 槽位默认全关。","u":["一套节点从文生图到成品：首传抽卡、放大精修、锐化调色分组按需开关","时尚/编辑类人像出图：启用 ControlNet 支线用参考图锁定姿态与构图","以自己的照片为底重绘：切到 i2i 备选模式，denoise 滑条控制改动幅度","批量抽卡选片：Batch size 滑条一次出多张，配对比器挑图"],"d":3,"st":[{"name":"模型与提示词","desc":"Z-Image Turbo 系 bf16 底模加载，Qwen3-4B 编码器按 lumina2 方式接入；负向由 ConditioningZeroOut 清零，LoRA 接线板七个槽位默认全关备用。","nodes":["5","2","4","8","7","236"]},{"name":"分辨率与首传采样","desc":"ResolutionMaster 从参考图读出目标宽高喂给空白潜空间，首传采样节点按种子与批量滑条一次生成，结果经 Any Switch 输出预览。","nodes":["63","99","10","36","27","80","84","34"]},{"name":"ControlNet 支线（默认旁路）","desc":"启用后参考图先过选定的预处理器（当前 DW），控制网按滑条强度写进首传模型，用真实照片锁姿态与结构。","nodes":["155","156","158","157"]},{"name":"放大精修第二传","desc":"首传图按 Upscale by 滑条放大 1.5 倍，交给 img2img 封装采样器重修细节，并与首传在对比器里左右验收。","nodes":["87","39","237","102","138"]},{"name":"i2i 备选首传（默认静音）","desc":"参考图缩放到目标分辨率后编码进潜空间，静音采样器按 denoise 滑条在原图上重绘，作为文生图首传的替代路线。","nodes":["104","65","83","247","88"]},{"name":"后处理与输出","desc":"锐化滑条（0 为关）、AutoTone 自动影调与 CineStill LUT 三道工序可选，分组开关控制启停，最终预览并按 ZIT_ComfyUI 前缀保存。","nodes":["89","90","137","123","240","135","185","208","222","226","214","227","213","122"]}],"p":"Upscale by 滑条（1.5）决定二传放大倍率，出图尺寸随之翻倍；启用 ControlNet 后用 CONTROLNET STRENGH 滑条（0.9）控制贴合度；i2i 备选模式里 Denoise img2img 滑条 0.5 是改动幅度主旋钮；sharpen amount 默认 0，调高会明显加锐。","n":"多个分组默认旁路或静音（ControlNet、LUT、AutoTone、i2i 首传、保存组），需用图内 Fast Groups Bypasser/Muter 面板按需启用；若干自定义节点以 GUID 串命名，缺包时报错按名补装；模型下载链接在图内 MarkdownNote 里。"}}