rom":"241","fromOut":1,"to":"268","toIn":1},{"from":"246","fromOut":0,"to":"256","toIn":1},{"from":"247","fromOut":0,"to":"255","toIn":0},{"from":"149","fromOut":0,"to":"255","toIn":1},{"from":"148","fromOut":0,"to":"255","toIn":2},{"from":"74","fromOut":0,"to":"266","toIn":0},{"from":"149","fromOut":0,"to":"266","toIn":1},{"from":"148","fromOut":0,"to":"266","toIn":2},{"from":"270","fromOut":0,"to":"255","toIn":3},{"from":"158","fromOut":0,"to":"271","toIn":0},{"from":"271","fromOut":0,"to":"255","toIn":4},{"from":"157","fromOut":0,"to":"270","toIn":0},{"from":"84","fromOut":0,"to":"260","toIn":0},{"from":"173","fromOut":0,"to":"257","toIn":2},{"from":"173","fromOut":0,"to":"263","toIn":2},{"from":"103","fromOut":0,"to":"168","toIn":0},{"from":"263","fromOut":1,"to":"105","toIn":1},{"from":"167","fromOut":0,"to":"272","toIn":0},{"from":"272","fromOut":0,"to":"104","toIn":0},{"from":"168","fromOut":0,"to":"273","toIn":0},{"from":"273","fromOut":0,"to":"104","toIn":1},{"from":"246","fromOut":0,"to":"214","toIn":0},{"from":"274","fromOut":0,"to":"118","toIn":0},{"from":"6","fromOut":0,"to":"274","toIn":0},{"from":"173","fromOut":0,"to":"113","toIn":2},{"from":"272","fromOut":0,"to":"116","toIn":1},{"from":"273","fromOut":0,"to":"116","toIn":2},{"from":"211","fromOut":1,"to":"275","toIn":0},{"from":"275","fromOut":0,"to":"222","toIn":1},{"from":"275","fromOut":0,"to":"267","toIn":1}],"ai":{"s":"本工作流是由 RunComfy 倾力打造的专为顶级底模 Flux.1 Dev 设计的高性能、工业级潜空间瓦片超分辨率分块放大（Flux Latent Tiled Upscale）旗舰管线。由于 Flux.1 模型参数量高达 12B，直接在 2K/4K 乃至更高超清分辨率下进行整图采样会瞬间耗尽 GPU 显存并导致 OOM，该工作流创新性地构建了“一阶段全图潜空间基础构图 + SimpleMath 动态几何坐标运算中枢 + 潜空间上下瓦片切片（LatentCrop）+ 独立高频微观噪波注入（InjectLatentNoise+）+ 两阶段 SplitSigmas 细化收敛 + FeatherMask 边缘羽化潜空间无缝回缝 + 全局极低去噪联合微调”七重闭环架构。通过严谨的数学几何矩阵自适应划分重叠区域（Overlap），配合无缝蒙版融合，彻底解决了传统超分辨率重绘中的接缝硬痕、瓦片拼接色差与画面模糊涂抹感，使消费级单卡即可稳定输出画质极为震撼的超高清商业级成片。","u":["在消费级显卡（16GB-24GB）上突破显存物理瓶颈，无损生成 2K/4K 级超高清 Flux.1 商业摄影与数字艺术大片","对低分辨率 Flux 初稿进行保持构图严格一致的高清微观皮肤毛孔、发丝质感与衣服纹理深度重雕","消除大模型超分重绘中常见的瓦片边缘拼接缝（Seam Lines）与明暗色调割裂瑕疵"],"d":3,"st":[{"name":"模型底模加载与一阶段全图潜空间采样","desc":"通过 UNETLoader 与 DualCLIPLoader 分别挂载 Flux.1 Dev 核心底模与 CLIP-L/T5XXL 双文本编码器；经由 ModelSamplingFlux 调整流匹配时序位移，配合 FluxGuidance 引导尺度，使用 SamplerCustomAdvanced 采样器完成基础分辨率下主体构图、光影透视与人物姿态的初版生成。","nodes":["12","11","10","28","6","29","22","48","25","16","17","13","8","26","49"]},{"name":"潜空间放大、数学切片与动态羽化掩膜系统","desc":"运用 LatentUpscale 将一阶段潜空间等比升采样至超高分辨率，同时依托多达 20 余个 SimpleMath 节点构建精密坐标计算中枢，自适应解算出上下瓦片的裁切长宽、偏移量（Offsets）、重叠区（Overlap）与步长；结合 SolidMask 与 FeatherMask 生成边缘平滑柔和的融合遮罩。","nodes":["138","104","108","109","53","54","103","57","178","180","181","196","197","201","210","211","239","240","241","153","155","157","158","159","162","148","149","167","168","173","174","214","243","244","245","246","247"]},{"name":"上半瓦片（Upper Tile）微观噪波注入与两段式采样重绘","desc":"由 LatentCrop 裁切出上半部局部潜空间，经过 InjectLatentNoise+ 注入定制强度的高斯微观噪波以重新激发生机；利用 SplitSigmasDenoise 切分调度步长，首先由 SamplerCustomAdvanced 进行带噪二次雕刻，随后在 DisableNoise 抑制下由第二采样器执行无噪平滑收敛。","nodes":["51","222","234","77","78","99","76","80","72","71","82","81","68","85","73","74","83","84"]},{"name":"下半瓦片（Lower Tile）微观噪波注入与两段式采样重绘","desc":"针对下半部局部视窗执行与上半部完全对称的高精局部重雕链路：通过 LatentCrop 切片、注入微观噪波（InjectLatentNoise+），利用专有提示词与两阶段级联 SamplerCustomAdvanced 采样器，高效重塑下半画面的高频材质纹理。","nodes":["255","224","264","265","263","266","259","262","258","257","260","261","256","272","267","268","270","271"]},{"name":"瓦片羽化蒙版全图缝合、全局微调去噪与最终成片","desc":"借助两组 LatentCompositeMasked 与 FeatherMask 柔和蒙版，将细化后的上下瓦片无缝回嵌至全尺寸超分潜空间；随后由全图采样器（节点 113）在极低 Denoise（如 0.15~0.25）下进行全局联合微调平滑，消除潜在接缝色差，最终由 VAEDecode 还原为高保真超清像素大图。","nodes":["101","105","116","118","115","117","114","113","106","107","120"]}],"p":"【一阶段采样基础】：基础步数（Steps）推荐 20~25 步，FluxGuidance 设为 3.0~3.5，采样器选用 Euler a，时序调度器推荐 Simple 或 Normal；【潜空间放大倍率】：节点 53 (Scale factor) 建议设为 1.5x~2.0x，过高（如 >2.5x）会导致瓦片重绘去噪负担过重；【微观噪波注入】：节点 210 (Tiles Noise Strength) 推荐设为 0.15~0.25，节点 240 (Inject noise at %) 设为 20%~30%，可精准补充细节而杜绝伪影噪点；【瓦片重绘 Denoise】：节点 239 (Tiles Denoise) 严格控制在 0.35~0.48 之间；【全局微调采样】：阶段五节点 113 的去噪幅度必须极低（0.12~0.2），仅用于平滑拼缝过渡，严禁大改画面整体结构。","t":["【拼缝交界处产生明显硬边缘或色差断层】：这是羽化宽度不足导致的。应确保节点 159 与 162 的 Feathering 数值设置合理（通常至少保留 64~128 像素的羽化宽度），并在节点 109 (FeatherMask) 中确认蒙版边缘呈平滑高斯渐变分布。","【放大后画面细节出现塑料感与蜡化】：潜空间直接升采样会使高频特征模糊，若关闭了 InjectLatentNoise+ 或噪波强度过低（<0.1），扩散模型将无法凭空生成微观发丝与毛孔。务必确保节点 222 与 224 处于激活状态并给予适量噪波扰动。","【分块重绘导致画面局部内容产生结构崩塌或多肢幻觉】：若瓦片重绘阶段 Denoise（节点 239）设置过高（>0.55），扩散模型会在裁剪视窗中将局部肢体误认为独立主体进行重新构图。务必将局部去噪幅度压低在 0.35~0.45 之间，并保持 Tiles Guidance 在 3.0 左右。"],"n":"运行本工作流需要顶级的显卡显存支持，尽管采用了分块瓦片技术规避了全图采样 OOM，但在多模型加载与潜空间拼接阶段依然对 VRAM 有较高要求（建议配备 16GB 以上显存的 RTX 3090/4090 或专业级显卡；若显存为 12GB，请务必加载 Flux.1 Dev 的 FP8 量化版本并将 VAE 设为分块模式）。环境需预先安装 ComfyUI-Impact-Pack、rgthree-comfy、ComfyUI-Custom-Scripts 以及 Inspire-Pack 等扩展节点；模型方面需在 models/unet 下放置 flux1-dev.sft（或 FP8 版本），在 models/clip 放置 t5xxl_fp16/fp8 与 clip_l.safetensors，并在 models/vae 下放置 ae.safetensors。","na":{"51":{"brief":"潜空间高精几何瓦片裁剪器 (LatentCrop Upper Tile)","detail":"基于上游 SimpleMath 动态计算的精确像素偏移量与重叠尺寸，精准从超大画布中裁切出上半部瓦片区域送入局部重绘采样链路，有效绕过整图推理爆显存的物理限制。"},"76":{"brief":"两阶段去噪时间步长分割器 (SplitSigmasDenoise)","detail":"将单瓦片的去噪调度步长拆分为两阶段：第一阶段带随机噪声进行宏观结构补全与细节重雕，第二阶段禁用噪声（DisableNoise）执行确定性平滑收敛，保障瓦片画质洁净度。"},"101":{"brief":"带羽化蒙版的潜空间高阶缝合器 (LatentCompositeMasked)","detail":"结合经过 FeatherMask 柔和羽化边缘的 Alpha 掩码，将重绘细化后的上半与下半瓦片精密嵌合回原始全尺寸潜空间中，在潜空间张量层面彻底消弭拼缝与接缝硬边。"},"138":{"brief":"潜空间整体升采样放大器 (LatentUpscale)","detail":"直接在扩散潜空间层级执行双三次或最近邻插值放大，将基础分辨率潜空间张量无损扩展至目标倍率尺寸，为后续瓦片切片重绘提供高分辨率基底。"},"222":{"brief":"潜空间高频微观噪波注入器 (InjectLatentNoise+)","detail":"在瓦片切片被采样前向其潜空间注入特定比例的高斯噪波，主动补充因潜空间升采样插值而丢失的高频微观纹理与空间扰动，彻底根治插值放大带来的塑料平滑感。"}}}}