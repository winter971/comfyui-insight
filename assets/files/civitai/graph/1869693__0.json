o":"68","toIn":0},{"from":"67","fromOut":0,"to":"69","toIn":0},{"from":"84","fromOut":0,"to":"70","toIn":0},{"from":"67","fromOut":0,"to":"70","toIn":1},{"from":"92","fromOut":0,"to":"71","toIn":0},{"from":"84","fromOut":0,"to":"72","toIn":0},{"from":"78","fromOut":0,"to":"74","toIn":0},{"from":"82","fromOut":0,"to":"74","toIn":1},{"from":"66","fromOut":0,"to":"75","toIn":0},{"from":"55","fromOut":0,"to":"76","toIn":0},{"from":"78","fromOut":0,"to":"77","toIn":0},{"from":"80","fromOut":0,"to":"77","toIn":1},{"from":"77","fromOut":0,"to":"81","toIn":0},{"from":"83","fromOut":0,"to":"82","toIn":0},{"from":"80","fromOut":0,"to":"82","toIn":1},{"from":"73","fromOut":0,"to":"84","toIn":0},{"from":"92","fromOut":0,"to":"84","toIn":1},{"from":"92","fromOut":0,"to":"85","toIn":0},{"from":"84","fromOut":0,"to":"86","toIn":0},{"from":"68","fromOut":0,"to":"89","toIn":0},{"from":"84","fromOut":0,"to":"90","toIn":0},{"from":"63","fromOut":0,"to":"91","toIn":0},{"from":"62","fromOut":0,"to":"91","toIn":1},{"from":"65","fromOut":0,"to":"91","toIn":2},{"from":"68","fromOut":0,"to":"91","toIn":3},{"from":"59","fromOut":0,"to":"91","toIn":4},{"from":"74","fromOut":0,"to":"92","toIn":0}],"ai":{"s":"洗图工作流：把摆拍合成图洗成真实照片。主线两段——先用 FastCanvas 把背景图与 RemBG 抠出的主体合成到一张画布，交给 LBM 桥接模型（lbm.safetensors，30 步采样）做图到图转换，得到真实感底图；再把底图送进 Flux dev 细化：BizyAirJoyCaption2 自动读图写提示词（与手写描述并用，免去手动打标），DepthAnythingV2 提深度图、Union-Pro ControlNet 指定 depth 类型锁构图（强度 0.6、步程 0.4 处截止），Nunchaku int4 量化的 Flux 以去噪 0.7、28 步 euler、guidance 3.5 图生图重绘。分两段的原因：LBM 负责材质真实化，Flux 负责细节与光影精修，深度控制保证精修不破坏已定构图。LBM 底图与最终结果会左右拼图对比输出。注意整图保存时所有节点都处于旁路状态，载入后需先全选取消旁路才能运行。","u":["电商产品图洗成实拍质感：摆好合成图后自动转真实照片","3D 渲染或 AI 生成的素材转写实风格，同时锁住原始构图不走样","懒得写提示词：JoyCaption 自动读图生成描述再喂给 Flux","显存吃紧又想跑 Flux 细化，用 Nunchaku int4 量化模型"],"d":3,"st":[{"name":"画布合成","desc":"背景图与 u2net 抠像后的主体在 FastCanvas 画布上摆位压平，得到一张完整合成图，是后续所有处理唯一输入。","nodes":["78","83","80","82","74","92","85"]},{"name":"LBM 洗图","desc":"LBM 桥接模型把合成图转成真实照片质感的底图，30 步采样；Get Image Size 读出尺寸喂给 Flux 侧的采样偏移。","nodes":["73","84","71","86"]},{"name":"自动提示与深度控制","desc":"JoyCaption 读底图自动写提示词，DualCLIP 按 Flux 方式编码；DepthAnythingV2 提深度，Union ControlNet 以 depth 模式把构图写进正负条件。","nodes":["90","79","62","63","88","65","68","91","56"]},{"name":"Flux 细化采样","desc":"Nunchaku int4 量化 Flux dev 做图生图：ModelSamplingFlux 按尺寸定偏移，RandomNoise 加噪，去噪 0.7、28 步 euler，从 LBM 底图的 latent 出发精修。","nodes":["87","55","76","54","64","57","60","61","59"]},{"name":"输出与显存清理","desc":"解码保存最终图；LBM 底图与细化结果拼成左右对比图另存；两处 PurgeVRAM在阶段间清显存防叠加溢出。","nodes":["67","69","70","66","75","58","72"]}],"p":"ControlNet depth 强度 0.6、在 0.4 步程截止：前段锁构图、后段留自由度，嫌画面死板就降强度或提前截止；Flux 去噪 0.7 决定重绘幅度，改小更保守；LBM 的 30 步影响底图真实感，是整条链的源头。","n":"全图节点保存时均为旁路状态，载入后必须全选取消旁路才能运行；依赖 LayerStyle、Nunchaku、ControlNet-Aux、essentials、RemBG、LBM、FastCanvas、BizyAir 等多个节点包，模型含 int4 Flux、t5xxl/clip_l、ae、Union-Pro ControlNet、DepthAnythingV2、lbm；节点 77/81 是未接线的画布冗余。"}}