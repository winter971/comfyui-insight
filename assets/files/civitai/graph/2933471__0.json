Out":0,"to":"441","toIn":0},{"from":"450","fromOut":0,"to":"449","toIn":9},{"from":"436","fromOut":0,"to":"88","toIn":0},{"from":"463","fromOut":0,"to":"464","toIn":0},{"from":"436","fromOut":0,"to":"463","toIn":0},{"from":"78","fromOut":1,"to":"436","toIn":1},{"from":"436","fromOut":3,"to":"463","toIn":1},{"from":"8","fromOut":0,"to":"464","toIn":1},{"from":"464","fromOut":0,"to":"60","toIn":0},{"from":"464","fromOut":0,"to":"440","toIn":1},{"from":"466","fromOut":0,"to":"465","toIn":0},{"from":"465","fromOut":0,"to":"8","toIn":0},{"from":"467","fromOut":0,"to":"465","toIn":1},{"from":"468","fromOut":0,"to":"465","toIn":2},{"from":"88","fromOut":0,"to":"465","toIn":4},{"from":"75","fromOut":0,"to":"467","toIn":0},{"from":"459","fromOut":0,"to":"467","toIn":1},{"from":"460","fromOut":0,"to":"467","toIn":2},{"from":"75","fromOut":0,"to":"471","toIn":0},{"from":"471","fromOut":0,"to":"465","toIn":3},{"from":"38","fromOut":0,"to":"473","toIn":0},{"from":"39","fromOut":0,"to":"473","toIn":1},{"from":"436","fromOut":0,"to":"473","toIn":2},{"from":"474","fromOut":0,"to":"475","toIn":0},{"from":"437","fromOut":0,"to":"474","toIn":0},{"from":"435","fromOut":0,"to":"437","toIn":0},{"from":"437","fromOut":0,"to":"476","toIn":0},{"from":"435","fromOut":1,"to":"437","toIn":1},{"from":"437","fromOut":3,"to":"476","toIn":1},{"from":"476","fromOut":0,"to":"477","toIn":0},{"from":"482","fromOut":0,"to":"66","toIn":0},{"from":"462","fromOut":0,"to":"89","toIn":0},{"from":"89","fromOut":0,"to":"482","toIn":0},{"from":"473","fromOut":0,"to":"460","toIn":0},{"from":"436","fromOut":0,"to":"111","toIn":2},{"from":"474","fromOut":0,"to":"111","toIn":3},{"from":"474","fromOut":0,"to":"473","toIn":3},{"from":"111","fromOut":0,"to":"459","toIn":0}],"ai":{"s":"Qwen-Image-Edit 2511 无痕换头工作流。两路输入：身体图（需涂出头部遮罩）与脸部参考，各自经 ImageResizeKJv2 统一缩到 1024，脸部再过 BiRefNetRMBG 抠掉背景得到干净脸块。条件侧由 TextEncodeQwenImageEditPlus 把身体与抠脸两张图一起编进正负两路，再过 FluxKontextMultiReferenceLatentMethod 的 index_timestep_zero 校准——这是 2511 多参考编辑的标准接法，模型才能分清哪张是底图、哪张是要换上的头。模型侧用 2511 fp8 底模叠 bfs_head_v5 换头 LoRA，经 ModelSamplingAuraFlow 与 CFGNorm 稳定后以 CFG 2.5、euler、20 步从身体 latent 整图重绘。旁路藏着三组备选：旧 2509 底模、Lightning 提速 LoRA、InpaintCrop/InpaintStitch 局部裁剪缝合支线，启用后者可只重绘头部再无痕贴回。输出自动拼出身体、脸、结果三联对比图并写参数标签保存。","u":["给人像照片换头：上传身体照和另一张脸，自动融合成无痕新图","批量做角色定妆照，固定身体只替换脸部身份","想要对比留档：自动生成身体/脸/结果拼图并标注采样参数","显存或速度受限时，启用旁路 Lightning LoRA 走少步快速出图"],"d":3,"st":[{"name":"双路素材准备","desc":"身体图与脸部参考分别缩放到 1024，脸部用 BiRefNet 抠掉背景——干净的脸块是模型对齐五官的前提；身体图的头部遮罩随图同步缩放。","nodes":["78","435","436","437","474","475"]},{"name":"双图条件编码","desc":"Qwen2.5-VL 编码器把身体与抠脸一起写进正负条件，MultiReferenceLatentMethod 校准多图时序，让 2511 明确底图与换脸来源的分工。","nodes":["38","39","111","473","459","460"]},{"name":"模型与采样","desc":"2511 底模叠换头 LoRA，过 AuraFlow 采样偏移与 CFGNorm；从身体图编码的 latent 出发，CFG 2.5、euler、20 步整图重绘。旁路的 2509 旧底模与 Lightning LoRA 是替换选项。","nodes":["462","482","89","37","66","75","466","468","471","467","465","88"]},{"name":"对比图输出","desc":"解码结果保存，同时把身体、脸、结果拼成三联图并写上采样配置标签，方便核对换头效果与复现参数。","nodes":["8","464","60","439","440","449","450","441"]},{"name":"局部裁剪缝合支线（旁路）","desc":"启用后按头部遮罩裁出小图只重绘头部，InpaintStitch 把结果无痕贴回原图，背景与身体像素零改动；476 用于预览裁剪区域。","nodes":["463","476","477"]}],"p":"无 Lightning 时按图内标注走 euler + simple + 20 步、CFG 2.5；启用 Lightning LoRA 后可降到 4-8 步并相应调低 CFG；两路素材统一 1024，分辨率不必手改；换头贴合度主要由 bfs_head LoRA 与脸部抠图质量决定。","n":"身体图需在 LoadImage 的遮罩编辑器里涂出头部区域；需准备 2511/2509 两代底模、Qwen2.5-VL 编码器、换头与 Lightning 两颗 LoRA、BiRefNet 抠图模型；多处节点默认旁路，按需启用；seed 47 固定，抽卡记得改 randomize。"}}