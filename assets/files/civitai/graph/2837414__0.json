tle":"VHS_VideoCombine","type":"VHS_VideoCombine","cat":"video","x":2354,"y":229,"inputs":[{"name":"images","type":"IMAGE"}],"outputs":[{"name":"Filenames","type":"VHS_FILENAMES"}],"widgets":[],"brief":"把帧序列合成视频文件，三条支线各导出一份便于横向对比","desc":""},{"id":"258","title":"LayerMask: LoadBiRefNetModelV2","type":"LayerMask: LoadBiRefNetModelV2","cat":"mask","x":-3156,"y":1230,"inputs":[],"outputs":[{"name":"birefnet_model","type":"BIREFNET_MODEL"}],"widgets":["RMBG-2.0"],"brief":"图层样式合成节点。（LayerMask: LoadBiRefNetModelV2）","desc":""},{"id":"282","title":"LoadImage","type":"LoadImage","cat":"load","x":-3570,"y":609,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE"},{"name":"MASK","type":"MASK"}],"widgets":["RunComfy_examples_1225_2.png","image"],"brief":"节点 45/46 是旁路的额外参考图，启用后进入多参考编辑","desc":""},{"id":"286","title":"LoadImage","type":"LoadImage","cat":"load","x":-3708,"y":166,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE"},{"name":"MASK","type":"MASK"}],"widgets":["RunComfy_examples_1225_1.jpg","image"],"brief":"节点 45/46 是旁路的额外参考图，启用后进入多参考编辑","desc":""}],"links":[{"from":"263","fromOut":0,"to":"259","toIn":0},{"from":"277","fromOut":0,"to":"259","toIn":1},{"from":"276","fromOut":0,"to":"261","toIn":0},{"from":"259","fromOut":0,"to":"261","toIn":1},{"from":"282","fromOut":0,"to":"264","toIn":0},{"from":"258","fromOut":0,"to":"264","toIn":1},{"from":"268","fromOut":0,"to":"265","toIn":0},{"from":"264","fromOut":0,"to":"266","toIn":0},{"from":"270","fromOut":0,"to":"267","toIn":0},{"from":"268","fromOut":0,"to":"267","toIn":1},{"from":"264","fromOut":0,"to":"268","toIn":0},{"from":"272","fromOut":0,"to":"269","toIn":0},{"from":"272","fromOut":0,"to":"270","toIn":0},{"from":"278","fromOut":0,"to":"271","toIn":0},{"from":"286","fromOut":0,"to":"272","toIn":0},{"from":"283","fromOut":0,"to":"272","toIn":1},{"from":"270","fromOut":0,"to":"273","toIn":0},{"from":"274","fromOut":0,"to":"275","toIn":0},{"from":"278","fromOut":0,"to":"275","toIn":1},{"from":"263","fromOut":0,"to":"276","toIn":0},{"from":"277","fromOut":0,"to":"276","toIn":1},{"from":"284","fromOut":0,"to":"276","toIn":2},{"from":"260","fromOut":0,"to":"277","toIn":0},{"from":"278","fromOut":0,"to":"277","toIn":1},{"from":"267","fromOut":0,"to":"278","toIn":0},{"from":"274","fromOut":0,"to":"279","toIn":0},{"from":"291","fromOut":0,"to":"279","toIn":1},{"from":"279","fromOut":0,"to":"280","toIn":0},{"from":"278","fromOut":0,"to":"280","toIn":1},{"from":"280","fromOut":0,"to":"281","toIn":0},{"from":"281","fromOut":0,"to":"288","toIn":0},{"from":"279","fromOut":0,"to":"289","toIn":0},{"from":"262","fromOut":0,"to":"290","toIn":1},{"from":"290","fromOut":0,"to":"291","toIn":0},{"from":"261","fromOut":0,"to":"291","toIn":1},{"from":"275","fromOut":0,"to":"291","toIn":3},{"from":"292","fromOut":0,"to":"291","toIn":7},{"from":"285","fromOut":0,"to":"291","toIn":9},{"from":"278","fromOut":1,"to":"291","toIn":12},{"from":"278","fromOut":2,"to":"291","toIn":13},{"from":"287","fromOut":0,"to":"291","toIn":10},{"from":"293","fromOut":0,"to":"290","toIn":2}],"ai":{"s":"HunyuanCustom 双主体定制视频：两张参考图各经 BiRefNet（RMBG-2.0）抠出主体，TTP 节点垫白底留边后左右拼接成一张双人画布，统一缩放到 896x512——这张画布就是视频的图像条件，经 HyVideoEncode 编码成参考潜空间，同时进 llava 视觉编码器与 clip_l/llava 双文本编码器，由 Hunyuan I2V 专用文本编码节点把画面与提示词融成条件。模型是 HunyuanVideo 的 HunyuanCustom 720p fp8 定制版，挂 reward 对齐 LoRA，20 个 transformer 块换出到内存省显存；采样挂 TeaCache 0.1、FresCa、SLG 三个加速/提质组件，采出的短视频经 VHS 双路保存：纯结果一版、与输入画布上下拼接的对比版一版。提示词只需描述两主体的互动动作，身份与外观由参考图锁定。","u":["让指定的人与指定的产品同框互动，例如让某位女性拿起某个瓶子，直接生成短视频","电商与广告素材：真人加商品的双主体视频，免去实拍成本","短剧分镜：固定角色与固定道具生成连贯动作镜头","需要身份可控的视频生成：两张参考图分别锁住两个主体的外观"],"d":3,"st":[{"name":"双主体抠图与垫底","desc":"两张参考图分别用 BiRefNet 抠出干净主体，TTP 再垫到白底画布并留边距；抠图质量直接决定后续视频里主体的还原度，各有预览可查。","nodes":["282","258","264","286","283","272","268","270"]},{"name":"合成画布与图像编码","desc":"两主体左右拼接、等比缩到 896x512 并白边补齐，这张画布既是视觉条件也被 VAE 编码成参考潜空间，等于给视频定了构图底版。","nodes":["267","278","274","275"]},{"name":"图文条件编码","desc":"画布进 llava 视觉编码器，提示词走 Hunyuan 双文本编码器，I2V 专用节点把两路融合；负向用固定串即可，不需要精心设计。","nodes":["260","277","263","284","276","259","261"]},{"name":"模型装配","desc":"HunyuanCustom 定制模型负责双主体一致性，reward LoRA 拉高提示词遵循度，block swap 把 20 个块挪出显存换取低配可跑。","nodes":["290","262","293"]},{"name":"采样与双路输出","desc":"采样器吃进条件、潜空间与 TeaCache/FresCa/SLG 三个附加参数，采完分两路存视频：纯净结果与和输入画布拼接的对比版，方便检查主体是否还原。","nodes":["291","292","285","287","279","289","280","281","288"]}],"p":"画布尺寸由 ImageResizeKJv2 的 896x512 决定并自动传给采样器，显存紧张可整体降档；TeaCache 0.1 相当激进，画面出现闪烁或主体变形就降到 0.05 或直接旁路。提示词用英文写清两主体的称呼与动作（如 the woman / the bag），动作幅度小些成片更稳。","n":"HunyuanCustom 定制模型、双 CLIP、llava 视觉编码器与 VAE 都要另下，建议 24GB 以上显存，block swap 20 是用速度换显存的手段。两张参考图务必主体清晰、背景干净；本流程固定双主体，单主体或三主体要改拼接画布结构。依赖 kijai HunyuanVideoWrapper、LayerStyle、KJNodes、Comfyroll、VHS 多个节点包。"}}