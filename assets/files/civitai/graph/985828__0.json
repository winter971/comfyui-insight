:"116","fromOut":1,"to":"48","toIn":0},{"from":"48","fromOut":0,"to":"107","toIn":0},{"from":"48","fromOut":0,"to":"113","toIn":0},{"from":"123","fromOut":0,"to":"117","toIn":0},{"from":"3","fromOut":0,"to":"8","toIn":0},{"from":"4","fromOut":2,"to":"124","toIn":1},{"from":"11","fromOut":0,"to":"124","toIn":0},{"from":"124","fromOut":0,"to":"8","toIn":1},{"from":"144","fromOut":0,"to":"152","toIn":0},{"from":"171","fromOut":0,"to":"144","toIn":7},{"from":"175","fromOut":0,"to":"144","toIn":6},{"from":"176","fromOut":1,"to":"144","toIn":8},{"from":"144","fromOut":1,"to":"178","toIn":0},{"from":"144","fromOut":2,"to":"179","toIn":0},{"from":"124","fromOut":0,"to":"177","toIn":2},{"from":"107","fromOut":0,"to":"177","toIn":3},{"from":"113","fromOut":0,"to":"177","toIn":4},{"from":"177","fromOut":0,"to":"180","toIn":0},{"from":"180","fromOut":0,"to":"144","toIn":1},{"from":"180","fromOut":1,"to":"144","toIn":2},{"from":"180","fromOut":2,"to":"144","toIn":3},{"from":"180","fromOut":3,"to":"144","toIn":4},{"from":"180","fromOut":4,"to":"144","toIn":5},{"from":"8","fromOut":0,"to":"144","toIn":0},{"from":"144","fromOut":0,"to":"28","toIn":0},{"from":"116","fromOut":0,"to":"177","toIn":0},{"from":"48","fromOut":0,"to":"177","toIn":1},{"from":"116","fromOut":0,"to":"3","toIn":0},{"from":"28","fromOut":0,"to":"9","toIn":0},{"from":"144","fromOut":3,"to":"181","toIn":0},{"from":"181","fromOut":0,"to":"182","toIn":0}],"ai":{"s":"Pony Diffusion V6 XL 的文生图一条龙：出整图、自动修脸、超分保存。正负提示词先过 SDXLPromptStyler，自动拼上 Pony 必需的 score 质量标签与 sai-enhance 风格前缀，再由 CLIPTextEncodeSDXL 双路编码；模型过两级 CR LoRA Stack（一级全关备用、一级挂了两个 LoRA）与 CLIPSetLastLayer -2。采样用 dpmpp_2m_sde + karras 30 步、CFG 7、denoise 0.98，画布由 CR SDXL Aspect Ratio 给出 896x1152 的 3:4 档，VAE 经开关二选一（外挂 sdxl_vae 或检查点自带）。解码后进 FaceDetailer：face_yolov8m 检脸、person 分割加 SAM 精修掩码，脸部区域放大单独重采样（denoise 0.7）修崩脸，模型与条件经 ToBasicPipe/FromBasicPipe 打包走线，最后 4x-UltraSharp 放大 1.5 倍保存。","u":["Pony 底模日常出图：填一句正面描述，质量标签与风格前缀自动拼装","多人或远景构图崩脸的自动修复：FaceDetailer 检脸后放大重绘，无需手涂遮罩","想要更锐利的成品图：4x-UltraSharp 放大 1.5 倍直接出可发布尺寸","试装 LoRA：两级 CR LoRA Stack 可叠多组并逐个开关对比"],"d":2,"st":[{"name":"提示词与风格化","desc":"正负文本先经 SDXLPromptStyler 拼上 Pony 的 score 质量标签体系与 sai-enhance 风格，再由 SDXL 双编码器编码，g/l 两路吃同一段风格化文本。","nodes":["110","112","111","107","113"]},{"name":"模型与 LoRA","desc":"Pony V6 XL 检查点串两级 CR LoRA Stack 后应用，CLIPSetLastLayer -2 是 SDXL/Pony 的标准设置；VAE 开关在'外挂 sdxl_vae'与'检查点自带'之间二选一。","nodes":["4","123","117","116","48","11","124"]},{"name":"初始采样","desc":"比例选择器给出 896x1152 的 SDXL 友好画布，dpmpp_2m_sde + karras 30 步出整图并解码预览，denoise 0.98 保证充分生成。","nodes":["34","3","8","35"]},{"name":"自动修脸","desc":"模型、VAE 与正负条件打包成 BasicPipe 喂 FaceDetailer；YOLO 检脸、person 分割与 SAM 共同生成脸部位掩码，脸部区域按 guide_size 放大重采样，崩脸自动修复，掩码与裁剪各有预览。","nodes":["177","180","175","176","171","144","152","178","179","181","182"]},{"name":"放大与保存","desc":"修脸后的整图用 4x-UltraSharp 模型放大 1.5 倍再保存，作为最后一道锐化。","nodes":["28","9"]}],"p":"Pony 常规配置：dpmpp_2m_sde + karras、30 步、CFG 7 即可；FaceDetailer 的 denoise 0.7 是修脸力度，太高会换成另一张脸、太低修不动崩脸；CR Upscale Image 的 1.5 倍缩放按用途调，追求细节可到 2 倍。","n":"需安装 ComfyUI-Impact-Pack 与 Comfyroll，另下 face_yolov8m、person_yolov8m-seg、sam_vit_b 与 4x-UltraSharp 模型；Pony 出图正负提示词都要带 score 标签（已由 Styler 自动处理）；第一级 CR LoRA Stack 默认全关，属备用位。"}}